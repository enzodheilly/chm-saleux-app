# ============================================================
# ENVIRONNEMENT
# ============================================================
APP_ENV=prod                          # dev | prod
APP_DEBUG=0                           # 0 en prod, 1 en dev
APP_SECRET=CHANGE_ME                  # php -r "echo bin2hex(random_bytes(32));"

# ============================================================
# BASE DE DONNÉES
# ============================================================
DATABASE_URL="mysql://user:password@127.0.0.1:3306/chm_db?serverVersion=8.0&charset=utf8mb4"

# ============================================================
# MAILER (Gmail SMTP)
# ============================================================
# Utiliser un mot de passe d'application Gmail (pas le mot de passe principal)
# https://myaccount.google.com/apppasswords
MAILER_DSN="smtp://VOTRE_EMAIL%40gmail.com:MOT_DE_PASSE_APPLICATION@smtp.gmail.com:587"

# ============================================================
# GEMINI AI
# ============================================================
# https://aistudio.google.com/apikey
GEMINI_API_KEY=CHANGE_ME

# ============================================================
# OAUTH GOOGLE
# ============================================================
# https://console.cloud.google.com → Identifiants → Créer un ID client OAuth
OAUTH_GOOGLE_ID=CHANGE_ME
OAUTH_GOOGLE_SECRET=CHANGE_ME

# ============================================================
# CLOUDFLARE TURNSTILE (Anti-bot)
# ============================================================
# https://dash.cloudflare.com → Turnstile
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME

# ============================================================
# JWT (API Mobile)
# ============================================================
# Générer les clés : php bin/console lexik:jwt:generate-keypair
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=CHANGE_ME

# ============================================================
# CORS (API)
# ============================================================
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# ============================================================
# MESSENGER
# ============================================================
MESSENGER_TRANSPORT_DSN=sync://

# ============================================================
# SÉCURITÉ — GÉOBLOCAGE
# ============================================================
GEO_ALLOWED_COUNTRY=FR               # Code pays ISO 3166-1 alpha-2
GEO_BLOCK_VPN=true                   # true | false

# ============================================================
# LOGS & ALERTES
# ============================================================
# Email qui reçoit les alertes de sécurité nocturnes
ADMIN_ALERT_EMAIL=admin@votre-domaine.com
# URL du site (sans slash final)
ADMIN_SITE_URL=https://votre-domaine.com

# ============================================================
# PROXY / CLOUDFLARE (optionnel)
# ============================================================
# Décommenter si tu es derrière Cloudflare ou un reverse proxy
# TRUSTED_PROXIES=127.0.0.1,CIDR_CLOUDFLARE
# TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto,x-forwarded-port,x-forwarded-host
