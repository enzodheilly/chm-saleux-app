{% extends 'base.html.twig' %}

{% block title %}Espace Musculation - CHM Saleux
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/nos_pratiques/musculation.css') }}">
{% endblock %}

{% block body %}

	<header class="page-header-sport" data-bg="{{ asset('images/nos_pratiques/musculation/histoire-club.jpg') }}" data-bg-webp="{{ asset('images/nos_pratiques/musculation/histoire-club.webp') }}">
		<div class="header-overlay-gradient"></div>

		<div class="header-content">
			<div class="page-container">
				<nav class="breadcrumb-nav">
					<a href="{{ path('home') }}" class="back-link-minimal">
						<i class="fa-solid fa-chevron-left"></i>
						<span>Accueil</span>
					</a>
				</nav>

				<div class="header-main-box">
					<div class="badge-accent">Force & Hypertrophie</div>
					<h1>Espace
						<span class="text-outline">Musculation</span>
					</h1>
					<p class="lead">Un plateau de 300m² combinant charges libres et machines guidées de dernière génération.</p>
				</div>
			</div>
		</div>
	</header>

	{# IMAGE DÉCORATIVE GAUCHE #}
	<div class="deco-left-wrap">
		<img src="{{ asset('images/decorations/dots-tree.png') }}" alt="" class="deco-left-img" aria-hidden="true">
	</div>

	<main
		class="page-shell elite-main">

		{# --- SECTION 1 : PECS --- #}
		<section class="feature-section">
			<div class="partner-heading-wrap">
				<h2 class="section-heading centered">Nos différents
					<span>Espaces d'Entraînement</span>
				</h2>
			</div>
			<div class="page-container grid-2">
				<div class="text-side">
					<span class="side-badge">Zone Pectoraux</span>

					<h2 class="section-heading section-heading-xl">
						Développez
						<span>Votre Puissance</span>
					</h2>

					<p>Un arsenal complet pour le travail polyarticulaire et l’isolation, adapté à tous les niveaux de pratique.</p>

					<div class="specs-mini-grid">
						<div class="spec-item">
							<i class="fa-solid fa-dumbbell"></i>
							<div>
								<strong>Charges</strong>
								<small>Haltères 1 à 34kg</small>
							</div>
						</div>
						<div class="spec-item">
							<i class="fa-solid fa-couch"></i>
							<div>
								<strong>Bancs</strong>
								<small>Incliné / Décliné</small>
							</div>
						</div>
					</div>
				</div>

				<div class="visual-side">
					<div class="img-frame-elite">
						<img src="{{ asset('images/zones/pecs.jpg') }}" alt="Zone pectoraux" loading="lazy">
					</div>
					<div class="frame-glow"></div>
				</div>
			</div>
		</section>

		{# --- SECTION 2 : DOS --- #}
		<section class="feature-section alt-bg">
			<div class="page-container grid-2 reversed">
				<div class="text-side">
					<span class="side-badge">Zone Dos</span>

					<h2 class="section-heading section-heading-xl">
						Épaisseur &
						<span>Densité</span>
					</h2>

					<p>Sollicitez votre chaîne postérieure sous tous les angles grâce à notre station de tirage polyvalente et nos postes de rowing.</p>

					<ul class="elite-check-list">
						<li>
							<i class="fa-solid fa-circle-check"></i>
							Station 4 tirages complète</li>
						<li>
							<i class="fa-solid fa-circle-check"></i>
							Espace Deadlift & Tirages lourds</li>
						<li>
							<i class="fa-solid fa-circle-check"></i>
							Bancs à lombaires & Tractions</li>
					</ul>
				</div>

				<div class="visual-side">
					<div class="img-frame-elite">
						<img src="{{ asset('images/zones/dos.jpg') }}" alt="Zone dos" loading="lazy">
					</div>
					<div class="frame-glow primary"></div>
				</div>
			</div>
		</section>

		{# --- SECTION : BRAS --- #}
		<section class="feature-section">
			<div class="page-container grid-2">
				<div class="text-side">
					<span class="side-badge">Zone Bras</span>

					<h2 class="section-heading section-heading-xl">
						Biceps &
						<span>Triceps</span>
					</h2>

					<p>Curl pupitre, barre EZ et câbles pour un travail d'isolation complet et précis.</p>

					<ul class="elite-check-list">
						<li>
							<i class="fa-solid fa-circle-check"></i>
							Curl pupitre & barre EZ</li>
						<li>
							<i class="fa-solid fa-circle-check"></i>
							Câbles hauts & bas</li>
						<li>
							<i class="fa-solid fa-circle-check"></i>
							Haltères & barre droite</li>
					</ul>
				</div>

				<div class="visual-side">
					<div class="img-frame-elite">
						<img src="{{ asset('images/zones/bras.jpg') }}" alt="Zone bras" loading="lazy">
					</div>
				</div>
			</div>
		</section>

		{# --- SECTION 3 : JAMBES --- #}
		<section class="feature-section">
			<div class="page-container grid-2 reversed">
				<div class="text-side">
					<span class="side-badge">Zone Bas du Corps</span>

					<h2 class="section-heading section-heading-xl">
						Force et
						<span>Mobilité</span>
					</h2>

					<p>Presse à 45°, Squat Rack et postes d'isolation pour construire des fondations solides.</p>

					<div class="tag-cloud">
						<span>Presse 45°</span>
						<span>Squat Rack</span>
						<span>Hip Thrust</span>
						<span>Leg Extension</span>
						<span>Trap Bar</span>
					</div>
				</div>

				<div class="visual-side">
					<div class="img-frame-elite">
						<img src="{{ asset('images/zones/jambes.jpg') }}" alt="Zone jambes" loading="lazy">
					</div>
				</div>
			</div>
		</section>

		{# --- SECTION CARDIO --- #}
		<section
			class="elite-cardio-section">

			{# Fond image (positionné en absolu par le CSS) #}
			<div class="cardio-bg" data-bg="{{ asset('images/zones/cardio.webp') }}" data-bg-webp="{{ asset('images/zones/cardio.webp') }}"></div>

			{# Overlay sombre par-dessus le fond #}
			<div class="cardio-overlay"></div>

			{# Contenu (z-index: 5 dans le CSS, donc au-dessus) #}
			<div class="page-container cardio-content">
				<div class="cardio-header">
					<h2 class="section-heading section-heading-xl centered">
						Espace
						<span>Cardio</span>
					</h2>
					<p>Performance cardiovasculaire et condition physique.</p>
				</div>

				<div class="cardio-stats-grid">
					<div class="stat-card">
						<strong>4</strong>
						<span>Tapis</span>
					</div>
					<div class="stat-card active">
						<strong>5</strong>
						<span>Vélos</span>
					</div>
					<div class="stat-card">
						<strong>2</strong>
						<span>Rameurs</span>
					</div>
					<div class="stat-card">
						<strong>2</strong>
						<span>Climbers</span>
					</div>
				</div>
			</div>

		</section>

		{# --- CTA --- #}
		<section class="elite-cta">
			<div class="page-container">
				<div class="cta-box">
					<div class="cta-content">
						<h2 class="section-heading section-heading-xl cta-title">
							Prêt pour le
							<span>Changement ?</span>
						</h2>
						<p>Réservez votre séance d'essai et découvrez notre plateau Musculation.</p>
					</div>

					<a href="{{ path('contact') }}" class="btn-elite-big">
						S'inscrire
						<i class="fa-solid fa-arrow-right"></i>
					</a>
				</div>
			</div>
		</section>

	</main>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	 <script src="{{ asset('js/nos_pratiques/musculation.js') }}"></script>
{% endblock %}
