{% extends 'base.html.twig' %}

{% block title %}Plateau Haltérophilie - CHM Saleux{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/nos_pratiques/halterophilie.css') }}">
{% endblock %}

{% block body %}

    {# --- HEADER ÉLITE --- #}
        <header class="page-header-sport" style="--bg-image: url('{{ asset('images/nos_pratiques/halterophilie/1.jpg') }}');">
        <div class="header-overlay-gradient"></div>
        <div class="container header-content">
            <nav class="breadcrumb-nav">
                <a href="{{ path('home') }}" class="back-link-minimal">
                    <i class="fa-solid fa-chevron-left"></i> <span>Retour à l'accueil</span>
                </a>
            </nav>

            <div class="header-main-box">
                <div class="badge-accent">Performance Olympique</div>
                <h1>ESPACE <span class="text-outline">HALTÉROPHILIE</span></h1>
                <p class="lead">Un plateau technique de 800m², conçu pour l'excellence et sécurisé pour l'apprentissage.</p>
            </div>
        </div>
    </header>

    <main class="elite-main">

        {# --- SECTION 1 : PODIUMS (Image à droite) --- #}
        <section class="feature-section">
            <div class="container grid-2">
                <div class="text-side">
                    <span class="side-badge">Zone 01</span>
                    <h2>PODIUMS & <br><span class="text-highlight">PLATEFORMES</span></h2>
                    <p>Le cœur de la pratique. Nos plateformes spécifiques permettent de chuter sous la barre en toute confiance et d'amortir les charges lourdes sans vibration parasite.</p>
                    
                    <div class="specs-mini-grid">
                        <div class="spec-item">
                            <i class="fa-solid fa-layer-group"></i>
                            <div><strong>Structure</strong><small>Plateaux IWF</small></div>
                        </div>
                        <div class="spec-item">
                            <i class="fa-solid fa-shield-halved"></i>
                            <div><strong>Sécurité</strong><small>Drop Zone 100%</small></div>
                        </div>
                    </div>
                </div>
                <div class="visual-side">
                    <div class="img-frame-elite">
                        <img src="{{ asset('images/halterophilie/podiums.jpg') }}" alt="Plateaux">
                        <div class="frame-glow"></div>
                    </div>
                </div>
            </div>
        </section>

        {# --- SECTION 2 : MATÉRIEL (Inversé - Image à gauche) --- #}
        <section class="feature-section alt-bg">
            <div class="container grid-2 reversed">
                <div class="text-side">
                    <span class="side-badge">Zone 02</span>
                    <h2>BARRES & <br><span class="text-highlight">DISQUES</span></h2>
                    <p>La qualité du roulement et la précision du calibrage sont essentielles. Nous mettons à disposition du matériel de compétition et d'entraînement pour tous les niveaux.</p>
                    
                    <ul class="elite-check-list">
                        <li><i class="fa-solid fa-circle-check"></i> Barres Hommes (20kg) & Femmes (15kg)</li>
                        <li><i class="fa-solid fa-circle-check"></i> Disques Bumper & Compétition (Calibrés)</li>
                        <li><i class="fa-solid fa-circle-check"></i> Barres d'initiation en aluminium</li>
                    </ul>
                </div>
                <div class="visual-side">
                    <div class="img-frame-elite">
                        <img src="{{ asset('images/halterophilie/barres.jpg') }}" alt="Barres">
                        <div class="frame-glow primary"></div>
                    </div>
                </div>
            </div>
        </section>

        {# --- SECTION 3 : ACCESSOIRES --- #}
        <section class="feature-section">
            <div class="container grid-2">
                <div class="text-side">
                    <span class="side-badge">Zone 03</span>
                    <h2>ASSISTANCE & <br><span class="text-highlight">RENFORCEMENT</span></h2>
                    <p>Travaillez vos points faibles avec des outils dédiés. Notre parc d'accessoires permet une programmation complète.</p>
                    
                    <div class="tag-cloud">
                        <span>Blocks d'arraché</span>
                        <span>Racks à squat</span>
                        <span>Magnésie</span>
                        <span>Élastiques</span>
                        <span>Pull-up Bars</span>
                    </div>
                </div>
                <div class="visual-side">
                    <div class="img-frame-elite">
                        <img src="{{ asset('images/halterophilie/accessoires.jpg') }}" alt="Accessoires">
                    </div>
                </div>
            </div>
        </section>

        {# --- BANNER CTA --- #}
        <section class="elite-cta">
            <div class="cta-box">
                <div class="cta-content">
                    <h3>REJOIGNEZ LE <span class="text-outline">COLLECTIF</span></h3>
                    <p>Venez tester notre plateau lors d'une séance d'essai encadrée.</p>
                </div>
                <a href="{{ path('contact') }}" class="btn-elite-big">
                    RÉSERVER MA SÉANCE <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </section>

    </main>
{% endblock %}