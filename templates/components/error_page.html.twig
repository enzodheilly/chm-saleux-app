{#
	Composant partagé pour les pages d'erreur (404 / 500) — design minimal.
	Variables attendues :
	  - code    : "404" | "500"
	  - title   : titre sous le code
	  - message : texte d'explication
#}

<main class="error-page">
	<div class="error-page-code">{{ code }}</div>
	<h1 class="error-page-title">{{ title }}</h1>
	<p class="error-page-message">{{ message }}</p>
	<a href="{{ path('home') }}" class="error-page-btn">Retour à l'accueil</a>
</main>
