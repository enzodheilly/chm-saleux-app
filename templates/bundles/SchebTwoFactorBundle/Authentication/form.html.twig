{% extends 'admin/base_admin.html.twig' %}

{% block title %}Vérification 2FA
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/bundles/form.css') }}">
{% endblock %}

{% block body %}
	<div class="tfa-overlay">
		<div class="tfa-wrapper">

			<div class="tfa-header">
				<div class="tfa-logo">
					<img src="{{ asset('images/favicon/icon2.png') }}" alt="CHM Saleux" width="32" height="32">
				</div>
				<p class="tfa-label">CHM Saleux — Administration</p>
				<h1 class="tfa-title">Vérification en deux étapes</h1>
				<p class="tfa-desc">Ouvrez votre application d'authentification<br>et saisissez le code à 6 chiffres.</p>
			</div>

			<form class="tfa-card" action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}" method="post">

				<span class="tfa-field-label">Code de vérification</span>

				<input id="auth_code" type="text" name="{{ authCodeParameterName }}" class="tfa-input" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autofocus required placeholder="• • • • • •"/>

				{% if authenticationError %}
					<div class="tfa-error">
						<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
							<circle cx="12" cy="12" r="10"/>
							<path d="M12 8v4M12 16h.01"/>
						</svg>
						{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}
					</div>
				{% endif %}

				{% if csrfToken is defined and csrfToken %}
					<input type="hidden" name="{{ csrfParameterName }}" value="{{ csrfToken }}"/>
				{% endif %}

				<button type="submit" class="tfa-btn">Vérifier le code</button>

			</form>

			<div class="tfa-footer-links">
				<a href="{{ path('app_logout') }}" class="tfa-cancel">← Annuler et se déconnecter</a>
			</div>

			<div class="tfa-footer">
				<svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
					<rect x="3" y="11" width="18" height="11" rx="2"/>
					<path d="M7 11V7a5 5 0 0110 0v4"/>
				</svg>
				<span>Connexion chiffrée · Session sécurisée</span>
			</div>

		</div>
	</div>
{% endblock %}
