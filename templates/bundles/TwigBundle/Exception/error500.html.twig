{% extends 'base.html.twig' %}

{% block title %}Erreur serveur — CHM Saleux{% endblock %}

{% block navbar %}{% endblock %}
{% block banner_body_class %} error-body{% endblock %}
{% block main_class %}{% endblock %}
{% block footer %}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/errors/error_page.css') }}">
{% endblock %}

{% block body %}
	{% include 'components/error_page.html.twig' with {
		code: '500',
		eyebrow: 'Erreur 500',
		title: 'Une erreur inattendue s\'est produite',
		message: "Quelque chose s'est mal passé de notre côté. Ce n'est pas vous, c'est nous — essayez de recharger la page dans un instant, ou revenez à l'accueil.",
		showRetry: true,
	} %}
{% endblock %}
