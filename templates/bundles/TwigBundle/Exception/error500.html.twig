{% extends 'base.html.twig' %}

{% block title %}Erreur serveur — CHM Saleux
{% endblock %}

{% block navbar %}{% endblock %}
{% block footer %}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style nonce="{{ csp_nonce('style') }}">
		body {
			min-height: 100vh;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			background: #0f1117;
		}
		.error-page {
			text-align: center;
			padding: 2rem;
		}
		.logo {
			width: 64px;
			margin-bottom: 2rem;
		}
		.error-code {
			font-size: 7rem;
			font-weight: 900;
			color: #F57706;
			line-height: 1;
		}
		.error-title {
			font-size: 1.8rem;
			font-weight: 700;
			margin: 1rem 0 0.5rem;
			color: #f1f5f9;
		}
		.error-message {
			color: #94a3b8;
			font-size: 1rem;
			max-width: 400px;
			margin: 0 auto 2rem;
			line-height: 1.6;
		}
		.error-btn {
			display: inline-block;
			padding: 12px 28px;
			background: #F57706;
			color: #fff;
			text-decoration: none;
			border-radius: 8px;
			font-weight: 700;
			font-size: 1rem;
			transition: opacity 0.2s;
		}
		.error-btn:hover {
			opacity: 0.85;
		}
	</style>
{% endblock %}

{% block body %}
	<main class="error-page">
		<img src="{{ asset('images/favicon/icon2.png') }}" alt="Logo CHM Saleux" class="logo">
		<div class="error-code">500</div>
		<h1 class="error-title">Erreur serveur</h1>
		<p class="error-message">Une erreur inattendue s'est produite. Nous faisons le nécessaire pour la résoudre.</p>
		<a href="{{ path('home') }}" class="error-btn">Retour à l'accueil</a>
	</main>
{% endblock %}
