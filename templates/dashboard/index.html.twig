{% extends 'base.html.twig' %}

{% block navbar %}{% endblock %}
{% block footer %}{% endblock %}


{% set admin = adminInfo|default({}) %}
{% set progress = mobileProgress|default({}) %}
{% set stats = progress.stats|default({}) %}
{% set sessions = progress.sessions|default([]) %}
{% set maxVolume = progress.maxVolume|default(1) %}
{% set totalVolumeKg = stats.total_volume|default(0) %}
{% set totalSeconds = stats.total_duration_seconds|default(0) %}
{% set totalHours = totalSeconds // 3600 %}
{% set totalMinutes = (totalSeconds % 3600) // 60 %}
{% set licence = currentLicence|default(null) %}
{% set licenceActive = licence and licence.expiryDate and licence.expiryDate|date('U') >= "now"|date('U') %}
{% set licenceStatusLabel = licence ? (licenceActive ? 'Active' : 'Inactive') : 'Aucune licence' %}
{% set licenceNumberLabel = licence ? licence.number : 'Non renseignée' %}
{% set licenceTypeLabel = licence ? licence.type : 'Loisir' %}
{% set lastSession = sessions|first %}
{% set firstName = app.user.firstname|default('Adhérent') %}
{% set profileImage = app.user.profileImageDataUrl ? app.user.profileImageDataUrl : app.user|avatar_initials %}
{% set bannerRightImage = asset('images/dashboard/banner-athlete-right.webp') %}

{% block title %}Espace Membre - CHM SALEUX
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('vendor/fullcalendar/index.global.min.css') }}">
	<link rel="stylesheet" href="{{ asset('vendor/cropper/cropper.min.css') }}">
	<link rel="stylesheet" href="{{ asset('css/dashboard/test-v2.css') }}">
{% endblock %}

{% block body %}
	<div class="flash-container">
		{% for label, messages in app.flashes %}
			{% for message in messages %}
				<div class="flash-message flash-{{ label }}">
					<i class="fa-solid {% if label == 'success' %}fa-circle-check{% elseif label == 'error' or label == 'danger' %}fa-circle-xmark{% else %}fa-circle-info{% endif %}"></i>
					<span class="flash-message-text">{{ message }}</span>
					<button type="button" class="flash-close" aria-label="Fermer">
						<i class="fa-solid fa-xmark"></i>
					</button>
				</div>
			{% endfor %}
		{% endfor %}
	</div>

	<div id="mobileOverlay" class="mobile-overlay"></div>

	<div class="app-shell" id="memberDashboard" data-route-update-email="{{ path('adherent_settings_update_email') }}" data-route-update-password="{{ path('adherent_settings_update_password') }}" data-route-update-licence="{{ path('adherent_edit_license') }}" data-route-delete-account="{{ path('profile_delete_account') }}" data-route-upload-photo="{{ path('profile_photo') }}" data-sessions='{{ sessions|json_encode|e("html_attr") }}'>
		<nav class="sidebar" id="sidebar">
			<div class="sidebar-top">
				<a href="{{ path('home') }}" class="brand-badge" title="Retour au site">
					<img src="{{ asset('images/favicon/icon2.png') }}" alt="Logo CHM SALEUX">
				</a>

				<div class="sidebar-nav">
					<div class="nav-item active" data-target="home" title="Vue d'ensemble">
						<i class="fa-solid fa-grip"></i>
						<span class="nav-tooltip">Vue d'ensemble</span>
					</div>

					<div class="nav-item" data-target="progress" title="Mes progrès">
						<i class="fa-solid fa-chart-simple"></i>
						<span class="nav-tooltip">Mes progrès</span>
					</div>

					<div class="nav-item" data-target="history" title="Historique">
						<i class="fa-solid fa-clock-rotate-left"></i>
						<span class="nav-tooltip">Historique</span>
					</div>

					<div class="nav-item" data-target="licence" title="Ma licence">
						<i class="fa-solid fa-id-card"></i>
						<span class="nav-tooltip">Ma licence</span>
					</div>
				</div>
			</div>

			<div class="sidebar-bottom">
				<a href="{{ path('home') }}" class="sidebar-link" title="Retour au site">
					<i class="fa-solid fa-arrow-left"></i>
				</a>

				<div class="sidebar-profile">
					<img id="avatar-preview" src="{{ profileImage }}" alt="Photo de profil" title="Cliquer pour changer la photo" style="cursor:pointer;">
				</div>
			</div>
		</nav>

		<main class="main-content">
			<header class="topbar">
				<div class="topbar-left">
					<button class="menu-toggle" id="sidebarToggle" type="button" aria-label="Ouvrir le menu latéral">
						<i class="fa-solid fa-bars"></i>
					</button>

					<div class="topbar-title-wrap">
						<small>Espace membre CHM Saleux</small>
						<h2 class="page-title">Dashboard adhérent</h2>
					</div>
				</div>

				<div class="topbar-actions">
					<label class="search-pill" aria-label="Rechercher">
						<i class="fa-solid fa-magnifying-glass"></i>
						<input type="text" placeholder="Rechercher une séance, une info...">
					</label>

					<button class="topbar-icon topbar-icon--notification" title="Notifications" type="button">
						<i class="fa-regular fa-bell"></i>
						{% if notifications|default([])|length > 0 %}
							<span class="topbar-notification-dot"></span>
						{% endif %}
					</button>

					<a href="{{ path('contact') }}" class="topbar-cta">
						<i class="fa-solid fa-paper-plane"></i>
						Contact
					</a>

					<button class="topbar-icon" id="openSettingsDrawer" title="Paramètres" type="button">
						<i class="fa-solid fa-gear"></i>
					</button>
				</div>
			</header>

			<div class="content-scroll">
				<div class="content-inner">
					<div class="hero-top">
						<div class="welcome-block">
							<div class="eyebrow">Suivez votre progression ici</div>
							<h1 class="welcome-title">Bon retour,
								<span class="accent">{{ firstName }}</span>
								!</h1>
							<p class="welcome-text">
								Retrouvez votre licence, vos statistiques d'entraînement et l’historique synchronisé avec l’application mobile dans une interface plus premium, plus sportive et plus claire.
							</p>
						</div>

						<div class="top-kcal-box">
							<div>
								<div class="metric-mini-label">Temps d'entraînement total</div>
								<div class="metric-mini-value">
									{% if totalHours > 0 %}
										{{ totalHours }}h
										{{ totalMinutes }}m
									{% else %}
										{{ totalMinutes }}m
									{% endif %}
								</div>
								<div class="metric-mini-sub">Période :
									{{ progress.rangeLabel|default('30 jours') }}</div>
							</div>

							<div class="topbar-icon top-kcal-box-icon">
								<i class="fa-solid fa-stopwatch"></i>
							</div>
						</div>
					</div>

					<section id="tab-home" class="section-view active">
						<div class="home-banner-wrap">
							<div class="glass-card banner-card">
								<div class="banner-content">
									<div class="banner-chip">
										<i class="fa-solid fa-bolt"></i>
										Performance • Discipline • Régularité
									</div>

									<h2 class="banner-title">
										Allez plus loin :
										<span class="strong">chaque séance</span>
										construit votre progression.
									</h2>

									<p class="banner-text">
										Centralisez vos statistiques, votre licence et vos dernières séances dans un dashboard conçu pour mettre en valeur votre progression et votre engagement au sein du club.
									</p>

									<div class="banner-inline-stats">
										<div class="banner-inline-stat">
											<span>Licence</span>
											<strong>{{ licenceStatusLabel }}</strong>
										</div>

										<div class="banner-inline-stat">
											<span>Répétitions</span>
											<strong id="homeTotalReps">0</strong>
										</div>

										<div class="banner-inline-stat">
											<span>Dernière activité</span>
											<strong>{{ lastSession and lastSession.performed_at is defined and lastSession.performed_at ? lastSession.performed_at|date('d/m/Y') : 'Aucune' }}</strong>
										</div>
									</div>
								</div>

								<div class="banner-visual">
									<img src="{{ bannerRightImage }}" alt="Athlète CHM" class="banner-athlete">
								</div>
							</div>
						</div>

						<input type="file" id="avatar-upload" class="input-file-hidden" accept="image/png, image/jpeg">

						<div class="dashboard-grid">
							<div class="glass-card card-padding weekly-progress-card">
								<div class="card-head weekly-head">
									<div class="card-head-left">
										<div class="card-icon"></div>
										<div class="dashboard-card-heading">
											<span class="dashboard-card-kicker">Suivi performance</span>
											<h3 class="dashboard-card-title">Progression hebdomadaire</h3>
											<span class="dashboard-card-title-line"></span>
										</div>
									</div>
								</div>

								<div class="weekly-tabs home-metric-tabs" id="homeMetricTabs">
									<button class="weekly-tab active" type="button" data-metric="volume">Volume</button>
									<button class="weekly-tab" type="button" data-metric="duration">Durée</button>
									<button class="weekly-tab" type="button" data-metric="reps">Reps</button>
								</div>

								{% if sessions|length > 0 %}
									<div class="refined-chart" id="homeWeeklyChart"></div>

									<div class="refined-weekly-stats">
										<div class="weekly-stat-box">
											<div class="weekly-stat-label">Total affiché</div>
											<div class="weekly-stat-value" id="homeMetricTotal">{{ totalVolumeKg|number_format(0, ',', ' ') }}
												kg</div>
										</div>

										<div class="weekly-stat-box">
											<div class="weekly-stat-label">Meilleure journée</div>
											<div class="weekly-stat-value" id="homeBestDay">—</div>
										</div>
									</div>
								{% else %}
									<div class="empty-state">Aucune donnée disponible pour la progression hebdomadaire.</div>
								{% endif %}
							</div>

							<div class="right-stack">
								<div class="glass-card card-padding last-sessions-card">
									<div class="card-head">
										<div class="card-head-left">
											<div class="card-icon"></div>
											<div class="dashboard-card-heading">
												<span class="dashboard-card-kicker">Activité récente</span>
												<h3 class="dashboard-card-title">Vos dernières séances</h3>
												<span class="dashboard-card-title-line"></span>
											</div>
										</div>
									</div>

									{% if sessions|length > 0 %}
										<div class="today-list">
											{% for s in sessions|slice(0, 3) %}
												{% set durSec = s.duration_seconds|default(0) %}
												{% set durH = durSec // 3600 %}
												{% set durM = (durSec % 3600) // 60 %}

												<div class="today-item">
													<div class="today-icon">
														<i class="fa-solid fa-dumbbell"></i>
													</div>

													<div>
														<h4 class="today-title">{{ s.routine_name|default('Séance libre') }}</h4>
														<div class="today-meta">
															{{ s.performed_at|default(null) ? 'Le ' ~ s.performed_at|date('d/m/Y à H:i') : 'Date non renseignée' }}
														</div>

														<div class="today-stats">
															<div class="today-stat">
																<strong>
																	{% if durH > 0 %}
																		{{ durH }}h
																		{{ durM }}m
																	{% else %}
																		{{ durM }}m
																	{% endif %}
																</strong>
																<span>Durée</span>
															</div>

															<div class="today-stat">
																<strong>{{ s.total_volume|default(0)|number_format(0, ',', ' ') }}
																	kg</strong>
																<span>Volume</span>
															</div>
														</div>
													</div>

													{% if s.is_from_planning|default(false) %}
														<div class="today-badge">Planning</div>
													{% else %}
														<div class="today-badge">Libre</div>
													{% endif %}
												</div>
											{% endfor %}
										</div>
									{% else %}
										<div class="empty-state">Aucune séance récente à afficher.</div>
									{% endif %}
								</div>
							</div>
						</div>
					</section>

					<section id="tab-progress" class="section-view">
						<div class="section-head">
							<h3>Mes progrès</h3>

							<div class="progress-range-menu" id="progressRangeTabs">
								<button type="button" class="progress-range-trigger" id="progressRangeTrigger">
									<i class="fa-solid fa-sliders"></i>
									<span class="progress-range-label">30 derniers jours</span>
									<i class="fa-solid fa-chevron-down"></i>
								</button>

								<div class="progress-range-dropdown" id="progressRangeDropdown">
									<button type="button" class="progress-range-option active" data-range="30">30 derniers jours</button>
									<button type="button" class="progress-range-option" data-range="90">3 derniers mois</button>
									<button type="button" class="progress-range-option" data-range="365">Cette année</button>
									<button type="button" class="progress-range-option" data-range="0">All time</button>
								</div>
							</div>
						</div>

						{% if sessions|length > 0 %}
							<div class="glass-card card-padding progress-detailed-card">
								<div class="progress-topbar">
									<div class="card-head-left">
										<div class="card-icon">
											<i class="fa-solid fa-chart-line"></i>
										</div>
										<div>
											<h3 class="card-title">Progression globale</h3>
											<div class="card-subtitle">Vue détaillée de votre activité avec filtres de période</div>
										</div>
									</div>

									<div class="progress-filters">
										<div class="weekly-tabs progress-metric-tabs" id="progressMetricTabs">
											<button class="weekly-tab active" type="button" data-metric="volume">Volume</button>
											<button class="weekly-tab" type="button" data-metric="duration">Durée</button>
											<button class="weekly-tab" type="button" data-metric="reps">Reps</button>
										</div>
									</div>
								</div>

								<div class="refined-chart progress-detailed-chart" id="progressDetailedChart"></div>

								<div class="progress-summary-grid">
									<div class="progress-summary-box">
										<div class="weekly-stat-label">Total période</div>
										<div class="weekly-stat-value" id="progressTotalValue">—</div>
									</div>

									<div class="progress-summary-box">
										<div class="weekly-stat-label">Temps cumulé</div>
										<div class="weekly-stat-value" id="progressDurationValue">—</div>
									</div>

									<div class="progress-summary-box">
										<div class="weekly-stat-label">Répétitions</div>
										<div class="weekly-stat-value" id="progressRepsValue">—</div>
									</div>

									<div class="progress-summary-box">
										<div class="weekly-stat-label">Jours actifs</div>
										<div class="weekly-stat-value" id="progressActiveDaysValue">—</div>
									</div>
								</div>
							</div>
						{% else %}
							<div class="empty-state">Aucune donnée disponible pour afficher vos progrès.</div>
						{% endif %}
					</section>

					<section id="tab-history" class="section-view">
						<div class="section-head">
							<h3>Historique complet des séances</h3>
							<div class="section-pill">
								<i class="fa-solid fa-database"></i>
								{{ sessions|length }}
								enregistrements
							</div>
						</div>

						<div class="glass-card card-padding">
							{% if sessions|length > 0 %}
								<div class="history-wrap">
									<table class="history-table">
										<thead>
											<tr>
												<th>Date</th>
												<th>Séance</th>
												<th>Volume</th>
												<th>Durée</th>
												<th>Origine</th>
											</tr>
										</thead>
										<tbody>
											{% for s in sessions %}
												{% set durSec = s.duration_seconds|default(0) %}
												{% set durH = durSec // 3600 %}
												{% set durM = (durSec % 3600) // 60 %}
												<tr>
													<td>{{ s.performed_at|default(null) ? s.performed_at|date('d/m/Y') : '—' }}</td>
													<td>{{ s.routine_name|default('Séance') }}</td>
													<td>{{ s.total_volume|default(0)|number_format(0, ',', ' ') }}
														kg</td>
													<td>
														{% if durH > 0 %}
															{{ durH }}h
															{{ durM }}m
														{% else %}
															{{ durM }}m
														{% endif %}
													</td>
													<td>
														{% if s.is_from_planning|default(false) %}
															Planning
														{% else %}
															Libre
														{% endif %}
													</td>
												</tr>
											{% endfor %}
										</tbody>
									</table>
								</div>
							{% else %}
								<div class="empty-state">Aucun historique disponible.</div>
							{% endif %}
						</div>
					</section>

					<section id="tab-licence" class="section-view">

						<div class="section-head">
							<h3>Votre licence officielle</h3>
							<div class="section-pill">
								<i class="fa-solid fa-shield-halved"></i>
								Saison 2025 / 2026
							</div>
						</div>

						<div
							class="lic-shell">

							{# --- CARTE PRINCIPALE --- #}
							<div
								class="glass-card lic-card">

								{# Bandeau haut #}
								<div class="lic-band">
									<div class="lic-brand">
										<div class="lic-brand-logo">
											<img src="{{ asset('images/favicon/icon2.png') }}" alt="Logo CHM">
										</div>
										<div>
											<div class="lic-brand-label">Club affilié</div>
											<div class="lic-brand-name">CHM SALEUX</div>
										</div>
									</div>
									<div class="lic-status-badge {{ licenceActive ? 'is-active' : 'is-inactive' }}">
										{% if licenceActive %}
											<span class="lic-status-dot"></span>
											Licence active
										{% else %}
											<i class="fa-solid fa-triangle-exclamation" style="font-size:.7rem"></i>
											Licence inactive
										{% endif %}
									</div>
								</div>

								{# Identité membre #}
								<div class="lic-identity">
									<div class="lic-name-block">
										<div class="lic-member-label">Adhérent</div>
										<div class="lic-member-name">{{ app.user.firstname }}
											{{ app.user.lastname }}</div>
										<div class="lic-member-email">{{ app.user.email }}</div>
									</div>
									<div class="lic-num-box">
										<div class="lic-num-label">N° licence</div>
										<div class="lic-num-val">{{ licenceNumberLabel }}</div>
									</div>
								</div>

								{# Grille 4 colonnes #}
								<div class="lic-grid">
									<div class="lic-field">
										<div class="lf-label">Club</div>
										<div class="lf-val">CHM SALEUX</div>
									</div>
									<div class="lic-field">
										<div class="lf-label">Saison</div>
										<div class="lf-val">2025 / 2026</div>
									</div>
									<div class="lic-field">
										<div class="lf-label">Type</div>
										<div class="lf-val">{{ licenceTypeLabel }}</div>
									</div>
									<div class="lic-field">
										<div class="lf-label">Statut</div>
										<div class="lf-val {{ licenceActive ? 'lf-val--ok' : 'lf-val--danger' }}">{{ licenceStatusLabel }}</div>
									</div>
									<div class="lic-field">
										<div class="lf-label">Cotisation</div>
										<div class="lf-val">{{ admin.feesStatus|default('—') }}</div>
									</div>
									<div class="lic-field">
										<div class="lf-label">Échéance cotisation</div>
										<div class="lf-val">{{ admin.feesDue|default('—') }}</div>
									</div>
									<div class="lic-field">
										<div class="lf-label">Certificat médical</div>
										<div class="lf-val">{{ admin.medicalStatus|default('—') }}</div>
									</div>
									<div class="lic-field">
										<div class="lf-label">Expiration certif.</div>
										<div class="lf-val">{{ admin.medicalExpiry|default('—') }}</div>
									</div>
								</div>

								{# Footer contextuel #}
								{% if licenceActive %}

									<div class="lic-footer lic-footer--active">
										<div class="lic-footer-left">
											<i class="fa-solid fa-circle-check lic-footer-icon lic-footer-icon--ok"></i>
											<div>
												<div class="lic-footer-title">Licence valide pour la saison 2025 / 2026</div>
												<div class="lic-footer-sub">Votre renouvellement sera à effectuer en septembre 2026 auprès du club.</div>
											</div>
										</div>
										<a href="{{ path('contact') }}" class="lic-footer-action">
											Contacter le club
											<i class="fa-solid fa-arrow-right" style="font-size:.7rem"></i>
										</a>
									</div>

								{% else %}

									{# État par défaut : invitation à saisir #}
									<div class="lic-footer lic-footer--inactive" id="licFooterDefault">
										<div class="lic-footer-left">
											<i class="fa-solid fa-envelope-open-text lic-footer-icon lic-footer-icon--warn"></i>
											<div>
												<div class="lic-footer-title">Vous avez reçu votre numéro de licence par e-mail ?</div>
												<div class="lic-footer-sub">Une fois votre inscription validée par le club, renseignez-le ici pour activer votre licence.</div>
											</div>
										</div>
										<button type="button" class="lic-footer-action lic-footer-action--primary" id="licAddBtn">
											Renseigner mon numéro
											<i class="fa-solid fa-arrow-right" style="font-size:.7rem"></i>
										</button>
									</div>

									{# Formulaire inline (masqué par défaut) #}
									<div class="lic-footer lic-footer--form is-hidden" id="licFooterForm">
										<div class="lic-form-wrap">
											<div class="lic-form-header">
												<i class="fa-solid fa-id-card" style="color:#F57706;font-size:.9rem"></i>
												<span>Renseigner le numéro de licence</span>
											</div>
											<div class="lic-form-hint">
												Votre numéro figure dans l'e-mail de confirmation envoyé par CHM Saleux suite à la validation de votre adhésion.
											</div>
											<div class="lic-form-row">
												<input type="text" id="licenceInputManual" class="lic-input" placeholder="Ex : 123456789" maxlength="20" autocomplete="off">
												<button type="button" class="btn-primary" id="licSaveBtn">
													<i class="fa-solid fa-floppy-disk"></i>
													Enregistrer
												</button>
												<button type="button" class="lic-cancel-btn" id="licCancelBtn">
													Annuler
												</button>
											</div>
										</div>
									</div>

								{% endif %}

							</div>

							{# --- COLONNE DROITE --- #}
							<div class="lic-side">

								<div class="glass-card lic-side-card">
									<div class="lic-side-icon">
										<i class="fa-solid fa-file-pdf"></i>
									</div>
									<h4>Justificatif adhérent</h4>
									<p>Téléchargez votre justificatif pour mutuelle, CE ou dossier administratif.</p>
									<a href="#" class="btn-primary btn-full-width">
										<i class="fa-solid fa-download"></i>
										Télécharger
									</a>
								</div>

								<div class="glass-card lic-side-card">
									<h4>Résumé</h4>
									<div class="lic-info-rows">
										<div class="lic-info-row">
											<span class="lir-label">Type</span>
											<span class="lir-val">{{ licenceTypeLabel }}</span>
										</div>
										<div class="lic-info-row">
											<span class="lir-label">Statut</span>
											<span class="lir-val {{ licenceActive ? 'lir-val--ok' : 'lir-val--danger' }}">{{ licenceStatusLabel }}</span>
										</div>
										<div class="lic-info-row">
											<span class="lir-label">Certificat</span>
											<span class="lir-val">{{ admin.medicalStatus|default('—') }}</span>
										</div>
										<div class="lic-info-row">
											<span class="lir-label">Échéance</span>
											<span class="lir-val">{{ admin.feesDue|default('—') }}</span>
										</div>
									</div>
								</div>

							</div>

						</div>
					</section>


				</div>
			</div>
		</main>
	</div>

	<div id="settingsOverlay" class="settings-overlay"></div>

	<aside
		id="settingsDrawer" class="settings-drawer" aria-hidden="true">

		{# --- HEADER --- #}
		<div class="sd-header">
			<div class="sd-header-left">
				<div class="sd-avatar">
					{{ app.user.firstname|first|upper }}{{ app.user.lastname|first|upper }}
				</div>
				<div class="sd-header-info">
					<strong class="sd-header-name">{{ app.user.firstname }}
						{{ app.user.lastname }}</strong>
					<span class="sd-header-role">Adhérent · CHM Saleux</span>
				</div>
			</div>
			<button class="sd-close" id="closeSettingsDrawer" title="Fermer" type="button">
				<i class="fa-solid fa-xmark"></i>
			</button>
		</div>

		{# --- FEEDBACK --- #}
		<div id="settingsFeedback" class="sd-feedback is-hidden"></div>

		{# --- BODY --- #}
		<div
			class="sd-body">

			{# Groupe : Compte #}
			<div class="sd-group">
				<div class="sd-group-label">Compte</div>
				<div class="sd-list">
					<div class="sd-list-row sd-list-row--info">
						<span class="sd-list-title">Nom</span>
						<span class="sd-list-value">{{ app.user.firstname }}
							{{ app.user.lastname }}</span>
					</div>
					<div class="sd-list-row sd-list-row--info">
						<span class="sd-list-title">E-mail</span>
						{% set emailDomain = app.user.email|split('@')|last %}
						<span class="sd-list-value">{{ app.user.email|slice(0,3) }}••••@{{ emailDomain }}</span>
					</div>
				</div>
			</div>

			{# Groupe : Connexion #}
			<div class="sd-group">
				<div class="sd-group-label">Connexion</div>
				<div
					class="sd-list">

					{# Ligne e-mail #}
					<div class="sd-list-row sd-list-row--action" data-toggle-form="email">
						<span class="sd-list-title">Modifier l'e-mail</span>
						<i class="fa-solid fa-chevron-right sd-chevron"></i>
					</div>
					<div id="form-email" class="sd-inline-form is-hidden">
						<div class="sd-form-grid">
							<div class="sd-field">
								<label for="input-email">Nouvel e-mail</label>
								<input type="email" id="input-email" class="sd-input" placeholder="nouvel@email.com">
							</div>
							<div class="sd-field">
								<label for="input-email-password">Mot de passe actuel</label>
								<input type="password" id="input-email-password" class="sd-input" placeholder="••••••••">
							</div>
						</div>
						<input type="hidden" id="email-csrf" value="{{ csrf_token('update_email') }}">
						<div class="sd-form-actions">
							<button class="sd-cancel" type="button" data-toggle-form="email">Annuler</button>
							<button class="btn-primary" type="button" id="saveEmailBtn">
								<i class="fa-solid fa-floppy-disk"></i>
								Enregistrer
							</button>
						</div>
					</div>

					{# Ligne mot de passe #}
					<div class="sd-list-row sd-list-row--action" data-toggle-form="password">
						<span class="sd-list-title">Changer le mot de passe</span>
						<i class="fa-solid fa-chevron-right sd-chevron"></i>
					</div>
					<div id="form-password" class="sd-inline-form is-hidden">
						<div class="sd-form-grid">
							<div class="sd-field">
								<label for="old-pass">Mot de passe actuel</label>
								<input type="password" id="old-pass" class="sd-input" placeholder="••••••••">
							</div>
							<div class="sd-field">
								<label for="new-pass">Nouveau mot de passe</label>
								<input type="password" id="new-pass" class="sd-input" placeholder="8 caractères min.">
							</div>
							<div class="sd-field sd-field-full">
								<label for="confirm-pass">Confirmer</label>
								<input type="password" id="confirm-pass" class="sd-input" placeholder="Confirmer le nouveau mot de passe">
							</div>
						</div>
						<input type="hidden" id="password-csrf" value="{{ csrf_token('update_password') }}">
						<div class="sd-form-actions">
							<button class="sd-cancel" type="button" data-toggle-form="password">Annuler</button>
							<button class="btn-primary" type="button" id="savePasswordBtn">
								<i class="fa-solid fa-shield-halved"></i>
								Mettre à jour
							</button>
						</div>
					</div>

				</div>
			</div>

			{# Groupe : Apparence #}
			<div class="sd-group">
				<div class="sd-group-label">Apparence</div>
				<div class="sd-list">
					<div class="sd-list-row">
						<span class="sd-list-title">Thème</span>
						<span class="sd-list-value sd-list-value--active">
							<i class="fa-solid fa-moon" style="font-size:11px"></i>
							Sombre actif
						</span>
					</div>
				</div>
			</div>

			{# Groupe : Danger #}
			<div class="sd-group">
				<div class="sd-group-label sd-group-label--danger">Zone de danger</div>
				<div class="sd-list">
					<div class="sd-list-row sd-list-row--danger" id="deleteAccountBtn">
						<span class="sd-list-title sd-list-title--danger">Supprimer le compte</span>
						<i class="fa-solid fa-chevron-right sd-chevron sd-chevron--danger"></i>
					</div>
				</div>
			</div>

		</div>
	</aside>


	<div id="cropperModal" class="cropper-modal-overlay">
		<div class="cropper-modal-card">
			<h3 class="cropper-modal-title">Ajuster la photo</h3>
			<div class="cropper-modal-frame">
				<img id="cropperImage" src="" class="cropper-modal-image" alt="">
			</div>
			<div class="cropper-modal-actions">
				<button id="cancelCropBtn" class="btn-outline" type="button">Annuler</button>
				<button id="cropAndSaveBtn" class="btn-primary" type="button">Enregistrer</button>
			</div>
		</div>
	</div>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
 <script src="{{ asset('vendor/chartjs/chart.umd.min.js') }}" defer nonce="{{ csp_nonce('script') }}"></script>
	 <script src="{{ asset('vendor/fullcalendar/index.global.min.js') }}" defer nonce="{{ csp_nonce('script') }}"></script>
	 <script src="{{ asset('js/dashboard/test-v2.js') }}" defer nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
