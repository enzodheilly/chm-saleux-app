                    <button class="btn-primary" onclick="updateProfile('phone')">Enregistrer</button>
                </div>
            </div>
        </div>

        <div class="card" style="margin-bottom:14px;">
            <div class="card-padding" style="border-bottom:1px solid var(--border);">
                <h4 style="margin:0; color:var(--text-main);">Sécurité</h4>
            </div>
            <div class="card-padding">
                <div style="display:flex; gap:12px; flex-wrap:wrap;">
                    <button class="btn-outline" style="flex:1; min-width:190px;" onclick="toggleEdit('password')">Changer mot de passe</button>
                    <button class="btn-outline" style="flex:1; min-width:190px;" onclick="toggleA2F()">Activer 2FA</button>
