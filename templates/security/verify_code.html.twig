{% extends 'base.html.twig' %}

{% block title %}Vérification du compte - CHM Saleux
{% endblock %}

{% block navbar %}{% endblock %}
{% block main_class %}{% endblock %}
{% block footer %}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/security/auth_layout.css') }}">
{% endblock %}

{% block body %}
	<section
		class="auth-split-screen">

		{# --- CÔTÉ GAUCHE : FORMULAIRE --- #}
		<div class="auth-left">
			<div class="auth-content-wrapper">
				<div class="auth-header">
					<a href="{{ path('home') }}" class="auth-logo">
						<img src="{{ asset('images/favicon/icon2.png') }}" alt="Logo CHM">
					</a>
					<h1>VÉRIFICATION</h1>
					<p>Un code à 6 chiffres a été envoyé à votre adresse email. Vérifiez également vos spams.</p>
				</div>

				{# Flash messages #}
				{% for label, messages in app.flashes %}
					{% for message in messages %}
						<div class="alert-{{ label }} flash-{{ label }}">
							{{ message }}
						</div>
					{% endfor %}
				{% endfor %}

				<form action="{{ path('app_verify_code') }}" method="post" class="auth-form">
					<input type="hidden" name="_token" value="{{ csrf_token('verify_code') }}">

					<div class="form-group">
						<label for="code">Code de vérification</label>
						<div class="code-inputs">
							<input type="text" maxlength="1" class="code-box form-control" autofocus autocomplete="off" inputmode="numeric">
							<input type="text" maxlength="1" class="code-box form-control" autocomplete="off" inputmode="numeric">
							<input type="text" maxlength="1" class="code-box form-control" autocomplete="off" inputmode="numeric">
							<input type="text" maxlength="1" class="code-box form-control" autocomplete="off" inputmode="numeric">
							<input type="text" maxlength="1" class="code-box form-control" autocomplete="off" inputmode="numeric">
							<input type="text" maxlength="1" class="code-box form-control" autocomplete="off" inputmode="numeric">
						</div>
						<input type="hidden" id="code" name="code">
					</div>

					<button type="submit" class="btn-auth login-btn">
						<span class="btn-text">Vérifier mon compte</span>
					</button>
				</form>

				<div class="register-hint">
					<p>Vous n'avez pas reçu le code ?</p>
					<form action="{{ path('app_resend_code') }}" method="post" id="resend-form">
						<input type="hidden" name="_token" value="{{ csrf_token('resend_code') }}">
						<button type="submit" class="btn-resend" id="btn-resend">
							<span class="btn-text">Renvoyer le code</span>
						</button>
					</form>
				</div>
			</div>
		</div>

		{# --- CÔTÉ DROIT : SLIDER --- #}
		<div class="auth-right">
			<div class="slider-arrows">
				<div class="arrow prev" id="btn-prev">❮</div>
				<div class="arrow next" id="btn-next">❯</div>
			</div>

			<div class="auth-slider">
				<div class="slide slide-1 active">
					<div class="slide-content">
						<h2>Dernière<br>Étape</h2>
						<p>Confirmez votre adresse email pour activer votre compte et accéder au club.</p>
						<div class="slide-pagination">
							<span class="dot active" data-slide="0"></span>
							<span class="dot" data-slide="1"></span>
							<span class="dot" data-slide="2"></span>
						</div>
					</div>
				</div>

				<div class="slide slide-2">
					<div class="slide-content">
						<h2>Vérifiez<br>Vos Spams</h2>
						<p>Si vous ne trouvez pas l'email, pensez à vérifier votre dossier spam ou courrier indésirable.</p>
						<div class="slide-pagination">
							<span class="dot" data-slide="0"></span>
							<span class="dot active" data-slide="1"></span>
							<span class="dot" data-slide="2"></span>
						</div>
					</div>
				</div>

				<div class="slide slide-3">
					<div class="slide-content">
						<h2>Besoin d'aide ?</h2>
						<p>Le staff du CHM Saleux est à votre disposition pour toute question.</p>
						<div class="slide-pagination">
							<span class="dot" data-slide="0"></span>
							<span class="dot" data-slide="1"></span>
							<span class="dot active" data-slide="2"></span>
						</div>
					</div>
				</div>
			</div>
		</div>

	</section>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	 <script src="{{ asset('js/security/auth_slider.js') }}" defer nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
