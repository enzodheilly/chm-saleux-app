{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe - CHM Saleux
{% endblock %}

{% block navbar %}{% endblock %}
{% block footer %}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/security/auth_layout.css') }}">
{% endblock %}

{% block body %}
	<section
		class="auth-split-screen">

		{# --- GAUCHE : FORMULAIRE DE RÉINITIALISATION --- #}
		<div class="auth-left">
			<div class="auth-content-wrapper">

				<div class="auth-header">
					<a href="{{ path('home') }}" class="auth-logo">
						<img src="{{ asset('images/favicon/icon2.png') }}" alt="Logo CHM">
					</a>
					<h1>Réinitialisation du mot de passe</h1>
					<p>Choisissez un nouveau mot de passe sécurisé pour votre compte.</p>
				</div>

				{# FLASH ERRORS #}
				{% for message in app.flashes('error') %}
					<div class="alert-error">{{ message }}</div>
				{% endfor %}

				{% for message in app.flashes('success') %}
					<div class="alert-success">{{ message }}</div>
				{% endfor %}

				<form action="{{ path('app_reset_password_confirm', { token: token }) }}" method="post" class="auth-form">

					<div class="form-group">
						<label for="password">Nouveau mot de passe</label>
						<div class="password-input-wrapper">
							<input type="password" id="password" name="password" class="form-control" placeholder="••••••••••••" required minlength="12" autocomplete="new-password">

							<span class="toggle-password" data-target="password">
								<img src="{{ asset('images/eye/eye-open.png') }}" alt="Afficher" class="eye-icon eye-open">
								<img src="{{ asset('images/eye/eye-closed.png') }}" alt="Cacher" class="eye-icon eye-closed hide">
							</span>
						</div>

						<p class="password-hint">Minimum 12 caractères, dont majuscule, minuscule, chiffre et symbole.</p>
					</div>

					<div class="form-group">
						<label for="confirm_password">Confirmer le mot de passe</label>

						<div class="password-input-wrapper">
							<input type="password" id="confirm_password" name="confirm_password" class="form-control" placeholder="••••••••••••" required autocomplete="new-password">

							<span class="toggle-password" data-target="confirm_password">
								<img src="{{ asset('images/eye/eye-open.png') }}" alt="Afficher" class="eye-icon eye-open">
								<img src="{{ asset('images/eye/eye-closed.png') }}" alt="Cacher" class="eye-icon eye-closed hide">
							</span>
						</div>
					</div>

					<input type="hidden" name="_token" value="{{ csrf_token('reset_final') }}">

					<div class="form-actions">
						<button type="submit" class="btn-auth login-btn">Valider le nouveau mot de passe</button>
					</div>

				</form>

				<div class="auth-bottom">
					<a href="{{ path('app_login') }}" class="back-link">← Retour à la connexion</a>
				</div>

			</div>
		</div>


		{# --- DROITE : SLIDER ADAPTÉ AU RESET MDP --- #}
		<div class="auth-right">

			<div class="slider-arrows">
				<div class="arrow prev" id="btn-prev">❮</div>
				<div class="arrow next" id="btn-next">❯</div>
			</div>

			<div class="auth-slider">

				<div class="slide slide-1 active">
					<div class="slide-content">
						<h2>Sécurité<br>Renforcée</h2>
						<p>Un nouveau mot de passe solide protège votre compte et vos données sportives.</p>
						<div class="slide-pagination">
							<span class="dot active" data-slide="0"></span>
							<span class="dot" data-slide="1"></span>
							<span class="dot" data-slide="2"></span>
						</div>
					</div>
				</div>

				<div class="slide slide-2">
					<div class="slide-content">
						<h2>Ne Lâchez<br>Rien</h2>
						<p>Chaque étape compte. Reprenez le contrôle de votre espace membre CHM.</p>
						<div class="slide-pagination">
							<span class="dot" data-slide="0"></span>
							<span class="dot active" data-slide="1"></span>
							<span class="dot" data-slide="2"></span>
						</div>
					</div>
				</div>

				<div class="slide slide-3">
					<div class="slide-content">
						<h2>Un Nouveau<br>Départ</h2>
						<p>Choisissez un mot de passe robuste et revenez plus motivé que jamais.</p>
						<div class="slide-pagination">
							<span class="dot" data-slide="0"></span>
							<span class="dot" data-slide="1"></span>
							<span class="dot active" data-slide="2"></span>
						</div>
					</div>
				</div>

			</div>
		</div>

	</section>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	 <script src="{{ asset('js/security/auth_slider.js') }}" defer nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
