{% extends 'base.html.twig' %}

{% block title %}Réinitialisation - CHM Saleux
{% endblock %}

{% block navbar %}{% endblock %}
{% block footer %}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/security/auth_layout.css') }}">
{% endblock %}

{% block body %}
	<section
		class="auth-split-screen">

		{# --- CÔTÉ GAUCHE : FORMULAIRE --- #}
		<div class="auth-left">
			<div class="auth-content-wrapper">
				<div class="auth-header">
					<a href="{{ path('home') }}" class="auth-logo">
						<img src="{{ asset('images/favicon/icon2.png') }}" alt="Logo CHM">
					</a>
					<h1>RÉINITIALISATION</h1>
					<p>Saisissez votre adresse email pour recevoir un lien de récupération.</p>
				</div>

				{# Gestion des messages Flash (Erreurs et Succès) #}
				{% for label, messages in app.flashes %}
					{% for message in messages %}
						<div class="alert-{{ label }} flash-{{ label }}">
							{{ message }}
						</div>
					{% endfor %}
				{% endfor %}

				<form
					action="{{ path('app_reset_password_request') }}" method="post" class="auth-form">
					{# ✅ JETON CSRF REQUIS PAR TON CONTROLLER #}
					<input type="hidden" name="_token" value="{{ csrf_token('reset_request') }}">

					<div class="form-group">
						<label for="reset_email">Votre Email</label>
						<input type="email" name="email" id="reset_email" class="form-control" placeholder="votre@email.com" required autocomplete="email" autofocus>
					</div>

					<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

					<div class="turnstile-container">
						<div class="cf-turnstile" data-sitekey="0x4AAAAAACvankHbbJ6UuueH" data-size="invisible" data-appearance="always"></div>
					</div>

					<button type="submit" class="btn-auth login-btn">
						Envoyer le lien
					</button>
				</form>

				<div class="register-hint">
					<p>Vous vous en souvenez ?
						<a href="{{ path('app_login') }}">Se connecter</a>
					</p>
				</div>

				<div class="auth-bottom">
					<a href="{{ path('home') }}" class="back-link">← Retour au site</a>
				</div>
			</div>
		</div>

		{# --- CÔTÉ DROIT : SLIDER --- #}
		<div class="auth-right">
			<div class="slider-arrows">
				<div class="arrow prev" id="btn-prev">❮</div>
				<div class="arrow next" id="btn-next">❯</div>
			</div>

			<div class="auth-slider">
				<div class="slide slide-1 active">
					<div class="slide-content">
						<h2>Ne Perdez Pas<br>Le Rythme</h2>
						<p>Une petite absence arrive à tout le monde. Récupérez vos accès et reprenez l'entraînement.</p>
						<div class="slide-pagination">
							<span class="dot active" data-slide="0"></span>
							<span class="dot" data-slide="1"></span>
							<span class="dot" data-slide="2"></span>
						</div>
					</div>
				</div>

				<div class="slide slide-2">
					<div class="slide-content">
						<h2>Sécurité<br>Maximale</h2>
						<p>Nous protégeons vos données. Changez votre mot de passe régulièrement pour plus de sûreté.</p>
						<div class="slide-pagination">
							<span class="dot active" data-slide="0"></span>
							<span class="dot" data-slide="1"></span>
							<span class="dot" data-slide="2"></span>
						</div>
					</div>
				</div>

				<div class="slide slide-3">
					<div class="slide-content">
						<h2>Besoin d'aide ?</h2>
						<p>Vérifiez vos spams si l'email n'arrive pas, ou contactez le staff du CHM Saleux.</p>
						<div class="slide-pagination">
							<span class="dot active" data-slide="0"></span>
							<span class="dot" data-slide="1"></span>
							<span class="dot" data-slide="2"></span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	 <script src="{{ asset('js/security/auth_slider.js') }}" defer></script>
{% endblock %}
