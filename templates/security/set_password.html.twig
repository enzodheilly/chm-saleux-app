{% extends 'base.html.twig' %}

{% block title %}Définir un mot de passe - CHM Saleux
{% endblock %}

{% block navbar %}{% endblock %}
{% block footer %}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/security/auth_layout.css') }}">
{% endblock %}

{% block body %}
	<section
		class="auth-split-screen">

		{# --- CÔTÉ GAUCHE : FORMULAIRE --- #}
		<div class="auth-left">
			<div class="auth-content-wrapper">
				<div class="auth-header">
					<a href="{{ path('home') }}" class="auth-logo">
						<img src="{{ asset('images/favicon/icon2.png') }}" alt="Logo CHM">
					</a>
					<h1>CRÉER VOTRE MOT DE PASSE</h1>
					<p>Définissez un mot de passe pour sécuriser et finaliser votre compte.</p>
				</div>

				{# Flash messages #}
				{% for label, messages in app.flashes %}
					{% for message in messages %}
						<div class="alert-{{ label }} flash-{{ label }}">
							{{ message }}
						</div>
					{% endfor %}
				{% endfor %}

				<form action="{{ path('set_password') }}" method="post" class="auth-form">
					<input type="hidden" name="_token" value="{{ csrf_token('set_password') }}">

					<div class="form-group">
						<label for="password">Nouveau mot de passe</label>
						<div class="password-input-wrapper">
							<input type="password" id="password" name="password" class="form-control" placeholder="Votre mot de passe" required minlength="10" autocomplete="new-password">
							<span class="toggle-password" data-target="password">
								<img src="{{ asset('images/eye/eye-open.png') }}" alt="Afficher" class="eye-icon eye-open">
								<img src="{{ asset('images/eye/eye-closed.png') }}" alt="Cacher" class="eye-icon eye-closed hide">
							</span>
						</div>
						<small class="password-hint">Minimum 10 caractères.</small>
					</div>

					<div class="form-group">
						<label for="confirm_password">Confirmation du mot de passe</label>
						<div class="password-input-wrapper">
							<input type="password" id="confirm_password" name="confirm_password" class="form-control" placeholder="Confirmez le mot de passe" required autocomplete="new-password">
							<span class="toggle-password" data-target="confirm_password">
								<img src="{{ asset('images/eye/eye-open.png') }}" alt="Afficher" class="eye-icon eye-open">
								<img src="{{ asset('images/eye/eye-closed.png') }}" alt="Cacher" class="eye-icon eye-closed hide">
							</span>
						</div>
					</div>

					<div class="form-group checkbox-group">
						<input type="checkbox" name="accepted_terms" id="set_pass_terms" required>
						<label for="set_pass_terms">
							J'ai lu et j'accepte les
							<a href="{{ path('legal_page_show', {'slug': 'conditions-utilisation'}) }}" target="_blank" class="link-legal">conditions générales d'utilisation</a>
							et les
							<a href="{{ path('legal_page_show', {'slug': 'mentions-legales'}) }}" target="_blank" class="link-legal">mentions légales</a>
						</label>
					</div>

					<button type="submit" class="btn-auth login-btn">
						<span class="btn-text">Valider</span>
					</button>
				</form>
			</div>
		</div>

		{# --- CÔTÉ DROIT : SLIDER --- #}
		<div class="auth-right">
			<div class="slider-arrows">
				<div class="arrow prev" id="btn-prev">❮</div>
				<div class="arrow next" id="btn-next">❯</div>
			</div>

			<div class="auth-slider">
				<div class="slide slide-1 active">
					<div class="slide-content">
						<h2>Finalisez<br>Votre Compte</h2>
						<p>Ajoutez un mot de passe pour accéder au CHM Saleux sans passer par Google.</p>
						<div class="slide-pagination">
							<span class="dot active" data-slide="0"></span>
							<span class="dot" data-slide="1"></span>
							<span class="dot" data-slide="2"></span>
						</div>
					</div>
				</div>

				<div class="slide slide-2">
					<div class="slide-content">
						<h2>Sécurité<br>Renforcée</h2>
						<p>Un bon mot de passe protège vos données personnelles.</p>
						<div class="slide-pagination">
							<span class="dot" data-slide="0"></span>
							<span class="dot active" data-slide="1"></span>
							<span class="dot" data-slide="2"></span>
						</div>
					</div>
				</div>

				<div class="slide slide-3">
					<div class="slide-content">
						<h2>Besoin d'aide ?</h2>
						<p>Le staff du CHM Saleux est à votre disposition.</p>
						<div class="slide-pagination">
							<span class="dot" data-slide="0"></span>
							<span class="dot" data-slide="1"></span>
							<span class="dot active" data-slide="2"></span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	 <script src="{{ asset('js/security/auth_slider.js') }}" defer nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
