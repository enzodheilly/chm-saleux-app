{% extends 'base.html.twig' %}

{% block title %}Rejoindre le Club - CHM Saleux
{% endblock %}

{% block navbar %}{% endblock %}
{% block main_class %}{% endblock %}
{% block footer %}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/security/auth_layout.css') }}">
{% endblock %}

{% block body %}
	<section
		class="auth-split-screen">

		{# --- CÔTÉ GAUCHE : FORMULAIRE --- #}
		<div class="auth-left">
			<div class="auth-content-wrapper">
				<div class="auth-header">
					<a href="{{ path('home') }}" class="auth-logo">
						<img src="{{ asset('images/favicon/icon2.png') }}" alt="Logo CHM">
					</a>
					<h1>BIENVENUE AU CLUB</h1>
					<p>Choisissez votre mode de connexion pour accéder à votre espace.</p>
				</div>

				<div class="auth-options">
					<a href="{{ path('oauth_google_start') }}" class="btn-auth google-btn">
						<span class="google-icon"></span>
						Continuer avec Google
					</a>

					<button type="button" class="btn-auth apple-btn" disabled title="Bientôt disponible">
						<svg class="apple-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true">
							<path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76 0-103.7 40.8-165.9 40.8s-105.2-57-155.9-127.4C46 441.8 43.3 254.3 141.4 163.2c35-31.5 93.8-58.3 155.5-58.3 86.3 0 138.8 55.8 193.9 55.8 52.9 0 96.1-55.8 196-55.8 38.5 0 131.3 3.2 196 96.4zm-162.5-123.6c29.6-34.4 51-81.7 51-129.1 0-6.4-.6-12.9-1.9-19.4-48.5 1.9-106.6 32.5-142.2 73.2-28.3 31.5-53.6 79-53.6 127 0 7.1 1.3 14.2 1.9 16.4 3.2.6 8.4 1.3 13.5 1.3 43.4 0 97.6-29 131.3-69.4z"/>
						</svg>
						Continuer avec Apple
						<span class="apple-soon-badge">Bientôt</span>
					</button>

					<div class="auth-separator">
						<span>OU</span>
					</div>

					<div class="auth-email-actions">
						<a href="{{ path('app_login') }}" class="btn-auth login-btn">
							Se connecter
						</a>

						<div class="register-hint">
							Pas encore de compte ?
							<a href="{{ path('app_register') }}">S'inscrire</a>
						</div>
					</div>
				</div>

				<div class="auth-bottom">
					<a href="{{ path('home') }}" class="back-link">← Accueil</a>
				</div>
			</div>
		</div>

		{# --- CÔTÉ DROIT : SLIDER STYLE MOBILE --- #}
		<div class="auth-right">

			<div class="slider-arrows">
				<div class="arrow prev" id="btn-prev">❮</div>
				<div class="arrow next" id="btn-next">❯</div>
			</div>

			<div
				class="auth-slider">
				{# Slide 1 #}
				<div class="slide slide-1 active">
					<div class="slide-content">
						<h2>Bouge Ton Corps<br>pour Être en Forme</h2>
						<p>L'application t'aide à te dépasser et à adopter un mode de vie sain grâce à l'entraînement.</p>
						<div class="slide-pagination">
							<span class="dot active" data-slide="0"></span>
							<span class="dot" data-slide="1"></span>
							<span class="dot" data-slide="2"></span>
						</div>
					</div>
				</div>

				{# Slide 2 #}
				<div class="slide slide-2">
					<div class="slide-content">
						<h2>Dépasse Tes Limites<br>Chaque Jour</h2>
						<p>Accède à des programmes personnalisés en haltérophilie et musculation pour exploser tes perfs.</p>
						<div class="slide-pagination">
							<span class="dot" data-slide="0"></span>
							<span class="dot active" data-slide="1"></span>
							<span class="dot" data-slide="2"></span>
						</div>
					</div>
				</div>

				{# Slide 3 #}
				<div class="slide slide-3">
					<div class="slide-content">
						<h2>Rejoins La<br>Communauté CHM</h2>
						<p>Suis ta progression, reste motivé(e) et atteins enfin tes objectifs avec nous.</p>
						<div class="slide-pagination">
							<span class="dot" data-slide="0"></span>
							<span class="dot" data-slide="1"></span>
							<span class="dot active" data-slide="2"></span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
{# On ajoute le nonce pour passer la sécurité CSP de ton base.html.twig #}
	 <script 
																	    src="{{ asset('js/security/auth_slider.js') }}" 
																	    defer 
																	    nonce="{{ csp_nonce('script') }}">
																	</script>
{% endblock %}
