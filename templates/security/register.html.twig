{% extends 'base.html.twig' %}

{% block title %}Inscription - CHM Saleux
{% endblock %}

{% block navbar %}{% endblock %}
{% block footer %}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/security/auth_layout.css') }}">
{% endblock %}

{% block body %}
	<section
		class="auth-split-screen">

		{# --- CÔTÉ GAUCHE : FORMULAIRE --- #}
		<div class="auth-left">
			<div class="auth-content-wrapper">
				<div class="auth-header">
					<a href="{{ path('home') }}" class="auth-logo">
						<img src="{{ asset('images/favicon/icon2.png') }}" alt="Logo CHM">
					</a>
					<h1>REJOINDRE LE CLUB</h1>
					<p>Créez votre compte pour commencer votre transformation.</p>
				</div>

				{# Affichage des erreurs Flash #}
				{% for message in app.flashes('error') %}
					<div class="alert-error">
						{{ message }}
					</div>
				{% endfor %}

				<form
					action="{{ path('app_register') }}" method="post" class="auth-form">
					{# CSRF Token unique pour l'inscription #}
					<input type="hidden" name="_token" value="{{ csrf_token('register') }}">

					<div class="form-row">
						<div class="form-group">
							<label for="reg_firstName">Prénom</label>
							<input type="text" name="registration_form[firstName]" id="reg_firstName" class="form-control" placeholder="Jean" value="{{ registrationForm.firstName.vars.value }}" required>
						</div>
						<div class="form-group">
							<label for="reg_lastName">Nom</label>
							<input type="text" name="registration_form[lastName]" id="reg_lastName" class="form-control" placeholder="Dupont" value="{{ registrationForm.lastName.vars.value }}" required>
						</div>
					</div>

					<div class="form-group">
						<label for="reg_email">Email</label>
						<input type="email" name="registration_form[email]" id="reg_email" class="form-control" placeholder="votre@email.com" value="{{ registrationForm.email.vars.value }}" required>
					</div>
					<div class="form-group">
						<label for="reg_pass1">Mot de passe</label>
						<div class="password-input-wrapper">
							<input type="password" name="registration_form[password][first]" id="reg_pass1" class="form-control" placeholder="••••••••••••" required>
							<span class="toggle-password" data-target="reg_pass1">
								<img src="{{ asset('images/eye/eye-open.png') }}" alt="Afficher" class="eye-icon eye-open">
								<img src="{{ asset('images/eye/eye-closed.png') }}" alt="Cacher" class="eye-icon eye-closed hide">
							</span>
						</div>
					</div>

					<div class="form-group">
						<label for="reg_pass2">Confirmer le mot de passe</label>
						<div class="password-input-wrapper">
							<input type="password" name="registration_form[password][second]" id="reg_pass2" class="form-control" placeholder="••••••••••••" required>
							<span class="toggle-password" data-target="reg_pass2">
								<img src="{{ asset('images/eye/eye-open.png') }}" alt="Afficher" class="eye-icon eye-open">
								<img src="{{ asset('images/eye/eye-closed.png') }}" alt="Cacher" class="eye-icon eye-closed hide">
							</span>
						</div>
					</div>

					<div class="form-group checkbox-group">
						<input type="checkbox" name="registration_form[acceptedTerms]" id="reg_terms" {% if registrationForm.acceptedTerms.vars.checked %} checked {% endif %} required>
						<label for="reg_terms">J’accepte les conditions générales d’utilisation</label>
					</div>

					{# Token CSRF indispensable #}
					<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

					<div class="turnstile-container">
						<div class="cf-turnstile" data-sitekey="0x4AAAAAACvankHbbJ6UuueH" data-size="invisible" data-appearance="always"></div>
					</div>

					<button type="submit" class="btn-auth login-btn">
						Créer mon compte
					</button>
				</form>

				<div class="register-hint">
					<p>Déjà membre ?
						<a href="{{ path('app_login') }}">Se connecter</a>
					</p>
				</div>

				<div class="auth-bottom">
					<a href="{{ path('home') }}" class="back-link">← Retour au site</a>
				</div>
			</div>
		</div>

		{# --- CÔTÉ DROIT : SLIDER --- #}
		<div class="auth-right">
			<div class="slider-arrows">
				<div class="arrow prev" onclick="prevSlide()">❮</div>
				<div class="arrow next" onclick="nextSlide()">❯</div>
			</div>

			<div class="auth-slider">
				<div class="slide slide-1 active">
					<div class="slide-content">
						<h2>Libérez Votre<br>Vrai Potentiel</h2>
						<p>En créant votre compte, vous faites le premier pas vers une version plus forte, plus endurante et plus saine de vous-même.</p>
						<div class="slide-pagination">
							<span class="dot active" onclick="changeSlide(0)"></span>
							<span class="dot" onclick="changeSlide(1)"></span>
							<span class="dot" onclick="changeSlide(2)"></span>
						</div>
					</div>
				</div>

				<div class="slide slide-2">
					<div class="slide-content">
						<h2>Suivi Précis Et<br>Programmes Experts</h2>
						<p>Accédez instantanément à des outils de suivi de performance et des plans d'entraînement conçus par nos coachs certifiés.</p>
						<div class="slide-pagination">
							<span class="dot" onclick="changeSlide(0)"></span>
							<span class="dot active" onclick="changeSlide(1)"></span>
							<span class="dot" onclick="changeSlide(2)"></span>
						</div>
					</div>
				</div>

				<div class="slide slide-3">
					<div class="slide-content">
						<h2>Une Communauté<br>Pour Vous Propulser</h2>
						<p>Rejoignez des centaines de passionnés. Partagez, progressez et restez motivé(e) grâce à l'esprit d'équipe du CHM Saleux.</p>
						<div class="slide-pagination">
							<span class="dot" onclick="changeSlide(0)"></span>
							<span class="dot" onclick="changeSlide(1)"></span>
							<span class="dot active" onclick="changeSlide(2)"></span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	 <script src="{{ asset('js/security/auth_slider.js') }}" defer nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
