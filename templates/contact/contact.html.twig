{% extends 'base.html.twig' %}

{% block title %}Contactez-nous - CHM Saleux{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/contact/contact.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
{% endblock %}

{% block body %}

    {# --- HEADER IMMERSIF (NE PAS TOUCHER) --- #}
    <header class="page-header">
<div class="header-bg header-gradient"></div>
        <div class="header-overlay"></div>

        <div class="container header-content">
            <a href="{{ path('home') }}" class="back-link">
                <i class="fa-solid fa-arrow-left"></i> Retour à l'accueil
            </a>

            <div class="header-title-box">
                <span class="subtitle">À votre écoute</span>
                <h1>Contactez-nous</h1>
                <p>Une question sur les tarifs ? Envie de réserver une séance d'essai ? Notre équipe est là pour vous répondre.</p>
            </div>
        </div>
    </header>

    <main class="main-container contact-page">

        {# --- BARRE D'INFOS RAPIDES --- #}
        <section class="quick-info-section">
            <div class="quick-bar">

                <div class="quick-item">
                    <div class="quick-icon"><i class="fa-solid fa-location-dot"></i></div>
                    <div class="quick-text">
                        <h3>Adresse</h3>
                        <p>8 rue Marx Dormoy, 80480 Saleux</p>
                    </div>
                </div>

                <div class="quick-item">
                    <div class="quick-icon"><i class="fa-solid fa-phone"></i></div>
                    <div class="quick-text">
                        <h3>Contact</h3>
                        <p class="quick-links">
                            <a href="tel:0322897257">03.22.89.72.57</a>
                            <a href="mailto:contact@chmsaleux.fr">contact@chmsaleux.fr</a>
                        </p>
                    </div>
                </div>

                <div class="quick-item">
                    <div class="quick-icon"><i class="fa-solid fa-clock"></i></div>
                    <div class="quick-text">
                        <h3>Horaires</h3>
                        <p>Lun/Mer/Ven : 10h-12h & 16h-20h<br>Mar/Jeu : 10h-12h & 16h-19h30</p>
                    </div>
                </div>

            </div>
        </section>

        {# --- LAYOUT : FORMULAIRE + SIDEBAR --- #}
        <section class="contact-layout">

            {# FORMULAIRE #}
            <div class="contact-card contact-form-card">
                <div class="section-header">
                    <h2>Envoyez-nous un message</h2>
                    <p>Réponse sous 24 à 48h (jours ouvrés). Pour une urgence, privilégiez l’appel.</p>
                </div>

                {# Messages Flash #}
                {% for message in app.flashes('success') %}
                    <div class="alert-success">
                        <i class="fa-solid fa-check-circle"></i> {{ message }}
                    </div>
                {% endfor %}

                <form action="{{ path('contact_submit') }}" method="POST" class="modern-form">

                    <div class="form-row">
                        <div class="form-group">
                            <label for="nom">Nom</label>
                            <input type="text" id="nom" name="nom" required placeholder="Votre nom" autocomplete="family-name">
                        </div>
                        <div class="form-group">
                            <label for="prenom">Prénom</label>
                            <input type="text" id="prenom" name="prenom" required placeholder="Votre prénom" autocomplete="given-name">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" name="email" required placeholder="exemple@mail.com" autocomplete="email">
                        </div>
                        <div class="form-group">
                            <label for="telephone">Téléphone <span class="label-muted">(optionnel)</span></label>
                            <input type="tel" id="telephone" name="telephone" placeholder="06 12 34 56 78" autocomplete="tel">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="subject">Sujet</label>
                        <select id="subject" name="subject">
                            <option value="renseignement">Demande de renseignements</option>
                            <option value="inscription">Inscription / Tarifs</option>
                            <option value="essai">Séance d'essai</option>
                            <option value="partenariat">Partenariat</option>
                            <option value="autre">Autre</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="message">Message</label>
                        <textarea id="message" name="message" rows="6" required placeholder="Expliquez votre besoin, on s’occupe du reste 🙂"></textarea>
                        <div class="hint">
                            <i class="fa-regular fa-lightbulb"></i>
                            Pensez à préciser vos disponibilités si vous demandez une séance d’essai.
                        </div>
                    </div>

                    <button type="submit" class="btn-submit">
                        Envoyer le message <i class="fa-solid fa-paper-plane"></i>
                    </button>

                    <div class="form-footnote">
                        En envoyant ce formulaire, vous acceptez d’être recontacté par le club.
                    </div>
                </form>
            </div>

            {# SIDEBAR (avec wrapper sticky interne) #}
            <aside class="contact-card contact-side-card">
                <div class="side-sticky">

                    <div class="side-block">
                        <h3><i class="fa-solid fa-circle-info"></i> Infos utiles</h3>

                        <div class="side-list">
                            <div class="side-row">
                                <span class="side-label">Adresse</span>
                                <span class="side-value">8 rue Marx Dormoy, 80480 Saleux</span>
                            </div>
                            <div class="side-row">
                                <span class="side-label">Téléphone</span>
                                <span class="side-value"><a href="tel:0322897257">03.22.89.72.57</a></span>
                            </div>
                            <div class="side-row">
                                <span class="side-label">Email</span>
                                <span class="side-value"><a href="mailto:contact@chmsaleux.fr">contact@chmsaleux.fr</a></span>
                            </div>
                            <div class="side-row">
                                <span class="side-label">Accueil</span>
                                <span class="side-value">Week-end : fermé</span>
                            </div>
                        </div>

                        <a href="https://www.google.com/maps/dir//Mairie+de+Saleux" target="_blank" class="btn-secondary">
                            <i class="fa-solid fa-diamond-turn-right"></i> Ouvrir l’itinéraire
                        </a>
                    </div>

                    <div class="side-block">
                        <h3><i class="fa-solid fa-circle-question"></i> Questions fréquentes</h3>

                        <div class="faq">
                            <details class="faq-item">
                                <summary>Comment réserver une séance d’essai ?</summary>
                                <p>Choisissez “Séance d’essai” dans le sujet et indiquez vos disponibilités. On vous propose un créneau.</p>
                            </details>

                            <details class="faq-item">
                                <summary>Quels sont les délais de réponse ?</summary>
                                <p>Généralement sous 24 à 48h (jours ouvrés). Pour une urgence, contactez-nous par téléphone.</p>
                            </details>

                            <details class="faq-item">
                                <summary>Y a-t-il un parking à proximité ?</summary>
                                <p>Oui, un parking gratuit est disponible à proximité immédiate du club.</p>
                            </details>
                        </div>
                    </div>

                    <div class="side-highlight">
                        <div class="badge"><i class="fa-solid fa-bolt"></i> Astuce</div>
                        <p>Pour une demande “Tarifs”, précisez l’âge et l’objectif (loisir/compétition), ça accélère la réponse.</p>
                    </div>

                </div>
            </aside>

        </section>

        {# --- LOCALISATION --- #}
        <section class="location-section">
            <div class="location-card">
                <div class="location-left">
                    <h3>Où nous trouver ?</h3>
                    <p>Le club est situé juste en face de la Mairie de Saleux. Un parking gratuit est disponible à proximité immédiate.</p>

                    <div class="location-actions">
                        <a href="https://www.google.com/maps/dir//Mairie+de+Saleux" target="_blank" class="btn-gps">
                            <i class="fa-solid fa-diamond-turn-right"></i> Itinéraire
                        </a>
                        <a href="tel:0322897257" class="btn-outline">
                            <i class="fa-solid fa-phone"></i> Appeler
                        </a>
                    </div>
                </div>

                <div class="location-right">
                    <iframe
                        src="https://www.google.com/maps?q=49.8609999,2.2373333+(Hangar+GERIS+Saleux)&hl=fr&z=18&output=embed"
                        width="100%"
                        height="100%"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy">
                    </iframe>
                </div>
            </div>
        </section>

    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/contact/contact.js') }}"></script>
{% endblock %}
