{% extends 'base.html.twig' %}

{% block title %}Contact · CHM Saleux{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/contact/contact.css') }}">
{% endblock %}

{% block body %}

	<header class="contact-page-header">
		<div class="page-container contact-hero-container">
			{% include 'components/breadcrumb.html.twig' with { items: [
				{ label: 'Contact' }
			] } %}
			<div class="contact-header-body">
				<h1>CONTACTEZ
					<span>NOUS</span>
				</h1>
				<p class="contact-header-lead">Une question, une demande d'inscription ou simplement envie d'en savoir plus ? Notre équipe est là pour vous répondre.</p>
			</div>
		</div>
		</header>

	<main class="contact-root page-shell">

		{# Flash messages #}
		<div class="page-container flash-container">
			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="alert-flash flash-{{ label }}">{{ message }}</div>
				{% endfor %}
			{% endfor %}
		</div>

		<section class="contact-section">
			<div class="contact-wm page-wm" aria-hidden="true">CONTACT</div>

			<div class="page-container">

				{# ── Bande d'infos ── #}
				<div class="contact-info-strip">
					<div class="contact-info-tile">
						<div class="cit-icon"><i class="fa-solid fa-location-dot"></i></div>
						<div class="cit-body">
							<p class="cit-label">Localisation</p>
							<p class="cit-val">8 rue Marx Dormoy — 80480 Saleux</p>
							<p class="cit-val cit-val--muted">À seulement 10 min d'Amiens et à 5 min de l'hôpital Sud et de l'IUT !</p>
						</div>
					</div>
					<div class="contact-info-tile">
						<div class="cit-icon"><i class="fa-solid fa-phone"></i></div>
						<div class="cit-body">
							<p class="cit-label">Téléphone</p>
							<p class="cit-val"><a href="tel:0322897257">03 22 89 72 57</a></p>
							<p class="cit-val cit-val--muted">Disponible aux heures d'ouverture</p>
						</div>
					</div>
					<a href="mailto:chm.saleux@orange.fr" class="contact-info-tile contact-info-tile--link">
						<div class="cit-icon"><i class="fa-solid fa-envelope"></i></div>
						<div class="cit-body">
							<p class="cit-label">Email</p>
							<p class="cit-val">chm.saleux@orange.fr</p>
							<p class="cit-val cit-val--muted">Réponse sous 48h en semaine</p>
						</div>
					</a>
					<div class="contact-info-tile">
						<div class="cit-icon"><i class="fa-regular fa-clock"></i></div>
						<div class="cit-body">
							<p class="cit-label">Horaires d'ouverture</p>
							<p class="cit-val">Lu · Me · Ve — 10h/12h &amp; 16h/20h</p>
							<p class="cit-val">Ma · Je — 10h/12h &amp; 16h/19h30</p>
						</div>
					</div>
				</div>

				{# ── Corps : formulaire + colonne droite ── #}
				<div class="contact-grid">

					{# Formulaire #}
					<div class="contact-form-container">
						<h2 class="contact-form-title">Envoyez-nous<br>un <span>message</span></h2>
						<p class="contact-form-sub">Nous vous répondons sous 48h en semaine.</p>

						<form action="{{ path('contact_submit') }}" method="POST" class="elite-form">
							<input type="hidden" name="_token" value="{{ csrf_token('contact_submit') }}">

							<div class="form-row">
								<div class="input-group">
									<label for="contact-last-name">Nom</label>
									<input id="contact-last-name" type="text" name="lastName" required placeholder="Ex: Dupont">
								</div>
								<div class="input-group">
									<label for="contact-first-name">Prénom</label>
									<input id="contact-first-name" type="text" name="firstName" required placeholder="Ex: Jean">
								</div>
							</div>

							<div class="input-group">
								<label for="contact-email">Email</label>
								<input id="contact-email" type="email" name="email" required placeholder="jean.dupont@mail.com">
							</div>

							<div class="input-group">
								<label for="contact-subject">Sujet</label>
								<select id="contact-subject" name="subject" required>
									<option value="">Choisissez un sujet</option>
									{% for label, value in subjectChoices %}
										<option value="{{ value }}">{{ label }}</option>
									{% endfor %}
								</select>
							</div>

							<div class="input-group">
								<label for="contact-content">Message</label>
								<textarea id="contact-content" name="content" rows="6" required placeholder="Votre message..."></textarea>
							</div>

							<div class="turnstile-wrapper">
								<div class="cf-turnstile" data-sitekey="0x4AAAAAACvankHbbJ6UuueH" data-theme="light"></div>
							</div>

							<button type="submit" class="btn-elite-submit btn-modern">
								<span class="btn-text">Envoyer le message</span>
								<span class="spinner"><i class="fa-solid fa-circle-notch fa-spin"></i></span>
							</button>
						</form>
					</div>

					{# Colonne droite : carte + FAQ #}
					<aside class="contact-sidebar">

						<div class="map-card">
							<div class="map-head">
								<div class="map-title">
									<h3>CHM Saleux</h3>
									<p>8 rue Marx Dormoy, 80480 Saleux</p>
								</div>
								<a class="map-cta" target="_blank" rel="noopener" href="https://maps.google.com/?q=8+rue+Marx+Dormoy+80480+Saleux">
									Itinéraire <i class="fa-solid fa-arrow-up-right-from-square"></i>
								</a>
							</div>
							<div class="map-frame">
								<iframe src="https://www.google.com/maps?q=CHM%20Saleux%2C%208%20rue%20Marx%20Dormoy%2C%2080480%20Saleux&output=embed" loading="lazy"></iframe>
							</div>
						</div>

						<div class="sidebar-box">
							<span class="sidebar-eyebrow">Questions fréquentes</span>
							<details class="faq-mini">
								<summary>Séance d'essai gratuite ?</summary>
								<p>Oui ! Précisez vos disponibilités dans le message, on vous rappellera pour confirmer un créneau.</p>
							</details>
							<details class="faq-mini">
								<summary>Quel équipement prévoir ?</summary>
								<p>Tenue de sport et chaussures fermées suffisent pour une première séance. On s'occupe du reste.</p>
							</details>
							<details class="faq-mini">
								<summary>Délai de réponse ?</summary>
								<p>Nous répondons sous 48h en semaine. Pour une urgence, appelez-nous directement.</p>
							</details>
						</div>

					</aside>
				</div>

			</div>
		</section>

	</main>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
 <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer nonce="{{ csp_nonce('script') }}"></script>
	 <script src="{{ asset('js/contact/contact.js') }}"></script>
{% endblock %}
