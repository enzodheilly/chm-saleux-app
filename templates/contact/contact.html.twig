{% extends 'base.html.twig' %}

{% block title %}Contactez-nous - CHM Saleux{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/contact/contact.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
{% endblock %}

{% block body %}

    {# --- HEADER IMMERSIF --- #}
    <header class="page-header">
        <div class="header-bg" style="background-image: url('{{ asset('images/club/contact.jpg') }}');"></div>
        <div class="header-overlay"></div>
        
        <div class="container header-content">
            <a href="{{ path('home') }}" class="back-link">
                <i class="fa-solid fa-arrow-left"></i> Retour à l'accueil
            </a>
            
            <div class="header-title-box">
                <span class="subtitle">À votre écoute</span>
                <h1>Contactez-nous</h1>
                <p>Une question sur les tarifs ? Envie de réserver une séance d'essai ? Notre équipe est là pour vous répondre.</p>
            </div>
        </div>
    </header>

    <main class="main-container">

        {# --- SECTION 1 : INFOS RAPIDES --- #}
        <section class="quick-info-section">
            <div class="info-cards-grid">
                
                <div class="info-card">
                    <div class="icon-circle"><i class="fa-solid fa-location-dot"></i></div>
                    <h3>Nous trouver</h3>
                    <p>8 rue Marx Dormoy<br>80480 Saleux</p>
                </div>

                <div class="info-card">
                    <div class="icon-circle"><i class="fa-solid fa-phone"></i></div>
                    <h3>Nous joindre</h3>
                    <p class="contact-links">
                        <a href="tel:0322897257">03.22.89.72.57</a>
                        <a href="mailto:contact@chmsaleux.fr">contact@chmsaleux.fr</a>
                    </p>
                </div>

                <div class="info-card">
                    <div class="icon-circle"><i class="fa-solid fa-clock"></i></div>
                    <h3>Horaires</h3>
                    <p>Lun/Mer/Ven : 10h-12h & 16h-20h<br>Mar/Jeu : 10h-12h & 16h-19h30<br>Week-end : Fermé</p>
                </div>

            </div>
        </section>

        {# --- SECTION 2 : FORMULAIRE CENTRÉ --- #}
        <section class="form-section">
            <div class="form-container">
                <div class="section-header text-center">
                    <h2>Envoyez-nous un message</h2>
                    <p>Remplissez le formulaire ci-dessous, nous vous répondrons sous 24 à 48h.</p>
                </div>

                {# Messages Flash #}
                {% for message in app.flashes('success') %}
                    <div class="alert-success">
                        <i class="fa-solid fa-check-circle"></i> {{ message }}
                    </div>
                {% endfor %}

                <form action="{{ path('contact_submit') }}" method="POST" class="modern-form">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="nom">Nom</label>
                            <input type="text" id="nom" name="nom" required placeholder="Votre nom">
                        </div>
                        <div class="form-group">
                            <label for="prenom">Prénom</label>
                            <input type="text" id="prenom" name="prenom" required placeholder="Votre prénom">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" name="email" required placeholder="exemple@mail.com">
                        </div>
                        <div class="form-group">
                            <label for="telephone">Téléphone (Optionnel)</label>
                            <input type="tel" id="telephone" name="telephone" placeholder="06 12 34 56 78">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="subject">Sujet</label>
                        <select id="subject" name="subject">
                            <option value="renseignement">Demande de renseignements</option>
                            <option value="inscription">Inscription / Tarifs</option>
                            <option value="essai">Séance d'essai</option>
                            <option value="partenariat">Partenariat</option>
                            <option value="autre">Autre</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="message">Message</label>
                        <textarea id="message" name="message" rows="6" required placeholder="Comment pouvons-nous vous aider ?"></textarea>
                    </div>

                    <button type="submit" class="btn-submit">
                        Envoyer le message <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>
            </div>
        </section>

        {# --- SECTION 3 : LOCALISATION (Bandeau Large) --- #}
        <section class="location-banner">
            <div class="location-text">
                <h3>Où nous trouver ?</h3>
                <p>Le club est situé juste en face de la Mairie de Saleux. Un parking gratuit est disponible à proximité immédiate.</p>
                <a href="https://www.google.com/maps/dir//Mairie+de+Saleux" target="_blank" class="btn-gps">
                    <i class="fa-solid fa-diamond-turn-right"></i> Itinéraire
                </a>
            </div>
            <div class="location-map">
                <iframe 
                    src="https://www.google.com/maps?q=49.8609999,2.2373333+(Hangar+GERIS+Saleux)&hl=fr&z=18&output=embed" 
                    width="100%" 
                    height="100%" 
                    style="border:0;" 
                    allowfullscreen="" 
                    loading="lazy">
                </iframe>
            </div>
        </section>

    </main>
{% endblock %}

{% block javascripts %}
     <script src="{{ asset('js/contact/contact.js') }}"></script>
{% endblock %}