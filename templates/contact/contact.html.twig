{% extends 'base.html.twig' %}

{% block title %}Contactez-nous — CHM Saleux
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/contact/contact.css') }}">
{% endblock %}

{% block body %}
	<header class="page-header-sport contact-header-bg">
		<div class="header-overlay-gradient"></div>
		<div class="header-content">
			<div class="page-container">
				<nav class="breadcrumb-nav">
					<a href="{{ path('home') }}" class="back-link-minimal">
						<i class="fa-solid fa-chevron-left"></i>
						<span>Accueil</span>
					</a>
				</nav>
				<div class="header-main-box">
					<div class="badge-accent">À votre écoute</div>
					<h1>Contactez
						<span class="text-outline">nous</span>
					</h1>
					<p class="lead">Notre équipe vous répond sous 48h.</p>
				</div>
			</div>
		</div>
	</header>

	{# IMAGE DÉCORATIVE GAUCHE #}
	<div class="deco-left-wrap">
		<img src="{{ asset('images/decorations/dots-tree.png') }}" alt="" class="deco-left-img" aria-hidden="true">
	</div>

	<main
		class="contact-root page-shell">

		{# Titre de section style "Agenda" #}
		<div class="section-header-competition centered">
			<h2 class="section-heading">Restons en
				<span>Contact</span>
			</h2>
			<p class="section-subtext">Besoin d'informations ? Remplissez le formulaire ci-dessous.</p>
		</div>

		{# Zone des messages flash #}
		<div class="page-container flash-container">
			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="alert-flash flash-{{ label }}">
						{{ message }}
					</div>
				{% endfor %}
			{% endfor %}
		</div>

		<section class="page-container section-spacer">
			<div class="contact-grid">
				<div class="contact-form-container form-area">
					<div class="form-header">
						<h2 class="section-heading">Envoyez un
							<span>message</span>
						</h2>
					</div>

					<form action="{{ path('contact_submit') }}" method="POST" class="elite-form">
						<input type="hidden" name="_token" value="{{ csrf_token('contact_submit') }}">

						<div class="form-row">
							<div class="input-group">
								<label for="contact-last-name">Nom</label>
								<input id="contact-last-name" type="text" name="lastName" required placeholder="Ex: Dupont">
							</div>
							<div class="input-group">
								<label for="contact-first-name">Prénom</label>
								<input id="contact-first-name" type="text" name="firstName" required placeholder="Ex: Jean">
							</div>
						</div>

						<div class="input-group">
							<label for="contact-email">Email</label>
							<input id="contact-email" type="email" name="email" required placeholder="jean.dupont@mail.com">
						</div>

						<div class="input-group">
							<label for="contact-subject">Sujet</label>
							<select id="contact-subject" name="subject" required>
								<option value="">Choisissez un sujet</option>
								{% for label, value in subjectChoices %}
									<option value="{{ value }}">{{ label }}</option>
								{% endfor %}
							</select>
						</div>

						<div class="input-group">
							<label for="contact-content">Message</label>
							<textarea id="contact-content" name="content" rows="5" required placeholder="Votre message..."></textarea>
						</div>

						<div class="turnstile-wrapper">
							<div class="cf-turnstile" data-sitekey="0x4AAAAAACvankHbbJ6UuueH" data-theme="dark"></div>
						</div>

						<button type="submit" class="btn-elite-submit btn-modern">
							<span class="btn-text">Envoyer
								<i class="fa-solid fa-paper-plane"></i>
							</span>
							{# Ajoute bien le style display: none ici #}
							<span class="spinner">
								<i class="fa-solid fa-circle-notch fa-spin"></i>
							</span>
						</button>
					</form>
				</div>

				<aside class="contact-sidebar">
					<div class="sidebar-box">
						<h3>
							<i class="fa-solid fa-circle-question"></i>
							FAQ Rapide</h3>
						<details class="faq-mini">
							<summary>Séance d'essai ?</summary>
							<p>Oui ! Précisez vos disponibilités dans le message.</p>
						</details>
					</div>

					<div class="map-card map-card--sidebar">
						<div class="map-head">
							<div class="map-title">
								<h3>CHM Saleux</h3>
								<p>8 rue Marx Dormoy, 80480 Saleux</p>
							</div>
							<a class="map-cta" target="_blank" rel="noopener" href="https://maps.google.com">
								Itinéraire
								<i class="fa-solid fa-arrow-up-right-from-square"></i>
							</a>
						</div>
						<div class="map-frame">
							<iframe src="https://www.google.com/maps?q=CHM%20Saleux%2C%208%20rue%20Marx%20Dormoy%2C%2080480%20Saleux&output=embed" loading="lazy"></iframe>
							<div class="map-overlay"></div>
						</div>
					</div>
				</aside>
			</div>
		</section>
	</main>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
 <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer nonce="{{ csp_nonce('script') }}"></script>
	 <script src="{{ asset('js/contact/contact.js') }}"></script>
{% endblock %}
