<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Confirmez votre inscription — CHM Saleux</title>
		<style>
			body,
			table,
			td,
			a {
				-webkit-text-size-adjust: 100%;
				-ms-text-size-adjust: 100%;
			}
			table,
			td {
				mso-table-lspace: 0;
				mso-table-rspace: 0;
			}
			img {
				border: 0;
				height: auto;
				line-height: 100%;
				outline: none;
				text-decoration: none;
				display: block;
			}
			body {
				margin: 0 !important;
				padding: 0 !important;
				background-color: #f0f2f5;
				font-family: 'Inter', Helvetica, Arial, sans-serif;
			}
			@media screen and(max-width: 600px) {
				.container {
					width: 100% !important;
				}
				.mobile-pad {
					padding: 30px 20px !important;
				}
				.btn {
					padding: 16px 28px !important;
					font-size: 13px !important;
				}
			}
		</style>
	</head>
	<body style="background-color: #f0f2f5; margin: 0; padding: 0;">

		<table border="0" cellpadding="0" cellspacing="0" width="100%">
			<tr>
				<td
					align="center" style="padding: 40px 16px;">

					{# ── CARTE PRINCIPALE ── #}
					<table
						class="container" border="0" cellpadding="0" cellspacing="0" width="560" style="background:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 4px 24px rgba(0,0,0,0.07);">

						{# ── HEADER ── #}
						<tr>
							<td align="center" style="background: linear-gradient(135deg, #0f1117 0%, #1a1d27 100%); padding: 40px 40px 32px;">
								<img src="https://raw.githubusercontent.com/enzodheilly/chm-saleux-app/main/public/images/favicon/icon2.png" alt="CHM Saleux" width="52" height="52" style="display: block; margin: 0 auto 16px auto; border-radius: 12px;">
								<div style="color: #F57706; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 8px; text-align: center;">
									Club d'Haltérophilie &amp; Musculation
								</div>
								<div style="color: #ffffff; font-size: 22px; font-weight: 800; line-height: 1.3; text-align: center;">
									CHM SALEUX
								</div>
							</td>
						</tr>

						{# ── CONTENU ── #}
						<tr>
							<td class="mobile-pad" align="center" style="padding: 48px 48px 40px; text-align: center;">

								<p style="margin: 0 0 8px; color: #6b7280; font-size: 13px; text-transform: uppercase; letter-spacing: 2px; font-weight: 600; text-align: center;">
									Newsletter
								</p>
								<h1 style="margin: 0 0 20px; color: #111827; font-size: 26px; font-weight: 800; line-height: 1.3; text-align: center;">
									Confirmez votre inscription
								</h1>

								<p style="margin: 0 0 16px; color: #4b5563; font-size: 15px; line-height: 1.7; text-align: center;">
									Bonjour
									{% if subscriber is defined and subscriber and subscriber.user and subscriber.user.firstName %}
										<strong>{{ subscriber.user.firstName }}</strong>
									{% endif %},
								</p>
								<p style="margin: 0 0 32px; color: #4b5563; font-size: 15px; line-height: 1.7; text-align: center;">
									Merci de votre intérêt pour les actualités du CHM Saleux !
									                                Un clic suffit pour valider votre abonnement et recevoir
									                                nos prochaines news directement dans votre boîte mail.
								</p>

								{# ── BOUTON ── #}
								<table border="0" cellpadding="0" cellspacing="0" align="center">
									<tr>
										<td align="center" bgcolor="#F57706" style="border-radius: 10px; box-shadow: 0 4px 14px rgba(245,119,6,0.35);">
											<a href="{{ confirmUrl }}" target="_blank" class="btn" style="display: inline-block; padding: 18px 40px;
													                                                  font-family: Arial, sans-serif; font-size: 14px;
													                                                  font-weight: 700; color: #ffffff; text-decoration: none;
													                                                  text-transform: uppercase; letter-spacing: 1.5px;">
												✓ &nbsp;Valider mon inscription
											</a>
										</td>
									</tr>
								</table>

								{# ── NOTE SÉCURITÉ ── #}
								<table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-top: 32px;">
									<tr>
										<td style="background: #f9fafb; border-radius: 10px; border-left: 3px solid #F57706; padding: 16px 20px;">
											<p style="margin: 0; color: #6b7280; font-size: 13px; line-height: 1.6; text-align: center;">
												🔒 Ce lien est valable
												<strong>24 heures</strong>.
													                                            Si vous n'avez pas demandé cette inscription, ignorez simplement cet email.
											</p>
										</td>
									</tr>
								</table>

							</td>
						</tr>

						{# ── SÉPARATEUR ── #}
						<tr>
							<td style="padding: 0 48px;">
								<div style="height: 1px; background: #f0f2f5;"></div>
							</td>
						</tr>

						{# ── FOOTER ── #}
						<tr>
							<td class="mobile-pad" style="padding: 28px 48px; background: #fafafa;">
								<table border="0" cellpadding="0" cellspacing="0" width="100%">
									<tr>
										<td align="center" style="color: #9ca3af; font-size: 12px; line-height: 1.8; text-align: center;">
											<strong style="color: #374151; font-size: 13px;">CHM SALEUX</strong><br>
											8 rue Max Dormoy – 80480 Saleux<br>
											Tél : 03.22.89.72.57 &nbsp;·&nbsp;
											<a href="mailto:chm.saleux@orange.fr" style="color: #9ca3af; text-decoration: none;">chm.saleux@orange.fr</a><br>
											<span style="font-style: italic;">Agréé Jeunesse et Sports – Association loi 1901</span>
										</td>
									</tr>
									<tr>
										<td style="padding-top: 20px;">
											<table border="0" cellpadding="0" cellspacing="0" width="100%">
												<tr>
													<td style="color: #d1d5db; font-size: 11px; text-align: center;">
														©
														{{ "now"|date("Y") }}
														CHM Saleux
													</td>
													<td align="right">
														<a href="{{ subscriber.getUnsubscribeUrl() }}" style="color: #9ca3af; font-size: 11px; text-decoration: underline;">
															Se désabonner
														</a>
													</td>
												</tr>
											</table>
										</td>
									</tr>
								</table>
							</td>
						</tr>

					</table>

					{# ── LIEN SITE ── #}
					<table class="container" border="0" cellpadding="0" cellspacing="0" width="560">
						<tr>
							<td align="center" style="padding: 24px 0 8px;">
								<a href="https://chm-saleux.fr" style="color: #9ca3af; text-decoration: none; font-size: 12px;">
									chm-saleux.fr
								</a>
							</td>
						</tr>
					</table>

				</td>
			</tr>
		</table>

	</body>
</html>
