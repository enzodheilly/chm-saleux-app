{% extends 'emails/_layout.html.twig' %}

{% block title %}Confirmez votre inscription — CHM Saleux{% endblock %}

{% block body %}
    <p style="margin:0 0 6px; color:#F57706; font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase; text-align:center;">
        Newsletter
    </p>
    <h1 style="margin:0 0 24px; color:#111827; font-size:24px; font-weight:800; line-height:1.3; text-align:center;">
        Confirmez votre inscription
    </h1>

    <p style="margin:0 0 12px; color:#4b5563; font-size:15px; line-height:1.7; text-align:center;">
        Bonjour{% if subscriber is defined and subscriber and subscriber.user and subscriber.user.firstName %}
            <strong> {{ subscriber.user.firstName }}</strong>{% endif %},
    </p>
    <p style="margin:0 0 32px; color:#4b5563; font-size:15px; line-height:1.7; text-align:center;">
        Merci de votre intérêt pour les actualités du CHM Saleux !<br>
        Un clic suffit pour valider votre abonnement.
    </p>

    <table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center" style="margin:0 auto 32px auto;">
        <tr>
            <td align="center" bgcolor="#F57706">
                <a href="{{ confirmUrl }}" target="_blank"
                   style="display:inline-block; padding:16px 40px; font-family:Arial, sans-serif; font-size:14px; font-weight:700; color:#ffffff; text-decoration:none; text-transform:uppercase; letter-spacing:1.5px;">
                    ✓&nbsp; Valider mon inscription
                </a>
            </td>
        </tr>
    </table>

    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom:24px;">
        <tr>
            <td style="background:#f9fafb; border-left:3px solid #F57706; padding:14px 18px;">
                <p style="margin:0; color:#6b7280; font-size:13px; line-height:1.6; text-align:center;">
                    🔒 Ce lien est valable <strong style="color:#374151;">24 heures</strong>.<br>
                    Si vous n'avez pas demandé cette inscription, ignorez simplement cet email.
                </p>
            </td>
        </tr>
    </table>

    <p style="margin:0; color:#b0b4bb; font-size:11px; text-align:center;">
        <a href="{{ subscriber.getUnsubscribeUrl() }}" style="color:#b0b4bb; text-decoration:underline;">
            Se désabonner
        </a>
    </p>
{% endblock %}
