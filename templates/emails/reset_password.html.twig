{% extends 'emails/_layout.html.twig' %}

{% block title %}Réinitialisation du mot de passe — CHM Saleux{% endblock %}

{% block body %}
    <p style="margin:0 0 6px; color:#F57706; font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase;">
        Sécurité
    </p>
    <h1 style="margin:0 0 24px; color:#111827; font-size:24px; font-weight:800; line-height:1.3;">
        Réinitialisation du mot de passe
    </h1>

    <p style="margin:0 0 12px; color:#4b5563; font-size:15px; line-height:1.7;">
        Bonjour <strong>{{ user.firstName }}</strong>,
    </p>
    <p style="margin:0 0 32px; color:#4b5563; font-size:15px; line-height:1.7;">
        Vous avez demandé à réinitialiser votre mot de passe. Cliquez sur le bouton ci-dessous pour en choisir un nouveau :
    </p>

    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom:32px;">
        <tr>
            <td align="center">
                <a href="{{ resetUrl }}"
                   style="display:inline-block; background-color:#F57706; color:#ffffff; padding:15px 32px; text-decoration:none; font-weight:700; font-size:14px; text-transform:uppercase; letter-spacing:1px;">
                    Réinitialiser mon mot de passe
                </a>
            </td>
        </tr>
    </table>

    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom:32px;">
        <tr>
            <td style="background:#f9fafb; border-left:3px solid #F57706; padding:14px 18px;">
                <p style="margin:0; color:#6b7280; font-size:13px; line-height:1.6;">
                    🔒 Ce lien est valable <strong style="color:#374151;">1 heure</strong>.<br>
                    Si vous n'avez pas demandé cette réinitialisation, ignorez cet email en toute sécurité.
                </p>
            </td>
        </tr>
    </table>

    <p style="margin:0; color:#64748b; font-size:14px; line-height:1.8;">
        À bientôt,<br>
        L'équipe <strong style="color:#374151;">CHM Saleux</strong>
    </p>
{% endblock %}
