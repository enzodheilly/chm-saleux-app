<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="color-scheme" content="light">
		<meta name="supported-color-schemes" content="light">
		<title>Votre code de vérification — CHM Saleux</title>
		<style>
			body,
			table,
			td,
			a {
				-webkit-text-size-adjust: 100%;
				-ms-text-size-adjust: 100%;
			}
			table,
			td {
				mso-table-lspace: 0;
				mso-table-rspace: 0;
			}
			img {
				border: 0;
				height: auto;
				line-height: 100%;
				outline: none;
				text-decoration: none;
				display: block;
			}
			body {
				margin: 0 !important;
				padding: 0 !important;
				background-color: #f0f2f5 !important;
				font-family: 'Inter', Helvetica, Arial, sans-serif;
			}
			:root {
				color-scheme: light only;
			}
			@media(prefers-color-scheme: dark) {
				body {
					background-color: #f0f2f5 !important;
				}
				.card {
					background: #ffffff !important;
				}
				.footer-bg {
					background: #fafafa !important;
				}
			}
			@media screen and(max-width: 600px) {
				.container {
					width: 100% !important;
				}
				.mobile-pad {
					padding: 30px 20px !important;
				}
				td[class="footer-cell"] {
					text-align: center !important;
					display: block !important;
					width: 100% !important;
				}
			}
		</style>
	</head>
	<body style="background-color: #f0f2f5; margin: 0; padding: 0;">

		<table border="0" cellpadding="0" cellspacing="0" width="100%">
			<tr>
				<td align="center" style="padding: 40px 16px;">

					<table
						class="container card" border="0" cellpadding="0" cellspacing="0" width="560" style="background:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 4px 24px rgba(0,0,0,0.07);">

						{# ── HEADER ── #}
						<tr>
							<td align="center" style="background: linear-gradient(135deg, #0f1117 0%, #1a1d27 100%) !important; padding: 40px 40px 32px;">
								<img src="https://raw.githubusercontent.com/enzodheilly/chm-saleux-app/main/public/images/favicon/icon2.png" alt="CHM Saleux" width="52" height="52" style="display: block; margin: 0 auto 16px auto; border-radius: 12px;">
								<div style="color: #F57706 !important; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 8px; text-align: center;">
									Club d'Haltérophilie &amp; Musculation
								</div>
								<div style="color: #ffffff !important; font-size: 22px; font-weight: 800; line-height: 1.3; text-align: center;">
									CHM SALEUX
								</div>
							</td>
						</tr>

						{# ── CONTENU ── #}
						<tr>
							<td class="mobile-pad" align="center" style="padding: 48px 48px 40px; text-align: center; background: #ffffff;">

								<p style="margin: 0 0 8px; color: #6b7280; font-size: 13px; text-transform: uppercase; letter-spacing: 2px; font-weight: 600; text-align: center;">
									Vérification du compte
								</p>
								<h1 style="margin: 0 0 20px; color: #111827; font-size: 26px; font-weight: 800; line-height: 1.3; text-align: center;">
									Votre code de vérification
								</h1>

								<p style="margin: 0 0 8px; color: #4b5563; font-size: 15px; line-height: 1.7; text-align: center;">
									Bonjour
									<strong>{{ firstName }}</strong>,
								</p>
								<p style="margin: 0 0 32px; color: #4b5563; font-size: 15px; line-height: 1.7; text-align: center;">
									Merci de vous inscrire sur le site du CHM Saleux.
									                                Voici votre code de vérification :
								</p>

								{# ── CODE BOX ── #}
								<table border="0" cellpadding="0" cellspacing="0" align="center" style="margin: 0 auto 32px auto;">
									<tr>
										<td align="center" style="background: #f9fafb; border-radius: 12px; border: 2px dashed #F57706; padding: 28px 48px; text-align: center;">
											<div style="font-size: 42px; font-weight: 900; letter-spacing: 10px; color: #0f1117; line-height: 1;">
												{{ code }}
											</div>
											<div style="color: #94a3b8; font-size: 13px; margin-top: 12px;">
												Ce code est valable
												<strong style="color: #374151;">15 minutes</strong>
											</div>
										</td>
									</tr>
								</table>

								{# ── NOTE SÉCURITÉ ── #}
								<table border="0" cellpadding="0" cellspacing="0" width="100%">
									<tr>
										<td style="background: #f9fafb; border-radius: 10px; border-left: 3px solid #F57706; padding: 16px 20px;">
											<p style="margin: 0; color: #6b7280; font-size: 13px; line-height: 1.6; text-align: center;">
												🔒 Si vous n'avez pas demandé ce code, ignorez simplement cet email.
											</p>
										</td>
									</tr>
								</table>

							</td>
						</tr>

						{# ── SÉPARATEUR ── #}
						<tr>
							<td style="padding: 0 48px; background: #ffffff;">
								<div style="height: 1px; background: #f0f2f5;"></div>
							</td>
						</tr>

						{# ── FOOTER ── #}
						<tr>
							<td class="mobile-pad footer-bg" align="center" style="padding: 28px 48px; background: #fafafa !important; text-align: center;">
								<table border="0" cellpadding="0" cellspacing="0" width="100%">
									<tr>
										<td align="center" style="text-align: center; color: #6b7280; font-size: 12px; line-height: 2;">
											<span style="display: block; text-align: center; font-weight: 700; color: #111827; font-size: 13px;">CHM SALEUX</span>
											<span style="display: block; text-align: center;">8 rue Max Dormoy – 80480 Saleux</span>
											<span style="display: block; text-align: center;">Tél : 03.22.89.72.57 &nbsp;·&nbsp;<a href="mailto:chm.saleux@orange.fr" style="color: #6b7280; text-decoration: none;">chm.saleux@orange.fr</a>
											</span>
											<span style="display: block; text-align: center; font-style: italic;">Agréé Jeunesse et Sports – Association loi 1901</span>
										</td>
									</tr>
									<tr>
										<td align="center" style="padding-top: 16px; color: #9ca3af; font-size: 11px; text-align: center;">
											©
											{{ "now"|date("Y") }}
											CHM Saleux
										</td>
									</tr>
								</table>
							</td>
						</tr>

					</table>

					{# ── LIEN SITE ── #}
					<table class="container" border="0" cellpadding="0" cellspacing="0" width="560">
						<tr>
							<td align="center" style="padding: 24px 0 8px;">
								<a href="https://chm-saleux.fr" style="color: #9ca3af; text-decoration: none; font-size: 12px;">
									chm-saleux.fr
								</a>
							</td>
						</tr>
					</table>

				</td>
			</tr>
		</table>

	</body>
</html>
