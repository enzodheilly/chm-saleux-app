{% extends 'emails/_layout.html.twig' %}

{% block title %}Votre code de vérification — CHM Saleux{% endblock %}

{% block body %}
    <h1 style="margin:0 0 20px; color:#111827; font-size:22px; font-weight:800; line-height:1.3; text-align:center;">
        Votre code de vérification
    </h1>

    <p style="margin:0 0 12px; color:#4b5563; font-size:15px; line-height:1.7; text-align:center;">
        Bonjour <strong>{{ firstName }}</strong>,
    </p>
    <p style="margin:0 0 32px; color:#4b5563; font-size:15px; line-height:1.7; text-align:center;">
        Merci de vous inscrire sur le site du CHM Saleux.<br>
        Voici votre code de vérification :
    </p>

    <table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center" style="margin:0 auto 32px auto;">
        <tr>
            <td align="center" style="background:#f9fafb; border:2px dashed #d1d5db; padding:28px 48px; text-align:center; border-radius:8px;">
                <div style="font-size:40px; font-weight:900; letter-spacing:10px; color:#0f1117; line-height:1;">
                    {{ code }}
                </div>
                <div style="color:#94a3b8; font-size:13px; margin-top:12px;">
                    Valable <strong style="color:#374151;">15 minutes</strong>
                </div>
            </td>
        </tr>
    </table>

    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
            <td style="background:#f9fafb; border-left:3px solid #e5e7eb; padding:14px 18px;">
                <p style="margin:0; color:#6b7280; font-size:13px; line-height:1.6; text-align:center;">
                    Si vous n'avez pas demandé ce code, ignorez simplement cet email.
                </p>
            </td>
        </tr>
    </table>
{% endblock %}
