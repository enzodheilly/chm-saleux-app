<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Désinscription — CHM Saleux</title>
		<link rel="stylesheet" href="{{ asset('css/newsletter_unsubscribe.css') }}">
	</head>
	<body>
		<div class="main-container">
			<div class="card">
				<div class="header-accent">
					<img src="{{ asset('images/favicon/icon2.png') }}" alt="Logo CHM Saleux" class="logo">
					<div class="club-name">CHM SALEUX</div>
				</div>

				<div class="content">
					{% if success %}
						<div class="success-icon">✓</div>
						<h1>Désabonné</h1>
						<p>C'est fait ! L'adresse
							<br><span class="email-tag">{{ subscriberEmail }}</span>
							<br>ne recevra plus nos actualités.</p>
						<a href="{{ path('home') }}" class="btn btn-home">Retour au site</a>
					{% else %}
						<h1>Désinscription</h1>
						<p>Bonjour
							<strong>{{ firstName ? firstName : 'à vous' }}</strong>,<br>
							Confirmez-vous la désinscription de :<br>
							<span class="email-tag">{{ subscriberEmail }}</span>
							?</p>

						<form method="POST">
							<input type="hidden" name="_token" value="{{ csrf_token('newsletter_unsubscribe_' ~ subscriberId) }}">
							<button type="submit" class="btn btn-confirm">Confirmer</button>
						</form>
						<a href="{{ path('home') }}" class="btn btn-home">Annuler</a>
					{% endif %}
				</div>
			</div>
			<div class="footer-text">©
				{{ "now"|date("Y") }}
				CHM SALEUX — FORCE & DISCIPLINE</div>
		</div>
	</body>
</html>
