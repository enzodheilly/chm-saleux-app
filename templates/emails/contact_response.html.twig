{% extends 'emails/_layout.html.twig' %}

{% block title %}Réponse à votre demande — CHM Saleux{% endblock %}

{% block accent_color %}#3b82f6{% endblock %}

{% block body %}
    <p style="margin:0 0 6px; color:#3b82f6; font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase;">
        Contact
    </p>
    <h1 style="margin:0 0 24px; color:#111827; font-size:24px; font-weight:800; line-height:1.3;">
        Réponse à votre demande
    </h1>

    <p style="margin:0 0 12px; color:#4b5563; font-size:15px; line-height:1.7;">
        Bonjour,
    </p>
    <p style="margin:0 0 24px; color:#4b5563; font-size:15px; line-height:1.7;">
        Nous avons bien pris en compte votre demande de contact et voici notre réponse :
    </p>

    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom:32px;">
        <tr>
            <td style="background:#f9fafb; border-left:4px solid #3b82f6; padding:20px 24px;">
                <p style="margin:0; color:#1e293b; font-size:15px; line-height:1.7; white-space:pre-line;">{{ responseText }}</p>
            </td>
        </tr>
    </table>

    <p style="margin:0; color:#64748b; font-size:14px; line-height:1.8;">
        Cordialement,<br>
        <strong style="color:#374151;">{{ adminName }}</strong><br>
        CHM Saleux
    </p>
{% endblock %}
