{% extends 'base.html.twig' %}

{% block title %}Paiement en cours · CHM Saleux{% endblock %}

{% block main_class %}page-top-offset dl-main{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/licence/demande.css') }}?v=9">
{% endblock %}

{% block body %}
	<div class="dl-root">
		<div class="dl-shell dl-shell--center">
			<div class="dl-merci">
				<div class="dl-merci-icon"><i class="fa-solid fa-hourglass-half"></i></div>
				<h1>Paiement en cours</h1>
				<p class="dl-intro-sub">
					Votre demande de licence <strong>{{ formuleLabel }}</strong> est bien enregistrée. Nous n'avons pas encore reçu la confirmation définitive de HelloAsso pour votre paiement.
				</p>

				<p class="dl-hint">
					C'est généralement une question de quelques instants. Vous recevrez un email de confirmation dès que le paiement sera validé — inutile de renvoyer le formulaire ou de payer une seconde fois. Si vous ne recevez rien d'ici quelques heures, contactez le club à <a href="mailto:chm.saleux@orange.fr" class="dl-link">chm.saleux@orange.fr</a>.
				</p>

				<a href="{{ path('home') }}" class="dl-btn-next dl-submit dl-merci-back">Retour à l'accueil</a>
			</div>
		</div>
	</div>
{% endblock %}
