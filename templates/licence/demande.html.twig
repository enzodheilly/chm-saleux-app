{% extends 'base.html.twig' %}

{% block title %}Demande de licence · CHM Saleux{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/licence/demande.css') }}">
{% endblock %}

{% block body %}

	<header class="dl-page-header">
		<div class="page-container dl-hero-container">
			{% include 'components/breadcrumb.html.twig' with { items: [
				{ label: 'Demande de licence' }
			] } %}
			<div class="dl-header-body">
				<h1>DEMANDE DE
					<span>LICENCE</span>
				</h1>
				<p class="dl-header-lead">Le club CHM Saleux, affilié à la Fédération Française d'Haltérophilie Musculation (FFHM), dématérialise sa procédure d'adhésion. Remplissez ce formulaire une fois : nous transmettons ensuite votre dossier à la FFHM pour l'édition de votre licence officielle.</p>
			</div>
		</div>
	</header>

	<main class="dl-root page-shell">

		<div class="page-container flash-container">
			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="alert-flash flash-{{ label }}">{{ message }}</div>
				{% endfor %}
			{% endfor %}
		</div>

		<section class="dl-section page-container">
			<div class="dl-wm" aria-hidden="true">LICENCE</div>

			{# ── Bande de confiance ── #}
			<div class="dl-trust-strip">
				<div class="dl-trust-tile">
					<div class="dl-trust-label">Affiliation</div>
					<div class="dl-trust-val">Club affilié FFHM — agréé Jeunesse &amp; Sports</div>
				</div>
				<div class="dl-trust-tile">
					<div class="dl-trust-label">Localisation</div>
					<div class="dl-trust-val">8 Rue Max Dormoy, 80480 Saleux</div>
				</div>
				<div class="dl-trust-tile">
					<div class="dl-trust-label">Téléphone</div>
					<div class="dl-trust-val"><a href="tel:0322897257">03 22 89 72 57</a></div>
				</div>
				<div class="dl-trust-tile">
					<div class="dl-trust-label">Email</div>
					<div class="dl-trust-val"><a href="mailto:chm.saleux@orange.fr">chm.saleux@orange.fr</a></div>
				</div>
			</div>

			<div class="dl-layout">

				<form method="post" action="{{ path('demande_licence_submit') }}" enctype="multipart/form-data" class="dl-form dl-wizard" novalidate>
					<input type="hidden" name="_token" value="{{ csrf_token('demande_licence_submit') }}">

					{# ── Barre de progression ── #}
					<div class="dl-progress">
						<div class="dl-progress-track"><div class="dl-progress-fill" id="dl-progress-fill"></div></div>
						<div class="dl-progress-label"><span id="dl-progress-step">1</span> / 6 — <span id="dl-progress-title">Choix de la formule</span></div>
					</div>

					{# ── Étape 1 : Formule ── #}
					<div class="dl-card dl-step active" data-step="1" data-title="Choix de la formule">
						<h2 class="dl-card-title"><span class="dl-num">1</span>Choix de la formule</h2>
						<div class="dl-formules">
							{% for key, label in formules %}
								<label class="dl-formule-option">
									<input type="radio" name="formule" value="{{ key }}" {% if key == 'loisir' %}checked{% endif %} required>
									<span class="dl-formule-card">
										<span class="dl-formule-name">{{ label }}</span>
									</span>
								</label>
							{% endfor %}
						</div>
						<p class="dl-hint">Le montant exact (dégressif pour Loisir &amp; Muscu selon le mois, réductions familiales, tarif réduit) est calculé automatiquement et confirmé après l'envoi du formulaire. Grille tarifaire complète sur la page <a href="{{ path('app_pricing') }}" class="dl-link">Tarifs</a>.</p>

						<div class="dl-row">
							<label class="dl-check">
								<input type="checkbox" name="tarif_reduit" id="dl-tarif-reduit" value="1">
								Je bénéficie du tarif réduit (Carte Génération HDF, carte étudiante, etc.)
							</label>
						</div>
						<div class="dl-field" id="dl-justificatif-wrap" style="display:none;">
							<label for="justificatif_reduit">Justificatif du tarif réduit</label>
							<input type="file" name="justificatif_reduit" id="justificatif_reduit" accept=".pdf,.jpg,.jpeg,.png">
						</div>

						<div class="dl-field">
							<label for="foyer_rang">Réduction familiale — rang de cette licence dans votre foyer</label>
							<select name="foyer_rang" id="foyer_rang" class="dl-input">
								<option value="1">1ère licence du foyer — plein tarif</option>
								<option value="2">2ème licence du foyer — -10%</option>
								<option value="3">3ème licence du foyer — -15%</option>
								<option value="4">4ème licence et + du foyer — -20%</option>
							</select>
						</div>

						<div class="dl-step-actions">
							<span></span>
							<button type="button" class="dl-btn-next">Suivant</button>
						</div>
					</div>

					{# ── Étape 2 : Pratiquant ── #}
					<div class="dl-card dl-step" data-step="2" data-title="Informations du pratiquant">
						<h2 class="dl-card-title"><span class="dl-num">2</span>Informations du pratiquant</h2>

						<div class="dl-row">
							<div class="dl-field">
								<label for="prenom">Prénom *</label>
								<input type="text" name="prenom" id="prenom" class="dl-input" maxlength="100" required>
							</div>
							<div class="dl-field">
								<label for="nom">Nom *</label>
								<input type="text" name="nom" id="nom" class="dl-input" maxlength="100" required>
							</div>
						</div>

						<div class="dl-row">
							<div class="dl-field">
								<label for="sexe">Sexe *</label>
								<select name="sexe" id="sexe" class="dl-input" required>
									<option value="">—</option>
									<option value="F">Féminin</option>
									<option value="M">Masculin</option>
								</select>
							</div>
							<div class="dl-field">
								<label for="date_naissance">Date de naissance *</label>
								<input type="date" name="date_naissance" id="date_naissance" class="dl-input" required>
							</div>
						</div>

						<div class="dl-row">
							<div class="dl-field">
								<label for="email">Email *</label>
								<input type="email" name="email" id="email" class="dl-input" maxlength="180" required>
							</div>
							<div class="dl-field">
								<label for="telephone">Téléphone *</label>
								<input type="tel" name="telephone" id="telephone" class="dl-input" maxlength="30" required>
							</div>
						</div>

						<div class="dl-field">
							<label for="adresse">Adresse *</label>
							<input type="text" name="adresse" id="adresse" class="dl-input" maxlength="255" required>
						</div>

						<div class="dl-step-actions">
							<button type="button" class="dl-btn-prev">Précédent</button>
							<button type="button" class="dl-btn-next">Suivant</button>
						</div>
					</div>

					{# ── Étape 3 : Responsable légal ── #}
					<div class="dl-card dl-step" data-step="3" data-title="Responsable légal">
						<h2 class="dl-card-title"><span class="dl-num">3</span>Responsable légal <span class="dl-card-subtitle" id="dl-resp-subtitle">(si pratiquant mineur)</span></h2>

						<div class="dl-row">
							<div class="dl-field">
								<label for="responsable_nom">Nom &amp; prénom du responsable <span class="dl-req-star" id="dl-star-resp-nom" style="display:none;">*</span></label>
								<input type="text" name="responsable_nom" id="responsable_nom" class="dl-input" maxlength="150">
							</div>
							<div class="dl-field">
								<label for="responsable_lien">Lien de parenté <span class="dl-req-star" id="dl-star-resp-lien" style="display:none;">*</span></label>
								<input type="text" name="responsable_lien" id="responsable_lien" class="dl-input" maxlength="100">
							</div>
						</div>
						<div class="dl-row">
							<div class="dl-field">
								<label for="responsable_telephone">Téléphone du responsable <span class="dl-req-star" id="dl-star-resp-tel" style="display:none;">*</span></label>
								<input type="tel" name="responsable_telephone" id="responsable_telephone" class="dl-input" maxlength="30">
							</div>
							<div class="dl-field">
								<label for="responsable_email">Email du responsable</label>
								<input type="email" name="responsable_email" id="responsable_email" class="dl-input" maxlength="180">
							</div>
						</div>

						<div class="dl-step-actions">
							<button type="button" class="dl-btn-prev">Précédent</button>
							<button type="button" class="dl-btn-next">Suivant</button>
						</div>
					</div>

					{# ── Étape 4 : Certificat médical ── #}
					<div class="dl-card dl-step" data-step="4" data-title="Justificatif médical">
						<h2 class="dl-card-title"><span class="dl-num">4</span>Justificatif médical</h2>
						<p class="dl-hint">Certificat médical de non contre-indication à la pratique de l'haltérophilie/musculation, ou questionnaire de santé signé (formulaire officiel FFHM). Formats acceptés : PDF, JPG, PNG — 8 Mo max.</p>
						<div class="dl-field">
							<label for="certificat_medical">Certificat médical / questionnaire de santé *</label>
							<input type="file" name="certificat_medical" id="certificat_medical" accept=".pdf,.jpg,.jpeg,.png" required>
						</div>
						<p class="dl-notice">Ce document contient des données de santé. Il est stocké hors de tout accès public et consultable uniquement par le bureau du club, dans le seul but d'instruire votre dossier de licence puis de le transmettre à la FFHM.</p>

						<div class="dl-step-actions">
							<button type="button" class="dl-btn-prev">Précédent</button>
							<button type="button" class="dl-btn-next">Suivant</button>
						</div>
					</div>

					{# ── Étape 5 : Paiement ── #}
					<div class="dl-card dl-step" data-step="5" data-title="Mode de règlement">
						<h2 class="dl-card-title"><span class="dl-num">5</span>Mode de règlement</h2>
						<div class="dl-formules">
							<label class="dl-formule-option">
								<input type="radio" name="mode_paiement" value="en_ligne" checked>
								<span class="dl-formule-card">
									<span class="dl-formule-name">Je règle en ligne</span>
									<span class="dl-formule-sub">Paiement sécurisé via HelloAsso (CB, PayPal…)</span>
								</span>
							</label>
							<label class="dl-formule-option">
								<input type="radio" name="mode_paiement" value="au_club">
								<span class="dl-formule-card">
									<span class="dl-formule-name">Je règle au club</span>
									<span class="dl-formule-sub">Sur place, en espèces ou par carte</span>
								</span>
							</label>
						</div>

						<div class="dl-step-actions">
							<button type="button" class="dl-btn-prev">Précédent</button>
							<button type="button" class="dl-btn-next">Suivant</button>
						</div>
					</div>

					{# ── Étape 6 : Récapitulatif & envoi ── #}
					<div class="dl-card dl-step" data-step="6" data-title="Récapitulatif">
						<h2 class="dl-card-title"><span class="dl-num">6</span>Récapitulatif</h2>
						<p class="dl-hint">Vérifiez vos informations avant l'envoi. Vous pouvez encore revenir en arrière pour corriger un champ.</p>

						<div class="dl-recap" id="dl-recap"></div>

						<div class="dl-card dl-card--consent">
							<label class="dl-check dl-check--consent">
								<input type="checkbox" name="consentement_rgpd" id="consentement_rgpd" value="1" required>
								<span>
									J'accepte que les informations renseignées dans ce formulaire, y compris les données de santé transmises via le certificat médical, soient collectées par CHM Saleux et transmises à la <strong>Fédération Française d'Haltérophilie Musculation (FFHM)</strong> aux seules fins de délivrance de ma licence sportive, conformément au <a href="{{ path('legal_page_show', {slug: 'confidentialite'}) }}" target="_blank" class="dl-link">RGPD et à notre politique de confidentialité</a>. Je peux exercer mes droits d'accès, de rectification et de suppression en écrivant à <a href="mailto:chm.saleux@orange.fr" class="dl-link">chm.saleux@orange.fr</a>.
								</span>
							</label>
						</div>

						<div class="turnstile-wrapper">
							<div class="cf-turnstile" data-sitekey="0x4AAAAAACvankHbbJ6UuueH" data-theme="light"></div>
						</div>

						<div class="dl-step-actions">
							<button type="button" class="dl-btn-prev">Précédent</button>
							<button type="submit" class="dl-btn-next dl-submit">Envoyer ma demande de licence</button>
						</div>
					</div>

				</form>

				{# ── Sidebar ── #}
				<aside class="dl-sidebar">
					<div class="dl-side-card">
						<h3 class="dl-side-title">Comment ça marche ?</h3>
						<ol class="dl-steps">
							<li><strong>Vous remplissez</strong> le formulaire en ligne, avec votre certificat médical.</li>
							<li><strong>Nous calculons</strong> le tarif exact selon votre formule et votre situation.</li>
							<li><strong>Vous réglez</strong> au club ou bientôt en ligne.</li>
							<li><strong>Nous transmettons</strong> votre dossier à la FFHM, qui édite votre licence officielle.</li>
						</ol>
					</div>

					<div class="dl-side-card">
						<h3 class="dl-side-title">Nos formules</h3>
						<div class="dl-side-tarif"><span>Jeune</span><strong>70 € / an</strong></div>
						<div class="dl-side-tarif"><span>Compétition</span><strong>90 € / an</strong></div>
						<div class="dl-side-tarif"><span>Loisir &amp; Muscu</span><strong>200 € / an</strong></div>
						<p class="dl-hint" style="margin:12px 0 0;">Tarif Loisir &amp; Muscu dégressif selon le mois d'inscription. Détail complet sur la page <a href="{{ path('app_pricing') }}" class="dl-link">Tarifs</a>.</p>
					</div>

					<div class="dl-side-card">
						<h3 class="dl-side-title">Une question ?</h3>
						<p class="dl-hint" style="margin:0 0 10px;">Notre bureau est disponible pour vous accompagner dans votre inscription.</p>
						<a href="{{ path('contact') }}" class="dl-side-link"><i class="fa-solid fa-envelope"></i> Contacter le club</a>
						<a href="tel:0322897257" class="dl-side-link"><i class="fa-solid fa-phone"></i> 03 22 89 72 57</a>
					</div>
				</aside>

			</div>

		</section>
	</main>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer nonce="{{ csp_nonce('script') }}"></script>
	<script nonce="{{ csp_nonce('script') }}">
	(function () {
		document.getElementById('dl-tarif-reduit').addEventListener('change', function () {
			document.getElementById('dl-justificatif-wrap').style.display = this.checked ? 'block' : 'none';
		});

		// ── Responsable légal obligatoire si pratiquant mineur ──
		var dateNaissanceInput = document.getElementById('date_naissance');
		var respFields = ['responsable_nom', 'responsable_lien', 'responsable_telephone'];
		var respStars  = { responsable_nom: 'dl-star-resp-nom', responsable_lien: 'dl-star-resp-lien', responsable_telephone: 'dl-star-resp-tel' };

		function isMineur(dateStr) {
			if (!dateStr) return false;
			var naissance = new Date(dateStr);
			if (isNaN(naissance.getTime())) return false;
			var aujourdhui = new Date();
			var age = aujourdhui.getFullYear() - naissance.getFullYear();
			var m = aujourdhui.getMonth() - naissance.getMonth();
			if (m < 0 || (m === 0 && aujourdhui.getDate() < naissance.getDate())) age--;
			return age < 18;
		}

		function updateResponsableRequirement() {
			var mineur = isMineur(dateNaissanceInput.value);
			respFields.forEach(function (fieldId) {
				var field = document.getElementById(fieldId);
				var star  = document.getElementById(respStars[fieldId]);
				field.required = mineur;
				if (star) star.style.display = mineur ? 'inline' : 'none';
			});
		}

		dateNaissanceInput.addEventListener('change', updateResponsableRequirement);
		updateResponsableRequirement();

		var form     = document.querySelector('.dl-wizard');
		var steps    = Array.prototype.slice.call(form.querySelectorAll('.dl-step'));
		var fillEl   = document.getElementById('dl-progress-fill');
		var stepEl   = document.getElementById('dl-progress-step');
		var titleEl  = document.getElementById('dl-progress-title');
		var current  = 0;

		function labelFor(select) {
			var opt = select.options[select.selectedIndex];
			return opt ? opt.textContent.trim() : '';
		}

		function radioLabel(name) {
			var checked = form.querySelector('input[name="' + name + '"]:checked');
			if (!checked) return null;
			var nameEl = checked.closest('.dl-formule-option');
			return {
				value: checked.value,
				label: nameEl ? nameEl.querySelector('.dl-formule-name').textContent.trim() : checked.value,
			};
		}

		function addRow(container, label, value) {
			if (!value) return;
			var row = document.createElement('div');
			row.className = 'dl-recap-row';
			var l = document.createElement('span');
			l.textContent = label;
			var v = document.createElement('strong');
			v.textContent = value;
			row.appendChild(l);
			row.appendChild(v);
			container.appendChild(row);
		}

		function addGroupTitle(container, title) {
			var h = document.createElement('div');
			h.className = 'dl-recap-group';
			h.textContent = title;
			container.appendChild(h);
		}

		function fillRecap() {
			var recap = document.getElementById('dl-recap');
			recap.innerHTML = '';

			var formule = radioLabel('formule');
			addGroupTitle(recap, 'Formule');
			addRow(recap, 'Formule choisie', formule ? formule.label : '—');
			addRow(recap, 'Tarif réduit', document.getElementById('dl-tarif-reduit').checked ? 'Oui' : 'Non');
			addRow(recap, 'Réduction familiale', labelFor(document.getElementById('foyer_rang')));

			addGroupTitle(recap, 'Pratiquant');
			var prenom = document.getElementById('prenom').value;
			var nom = document.getElementById('nom').value;
			addRow(recap, 'Nom complet', (prenom + ' ' + nom).trim());
			addRow(recap, 'Sexe', labelFor(document.getElementById('sexe')));
			addRow(recap, 'Date de naissance', document.getElementById('date_naissance').value);
			addRow(recap, 'Email', document.getElementById('email').value);
			addRow(recap, 'Téléphone', document.getElementById('telephone').value);
			addRow(recap, 'Adresse', document.getElementById('adresse').value);

			var respNom = document.getElementById('responsable_nom').value;
			if (respNom) {
				addGroupTitle(recap, 'Responsable légal');
				addRow(recap, 'Nom', respNom);
				addRow(recap, 'Lien de parenté', document.getElementById('responsable_lien').value);
				addRow(recap, 'Téléphone', document.getElementById('responsable_telephone').value);
				addRow(recap, 'Email', document.getElementById('responsable_email').value);
			}

			addGroupTitle(recap, 'Documents');
			var certFiles = document.getElementById('certificat_medical').files;
			addRow(recap, 'Certificat médical', certFiles.length ? certFiles[0].name : 'Non fourni');
			var justifFiles = document.getElementById('justificatif_reduit').files;
			if (justifFiles.length) addRow(recap, 'Justificatif tarif réduit', justifFiles[0].name);

			addGroupTitle(recap, 'Règlement');
			var modePaiement = radioLabel('mode_paiement');
			addRow(recap, 'Mode choisi', modePaiement ? modePaiement.label : '—');
		}

		function show(index) {
			steps.forEach(function (step, i) {
				step.classList.toggle('active', i === index);
			});
			var step = steps[index];
			stepEl.textContent = index + 1;
			titleEl.textContent = step.getAttribute('data-title');
			fillEl.style.width = (((index + 1) / steps.length) * 100) + '%';
			if (index === steps.length - 1) fillRecap();
			current = index;
			form.scrollIntoView({ behavior: 'smooth', block: 'start' });
		}

		function validateStep(index) {
			var invalid = steps[index].querySelector(':invalid');
			if (invalid) {
				invalid.reportValidity();
				return false;
			}
			return true;
		}

		form.querySelectorAll('.dl-btn-next').forEach(function (btn) {
			btn.addEventListener('click', function () {
				if (!validateStep(current)) return;
				if (current < steps.length - 1) show(current + 1);
			});
		});

		form.querySelectorAll('.dl-btn-prev').forEach(function (btn) {
			btn.addEventListener('click', function () {
				if (current > 0) show(current - 1);
			});
		});

		form.addEventListener('submit', function (e) {
			for (var i = 0; i < steps.length; i++) {
				var invalid = steps[i].querySelector(':invalid');
				if (invalid) {
					e.preventDefault();
					show(i);
					window.setTimeout(function () { invalid.reportValidity(); }, 300);
					return;
				}
			}
		});

		show(0);
	})();
	</script>
{% endblock %}
