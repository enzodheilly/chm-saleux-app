{% extends 'base.html.twig' %}

{% block title %}Paiement non abouti · CHM Saleux{% endblock %}

{% block main_class %}page-top-offset dl-main{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/licence/demande.css') }}?v=10">
{% endblock %}

{% block body %}
	<div class="dl-root">
		<div class="dl-shell dl-shell--center">
			<div class="dl-merci">
				<div class="dl-merci-icon" style="color:#f87171;"><i class="fa-solid fa-circle-xmark"></i></div>
				<h1>Le paiement n'a pas abouti</h1>
				<p class="dl-intro-sub">
					Pas d'inquiétude : votre demande de licence <strong>{{ formuleLabel }}</strong> reste bien enregistrée. Seul le paiement en ligne a été refusé ou annulé.
				</p>

				<p class="dl-hint">
					Le bureau du club va vous recontacter pour convenir d'un autre moyen de règlement (au club, en espèces ou par carte). Vous pouvez aussi nous écrire directement à <a href="mailto:chm.saleux@orange.fr" class="dl-link">chm.saleux@orange.fr</a> ou au <a href="tel:0322897257" class="dl-link">03 22 89 72 57</a>.
				</p>

				<a href="{{ path('accueil') }}" class="dl-btn-next dl-submit dl-merci-back">Retour à l'accueil</a>
			</div>
		</div>
	</div>
{% endblock %}
