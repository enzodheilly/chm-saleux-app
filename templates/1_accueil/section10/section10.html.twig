{# --- SECTION : COURS COLLECTIFS — REFONTE --- #}
<section class="home-cc-section">
	<div class="container cc-inner">

		<div
			class="cc-grid-layout">

			{# ── Colonne gauche ── #}
			<div class="cc-info-side">

				<div class="cc-eyebrow">
					<span class="cc-eyebrow-line"></span>
					Cours collectifs
				</div>

				<h2 class="cc-main-title">
					L'énergie<br>
					du groupe,<br>
					<em>la progression<br>en plus.</em>
				</h2>

				<p class="cc-description">
					Marre de s'entraîner seul ? Séances rythmées, coachs diplômés.
																									          Du cardio au renforcement — on se dépasse ensemble dans une ambiance survoltée.
				</p>

				<div class="cc-stats-row">
					<div class="cc-stat">
						<span class="cc-stat-v">45</span>
						<span class="cc-stat-u">min / séance</span>
					</div>
					<div class="cc-stat-sep"></div>
					<div class="cc-stat">
						<span class="cc-stat-v">2<sup>×</sup>
						</span>
						<span class="cc-stat-u">par semaine</span>
					</div>
					<div class="cc-stat-sep"></div>
					<div class="cc-stat">
						<span class="cc-stat-v">100<sup>%</sup>
						</span>
						<span class="cc-stat-u">tous niveaux</span>
					</div>
				</div>

				<a href="{{ path('cours_collectifs') }}" class="btn-elite cc-btn">
					Découvrir les cours
					<i class="fa-solid fa-arrow-right"></i>
				</a>

			</div>

			{# ── Colonne droite ── #}
			<div class="cc-visual-side">

				<div class="cc-img-wrapper">
					<img src="{{ asset('images/menu_dropdown/services_du_club/cours_collectifs/cours-co.jpg') }}" alt="Cours Collectifs CHM" loading="lazy" class="cc-img">
					<div class="cc-img-overlay"></div>
					<span class="cc-img-meta">CHM — Studio</span>
					<span class="cc-img-count">01 / 03</span>
					<div class="cc-img-corner"></div>
				</div>

				<div class="cc-disc-strip">
					<div class="cc-disc cardio">
						<i class="fa-solid fa-heart-pulse"></i>
						<span class="cc-disc-name">Cardio</span>
						<span class="cc-disc-sub">Intensité</span>
					</div>
					<div class="cc-disc renfo">
						<i class="fa-solid fa-dumbbell"></i>
						<span class="cc-disc-name">Renfo</span>
						<span class="cc-disc-sub">Tonification</span>
					</div>
					<div class="cc-disc zen">
						<i class="fa-solid fa-leaf"></i>
						<span class="cc-disc-name">Zen</span>
						<span class="cc-disc-sub">Mobilité</span>
					</div>
				</div>

			</div>

		</div>
	</div>
</section>


{# --- SECTION : AVIS CLIENTS — REFONTE --- #}
<section class="home-reviews-section">
	<div class="container reviews-inner">

		<span class="rev-bg-score" aria-hidden="true">4.9</span>

		<div class="reviews-header">
			<div class="reviews-header-left">
				<div class="cc-eyebrow">
					<span class="cc-eyebrow-line"></span>
					<span class="cc-eyebrow-text">Ce qu'ils disent</span>
				</div>
				<h3 class="reviews-title">
					Ils s'entraînent<br>
					<em>avec nous</em>
				</h3>
			</div>
			<div class="reviews-score-block">
				<span class="score-number">4.9</span>
				<span class="score-stars">★★★★★</span>
				<span class="score-count">128 avis vérifiés</span>
			</div>
		</div>

		<div class="reviews-grid">

			{% set reviews = [
        { n: 'Sarah M.',  i: 'S', av: 'av-a', since: '2 ans',  t: 'Super ambiance et coachs au top ! J\'ai repris le sport avec plaisir grâce à l\'énergie du groupe.' },
        { n: 'Julien D.', i: 'J', av: 'av-b', since: '1 an',   t: 'Séances dynamiques de 45 min, parfait pour mon emploi du temps. On se sent fier après chaque session.' },
        { n: 'Nadia K.',  i: 'N', av: 'av-c', since: '8 mois', t: 'Une source de motivation énorme. Je ne rate plus ma séance du mardi — l\'ambiance est incomparable.' },
        { n: 'Alex P.',   i: 'A', av: 'av-d', since: '3 ans',  t: 'On progresse vite, on s\'accroche grâce au collectif. Ça change tout par rapport à la muscu solo.' }
      ] %}

			{% for r in reviews %}
				<article class="rev-card {% if loop.first %}rev-card--featured{% endif %}">
					<span class="rev-quote-mark">"</span>
					<p class="rev-text">{{ r.t }}</p>
					<div class="rev-footer">
						<div class="rev-avatar {{ r.av }}">{{ r.i }}</div>
						<div class="rev-user">
							<span class="rev-name">{{ r.n }}</span>
							<span class="rev-label">Membre ·
								{{ r.since }}</span>
						</div>
						<span class="rev-stars">★★★★★</span>
					</div>
				</article>
			{% endfor %}

		</div>

	</div>
</section>
