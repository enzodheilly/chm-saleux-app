<section id="accueil" class="hero-section">

	{# ── SLIDES PHOTOS ── #}
	<div class="slider-track" aria-hidden="true">
		<div class="slide slide-1 active"></div>
		<div class="slide slide-2"></div>
		<div class="slide slide-3"></div>
		<div class="slide slide-4"></div>
	</div>

	{# ── OVERLAY SOMBRE ── #}
	<div class="slider-overlay"></div>

	{# ── FILIGRANE GRAND TITRE ── #}
	<div class="slider-watermark" aria-hidden="true">CHM SALEUX</div>

	{# ── CONTENU BAS-GAUCHE ── #}
	<div class="slider-content">
<h1 class="slider-title">
			{% if app.user and not is_preview_mode %}
				Bonjour,<br>
				<span class="slider-title-accent">{{ app.user.firstName }} !</span>
			{% else %}
				Club d'Haltérophilie<br>
				<span class="slider-title-accent">&amp; Musculation</span>
			{% endif %}
		</h1>

		{% if app.user and not is_preview_mode %}
			<p class="slider-subtitle">Retrouvez vos séances, vos progrès et l'actualité du club.</p>
		{% else %}
			<p class="slider-subtitle">Rejoignez une communauté de passionnés et repoussez vos limites chaque jour.</p>
		{% endif %}

		<div class="slider-cta">
			{% if app.user and not is_preview_mode %}
				<a href="{{ path(is_granted('ROLE_ADMIN') ? 'admin_dashboard' : 'dashboard') }}" class="hero-cta-primary">
					MON TABLEAU DE BORD
				</a>
			{% else %}
				<a href="{{ path('app_auth_choice') }}" class="hero-cta-primary">
					NOUS REJOINDRE
				</a>
				<a href="{{ path('app_club') }}" class="hero-cta-white">
					Découvrir le club
				</a>
			{% endif %}
		</div>
	</div>

	{# Badge FFHM #}
	<div class="badge-ffhm">
		<span class="badge-text">Club affilié</span>
		<span class="badge-separator"></span>
		<img src="{{ asset('images/ffhm.png') }}" alt="Logo FFHM" loading="lazy" decoding="async" width="80" height="30">
	</div>

	{# ── BARRE STATS EN BAS ── #}
	<div class="slider-stats-bar">
		<div class="slider-stat">
			<span class="slider-stat-num" id="adherents-counter">85+</span>
			<span class="slider-stat-label">Adhérents</span>
		</div>
		<div class="slider-stat-div"></div>
		<div class="slider-stat">
			<span class="slider-stat-num">300</span>
			<span class="slider-stat-label">m² d'installations</span>
		</div>
		<div class="slider-stat-div"></div>
		<div class="slider-stat">
			<span class="slider-stat-num">30+</span>
			<span class="slider-stat-label">Compétitions</span>
		</div>
		<div class="slider-stat-div"></div>
		<div class="slider-stat">
			<span class="slider-stat-num">+25</span>
			<span class="slider-stat-label">Ans d'expérience</span>
		</div>
	</div>

	{# ── DOTS DE NAVIGATION ── #}
	<div class="slider-dots">
		<button class="slider-dot active" data-slide="0" aria-label="Slide 1">1</button>
		<button class="slider-dot" data-slide="1" aria-label="Slide 2">2</button>
		<button class="slider-dot" data-slide="2" aria-label="Slide 3">3</button>
		<button class="slider-dot" data-slide="3" aria-label="Slide 4">4</button>
	</div>

</section>
