{% extends 'base.html.twig' %}

{% block title %}Actualités · CHM Saleux{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/accueil/section4/actualites/articles.css') }}">
	<link rel="stylesheet" href="{{ asset('css/competitions/team-archives.css') }}">
{% endblock %}

{% block body %}

	<header class="news-page-header">
		<div class="page-container">
		{% include 'components/breadcrumb.html.twig' with { items: [{ label: 'Actualités' }] } %}
			<div class="news-header-body">
				<h1 class="news-header-title">Actualités <span>& News</span></h1>
				<p class="news-header-lead">Résultats, événements et vie de l'association — ne manquez rien de l'actu du CHM.</p>
			</div>
		</div>
	</header>

	{# IMAGE DÉCORATIVE GAUCHE #}

	<main class="news-root page-shell">

		<section class="page-container news-main-section">
<form id="newsFilterForm" method="get" action="{{ path('actualites', {'page': 1}) }}" class="news-filter-bar">

				<select name="category" class="nf-select">
					<option value="">Toutes les catégories</option>
					{% for cat in categories %}
						<option value="{{ cat.name }}" {% if filters.category is defined and filters.category == cat.name %}selected{% endif %}>
							{{ cat.name|capitalize }}
						</option>
					{% endfor %}
				</select>

				<div class="nf-separator"></div>

				<div class="nf-date-range">
					<input type="date" name="date_from" value="{{ filters.date_from ?? '' }}" class="nf-date" placeholder="Du">
					<span class="nf-date-sep">→</span>
					<input type="date" name="date_to" value="{{ filters.date_to ?? '' }}" class="nf-date" placeholder="Au">
				</div>

				<button type="submit" class="nf-btn-search">
					<i class="fa-solid fa-magnifying-glass"></i>
				</button>

				{% if (filters.category is defined and filters.category) or filters.date_from or filters.date_to %}
					<a href="{{ path('actualites') }}" class="nf-btn-reset" title="Réinitialiser">
						<i class="fa-solid fa-xmark"></i>
					</a>
				{% endif %}

			</form>

			<div id="newsResults" class="news-results-wrap">
				{% include '1_accueil/section4/actualites/_results.html.twig' %}
			</div>
		</section>

	</main>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	 <script src="{{ asset('js/accueil/section4/actualites/articles.js') }}"></script>
{% endblock %}
