{% extends 'base.html.twig' %}

{% block title %}Actualités du Club — CHM Saleux{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/accueil/section4/actualites/articles.css') }}">
{% endblock %}

{% block body %}

    {# --- HEADER ELITE --- #}
    <header class="page-header-sport" style="--bg-image: url('{{ asset('images/competitions/1.jpg') }}');">
        <div class="header-overlay-gradient"></div>
        <div class="container header-content">
            <nav class="breadcrumb-nav">
                <a href="{{ path('home') }}" class="back-link-minimal">
                    <i class="fa-solid fa-chevron-left"></i> <span>Retour à l'accueil</span>
                </a>
            </nav>

            <div class="header-main-box">
                <div class="badge-accent">Le Journal du Club</div>
                <h1>Actualités <span class="text-outline">& News</span></h1>
                <p class="lead">Résultats, événements et vie de l'association : ne manquez rien de l'actu du CHM.</p>
            </div>
        </div>
    </header>

    <main class="news-root">
        
        {# --- FILTRES --- #}
        <section class="container">
            <div class="filter-card-wrapper">
                <form method="get" action="{{ path('actualites', {'page': 1}) }}" class="elite-filter-bar">
                    <div class="filter-inputs">
                        <div class="filter-field">
                            <label><i class="fa-solid fa-tag"></i> Catégorie</label>
                            <select name="category">
                                <option value="">Toutes</option>
                                {% for cat in categories %}
                                    <option value="{{ cat }}" {% if filters.category is defined and filters.category == cat %}selected{% endif %}>
                                        {{ cat|capitalize }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        
                        <div class="filter-field">
                            <label><i class="fa-solid fa-calendar-days"></i> Période</label>
                            <div class="date-range">
                                <input type="date" name="date_from" value="{{ filters.date_from ?? '' }}" placeholder="Du">
                                <span>au</span>
                                <input type="date" name="date_to" value="{{ filters.date_to ?? '' }}" placeholder="Au">
                            </div>
                        </div>
                    </div>

                    <div class="filter-buttons">
                        <button type="submit" class="btn-elite-search"><i class="fa-solid fa-magnifying-glass"></i></button>
                        {% if (filters.category is defined and filters.category) or filters.date_from or filters.date_to %}
                            <a href="{{ path('actualites') }}" class="btn-elite-reset"><i class="fa-solid fa-rotate-left"></i></a>
                        {% endif %}
                    </div>
                </form>
            </div>
        </section>

        {# --- GRILLE D'ARTICLES --- #}
        <section class="container section-spacer">
            {% if articles is not empty %}
                <div class="news-grid-layout">
                    {% for article in articles %}
                        <article class="news-card-elite">
                            <div class="card-thumb">
                                <img src="{{ asset('uploads/' ~ article.photo) }}" alt="{{ article.title }}" loading="lazy">
                                <div class="card-badge">{{ article.category ? article.category|capitalize : 'Info' }}</div>
                            </div>
                            
                            <div class="card-body">
                                <span class="card-date"><i class="fa-regular fa-calendar"></i> {{ article.publishedAt|date('d/m/Y') }}</span>
                                <h3><a href="{{ path('article_show', {'id': article.id}) }}">{{ article.title }}</a></h3>
                                <p>{{ article.description|striptags|slice(0, 100) ~ '...' }}</p>
                                <a href="{{ path('article_show', {'id': article.id}) }}" class="link-arrow">Lire l'article <i class="fa-solid fa-arrow-right"></i></a>
                            </div>
                        </article>
                    {% endfor %}
                </div>

                {# --- PAGINATION --- #}
                {% if totalPages > 1 %}
                    <div class="pagination-elite mt-5">
                        {% set query = filters %}
                        <a href="{{ page > 1 ? path('actualites', query|merge({'page': page - 1})) : '#' }}" class="page-btn {{ page <= 1 ? 'disabled' : '' }}"><i class="fa-solid fa-chevron-left"></i></a>
                        
                        {% for i in 1..totalPages %}
                            <a href="{{ path('actualites', query|merge({'page': i})) }}" class="page-btn {{ i == page ? 'active' : '' }}">{{ i }}</a>
                        {% endfor %}

                        <a href="{{ page < totalPages ? path('actualites', query|merge({'page': page + 1})) : '#' }}" class="page-btn {{ page >= totalPages ? 'disabled' : '' }}"><i class="fa-solid fa-chevron-right"></i></a>
                    </div>
                {% endif %}

            {% else %}
                <div class="empty-news">
                    <i class="fa-solid fa-newspaper"></i>
                    <h3>Aucun article trouvé</h3>
                    <p>Modifiez vos filtres pour voir d'autres résultats.</p>
                </div>
            {% endif %}
        </section>

    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/accueil/section4/actualites/articles.js') }}"></script>
{% endblock %}