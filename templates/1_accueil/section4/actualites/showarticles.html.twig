{% extends 'base.html.twig' %}

{% block title %}{{ article.title }} - CHM Saleux{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/accueil/section4/actualites/showarticles.css') }}">

        <style nonce="{{ csp_nonce('style') }}">
        {% if article.photo %}
            .article-hero-bg {
                background-image: url('{{ asset('uploads/' ~ article.photo) }}');
            }
        {% else %}
            .article-hero-bg {
                background-image: url('{{ asset('images/defaults/article-placeholder.jpg') }}');
            }
        {% endif %}
    </style>
{% endblock %}

{% block body %}
<main class="article-root">

    {# --- HEADER DE L'ARTICLE --- #}
<header class="article-hero">
    <div class="hero-bg article-hero-bg"></div>
    <div class="hero-overlay"></div>

    <div class="article-hero-container hero-content">
        <nav class="article-breadcrumb">
            <a href="{{ path('home') }}">Accueil</a>
            <i class="fa-solid fa-chevron-right"></i>
            <a href="{{ path('actualites') }}">Actualités</a>
        </nav>

        <div class="title-area">
            {% if article.category %}
                <span class="badge-category">{{ article.category|upper }}</span>
            {% endif %}
            <h1>{{ article.title }}</h1>
            <div class="article-meta">
                <span class="meta-item"><i class="fa-regular fa-calendar-check"></i> {{ article.publishedAt|date('d/m/Y') }}</span>
                <span class="meta-item"><i class="fa-regular fa-clock"></i> 3 min de lecture</span>
            </div>
        </div>
    </div>
</header>

    {# --- CONTENU DE L'ARTICLE --- #}
    <section class="article-body-wrapper">
        <div class="article-content-container">

            <a href="{{ path('actualites') }}" class="back-to-news">
                <i class="fa-solid fa-arrow-left-long"></i> Retour aux actualités
            </a>

            {# Corps de l'article #}
            {% if article.description %}
                <div class="article-main-content">
                    {{ article.description|raw }}
                </div>
            {% endif %}

            {# =========================
               Préparation des URLs de partage
               ========================= #}
            {% set articleUrl = absolute_url(path('article_show', {'id': article.id})) %}
            {% set shareTitle = article.title ~ ' | CHM Saleux' %}

            {% set facebookShareUrl = 'https://www.facebook.com/sharer/sharer.php?u=' ~ (articleUrl|url_encode) %}
            {% set xShareUrl = 'https://twitter.com/intent/tweet?url=' ~ (articleUrl|url_encode) ~ '&text=' ~ (shareTitle|url_encode) %}
            {% set whatsappShareUrl = 'https://wa.me/?text=' ~ ((shareTitle ~ ' ' ~ articleUrl)|url_encode) %}

            {# Footer d'article #}
            <footer class="article-footer">
                <div class="share-box">
                    <span>Partager cet article :</span>
                    <div class="share-links">
                        <a href="{{ facebookShareUrl }}"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Partager sur Facebook"
                           title="Partager sur Facebook">
                            <i class="fa-brands fa-facebook-f"></i>
                        </a>

                        <a href="{{ xShareUrl }}"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Partager sur X"
                           title="Partager sur X">
                            <i class="fa-brands fa-x-twitter"></i>
                        </a>

                        <a href="{{ whatsappShareUrl }}"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Partager sur WhatsApp"
                           title="Partager sur WhatsApp">
                            <i class="fa-brands fa-whatsapp"></i>
                        </a>
                    </div>
                </div>
            </footer>

        </div>
    </section>

</main>
{% endblock %}