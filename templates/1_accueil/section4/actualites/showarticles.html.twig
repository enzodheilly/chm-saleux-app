{% extends 'base.html.twig' %}

{% block title %}{{ article.title }} - CHM Saleux{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/accueil/section4/actualites/showarticles.css') }}">
{% endblock %}

{% block body %}
<main class="article-root">

    {# --- HEADER DE L'ARTICLE --- #}
    <header class="article-hero">
        {% if article.photo %}
            <div class="hero-bg" style="background-image: url('{{ asset('uploads/' ~ article.photo) }}');"></div>
        {% endif %}
        <div class="hero-overlay"></div>
        
        <div class="container hero-content">
            <nav class="article-breadcrumb">
                <a href="{{ path('home') }}">Accueil</a>
                <i class="fa-solid fa-chevron-right"></i>
                <a href="{{ path('actualites') }}">Actualités</a>
            </nav>

            <div class="title-area">
                {% if article.category %}
                    <span class="badge-category">{{ article.category|upper }}</span>
                {% endif %}
                <h1>{{ article.title }}</h1>
                <div class="article-meta">
                    <span class="meta-item"><i class="fa-regular fa-calendar-check"></i> {{ article.publishedAt|date('d/m/Y') }}</span>
                    <span class="meta-item"><i class="fa-regular fa-clock"></i> 3 min de lecture</span>
                </div>
            </div>
        </div>
    </header>

    {# --- CONTENU DE L'ARTICLE --- #}
    <section class="article-body-wrapper">
        <div class="container-narrow">
            
            <a href="{{ path('actualites') }}" class="back-to-news">
                <i class="fa-solid fa-arrow-left-long"></i> Retour aux actualités
            </a>

            {# Corps de l'article #}
        {# On remplace article.content par article.description #}
{% if article.description %}
    <div class="article-main-content">
        {{ article.description|raw }}
    </div>
{% endif %}

            {# Footer d'article #}
            <footer class="article-footer">
                <div class="share-box">
                    <span>Partager cet article :</span>
                    <div class="share-links">
                        <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#"><i class="fa-brands fa-x-twitter"></i></a>
                        <a href="#"><i class="fa-brands fa-whatsapp"></i></a>
                    </div>
                </div>
            </footer>

        </div>
    </section>

</main>
{% endblock %}