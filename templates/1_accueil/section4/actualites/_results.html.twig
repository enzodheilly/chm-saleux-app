{% if articles is not empty %}
    <div class="arc-grid">
        {% for article in articles %}
            <a href="{{ path('article_show', {'id': article.id}) }}" class="arc-card">
                <div class="arc-card-media">
                    <img
                        class="arc-card-img"
                        src="{{ article.photo ? asset('uploads/' ~ article.photo) : asset('images/article.jpg') }}"
                        alt="{{ article.title }}"
                        loading="lazy"
                        draggable="false">
                </div>
                <div class="arc-card-body">
                    <span class="arc-card-eyebrow">{{ article.category ? article.category.name|capitalize : 'Info' }}</span>
                    <h4 class="arc-card-title">{{ article.title }}</h4>
                    {% if article.description %}
                        <p class="arc-card-excerpt">{{ article.description|striptags|slice(0, 110) }}…</p>
                    {% endif %}
                    <div class="arc-card-footer">
                        <span class="arc-card-date">{{ article.publishedAt|date('d/m/Y') }}</span>
                    </div>
                </div>
            </a>
        {% endfor %}
    </div>

    {% if totalPages > 1 %}
        <div class="pagination-elite mt-5">
            {% set query = filters %}

            <a href="{{ page > 1 ? path('actualites', query|merge({'page': page - 1})) : '#' }}"
               class="page-btn {{ page <= 1 ? 'disabled' : '' }}">
                <i class="fa-solid fa-chevron-left"></i>
            </a>

            {% for i in 1..totalPages %}
                <a href="{{ path('actualites', query|merge({'page': i})) }}"
                   class="page-btn {{ i == page ? 'active' : '' }}">
                    {{ i }}
                </a>
            {% endfor %}

            <a href="{{ page < totalPages ? path('actualites', query|merge({'page': page + 1})) : '#' }}"
               class="page-btn {{ page >= totalPages ? 'disabled' : '' }}">
                <i class="fa-solid fa-chevron-right"></i>
            </a>
        </div>
    {% endif %}
{% else %}
    <div class="empty-news">
        <i class="fa-solid fa-newspaper"></i>
        <h3>Aucun article trouvé</h3>
        <p>Modifiez vos filtres pour voir d'autres résultats.</p>
    </div>
{% endif %}