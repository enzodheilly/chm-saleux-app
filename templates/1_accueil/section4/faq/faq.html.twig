{% extends 'base.html.twig' %}

{% block title %}FAQ - CHM Saleux
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/accueil/section4/faq/faq.css') }}">
{% endblock %}

{% block body %}

	<header class="hero-header">
		<div class="overlay"></div>
		<div class="hero-content">
			<h1>Comment pouvons-nous
<span>vous aider ?</span></h1>
		</div>
		
	</header>

<div class="hero-transition-image">
    <img src="{{ asset('images/club/faq.jpg') }}" alt="Transition image">
</div>

	<section class="test">
	    <p>
        Retrouvez ici les réponses aux questions les plus fréquentes posées par les membres 
        et futurs adhérents du CHM Saleux. Notre objectif est de vous guider et de vous aider 
        à trouver rapidement l’information dont vous avez besoin : abonnement, entraînement, 
        équipements, compétitions ou encore démarches pratiques.
    </p>
	</section>

<div class="img-wrapper">
    <div class="img">
<img src="{{ asset('images/club/ok.jpg') }}" style="display:none;" id="preloadHero">
    </div>
</div>

		<header class="contact-header">
    <h1>Foire Aux Questions</h1>
    <p>Trouvez ici les réponses à vos questions ou contactez-nous pour toute demande d'information.</p>
</header>


	<!-- SECTION FAQ -->
	<section class="faq-container">
		<div class="faq-sidebar">
			<h3>CHOISISSEZ<br>VOTRE
				<span>SUJET</span>
			</h3>
			<ul>
				<li class="active" data-section="questions">
					<a href="#">Questions Fréquemment Posées</a>
				</li>
				<li data-section="abonnement">
					<a href="#">Mon Abonnement</a>
				</li>
				<li data-section="entrainement">
					<a href="#">Entraînement & Coaching</a>
				</li>
				<li data-section="installations">
					<a href="#">Installations</a>
				</li>
				<li data-section="competition">
					<a href="#">Compétition & Événements</a>
				</li>
				<li data-section="autres">
					<a href="#">Autres</a>
				</li>
			</ul>
		</div>

		<!-- SECTION : Questions fréquentes -->
		<div class="faq-content" data-section="questions">
			<h2>Questions Fréquemment Posées</h2>

			<div class="faq-item">
				<div class="faq-question">Faut-il une expérience avant de s’inscrire ?
					<span>+</span>
				</div>
				<div class="faq-answer">Pas du tout ! Le CHM Saleux accueille les débutants comme les confirmés. Nos coachs vous accompagnent selon votre niveau.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Puis-je faire une séance d’essai ?
					<span>+</span>
				</div>
				<div class="faq-answer">Oui, une séance d’essai gratuite est disponible sur rendez-vous. C’est idéal pour découvrir le club et l’ambiance.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Y a-t-il des coachs disponibles tout le temps ?
					<span>+</span>
				</div>
				<div class="faq-answer">Un coach diplômé est présent sur les horaires principaux pour encadrer, conseiller et garantir la sécurité des pratiquants.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Les femmes peuvent-elles s’inscrire ?
					<span>+</span>
				</div>
				<div class="faq-answer">Bien sûr ! De nombreuses adhérentes s’entraînent régulièrement au CHM Saleux dans une ambiance respectueuse et motivante.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Proposez-vous des tarifs étudiants ?
					<span>+</span>
				</div>
				<div class="faq-answer">Oui, des réductions sont disponibles pour les étudiants et les jeunes de moins de 21 ans.</div>
			</div>
		</div>

		<!-- SECTION : Mon Abonnement -->
		<div class="faq-content" data-section="abonnement" style="display:none;">
			<h2>Mon Abonnement</h2>

			<div class="faq-item">
				<div class="faq-question">Quels abonnements proposez-vous ?
					<span>+</span>
				</div>
				<div class="faq-answer">Nous proposons deux formules principales :
					<br>• Loisir Musculation & Haltérophilie<br>• Compétition (8-13 ans, 14-20 ans, +21 ans)</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Puis-je mettre mon abonnement en pause ?
					<span>+</span>
				</div>
				<div class="faq-answer">Oui, il est possible de suspendre votre abonnement pour une durée minimale d’un mois (maladie, vacances, etc.).</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Quels moyens de paiement acceptez-vous ?
					<span>+</span>
				</div>
				<div class="faq-answer">Carte bancaire, espèces et prélèvements automatiques sont acceptés pour les abonnements annuels.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Puis-je changer de formule en cours d’année ?
					<span>+</span>
				</div>
				<div class="faq-answer">Oui, il est possible de passer d’un abonnement Loisir à un abonnement Compétition sur simple demande.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Les licences sont-elles incluses dans le tarif ?
					<span>+</span>
				</div>
				<div class="faq-answer">Les licences fédérales sont incluses pour les adhérents Compétition et en option pour les adhérents Loisir.</div>
			</div>
		</div>

		<!-- SECTION : Entraînement & Coaching -->
		<div class="faq-content" data-section="entrainement" style="display:none;">
			<h2>Entraînement & Coaching</h2>

			<div class="faq-item">
				<div class="faq-question">Les coachs sont-ils diplômés ?
					<span>+</span>
				</div>
				<div class="faq-answer">Oui, tous nos coachs sont diplômés d’État et formés à l’encadrement en musculation et en haltérophilie.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Proposez-vous des programmes personnalisés ?
					<span>+</span>
				</div>
				<div class="faq-answer">Oui, un programme sur mesure peut être établi selon vos objectifs : prise de masse, perte de poids, force, compétition, etc.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Puis-je m’entraîner seul ?
					<span>+</span>
				</div>
				<div class="faq-answer">Oui, les adhérents Loisir ont accès libre à la salle pendant les horaires d’ouverture pour un entraînement autonome.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Comment se déroule une séance d’haltérophilie ?
					<span>+</span>
				</div>
				<div class="faq-answer">Une séance comprend un échauffement, un travail technique (arraché / épaulé-jeté) et un renforcement musculaire complémentaire.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Puis-je suivre mes performances ?
					<span>+</span>
				</div>
				<div class="faq-answer">Oui, nous proposons des suivis personnalisés et vous pouvez utiliser vos montres ou applications connectées.</div>
			</div>
		</div>

		<!-- SECTION : Installations -->
		<div class="faq-content" data-section="installations" style="display:none;">
			<h2>Installations</h2>

			<div class="faq-item">
				<div class="faq-question">Quels équipements sont disponibles ?
					<span>+</span>
				</div>
				<div class="faq-answer">Racks, barres olympiques, haltères, bancs, kettlebells, machines guidées et un espace cardio complet.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Avez-vous une zone d’haltérophilie dédiée ?
					<span>+</span>
				</div>
				<div class="faq-answer">Oui, nous disposons de plateformes officielles avec barres et disques adaptés à la compétition.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Disposez-vous de vestiaires et douches ?
					<span>+</span>
				</div>
				<div class="faq-answer">Oui, des vestiaires hommes/femmes séparés, douches, casiers et un espace détente sont à votre disposition.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Puis-je venir avec un ami non adhérent ?
					<span>+</span>
				</div>
				<div class="faq-answer">Oui, nous proposons un pass découverte pour venir s’entraîner avec un ami occasionnellement.</div>
			</div>
		</div>

		<!-- SECTION : Compétition -->
		<div class="faq-content" data-section="competition" style="display:none;">
			<h2>Compétition & Événements</h2>

			<div class="faq-item">
				<div class="faq-question">Organisez-vous des compétitions ?
					<span>+</span>
				</div>
				<div class="faq-answer">Oui, le CHM Saleux participe à de nombreuses compétitions régionales et nationales d’haltérophilie.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Y a-t-il un suivi spécifique pour les athlètes ?
					<span>+</span>
				</div>
				<div class="faq-answer">Oui, nos coachs accompagnent les athlètes tout au long de la saison avec une préparation adaptée.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Faites-vous des événements internes ?
					<span>+</span>
				</div>
				<div class="faq-answer">Oui, des challenges, portes ouvertes et initiations sont régulièrement organisés pour la communauté du club.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Puis-je assister à une compétition sans participer ?
					<span>+</span>
				</div>
				<div class="faq-answer">Bien sûr ! Les spectateurs sont toujours les bienvenus pour encourager les athlètes du CHM.</div>
			</div>
		</div>

		<!-- SECTION : Autres -->
		<div class="faq-content" data-section="autres" style="display:none;">
			<h2>Autres</h2>

			<div class="faq-item">
				<div class="faq-question">Comment contacter le CHM Saleux ?
					<span>+</span>
				</div>
				<div class="faq-answer">Vous pouvez nous joindre via Instagram, Facebook, WhatsApp ou directement à la salle.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Où se situe le club ?
					<span>+</span>
				</div>
				<div class="faq-answer">Le CHM Saleux se situe à Saleux (près d’Amiens), avec un parking gratuit pour les membres.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Proposez-vous des stages ou ateliers ?
					<span>+</span>
				</div>
				<div class="faq-answer">Oui, nous organisons des stages techniques et des journées de perfectionnement tout au long de l’année.</div>
			</div>

			<div class="faq-item">
				<div class="faq-question">Puis-je louer la salle pour un événement ?
					<span>+</span>
				</div>
				<div class="faq-answer">Sous certaines conditions, il est possible de privatiser la salle pour un stage ou une démonstration.</div>
			</div>
		</div>
	</section>


	<!-- SECTION CONTACT STYLE BASIC-FIT -->
	<section class="faq-contact-section basicfit-style">
		<div class="faq-contact-wrapper">
			<h2>VOTRE QUESTION N'EST PAS ICI ?</h2>
			<p>Alors contactez-nous et nous serons heureux de vous aider.</p>

			<div
				class="faq-contact-grid">
				<!-- Elios Live Chat -->
				<div class="contact-option">
					<a href="/elios" target="_blank" rel="noopener noreferrer">
						<div class="icon">
							<img src="{{ asset('images/accueil/section4/faq/ai-bot.png') }}" alt="Elios Bot IA">
						</div>
						<h3>Live chat (Elios)</h3>
						<span>Disponible 24h/24 🤖</span>
					</a>
				</div>

				<!-- WhatsApp -->
				<div class="contact-option">
					<a href="https://chat.whatsapp.com/TON_CODE_DE_GROUPE" target="_blank" rel="noopener noreferrer">
						<div class="icon">
							<img src="{{ asset('images/accueil/section4/faq/whatsapp1.png') }}" alt="WhatsApp">
						</div>
						<h3>WhatsApp</h3>
						<span>Réponse rapide aux horaires du club</span>
					</a>
				</div>

				<!-- Facebook -->
				<div class="contact-option">
					<a href="https://www.facebook.com/chmsaleux1/" target="_blank" rel="noopener noreferrer">
						<div class="icon">
							<img src="{{ asset('images/accueil/section4/faq/facebook1.png') }}" alt="Facebook">
						</div>
						<h3>Facebook</h3>
						<span>Réponse sous 2 jours</span>
					</a>
				</div>

				<!-- Instagram -->
				<div class="contact-option">
					<a href="https://www.instagram.com/chmsaleux/" target="_blank" rel="noopener noreferrer">
						<div class="icon">
							<img src="{{ asset('images/accueil/section4/faq/instagram1.png') }}" alt="Instagram">
						</div>
						<h3>Instagram</h3>
						<span>Suivez-nous & écrivez en DM</span>
					</a>
				</div>

				<!-- Formulaire -->
				<div class="contact-option">
					<a href="{{ path('contact') }}" target="_blank" rel="noopener noreferrer">
						<div class="icon">
							<img src="{{ asset('images/accueil/section4/faq/envelope.png') }}" alt="Contact">
						</div>
						<h3>Envoyer un message</h3>
						<span>Réponse sous 3 jours</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	 <script src="{{ asset('js/accueil/section4/faq/faq.js') }}" defer></script>

{% endblock %}
