{% extends 'base.html.twig' %}

{% block title %}Foire Aux Questions — CHM Saleux
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/accueil/section4/faq/faq.css') }}">
{% endblock %}

{% block body %}

	<header class="page-header-sport faq-header-bg">
		<div class="header-overlay-gradient"></div>
		<div class="header-content">
			<div class="page-container">
				{% include 'components/breadcrumb.html.twig' with { items: [{ label: 'FAQ' }] } %}
				<div class="header-main-box">
					<h1>Questions
						<span class="text-outline">Fréquentes</span>
					</h1>
					<p class="lead">Abonnements, entraînements, équipements... Toutes les réponses pour bien débuter.</p>
				</div>
			</div>
		</div>
	</header>

	<main class="page-shell faq-root">

		{# --- SECTION PRINCIPALE --- #}
		<section class="page-container section-spacer faq-main-section">

			<div class="faq-wm" aria-hidden="true">QUESTIONS</div>

			{# Filtres #}
			<div class="faq-nav-wrapper">
				<div class="faq-filters-scroll">
					<button class="filter-btn active" data-target="questions">Général</button>
					<button class="filter-btn" data-target="abonnement">Abonnement</button>
					<button class="filter-btn" data-target="entrainement">Entraînement</button>
					<button class="filter-btn" data-target="installations">Installations</button>
					<button class="filter-btn" data-target="competition">Compétition</button>
					<button class="filter-btn" data-target="autres">Divers</button>
				</div>
			</div>

			{# Accordéons #}
			<div class="faq-container">

				<div class="faq-group active" id="questions">
					<h2 class="group-title">Questions <span>Fréquentes</span></h2>
					<div class="accordion-elite">
						{% for faq in faqs | filter(f => f.categorie == 'questions') %}
							<div class="accordion-item">
								<div class="accordion-header">
									<span>{{ faq.question }}</span>
									<i class="fa-solid fa-plus"></i>
								</div>
								<div class="accordion-body">
									<p>{{ faq.reponse }}</p>
								</div>
							</div>
						{% endfor %}
					</div>
				</div>

				<div class="faq-group faq-group-hidden" id="abonnement">
					<h2 class="group-title">Mon <span>Abonnement</span></h2>
					<div class="accordion-elite">
						{% for faq in faqs | filter(f => f.categorie == 'abonnement') %}
							<div class="accordion-item">
								<div class="accordion-header">
									<span>{{ faq.question }}</span>
									<i class="fa-solid fa-plus"></i>
								</div>
								<div class="accordion-body">
									<p>{{ faq.reponse }}</p>
								</div>
							</div>
						{% endfor %}
					</div>
				</div>

				<div class="faq-group faq-group-hidden" id="entrainement">
					<h2 class="group-title">Mon <span>Entraînement</span></h2>
					<div class="accordion-elite">
						{% for faq in faqs | filter(f => f.categorie == 'entrainement') %}
							<div class="accordion-item">
								<div class="accordion-header">
									<span>{{ faq.question }}</span>
									<i class="fa-solid fa-plus"></i>
								</div>
								<div class="accordion-body">
									<p>{{ faq.reponse }}</p>
								</div>
							</div>
						{% endfor %}
					</div>
				</div>

				<div class="faq-group faq-group-hidden" id="installations">
					<h2 class="group-title">Nos <span>Installations</span></h2>
					<div class="accordion-elite">
						{% for faq in faqs | filter(f => f.categorie == 'installations') %}
							<div class="accordion-item">
								<div class="accordion-header">
									<span>{{ faq.question }}</span>
									<i class="fa-solid fa-plus"></i>
								</div>
								<div class="accordion-body">
									<p>{{ faq.reponse }}</p>
								</div>
							</div>
						{% endfor %}
					</div>
				</div>

				<div class="faq-group faq-group-hidden" id="competition">
					<h2 class="group-title">La <span>Compétition</span></h2>
					<div class="accordion-elite">
						{% for faq in faqs | filter(f => f.categorie == 'competition') %}
							<div class="accordion-item">
								<div class="accordion-header">
									<span>{{ faq.question }}</span>
									<i class="fa-solid fa-plus"></i>
								</div>
								<div class="accordion-body">
									<p>{{ faq.reponse }}</p>
								</div>
							</div>
						{% endfor %}
					</div>
				</div>

				<div class="faq-group faq-group-hidden" id="autres">
					<h2 class="group-title">Questions <span>Diverses</span></h2>
					<div class="accordion-elite">
						{% for faq in faqs | filter(f => f.categorie == 'autres') %}
							<div class="accordion-item">
								<div class="accordion-header">
									<span>{{ faq.question }}</span>
									<i class="fa-solid fa-plus"></i>
								</div>
								<div class="accordion-body">
									<p>{{ faq.reponse }}</p>
								</div>
							</div>
						{% endfor %}
					</div>
				</div>

			</div>
		</section>

		{# --- BARRE DE CONTACT --- #}
		<section class="bg-dark-alternate section-spacer">
			<div class="page-container text-center">
				<h2 class="section-heading centered faq-contact-title">Toujours
					<span>une question ?</span>
				</h2>
				<div class="contact-bar-elite">
					<a href="{{ path('contact') }}" class="contact-circle" title="Email">
						<i class="fa-solid fa-envelope"></i>
					</a>
					<a href="https://chat.whatsapp.com/..." class="contact-circle whatsapp" title="WhatsApp">
						<i class="fa-brands fa-whatsapp"></i>
					</a>
					<a href="https://instagram.com/chmsaleux" class="contact-circle instagram" title="Instagram">
						<i class="fa-brands fa-instagram"></i>
					</a>
					<a href="https://facebook.com/chmsaleux1" class="contact-circle facebook" title="Facebook">
						<i class="fa-brands fa-facebook-f"></i>
					</a>
				</div>
			</div>
		</section>

	</main>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('js/accueil/section4/faq/faq.js') }}"></script>
{% endblock %}
