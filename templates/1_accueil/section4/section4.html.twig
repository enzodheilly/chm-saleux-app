{# ── SECTION : DERNIÈRES ACTUALITÉS ── #}
<section class="home-news-section">
	<div class="container">

		<div class="section-header-elite">
			<div class="header-text">
				<h2 class="section-title">Dernières
					<span class="text-outline">Actualités</span>
				</h2>
			</div>
			<a href="{{ path('actualites') }}" class="btn-link-all">
				Voir tout le journal
				<i class="fa-solid fa-arrow-right"></i>
			</a>
		</div>

		<div class="news-grid-home">
			{% for article in articles|slice(0, 3) %}
				<article class="news-card-minimal">
					<a href="{{ path('article_show', { id: article.id }) }}" class="card-anchor">
						<div class="card-img-container">
							{% if article.photo %}
								<img src="{{ asset('uploads/' ~ article.photo) }}" alt="{{ article.title }}" loading="lazy">
							{% else %}
								<img src="{{ asset('images/article.jpg') }}" alt="CHM Saleux">
							{% endif %}
							<div class="card-overlay">
								<span class="info-date">{{ article.publishedAt|date('d/m/Y') }}</span>
								<h3 class="info-title">
									{{ article.title|length > 55 ? article.title|slice(0, 55) ~ '...' : article.title }}
								</h3>
								<p class="info-excerpt">
									{{ article.description|striptags|length > 80 ? article.description|striptags|slice(0, 80) ~ '...' : article.description }}
								</p>
								<span class="info-more">Lire l'article <i class="fa-solid fa-chevron-right"></i></span>
							</div>
						</div>
					</a>
				</article>
			{% else %}
				<div class="empty-news-minimal">
					<p>De nouvelles actualités arrivent bientôt !</p>
				</div>
			{% endfor %}
		</div>

	</div>
</section>
