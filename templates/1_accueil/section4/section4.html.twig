{# ── SECTION : DERNIÈRES ACTUALITÉS ── #}
<section class="hm-news">
	<div class="hm-news-head">
		<div>
			<span class="hm-label">Actualités</span>
			<h2 class="hm-title">Dernières <span class="hm-orange">nouvelles</span></h2>
		</div>
		<a href="{{ path('actualites') }}" class="hm-btn hm-btn--outline">Tout voir <i class="fa-solid fa-arrow-right"></i></a>
	</div>

	<div class="hm-news-list">
		{% for article in articles|slice(0, 3) %}
		<a href="{{ path('article_show', { id: article.id }) }}" class="hm-news-row">
			<div class="hm-news-row-content">
				<span class="hm-news-date">{{ article.publishedAt|date('d/m/Y') }}</span>
				<h3 class="hm-news-row-title">{{ article.title|length > 70 ? article.title|slice(0, 70) ~ '…' : article.title }}</h3>
				<p class="hm-news-row-excerpt">{{ article.description|striptags|length > 100 ? article.description|striptags|slice(0, 100) ~ '…' : article.description|striptags }}</p>
				<span class="hm-news-more">Lire l'article <i class="fa-solid fa-arrow-right"></i></span>
			</div>
			<div class="hm-news-row-img">
				{% if article.photo %}
					<img src="{{ asset('uploads/' ~ article.photo) }}" alt="{{ article.title }}" loading="lazy">
				{% else %}
					<img src="{{ asset('images/article.jpg') }}" alt="CHM Saleux">
				{% endif %}
			</div>
		</a>
		{% else %}
			<p class="hm-news-empty">De nouvelles actualités arrivent bientôt.</p>
		{% endfor %}
	</div>
</section>
