{# ── NOUVEAUX ÉQUIPEMENTS ── #}
<section class="hm-equip">
	<div class="hm-equip-head">
		<div>
			<span class="hm-label">Nos équipements</span>
			<h2 class="hm-title">Toujours plus <span class="hm-orange">performant</span></h2>
			<p class="hm-equip-intro">Chaque année, le club investit dans du nouveau matériel pour vous offrir les meilleures conditions d'entraînement. Machines guidées, poids libres, équipements olympiques — tout est pensé pour votre progression.</p>
		</div>
		<div class="hm-equip-arrows">
			<button class="hm-arrow" id="equipPrev"><i class="fa-solid fa-chevron-left"></i></button>
			<button class="hm-arrow" id="equipNext"><i class="fa-solid fa-chevron-right"></i></button>
		</div>
	</div>
	{% if newEquipments is not empty %}
		<div class="hm-equip-wrap">
			<div class="hm-equip-track" id="equipTrack">
				{% for equipment in newEquipments %}
					<article class="hm-equip-card">
						<img src="{{ asset('uploads/machines/' ~ equipment.image) }}" alt="{{ equipment.name }}" class="hm-equip-card-img" loading="lazy">
						<div class="hm-equip-card-overlay"></div>
						<div class="hm-equip-card-body">
							<span class="hm-equip-badge">Nouveauté</span>
							<h3 class="hm-equip-card-name">{{ equipment.name }}</h3>
						</div>
					</article>
				{% endfor %}
			</div>
		</div>
	{% else %}
		<p class="hm-equip-empty">Aucun équipement pour le moment.</p>
	{% endif %}
</section>
