<section class="equipment-section">
  <div class="equipment-container">

    
    <div class="equipment-layout">
      
      <div class="equipment-info">
        <div class="sticky-wrapper">
          <h2 class="section-title">NOS NOUVEAUX <span class="text-highlight">ÉQUIPEMENTS</span></h2>
          <p class="section-desc">
            Nous investissons chaque année pour vous offrir le meilleur. Ergonomie, biomecanique et design : découvrez les dernières arrivées au club.
          </p>

          <ul class="benefits-list">
            <li>
              <span class="icon">⚡</span>
              <div>
                <strong>Innovation continue</strong>
                <small>Matériel renouvelé régulièrement.</small>
              </div>
            </li>
            <li>
              <span class="icon">🎯</span>
              <div>
                <strong>Performance & Confort</strong>
                <small>Mouvements fluides et précis.</small>
              </div>
            </li>
            <li>
              <span class="icon">🛡️</span>
              <div>
                <strong>Sécurité maximale</strong>
                <small>Adapté aux débutants et pros.</small>
              </div>
            </li>
          </ul>
          
   <div class="scroll-indicator" aria-hidden="true">
  <span>Glissez pour voir</span> &rarr;
</div>

        </div>
      </div>

      <div class="equipment-gallery">
        <div class="gallery-track">
          
          {% for machine in machines %}
            <article class="machine-card">
              <div class="image-box">
                <img src="{{ asset('uploads/machines/' ~ machine.image) }}" alt="{{ machine.name }}" loading="lazy">
                <div class="card-overlay"></div>
              </div>
              <div class="machine-info">
                <h3>{{ machine.name }}</h3>
                <span class="category">Nouveauté</span>
              </div>
            </article>
          {% endfor %}

          <article class="machine-card last-card">
            <div class="last-content">
              <h3>Venez les tester</h3>
              <a href="#" class="btn-test">Séance d'essai</a>
            </div>
          </article>

        </div>
      </div>

    </div>
  </div>
</section>