{# --- SECTION : ÉQUIPEMENTS — REFONTE --- #}
<section class="equipment-section">
	<div class="container equip-inner">

		<div
			class="equip-layout">

			{# ── Colonne gauche sticky ── #}
			<aside class="equip-info">
				<div class="equip-sticky">

					<div class="cc-eyebrow">
						<span class="cc-eyebrow-line"></span>
						Équipements
					</div>

					<h2 class="equip-title">
						Nos nouveaux<br>
						<em>équipements</em>
					</h2>

					<p class="equip-desc">
						Nous investissons chaque année pour vous offrir le meilleur.
																								            Ergonomie, biomécanique et design — découvrez les dernières arrivées au club.
					</p>

					<ul class="equip-benefits">
						<li class="equip-benefit">
							<span class="equip-benefit-icon">
								<i class="fa-solid fa-bolt"></i>
							</span>
							<div class="equip-benefit-text">
								<strong>Innovation continue</strong>
								<span>Matériel renouvelé régulièrement.</span>
							</div>
						</li>
						<li class="equip-benefit">
							<span class="equip-benefit-icon">
								<i class="fa-solid fa-crosshairs"></i>
							</span>
							<div class="equip-benefit-text">
								<strong>Performance & Confort</strong>
								<span>Mouvements fluides et précis.</span>
							</div>
						</li>
						<li class="equip-benefit">
							<span class="equip-benefit-icon">
								<i class="fa-solid fa-shield-halved"></i>
							</span>
							<div class="equip-benefit-text">
								<strong>Sécurité maximale</strong>
								<span>Adapté aux débutants et aux pros.</span>
							</div>
						</li>
					</ul>

					<div class="equip-scroll-hint" aria-hidden="true">
						<span class="equip-scroll-line"></span>
						<span>Glissez pour voir</span>
						<i class="fa-solid fa-arrow-right"></i>
					</div>

				</div>
			</aside>

			{# ── Galerie droite ── #}
			<div class="equip-gallery">
				<div class="equip-track">

					{% for equipment in newEquipments %}
						<article class="equip-card">
							<div class="equip-card-img">
								<img src="{{ asset('uploads/machines/' ~ equipment.image) }}" alt="{{ equipment.name }}" loading="lazy">
								<div class="equip-card-overlay"></div>
							</div>
							<div class="equip-card-body">
								<span class="equip-badge">Nouveauté</span>
								<h3 class="equip-card-title">{{ equipment.name }}</h3>
							</div>
							<div class="equip-card-corner"></div>
						</article>
					{% endfor %}

					{# Dernière carte CTA #}
					<article class="equip-card equip-card--cta">
						<span class="equip-cta-bg-text" aria-hidden="true">TRY</span>
						<div class="equip-cta-body">
							<h3 class="equip-cta-title">
								Venez les<br>
								<em>tester</em>
							</h3>
							<a href="{{ path('seance_essai') }}" class="btn-elite equip-cta-btn">
								Séance d'essai
								<i class="fa-solid fa-arrow-right"></i>
							</a>
						</div>
					</article>

				</div>
			</div>

		</div>
	</div>
</section>
