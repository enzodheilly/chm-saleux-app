{# ── FAQ ── #}
<section class="hm-faq">

	<div class="hm-faq-watermark" aria-hidden="true">FAQ</div>

	{# ── GAUCHE : accordéon ── #}
	<div class="hm-faq-col-questions">

		<div class="hm-faq-list">
			{% for faq in faqHome %}
				<details class="hm-faq-item">
					<summary class="hm-faq-question">
						<span>{{ faq.question }}</span>
						<span class="hm-faq-icon"><i class="fa-solid fa-plus"></i></span>
					</summary>
					<div class="hm-faq-answer">
						<p>{{ faq.reponse | nl2br }}</p>
					</div>
				</details>
			{% endfor %}
		</div>

		<a href="{{ path('faq') }}" class="hm-faq-see-all">
			Voir toutes les questions <i class="fa-solid fa-arrow-right"></i>
		</a>
	</div>

	{# ── DROITE : contact direct ── #}
	<div class="hm-faq-col-cta">
		<div class="hm-faq-contact-card">
			<h3 class="hm-faq-contact-title">Toujours pas<br>de réponse ?</h3>
			<p class="hm-faq-contact-desc">Pour toute question ou problème, n'hésitez pas à nous écrire, notre équipe vous répond dans les 24 à 48h.</p>
			<a href="{{ path('contact') }}" class="hm-btn hm-btn--orange">
				Nous écrire
			</a>
		</div>
	</div>

</section>

<script nonce="{{ csp_nonce('script') }}">
(function() {
	var section = document.querySelector('.hm-faq');
	var wm = document.querySelector('.hm-faq-watermark');
	if (!section || !wm) return;
	var obs = new IntersectionObserver(function(entries) {
		if (entries[0].isIntersecting) { wm.classList.add('is-visible'); obs.disconnect(); }
	}, { threshold: 0.15 });
	obs.observe(section);
})();
</script>
