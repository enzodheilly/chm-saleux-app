{# ── APPLICATION MOBILE ── #}
<section class="app-section">

	{# Glow décoratif #}
	<div class="app-glow" aria-hidden="true"></div>

	{# ── CONTENU GAUCHE ── #}
	<div class="app-content">
		<span class="hm-label">Notre application</span>
		<h2 class="hm-title hm-title--light">Votre club,<br>dans votre <span class="hm-orange">poche</span></h2>
		<p class="hm-text hm-text--light">Gérez vos entraînements, suivez vos progrès et restez connecté au club où que vous soyez.</p>

		<div class="app-features">
			<div class="app-feature">
				<div class="app-feature-icon"><i class="fa-solid fa-chart-line"></i></div>
				<div>
					<div class="app-feature-title">Suivi des performances</div>
					<div class="app-feature-sub">Historique complet de vos séances</div>
				</div>
			</div>
			<div class="app-feature">
				<div class="app-feature-icon"><i class="fa-solid fa-dumbbell"></i></div>
				<div>
					<div class="app-feature-title">Programmes personnalisés</div>
					<div class="app-feature-sub">Adaptés à votre niveau et vos objectifs</div>
				</div>
			</div>
			<div class="app-feature">
				<div class="app-feature-icon"><i class="fa-solid fa-id-card"></i></div>
				<div>
					<div class="app-feature-title">Espace membre</div>
					<div class="app-feature-sub">Licence, abonnement, documents</div>
				</div>
			</div>
			<div class="app-feature">
				<div class="app-feature-icon"><i class="fa-solid fa-bell"></i></div>
				<div>
					<div class="app-feature-title">Actualités en temps réel</div>
					<div class="app-feature-sub">Compétitions, événements, news club</div>
				</div>
			</div>
		</div>

		<div class="app-actions">
			{% if app.user %}
				<a href="{{ path('dashboard') }}" class="hm-btn hm-btn--orange">Mon espace <i class="fa-solid fa-arrow-right"></i></a>
			{% else %}
				<a href="{{ path('app_auth_choice') }}" class="hm-btn hm-btn--orange">Créer mon compte <i class="fa-solid fa-arrow-right"></i></a>
				<a href="{{ path('app_login') }}" class="hm-btn hm-btn--ghost">Connexion</a>
			{% endif %}
		</div>
	</div>

	{# ── VISUEL DROIT ── #}
	<div class="app-visual">
		<div class="app-mockup-wrap">
			<img src="{{ asset('images/mockup2.png') }}" alt="Application CHM Saleux" class="app-mockup">
		</div>
	</div>

</section>
