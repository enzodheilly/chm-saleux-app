{# ── APPLICATION MOBILE ── #}
<section class="app-section">

	<div class="app-watermark" aria-hidden="true">APPLICATION<br>MOBILE</div>


	{# ── Colonne gauche : texte ── #}
	<div class="app-copy">

		<p class="app-lead">Vous pourrez bientôt gérer vos entraînements, suivre vos progrès et rester connecté au club, où que vous soyez.</p>

		<ul class="app-benefits">
			<li class="app-benefit">
				<i class="fa-solid fa-circle-check app-benefit-icon"></i>
				<div>
					<strong>Suivi des performances</strong>
					<span>Historique complet de vos séances et records personnels</span>
				</div>
			</li>
			<li class="app-benefit">
				<i class="fa-solid fa-circle-check app-benefit-icon"></i>
				<div>
					<strong>Programmes personnalisés</strong>
					<span>Adaptés à votre niveau, vos objectifs et votre planning</span>
				</div>
			</li>
			<li class="app-benefit">
				<i class="fa-solid fa-circle-check app-benefit-icon"></i>
				<div>
					<strong>Espace membre complet</strong>
					<span>Licence, abonnement et documents en un clic</span>
				</div>
			</li>
		</ul>

		<div class="app-stores">
			<span class="app-store-badge app-store-badge--disabled" aria-disabled="true">
				<i class="fa-brands fa-apple"></i>
				<div class="app-store-label">
					<span>Télécharger sur</span>
					<strong>App Store</strong>
				</div>
			</span>
			<span class="app-store-badge app-store-badge--disabled" aria-disabled="true">
				<i class="fa-brands fa-google-play"></i>
				<div class="app-store-label">
					<span>Disponible sur</span>
					<strong>Google Play</strong>
				</div>
			</span>
		</div>
	</div>

	{# ── Colonne droite : carousel mockups ── #}
	<div class="app-visual">

		<div class="app-carousel-wrapper">
			<div class="app-carousel-track">

				<!--
					SPOTLIGHT SVG — triangle inversé (faisceau) + ellipse (flaque au sol).
					SVG feGaussianBlur : region étendue → bords vraiment doux, pas clippés.
					viewBox 1000×642 : 1000 unités de large, 642 = hauteur exacte du track.
				-->

				<div class="app-slide is-active" data-index="0">
					<img src="{{ asset('images/mockup-screen-1.png') }}" alt="Accueil application CHM Saleux" loading="lazy">
				</div>

				<div class="app-slide" data-index="1">
					<img src="{{ asset('images/mockup-screen-2.png') }}" alt="Statistiques application CHM Saleux" loading="lazy">
				</div>

				<div class="app-slide" data-index="2">
					<img src="{{ asset('images/mockup-screen-3.png') }}" alt="Programme application CHM Saleux" loading="lazy">
				</div>

			</div>
		</div>

	</div>

	{# ── Ligne de bas : note + dots ── #}
	<div class="app-bottom-row">
		<p class="app-stores-note">
			<i class="fa-regular fa-clock"></i>
			Disponible prochainement sur iOS et Android
		</p>
		<div class="app-dots">
			<span class="app-dot app-dot--active" data-index="0" role="button" aria-label="Écran 1"></span>
			<span class="app-dot" data-index="1" role="button" aria-label="Écran 2"></span>
			<span class="app-dot" data-index="2" role="button" aria-label="Écran 3"></span>
		</div>
	</div>

	{# ── Mobile uniquement : note sous les btns + dots sous le carousel ── #}
	<p class="app-stores-note app-stores-note--mobile">
		<i class="fa-regular fa-clock"></i>
		Disponible prochainement
	</p>
	<div class="app-dots app-dots--mobile">
		<span class="app-dot app-dot--active" data-index="0" role="button" aria-label="Écran 1"></span>
		<span class="app-dot" data-index="1" role="button" aria-label="Écran 2"></span>
		<span class="app-dot" data-index="2" role="button" aria-label="Écran 3"></span>
	</div>

	<script nonce="{{ csp_nonce('script') }}">
	(function() {
		var section = document.querySelector('.app-section');
		var el = document.querySelector('.app-watermark');
		if (!section || !el) return;
		var obs = new IntersectionObserver(function(entries) {
			if (entries[0].isIntersecting) {
				el.classList.add('is-visible');
				obs.disconnect();
			}
		}, { threshold: 0.2 });
		obs.observe(section);

		var mist = section.querySelector('.app-mist');
		if (mist) mist.playbackRate = 0.65;
		if (mist) mist.addEventListener('loadedmetadata', function() { mist.playbackRate = 0.65; });

	})();
	</script>

</section>
