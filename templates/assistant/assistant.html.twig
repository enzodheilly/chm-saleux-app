<style>
/* ==========================================
   Assistant "Elios" — Nouvelle version pro
   ========================================== */:root
{
	--elios-blue: #2563eb;
	--elios-blue-light: #eff6ff;
	--elios-border: #e5e7eb;
	--elios-gray: #f9fafb;
	--elios-text: #111827;
	--elios-muted: #6b7280;
	--elios-radius: 16px;
	--elios-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
	--elios-font: 'Inter', 'Poppins', sans-serif;
}

/* === Bouton flottant === */
.assistant-bubble {
	position: fixed;
	right: 24px;
	bottom: 24px;
	background: transparent;
	color: #fff;
	border-radius: 50px;
	padding: 12px 20px;
	font-weight: 600;
	cursor: pointer;
	box-shadow: 0 8px 20px rgba(37, 99, 235, 0.4);
	z-index: 1000;
	transition: transform 0.25s ease, box-shadow 0.25s ease;
	display: flex;
	align-items: center;
	gap: 6px;
}
.assistant-bubble:hover {
	transform: translateY(-3px);
	box-shadow: 0 12px 25px rgba(37, 99, 235, 0.5);
}

/* === Panneau principal === */
.assistant-panel {
	position: fixed;
	right: 24px;
	bottom: 90px;
	width: 400px; /* ← Augmente la largeur (avant : 340px) */
	background: #fff;
	border-radius: var(--elios-radius);
	box-shadow: var(--elios-shadow);
	border: 1px solid var(--elios-border);
	display: none;
	overflow: hidden;
	transition: all 0.3s ease;
	z-index: 1000;
}
.assistant-panel.open {
	display: block;
	animation: eliosFadeIn 0.25s ease;
}

/* === En-tête === */
.assistant-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 14px 18px;
	background: rgba(255, 255, 255, 0.7);
	backdrop-filter: blur(12px);
	-webkit-backdrop-filter: blur(12px);
	box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
	position: sticky;
	top: 0;
	z-index: 2;
	border: none;
	border-bottom: none !important; /* ✅ Supprime totalement le séparateur */
	border-top-left-radius: var(--elios-radius);
	border-top-right-radius: var(--elios-radius);
}

.assistant-header h3 {
	margin: 0;
	font-size: 1rem;
	font-weight: 700;
	color: var(--elios-text);
	font-family: var(--elios-font);
	display: flex;
	align-items: center;
	gap: 6px;
}
.assistant-header small {
	color: var(--elios-muted);
	font-weight: 500;
	font-size: 0.8rem;
}
.assistant-header .elios-logo {
	font-size: 1.2rem;
	color: var(--elios-blue);
}

/* === Corps === */
.assistant-body {
	background: var(--elios-gray);
	padding: 16px;
	max-height: 520px; /* ← avant : 420px */
	overflow-y: auto;
	font-family: var(--elios-font);
	font-size: 0.95rem;
	color: var(--elios-text);
}

/* === Message principal === */
.assistant-msg {
	background: #fff;
	border: 1px solid var(--elios-border);
	border-radius: var(--elios-radius);
	padding: 12px 14px;
	margin-bottom: 10px;
	line-height: 1.5;
	box-shadow: 0 2px 5px rgba(0, 0, 0, 0.03);
}
.assistant-msg strong {
	color: var(--elios-blue);
}

/* === Catégories === */
.assistant-categories {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 10px;
	margin-top: 12px;
}
.assistant-cat-btn {
	background: var(--elios-blue-light);
	color: var(--elios-blue);
	border: none;
	border-radius: 10px;
	padding: 10px 12px;
	font-weight: 600;
	cursor: pointer;
	font-family: var(--elios-font);
	font-size: 0.9rem;
	text-align: center;
	transition: background 0.2s ease, transform 0.15s ease;
}
.assistant-cat-btn:hover {
	background: #dbeafe;
	transform: translateY(-2px);
}

/* === Zone de chat === */
.assistant-chat-area {
	display: flex;
	flex-direction: column;
	gap: 8px;
	padding: 10px;
	background: var(--elios-gray);
	border-top: 1px solid var(--elios-border);
	border-bottom: 1px solid var(--elios-border);
	overflow-y: auto;
	height: 320px;
	max-height: 55vh;
	scroll-behavior: smooth;
}

/* Messages chat */
.assistant-msg {
	padding: 10px 14px;
	border-radius: 14px;
	line-height: 1.4;
	word-break: break-word;
	max-width: 85%;
	animation: msgPop 0.3s ease;
}
.assistant-msg.user {
	align-self: flex-end;
	background: var(--elios-blue);
	color: #fff;
	border: none;
	border-bottom-right-radius: 4px;
}
.assistant-msg.bot {
	align-self: flex-start;
	background: #fff;
	border: 1px solid var(--elios-border);
	border-bottom-left-radius: 4px;
}

/* === Animation apparition message === */
@keyframes msgPop {
	from {
		opacity: 0;
		transform: translateY(8px);
	}
	to {
		opacity: 1;
		transform: translateY(0);
	}
}

/* === Animation ouverture panneau === */
@keyframes eliosFadeIn {
	from {
		opacity: 0;
		transform: translateY(10px);
	}
	to {
		opacity: 1;
		transform: translateY(0);
	}
}

/* === Animation écriture === */
.assistant-typing {
	display: inline-flex;
	gap: 4px;
	align-items: center;
	padding: 6px 12px;
}
.assistant-typing span {
	width: 6px;
	height: 6px;
	border-radius: 50%;
	background: #94a3b8;
	opacity: 0.6;
	animation: blink 1.2s infinite;
}
.assistant-typing span:nth-child(2) {
	animation-delay: 0.15s;
}
.assistant-typing span:nth-child(3) {
	animation-delay: 0.3s;
}
@keyframes blink {
	0,
	80%,
	100% {
		opacity: 0.25;
	}
	40% {
		opacity: 1;
	}
}

/* === Entrée utilisateur === */
.assistant-chat-input {
	display: flex;
	align-items: center;
	gap: 8px;
	padding: 12px 16px;
	background: rgba(255, 255, 255, 0.8);
	backdrop-filter: blur(10px);
	-webkit-backdrop-filter: blur(10px);
	border: none;
	border-top: 1px solid rgba(229, 231, 235, 0.3);
	width: 100%; /* ✅ prend toute la largeur */
	box-sizing: border-box;
	margin: 0; /* ✅ évite les marges parasites */
	position: sticky;
	bottom: 0;
	z-index: 2;
}
.assistant-chat-input input {
	flex: 1;
	border: 1px solid var(--elios-border);
	border-radius: 20px;
	padding: 8px 12px;
	font-size: 0.9rem;
	font-family: var(--elios-font);
	outline: none;
	width: 100%;
	box-sizing: border-box;
}

.assistant-chat-input input:focus {
	border-color: var(--elios-blue);
	box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
}
.assistant-chat-input button {
	background: var(--elios-blue);
	border: none;
	color: #fff;
	border-radius: 50%;
	width: 36px;
	height: 36px;
	display: flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	transition: background 0.2s ease, transform 0.2s ease;
}
.assistant-chat-input button:hover {
	background: #1e40af;
	transform: scale(1.05);
}

/* === Scrollbar discrète === */
.assistant-body::-webkit-scrollbar,
.assistant-chat-area::-webkit-scrollbar {
	width: 6px;
}
.assistant-body::-webkit-scrollbar-thumb,
.assistant-chat-area::-webkit-scrollbar-thumb {
	background: rgba(0, 0, 0, 0.15);
	border-radius: 10px;
}

.elios-logo {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 34px;
	height: 34px;
	border-radius: 8px;
	background: radial-gradient(circle at center, rgba(37,99,235,0.1), transparent);
}

.elios-logo img {
	width: 26px;
	height: 26px;
	object-fit: contain;
	filter: drop-shadow(0 0 6px rgba(37, 99, 235, 0.5));
	transition: transform 0.3s ease;
}

.elios-logo img:hover {
	transform: scale(1.08);
}

.assistant-bubble {
	position: fixed;
	right: 24px;
	bottom: 24px;
	display: flex;
	align-items: center;
	gap: 8px;
	background: #fff;
	color: var(--elios-blue);
	border-radius: 50px;
	padding: 12px 20px;
	font-weight: 700;
	font-family: var(--elios-font);
	cursor: pointer;
	box-shadow: 0 8px 20px rgba(37, 99, 235, 0.25);
	z-index: 1000;
	transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.assistant-bubble:hover {
	transform: translateY(-3px);
	box-shadow: 0 12px 25px rgba(37, 99, 235, 0.35);
}

.elios-bubble-logo {
	width: 22px;
	height: 22px;
	object-fit: contain;
	filter: drop-shadow(0 0 6px rgba(37, 99, 235, 0.4));
}


/* === Responsive === */
@media(max-width: 480px) {
	.assistant-panel {
		right: 10px;
		bottom: 80px;
		width: calc(100% - 20px);
	}
	.assistant-bubble {
		right: 10px;
		bottom: 10px;
	}
}

/* From Uiverse.io by andrew-manzyk */ 
.loader {
  --color-one: red;
  --color-two: blue;
  --color-three: yellow;
  --color-fore: cyan;
  --color-five: white;
  --time-animation: 1s;
  --size: 30px;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  border-radius: 50%;
}

.loader .sphere {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  border-radius: 50%;
  width: var(--size);
  height: var(--size);
  background: radial-gradient(
    circle at 80% 20%,
    rgba(255, 255, 255, 1) 0%,
    rgba(255, 255, 255, 0.8) 20%,
    rgba(255, 255, 255, 0.4) 50%,
    rgba(255, 255, 255, 0) 70%
  );
}

.loader .sphere::before {
  content: "";
  position: absolute;
  display: flex;
  justify-content: center;
  align-items: center;
  width: var(--size);
  height: var(--size);
  border-radius: 50%;
  box-shadow:
    inset calc(var(--size) / -20) calc(var(--size) / -20) calc(var(--size) / 10)
      var(--color-fore),
    inset calc(var(--size) / 10) 0 calc(var(--size) / 5) var(--color-three);
  animation:
    rotation calc(var(--time-animation) * 2) linear infinite,
    colorize calc(var(--time-animation) * 2) ease-in-out infinite;
}

.loader .sphere::after {
  content: "";
  position: absolute;
  display: flex;
  justify-content: center;
  align-items: center;
  width: var(--size);
  height: var(--size);
  border-radius: 50%;
  z-index: -1;
  background: radial-gradient(
      circle at 80% 20%,
      rgba(255, 255, 255, 0.7) 0%,
      rgba(255, 255, 255, 0.5) 30%,
      rgba(255, 255, 255, 0) 70%
    ),
    linear-gradient(120deg, var(--color-one) 20%, var(--color-two) 80%);
  animation:
    rotation calc(var(--time-animation) * 2) linear infinite,
    colorblur calc(var(--time-animation) * 2) ease-in-out infinite;
}

.loader svg {
  position: absolute;
  display: flex;
  justify-content: center;
  align-items: center;
  width: var(--size);
  height: var(--size);
  animation: rotation calc(var(--time-animation) * 3)
    cubic-bezier(0.7, 0.6, 0.3, 0.4) infinite;
}

.loader svg #shapes circle {
  fill: var(--color-five);
}

.loader svg #blurriness g,
.loader svg #clipping ellipse,
.loader svg #shapes g:nth-of-type(2),
.loader svg #fade ellipse {
  filter: blur(7px);
}

.loader svg #waves g path {
  will-change: d;
  stroke-width: 7px;
}

.loader svg #waves g path:nth-of-type(1) {
  animation: wave-one var(--time-animation) cubic-bezier(0.7, 0.6, 0.3, 0.4)
    infinite;
}

.loader svg #waves g path:nth-of-type(2) {
  animation: wave-two var(--time-animation) cubic-bezier(0.7, 0.6, 0.3, 0.4)
    calc(var(--time-animation) / -2) infinite reverse;
}

.loader svg #waves g path:nth-of-type(3) {
  animation: wave-one var(--time-animation) cubic-bezier(0.7, 0.6, 0.3, 0.4)
    calc(var(--time-animation) / -2) infinite;
}

.loader svg #waves g path:nth-of-type(4) {
  animation: wave-two var(--time-animation) cubic-bezier(0.7, 0.6, 0.3, 0.4)
    infinite reverse;
}

@keyframes wave-one {
  0% {
    d: path("M5,50 C10,50 15,50 20,50 C25,50 30,50 95,50");
  }
  50% {
    d: path("M5,50 C25,50 30,20 50,20 C70,20 75,50 95,50");
  }
  100% {
    d: path("M5,50 C70,50 75,50 80,50 C85,50 90,50 95,50");
  }
}

@keyframes wave-two {
  0% {
    d: path("M5,50 C10,50 15,50 20,50 C25,50 30,50 95,50");
  }
  50% {
    d: path("M5,50 C25,50 30,80 50,80 C70,80 75,50 95,50");
  }
  100% {
    d: path("M5,50 C70,50 75,50 80,50 C85,50 90,50 95,50");
  }
}

@keyframes rotation {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

@keyframes colorize {
  0% {
    filter: hue-rotate(0deg);
  }
  20% {
    filter: hue-rotate(-30deg);
  }
  40% {
    filter: hue-rotate(-60deg);
  }
  60% {
    filter: hue-rotate(-90deg);
  }
  80% {
    filter: hue-rotate(-45deg);
  }
  100% {
    filter: hue-rotate(0deg);
  }
}

@keyframes colorblur {
  0% {
    filter: hue-rotate(0deg) blur(calc(var(--size) / 15));
  }
  20% {
    filter: hue-rotate(-30deg) blur(calc(var(--size) / 15));
  }
  40% {
    filter: hue-rotate(-60deg) blur(calc(var(--size) / 15));
  }
  60% {
    filter: hue-rotate(-90deg) blur(calc(var(--size) / 15));
  }
  80% {
    filter: hue-rotate(-45deg) blur(calc(var(--size) / 15));
  }
  100% {
    filter: hue-rotate(0deg) blur(calc(var(--size) / 15));
  }
}

</style>
