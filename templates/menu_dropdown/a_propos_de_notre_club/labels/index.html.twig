{% extends 'base.html.twig' %}

{% block title %}Labels & Certifications - CHM Saleux{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/menu_dropdown/a_propos_de_notre_club/labels/index.css') }}">
{% endblock %}

{% block body %}

    {# --- HEADER IMMERSIF (NE PAS TOUCHER) --- #}
    <header class="page-header">
        <div class="header-bg" style="background-image: url('{{ asset('images/menu_dropdown/a_propos_de_notre_club/labels/1.jpg') }}');"></div>
        <div class="header-overlay"></div>

        <div class="container header-content">
            <a href="{{ path('home') }}" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Retour à l'accueil</span>
            </a>

            <div class="header-title-box">
                <span class="subtitle">Reconnaissance Fédérale</span>
                <h1>Labels Qualité</h1>
                <p>Performance, Pédagogie et Santé. Découvrez les certifications officielles qui valident notre expertise auprès de tous les publics.</p>
            </div>
        </div>
    </header>

<main class="main-container">

        {# --- SECTION 1 : LA PROMESSE (Intro) --- #}
        <section class="promise-section">
            <div class="container-narrow">
                <div class="promise-badge">Engagement Qualité</div>
                <h2 class="promise-title">Pourquoi ces labels comptent pour vous ?</h2>
                <p class="promise-text">
                    Au CHM Saleux, nos certifications ne sont pas juste des logos sur un mur. 
                    Elles garantissent que vous pratiquez dans une structure auditée, sécurisée 
                    et reconnue par la Fédération Française pour son excellence pédagogique.
                </p>
                
                <div class="key-benefits">
                    <div class="benefit-item">
                        <div class="benefit-icon"><i class="fa-solid fa-user-graduate"></i></div>
                        <span>Encadrement Diplômé</span>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-icon"><i class="fa-solid fa-shield-heart"></i></div>
                        <span>Pratique Sécurisée</span>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-icon"><i class="fa-solid fa-medal"></i></div>
                        <span>Matériel Homologué</span>
                    </div>
                </div>
            </div>
        </section>

        {# --- SECTION 2 : LES LABELS (DÉTAILLÉS) --- #}
        <section class="certifications-section">
            <div class="container">
                
                {# Label 1 : École #}
                <article class="certif-card highlight-card">
                    <div class="certif-content">
                        <div class="certif-header">
                            <span class="certif-icon-box gold"><i class="fa-solid fa-star"></i></span>
                            <h3>École d'Haltérophilie & Club Formateur</h3>
                        </div>
                        <p class="certif-desc">
                            Ce label d'excellence récompense notre savoir-faire dans l'accueil et la formation des jeunes athlètes.
                            Il valide notre capacité à enseigner les mouvements techniques avec pédagogie et sécurité.
                        </p>
                        <ul class="certif-points">
                            <li><i class="fa-solid fa-check"></i> Apprentissage progressif par niveaux</li>
                            <li><i class="fa-solid fa-check"></i> Détection et suivi des talents</li>
                            <li><i class="fa-solid fa-check"></i> Participation aux compétitions fédérales</li>
                        </ul>
                    </div>
                    <div class="certif-visual" style="background-image: url('{{ asset('images/menu_dropdown/a_propos_de_notre_club/labels/1.jpg') }}');">
                        </div>
                </article>

                {# Grille pour les autres labels #}
                <div class="secondary-labels-grid">
                    
                    {# Label 2 : Muscu Loisir #}
                    <article class="certif-card simple-card">
                        <div class="certif-icon-box blue"><i class="fa-solid fa-dumbbell"></i></div>
                        <h3>Musculation Loisir</h3>
                        <p>
                            Garantit un accès libre à un plateau de musculation complet et entretenu, 
                            permettant une pratique autonome ou guidée dans une ambiance conviviale.
                        </p>
                    </article>

                    {# Label 3 : Muscu Bien-être #}
                    <article class="certif-card simple-card">
                        <div class="certif-icon-box green"><i class="fa-solid fa-heart-pulse"></i></div>
                        <h3>Musculation Bien-être</h3>
                        <p>
                            Certifie notre compétence à accueillir des publics cherchant une pratique "Santé". 
                            Adaptation des charges, prévention des blessures et lutte contre la sédentarité.
                        </p>
                    </article>

                    {# Label 4 : Sport Santé (Optionnel si pertinent) #}
                    <article class="certif-card simple-card">
                        <div class="certif-icon-box purple"><i class="fa-solid fa-users"></i></div>
                        <h3>Affiliation FFHM</h3>
                        <p>
                            En tant que club affilié, nous respectons scrupuleusement les règlements fédéraux, 
                            assurant une éthique sportive irréprochable et une assurance adaptée.
                        </p>
                    </article>

                </div>

            </div>
        </section>

        {# --- SECTION 3 : PARTENAIRES & CONFIANCE --- #}
        <section class="trust-section">
            <div class="container-narrow">
                <div class="trust-box">
                    <div class="trust-logo">
                        <img src="{{ asset('images/ffhm.png') }}" alt="Logo FFHM" onerror="this.style.display='none'">
                        <h4 class="trust-fallback">Fédération Française d'Haltérophilie - Musculation</h4>
                    </div>
                    <div class="trust-content">
                        <h4>Un gage de sérieux</h4>
                        <p>
                            Le CHM Saleux est audité régulièrement par la Fédération. 
                            Ces labels sont renouvelés périodiquement sur la base de critères stricts : 
                            diplômes des encadrants, qualité des installations et résultats sportifs.
                        </p>
                        <a href="http://www.ffhaltero.fr" target="_blank" class="trust-link">
                            En savoir plus sur la FFHM <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </section>

    </main>
{% endblock %}
