{% extends 'base.html.twig' %}

{% block title %}Horaires d'entraînement - CHM Saleux{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/menu_dropdown/a_propos_de_notre_club/horaires/index.css') }}">
{% endblock %}

{% block body %}

    {# --- HEADER IMMERSIF --- #}
    <header class="page-header">
        {# Image de fond (tu peux changer l'image pour une photo de la salle/horloge) #}
        <div class="header-bg" style="background-image: url('{{ asset('images/menu_dropdown/a_propos_de_notre_club/horaires/1.jpg') }}');"></div>
        <div class="header-overlay"></div>
        
        <div class="container header-content">
            <a href="{{ path('home') }}" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Retour à l'accueil</span>
            </a>
            
            <div class="header-title-box">
                <span class="subtitle">Planning Hebdomadaire</span>
                <h1>Nos Créneaux</h1>
                <p>Des horaires adaptés pour vous entraîner matin et soir, encadrés par nos bénévoles passionnés.</p>
            </div>
        </div>
    </header>

    <main class="main-container">

        {# --- SECTION 1 : GRILLE DES HORAIRES --- #}
        <section class="schedule-section">
            <div class="intro-text text-center">
                <p>Le club est ouvert en continu sur les créneaux suivants.</p>
            </div>

            <div class="schedule-grid">
                
                {# Carte Lundi / Mercredi / Vendredi #}
                <article class="schedule-card primary-card">
                    <div class="card-header">
                        <div class="icon-day">📅</div>
                        <h3>Lundi • Mercredi • Vendredi</h3>
                    </div>
                    <div class="card-body">
                        <div class="time-row">
                            <span class="time-label">Matin</span>
                            <span class="time-value">10H00 - 12H00</span>
                        </div>
                        <div class="divider"></div>
                        <div class="time-row">
                            <span class="time-label">Après-midi</span>
                            <span class="time-value">16H00 - 20H00</span>
                        </div>
                    </div>
                    <div class="card-footer">
                        <span class="note">* Vendredi : fermeture possible à 18h45 (veilles de compétition)</span>
                    </div>
                </article>

                {# Carte Mardi / Jeudi #}
                <article class="schedule-card secondary-card">
                    <div class="card-header">
                        <div class="icon-day">📅</div>
                        <h3>Mardi • Jeudi</h3>
                    </div>
                    <div class="card-body">
                        <div class="time-row">
                            <span class="time-label">Matin</span>
                            <span class="time-value">10H00 - 12H00</span>
                        </div>
                        <div class="divider"></div>
                        <div class="time-row">
                            <span class="time-label">Après-midi</span>
                            <span class="time-value">16H00 - 19H30</span>
                        </div>
                    </div>
                </article>

                {# Carte Week-end #}
                <article class="schedule-card closed-card">
                    <div class="card-header">
                        <div class="icon-day">🔒</div>
                        <h3>Samedi • Dimanche</h3>
                    </div>
                    <div class="card-body centered-body">
                        <span class="closed-badge">FERMÉ</span>
                        <p>Repos ou Compétitions extérieures</p>
                    </div>
                </article>

            </div>
        </section>

        {# --- SECTION 2 : INFOS IMPORTANTES (Alertes) --- #}
        <section class="info-section">
            <h2 class="section-heading">Informations Pratiques</h2>

            <div class="info-grid">
                
                {# Bloc Bénévoles #}
                <div class="info-box info-volunteer">
                    <div class="info-icon">
                        <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                    </div>
                    <div class="info-content">
                        <h3>Gestion Bénévole</h3>
                        <p>Notre club vit grâce à l'engagement de bénévoles. Les horaires peuvent varier exceptionnellement selon leurs disponibilités professionnelles ou personnelles. Merci de votre compréhension.</p>
                    </div>
                </div>

                {# Bloc Compétition #}
                <div class="info-box info-competition">
                    <div class="info-icon">
                        <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
                    </div>
                    <div class="info-content">
                        <h3>Jours de Compétition</h3>
                        <p>Lors des week-ends de compétition à domicile, la salle ferme exceptionnellement le <strong>vendredi à 18h45</strong> pour l'installation du plateau.</p>
                    </div>
                </div>

                {# Bloc Météo / WhatsApp #}
                <div class="info-box info-weather">
                    <div class="info-icon">
                        <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                    </div>
                    <div class="info-content">
                        <h3>Restez Connectés</h3>
                        <p>Neige, jour férié ou imprévu ? Les fermetures ponctuelles sont annoncées en priorité sur notre <strong>groupe WhatsApp</strong> et nos réseaux sociaux.</p>
                    </div>
                </div>

            </div>
        </section>

    </main>
{% endblock %}