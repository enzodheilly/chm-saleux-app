{% extends 'base.html.twig' %}

{% block title %}Horaires d'entraînement — CHM Saleux
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/menu_dropdown/a_propos_de_notre_club/horaires/index.css') }}">
{% endblock %}

{% block body %}

	<header class="page-header-sport horaires-header-bg">
		<div class="header-overlay-gradient"></div>
		<div class="header-content">
			<div class="page-container">
				<nav class="breadcrumb-nav">
					<a href="{{ path('home') }}" class="back-link-minimal">
						<i class="fa-solid fa-chevron-left"></i>
						<span>Accueil</span>
					</a>
				</nav>
				<div class="header-main-box">
					<div class="badge-accent">Planning Hebdomadaire</div>
					<h1>Nos
						<span class="text-outline">Créneaux</span>
					</h1>
					<p class="lead">Des horaires adaptés pour vous entraîner matin et soir, encadrés par nos bénévoles passionnés.</p>
				</div>
			</div>
		</div>
	</header>

	<main class="horaires-root page-shell">

		{# --- PLANNING SEMAINE --- #}
		<section class="planning-section page-container">

			<div class="planning-header">
				<span class="h-eyebrow">Planning Hebdomadaire</span>
				<h2 class="h-title">Horaires d'<span>ouverture</span></h2>
				<p class="h-sub">La salle est ouverte du lundi au vendredi. Les horaires sont susceptibles de varier selon les disponibilités des bénévoles.</p>
			</div>

			<div class="week-grid">

				{# LUNDI #}
				<div class="day-card">
					<div class="day-header">
						<span class="day-name">Lundi</span>
						<span class="day-badge open">Ouvert</span>
					</div>
					<div class="day-slots">
						<div class="slot">
							<div class="slot-period">
								<i class="fa-solid fa-sun"></i>
								Matin
							</div>
							<div class="slot-hours">10:00 — 12:00</div>
						</div>
						<div class="slot-divider"></div>
						<div class="slot">
							<div class="slot-period">
								<i class="fa-solid fa-moon"></i>
								Soir
							</div>
							<div class="slot-hours">16:00 — 20:00</div>
						</div>
					</div>
				</div>

				{# MARDI #}
				<div class="day-card">
					<div class="day-header">
						<span class="day-name">Mardi</span>
						<span class="day-badge open">Ouvert</span>
					</div>
					<div class="day-slots">
						<div class="slot">
							<div class="slot-period">
								<i class="fa-solid fa-sun"></i>
								Matin
							</div>
							<div class="slot-hours">10:00 — 12:00</div>
						</div>
						<div class="slot-divider"></div>
						<div class="slot">
							<div class="slot-period">
								<i class="fa-solid fa-moon"></i>
								Soir
							</div>
							<div class="slot-hours">16:00 — 19:30</div>
						</div>
					</div>
				</div>

				{# MERCREDI #}
				<div class="day-card">
					<div class="day-header">
						<span class="day-name">Mercredi</span>
						<span class="day-badge open">Ouvert</span>
					</div>
					<div class="day-slots">
						<div class="slot">
							<div class="slot-period">
								<i class="fa-solid fa-sun"></i>
								Matin
							</div>
							<div class="slot-hours">10:00 — 12:00</div>
						</div>
						<div class="slot-divider"></div>
						<div class="slot">
							<div class="slot-period">
								<i class="fa-solid fa-moon"></i>
								Soir
							</div>
							<div class="slot-hours">16:00 — 20:00</div>
						</div>
					</div>
				</div>

				{# JEUDI #}
				<div class="day-card">
					<div class="day-header">
						<span class="day-name">Jeudi</span>
						<span class="day-badge open">Ouvert</span>
					</div>
					<div class="day-slots">
						<div class="slot">
							<div class="slot-period">
								<i class="fa-solid fa-sun"></i>
								Matin
							</div>
							<div class="slot-hours">10:00 — 12:00</div>
						</div>
						<div class="slot-divider"></div>
						<div class="slot">
							<div class="slot-period">
								<i class="fa-solid fa-moon"></i>
								Soir
							</div>
							<div class="slot-hours">16:00 — 19:30</div>
						</div>
					</div>
				</div>

				{# VENDREDI #}
				<div class="day-card day-card--note">
					<div class="day-header">
						<span class="day-name">Vendredi</span>
						<span class="day-badge open">Ouvert</span>
					</div>
					<div class="day-slots">
						<div class="slot">
							<div class="slot-period">
								<i class="fa-solid fa-sun"></i>
								Matin
							</div>
							<div class="slot-hours">10:00 — 12:00</div>
						</div>
						<div class="slot-divider"></div>
						<div class="slot">
							<div class="slot-period">
								<i class="fa-solid fa-moon"></i>
								Soir
							</div>
							<div class="slot-hours">16:00 — 20:00 <sup>*</sup></div>
						</div>
					</div>
					<div class="day-note">
						<i class="fa-solid fa-circle-info"></i>
						* Fermeture à 18h45 avant une compétition à domicile
					</div>
				</div>

				{# SAMEDI #}
				<div class="day-card day-card--closed">
					<div class="day-header">
						<span class="day-name">Samedi</span>
						<span class="day-badge closed">Fermé</span>
					</div>
					<div class="closed-body">
						<i class="fa-solid fa-lock"></i>
						<p>Repos / Compétitions</p>
					</div>
				</div>

				{# DIMANCHE #}
				<div class="day-card day-card--closed">
					<div class="day-header">
						<span class="day-name">Dimanche</span>
						<span class="day-badge closed">Fermé</span>
					</div>
					<div class="closed-body">
						<i class="fa-solid fa-lock"></i>
						<p>Repos / Compétitions</p>
					</div>
				</div>

			</div>

			{# Légende #}
			<div class="planning-legend">
				<div class="legend-item">
					<span class="legend-dot open"></span>
					<span>Salle ouverte</span>
				</div>
				<div class="legend-item">
					<span class="legend-dot closed"></span>
					<span>Salle fermée</span>
				</div>
				<div class="legend-item">
					<i class="fa-solid fa-circle-info"></i>
					<span>Horaires susceptibles de varier</span>
				</div>
			</div>

		</section>

		{# --- INFOS PRATIQUES --- #}
		<section class="infos-section">
			<div class="page-container">

				<div class="planning-header">
					<span class="h-eyebrow h-eyebrow--light">À savoir</span>
					<h2 class="h-title h-title--light">Informations <span class="text-outline-light">pratiques</span></h2>
				</div>

				<div class="infos-grid">
					<div class="info-card">
						<div class="info-icon">
							<i class="fa-solid fa-handshake-angle"></i>
						</div>
						<div class="info-body">
							<h4>Club bénévole</h4>
							<p>Le CHM Saleux fonctionne grâce à ses bénévoles. Les horaires peuvent évoluer selon leurs disponibilités. En cas de doute, renseignez-vous avant de vous déplacer.</p>
						</div>
					</div>

					<div class="info-card">
						<div class="info-icon">
							<i class="fa-solid fa-trophy"></i>
						</div>
						<div class="info-body">
							<h4>Jours de compétition</h4>
							<p>Le vendredi soir précédant une compétition à domicile, la salle ferme à 18h45 pour permettre l'installation du plateau de compétition.</p>
						</div>
					</div>

					<div class="info-card">
						<div class="info-icon info-icon--green">
							<i class="fa-brands fa-whatsapp"></i>
						</div>
						<div class="info-body">
							<h4>Alertes en temps réel</h4>
							<p>Rejoignez notre groupe WhatsApp pour être informé instantanément des fermetures exceptionnelles, changements d'horaires et actualités du club.</p>
						</div>
					</div>
				</div>

				<div class="infos-cta">
					<a href="https://chat.whatsapp.com/TON_LIEN_GROUPE" class="btn-whatsapp" target="_blank" rel="noopener noreferrer">
						<i class="fa-brands fa-whatsapp"></i>
						Rejoindre le groupe WhatsApp
					</a>
					<p class="infos-cta-note">Restez informé des fermetures exceptionnelles</p>
				</div>

			</div>
		</section>

		{# --- CTA CONTACT --- #}
		<section class="horaires-cta-section page-container">
			<div class="horaires-cta-card">
				<div class="horaires-cta-text">
					<h3>Une question sur les horaires ?</h3>
					<p>Notre équipe vous répond rapidement par téléphone ou via le formulaire de contact.</p>
				</div>
				<div class="horaires-cta-actions">
					<a href="{{ path('contact') }}" class="btn-cta-primary">
						<i class="fa-solid fa-envelope"></i>
						Nous contacter
					</a>
					<a href="tel:0322897257" class="btn-cta-phone">
						<i class="fa-solid fa-phone"></i>
						03.22.89.72.57
					</a>
				</div>
			</div>
		</section>

	</main>
{% endblock %}
