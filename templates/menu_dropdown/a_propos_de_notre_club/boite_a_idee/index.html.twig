{% extends 'base.html.twig' %}

{% block title %}Boîte à idées · CHM Saleux{% endblock %}
{% block description %}Partagez vos idées pour améliorer le club CHM Saleux.
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/menu_dropdown/a_propos_de_notre_club/boite_a_idee/index.css') }}">
{% endblock %}

{% block body %}

	<header class="page-header-sport boite-a-idees-header-bg">
		<div class="header-overlay-gradient"></div>
		<div class="header-content">
			<div class="page-container">
				{% include 'components/breadcrumb.html.twig' with { items: [{ label: 'Le Club' }, { label: 'Boîte à idées' }] } %}
				<div class="header-main-box">
					<h1>Boîte à
						<span class="text-outline">Idées</span>
					</h1>
					<p class="lead">Vous avez une suggestion pour améliorer le club ? Partagez-la avec nous — chaque idée est lue et étudiée par l'équipe.</p>
				</div>
			</div>
		</div>
	</header>

	<main class="bai-root page-shell">
		<div class="bai-wm page-wm" aria-hidden="true">SUGGESTIONS</div>

		{# --- QR + ÉTAPES --- #}
		<section class="bai-qr-section page-container">

			<div class="bai-section-head">
				<h2 class="bai-title">Scannez &amp; <span>Suggérez</span></h2>
				<p class="bai-sub">Un geste, une idée. Pointez votre appareil photo sur le QR code et rédigez votre suggestion en 30 secondes.</p>
			</div>

			<div class="bai-layout">

				{# Étapes #}
				<div class="bai-steps">
					<div class="bai-step-card">
						<div class="bai-step-num">1</div>
						<div class="bai-step-body">
							<h4>Scannez</h4>
							<p>Ouvrez l'appareil photo de votre téléphone et pointez-le sur le QR code.</p>
						</div>
					</div>
					<div class="bai-step-connector"></div>
					<div class="bai-step-card">
						<div class="bai-step-num">2</div>
						<div class="bai-step-body">
							<h4>Rédigez</h4>
							<p>Décrivez votre idée ou suggestion librement, sans contrainte de longueur.</p>
						</div>
					</div>
					<div class="bai-step-connector"></div>
					<div class="bai-step-card">
						<div class="bai-step-num">3</div>
						<div class="bai-step-body">
							<h4>Envoyez</h4>
							<p>L'équipe du club reçoit immédiatement votre suggestion et l'étudie.</p>
						</div>
					</div>
				</div>

				{# QR Code #}
				<div class="bai-qr-block">
					<div class="bai-qr-frame">
						<span class="qr-corner tl" aria-hidden="true"></span>
						<span class="qr-corner tr" aria-hidden="true"></span>
						<span class="qr-corner bl" aria-hidden="true"></span>
						<span class="qr-corner br" aria-hidden="true"></span>
						<img src="{{ asset('images/qrcodes/boite-a-idees.png') }}" alt="QR Code — Boîte à idées CHM Saleux" class="bai-qr-img">
					</div>
					<p class="bai-qr-label">
						<i class="fa-solid fa-mobile-screen-button"></i>
						Pointez votre appareil photo ici
					</p>
					<div class="bai-badges">
						<span class="bai-badge">
							<i class="fa-solid fa-user-secret"></i>
							100&nbsp;% anonyme
						</span>
						<span class="bai-badge">
							<i class="fa-solid fa-bolt"></i>
							30&nbsp;secondes
						</span>
					</div>
				</div>

			</div>
		</section>

		{# --- POURQUOI --- #}
		<section class="bai-why-section">
			<div class="page-container">
				<div class="bai-section-head bai-section-head--light">
					<h2 class="bai-title bai-title--light">Pourquoi nous <span class="text-outline-light">suggérer</span>&nbsp;?</h2>
					<p class="bai-sub bai-sub--light">Le CHM Saleux évolue grâce à ses membres. Chaque suggestion est une opportunité d'amélioration.</p>
				</div>

				<div class="bai-why-grid">
					<div class="bai-why-card">
						<div class="bai-why-icon">
							<i class="fa-solid fa-people-group"></i>
						</div>
						<h3>Un club participatif</h3>
						<p>Le CHM Saleux évolue grâce à ses membres. Votre avis est le meilleur moteur de notre progression collective.</p>
					</div>
					<div class="bai-why-card">
						<div class="bai-why-icon">
							<i class="fa-solid fa-lightbulb"></i>
						</div>
						<h3>Des idées qui aboutissent</h3>
						<p>Plusieurs améliorations du club sont nées de suggestions de membres. La vôtre peut être la prochaine.</p>
					</div>
					<div class="bai-why-card">
						<div class="bai-why-icon">
							<i class="fa-solid fa-lock"></i>
						</div>
						<h3>100&nbsp;% Anonyme</h3>
						<p>Pas besoin de compte. Pas de traçage. Votre idée arrive directement à l'équipe, sans intermédiaire.</p>
					</div>
				</div>
			</div>
		</section>

	</main>

{% endblock %}

{% block javascripts %}{% endblock %}
