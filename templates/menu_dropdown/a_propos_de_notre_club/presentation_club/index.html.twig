{% extends 'base.html.twig' %}

{% block title %}Présentation du Club — CHM Saleux{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/menu_dropdown/a_propos_de_notre_club/presentation_club/index.css') }}">
{% endblock %}

{% block body %}

    {# --- HEADER ELITE (GLOBAL) --- #}
    <header class="page-header-sport presentation-club-header-bg">
        <div class="header-overlay-gradient"></div>

        <div class="header-content">
            <div class="page-container">
                <nav class="breadcrumb-nav">
                    <a href="{{ path('home') }}" class="back-link-minimal">
                        <i class="fa-solid fa-chevron-left"></i> <span>Retour à l'accueil</span>
                    </a>
                </nav>

                <div class="header-main-box">
                    <div class="badge-accent">Depuis 1984</div>
                    <h1>L'Esprit <span class="text-outline">CHM Saleux</span></h1>
                    <p class="lead">Bien plus qu'une salle de sport. Une association bâtie sur l'amitié, la performance et le partage depuis 40 ans.</p>
                </div>
            </div>
        </div>
    </header>

    <main class="presentation-root page-shell">

        {# --- SECTION HISTOIRE --- #}
        <section class="page-container section-spacer">
            <div class="split-layout">
                <div class="split-content">
                    <h2 class="section-heading">Notre <span>Histoire</span></h2>
                    <p class="desc-text-large">
                        Fondé en 1984 par Michel et Francine, le CHM est né d’une volonté simple : offrir un espace d'entraînement sérieux et chaleureux au cœur de Saleux.
                    </p>
                    <div class="bio-content">
                        <p>Grâce à l’engagement de ses fondateurs, le club est devenu un lieu incontournable. Des centaines d’adhérents ont franchi nos portes avec un objectif commun : se dépasser dans une ambiance familiale.</p>
                    </div>
                </div>

                <div class="split-image">
                    <div class="image-frame">
                        <img src="{{ asset('images/menu_dropdown/a_propos_de_notre_club/presentation_club/2.jpg') }}" alt="Histoire du club">
                        <div class="experience-floating-badge">
                            <span class="years">40+</span>
                            <span class="label">Ans de passion</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {# --- SECTION VALEURS --- #}
        <section class="bg-dark-alternate section-spacer">
            <div class="page-container">
                <div class="intro-centered-box mb-5">
                    <h2 class="section-heading centered section-title-offset">Nos <span>Piliers</span></h2>
                </div>

                <div class="values-grid">
                    <div class="value-card">
                        <div class="value-icon">💪</div>
                        <h3>Dépassement</h3>
                        <p>Nous valorisons l'effort intelligent et la constance dans la progression.</p>
                    </div>

                    <div class="value-card">
                        <div class="value-icon">🤝</div>
                        <h3>Convivialité</h3>
                        <p>Ici, on se soutient. Quel que soit ton niveau, tu es chez toi.</p>
                    </div>

                    <div class="value-card">
                        <div class="value-icon">🛡️</div>
                        <h3>Sécurité</h3>
                        <p>Technique et prévention des blessures sont nos priorités absolues.</p>
                    </div>
                </div>
            </div>
        </section>

        {# --- SECTION BUREAU --- #}
        <section class="page-container section-spacer">
            <h2 class="section-heading centered section-title-offset">Le <span>Bureau</span></h2>

            <div class="staff-grid mt-5">
                <div class="staff-card highlight-staff">
                    <img src="{{ asset('images/menu_dropdown/membres_du_bureau/president/president.jpg') }}" alt="Florian">
                    <div class="staff-overlay">
                        <h3>Florian ROHAUT</h3>
                        <span>Président</span>
                    </div>
                </div>

                <div class="staff-card">
                    <img src="{{ asset('images/menu_dropdown/membres_du_bureau/secretaire/secretaire.png') }}" alt="Ema">
                    <div class="staff-overlay">
                        <h3>Ema BERTRAND</h3>
                        <span>Secrétaire</span>
                    </div>
                </div>

                <div class="staff-card">
                    <img src="{{ asset('images/menu_dropdown/membres_du_bureau/tresorier/tresorier.jpg') }}" alt="Aurore">
                    <div class="staff-overlay">
                        <h3>Aurore BERTRAND</h3>
                        <span>Trésorière</span>
                    </div>
                </div>

                <div class="staff-card">
                    <img src="{{ asset('images/menu_dropdown/membres_du_bureau/membre_bureau/1.png') }}" alt="Marianne BOULANGER-BAILLEUX">
                    <div class="staff-overlay">
                        <h3>Marianne BOULANGER-BAILLEUX</h3>
                        <span>Membre du bureau</span>
                    </div>
                </div>
            </div>
        </section>

    </main>
{% endblock %}