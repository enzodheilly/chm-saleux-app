{% extends 'base.html.twig' %}

{% block title %}Présentation du Club - CHM Saleux{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/menu_dropdown/a_propos_de_notre_club/presentation_club/index.css') }}">
{% endblock %}

{% block body %}

    {# --- HEADER IMMERSIF --- #}
    <header class="page-header">
        {# Image de fond (tu peux changer le path) #}
        <div class="header-bg" style="background-image: url('{{ asset('images/menu_dropdown/a_propos_de_notre_club/presentation_club/ddd.jpg') }}');"></div>
        <div class="header-overlay"></div>
        
        <div class="container header-content">
            <a href="{{ path('home') }}" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Retour à l'accueil</span>
            </a>
            
            <div class="header-title-box">
                <span class="subtitle">Depuis 1984</span>
                <h1>L'Esprit CHM Saleux</h1>
                <p>Bien plus qu'une salle de sport. Une association bâtie sur l'amitié, la performance et le partage.</p>
            </div>
        </div>
    </header>

    <main class="main-container">

        {# --- SECTION 1 : HISTOIRE (Split Layout) --- #}
        <section class="section-history">
            <div class="split-layout">
                <div class="split-content">
                    <h2 class="section-heading">Notre Histoire</h2>
                    <p class="lead-text">
                        Fondé en 1984 au cœur de Saleux par Michel et Francine, le CHM est né d’une volonté simple : offrir un espace sérieux et chaleureux.
                    </p>
                    <p>
                        Au fil des années, le club s’est développé autour de valeurs fortes telles que la progression, le partage et le respect. Grâce à l’engagement de ses fondateurs et de ses membres, le CHM est devenu un lieu incontournable pour tous ceux qui souhaitent s’entraîner dans une ambiance conviviale et motivante.
                    </p>
                    <p>
                        Des centaines d’adhérents sont passés par nos bancs, chacun avec son objectif : prise de masse, perte de poids, préparation physique ou performance.
                    </p>
                </div>
                <div class="split-image">
                    <div class="image-frame">
                        <img src="{{ asset('images/menu_dropdown/a_propos_de_notre_club/presentation_club/2.jpg') }}" alt="Histoire du club">
                    </div>
                    <div class="experience-badge">
                        <span class="years">40+</span>
                        <span class="label">Ans d'expérience</span>
                    </div>
                </div>
            </div>
        </section>

        {# --- SECTION 2 : VALEURS (Grid Cards) --- #}
        <section class="section-values">
            <div class="text-center mb-5">
                <h2 class="section-heading centered">Nos Piliers</h2>
                <p class="section-subtitle">Ce qui nous rassemble et nous fait avancer.</p>
            </div>

            <div class="values-grid">
                <article class="value-card">
                    <div class="icon-box">💪</div>
                    <h3>Dépassement de soi</h3>
                    <p>La progression se construit dans la constance. Nous valorisons l’effort intelligent et durable.</p>
                </article>

                <article class="value-card">
                    <div class="icon-box">🤝</div>
                    <h3>Convivialité</h3>
                    <p>Quel que soit ton niveau, tu es accueilli avec bienveillance. Ici, on se soutient et on progresse ensemble.</p>
                </article>

                <article class="value-card">
                    <div class="icon-box">🔓</div>
                    <h3>Accessibilité</h3>
                    <p>Débuter ici ne demande aucune condition. Tu évolues à ton rythme, accompagné par des passionnés.</p>
                </article>

                <article class="value-card">
                    <div class="icon-box">🛡️</div>
                    <h3>Sécurité</h3>
                    <p>Technique, charge adaptée et prévention des blessures sont nos priorités absolues.</p>
                </article>
            </div>
        </section>

        {# --- SECTION 3 : LE BUREAU (Team Grid) --- #}
        <section class="section-team">
            <h2 class="section-heading centered">Le Bureau</h2>
            <p class="section-subtitle text-center">Les bénévoles qui font vivre l'association au quotidien.</p>

            <div class="staff-grid">
                {# Carte Président (Mise en avant) #}
                <article class="staff-card president-card">
                    <div class="staff-photo">
                        <img src="{{ asset('images/club/president.jpg') }}" alt="Florian ROHAUT">
                    </div>
                    <div class="staff-info">
                        <h3>Florian ROHAUT</h3>
                        <span class="role">Président</span>
                        <p class="staff-bio">Ancien compétiteur, Florian porte les valeurs de passion et de discipline du CHM.</p>
                    </div>
                </article>

                {# Autres membres #}
                <article class="staff-card">
                    <div class="staff-photo">
                        <img src="{{ asset('images/club/bureau-secretaire.png') }}" alt="Ema BERTRAND">
                    </div>
                    <div class="staff-info">
                        <h3>Ema BERTRAND</h3>
                        <span class="role">Secrétaire</span>
                    </div>
                </article>

                <article class="staff-card">
                    <div class="staff-photo">
                        <img src="{{ asset('images/club/bureau-tresorier.png') }}" alt="Aurore BERTRAND">
                    </div>
                    <div class="staff-info">
                        <h3>Aurore BERTRAND</h3>
                        <span class="role">Trésorière</span>
                    </div>
                </article>

                <article class="staff-card">
                    <div class="staff-photo">
                        <img src="{{ asset('images/club/bg3.jpg') }}" alt="Marianne NOM">
                    </div>
                    <div class="staff-info">
                        <h3>Marianne NOM</h3>
                        <span class="role">Membre du bureau</span>
                    </div>
                </article>
            </div>
        </section>

        {# --- SECTION 4 : ALBUM (Marquee Infini) --- #}
        <section class="section-gallery">
            <h2 class="section-heading">La vie du club</h2>
            
            <div class="marquee-wrapper">
                <div class="marquee-track">
                    {# On boucle deux fois pour l'effet infini #}
                    {% for i in 1..10 %}
                        <div class="marquee-item">
                            <img src="{{ asset('images/club/' ~ i ~ '.jpg') }}" alt="Photo {{ i }}" loading="lazy">
                        </div>
                    {% endfor %}
                    {# Duplication pour le scroll infini #}
                    {% for i in 1..10 %}
                        <div class="marquee-item">
                            <img src="{{ asset('images/club/' ~ i ~ '.jpg') }}" alt="Photo {{ i }}" loading="lazy">
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>

    </main>
{% endblock %}