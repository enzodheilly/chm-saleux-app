{% extends 'base.html.twig' %}

{% block title %}Trésorier - CHM Saleux{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/menu_dropdown/membres_du_bureau/tresorier/tresorier.css') }}">
{% endblock %}

{% block body %}

    {# --- HEADER IMMERSIF --- #}
    <header class="page-header">
        {# Image de fond #}
        <div class="header-bg" style="background-image: url('{{ asset('images/menu_dropdown/services_du_club/evenements/2.jpg') }}'); top:120px;"></div>
        <div class="header-overlay"></div>
        
        <div class="container header-content">
            <a href="{{ path('home') }}" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Retour à l'accueil</span>
            </a>
            
            <div class="header-title-box">
                <span class="subtitle">Gestion & Finances</span>
                <h1>Le Trésorier</h1>
                <p>Découvrez celle qui veille à l'équilibre financier et à la pérennité économique de notre association.</p>
            </div>
        </div>
    </header>

    <main class="main-container">

        <section class="profile-card">
            <div class="profile-grid">
                
                {# --- COLONNE PHOTO --- #}
                <div class="profile-image-wrapper">
                    <div class="image-frame">
                        <img src="{{ asset('images/menu_dropdown/membres_du_bureau/tresorier/tresorier.jpg') }}" alt="Aurore Bertrand">
                    </div>
                    
                    {# Badge Ancienneté #}
                    <div class="badge-since">
                        <span class="label">En poste depuis</span>
                        <span class="year">2025</span>
                    </div>
                </div>

                {# --- COLONNE TEXTE --- #}
                <div class="profile-content">
                    <span class="role-tag">Trésorière du Club</span>
                    <h2>Aurore Bertrand</h2>
                    
                    <div class="bio-text">
                        <p>
                            Aurore Bertrand a repris les rênes de la trésorerie du CHM Saleux en 2025. Responsable de la gestion financière, elle occupe un rôle clé en assurant la transparence des comptes et le respect des budgets alloués.
                        </p>
                        <p>
                            Grâce à son sérieux et son organisation, elle permet au club d'investir sereinement dans du nouveau matériel et de financer les déplacements en compétition, garantissant ainsi la pérennité de notre structure.
                        </p>
                    </div>

                    {# Points Clés (Focus Gestion) #}
                    <div class="key-points">
                        <div class="point-item">
                            <div class="point-icon">📊</div>
                            <div class="point-text">
                                <strong>Gestion Rigoureuse</strong>
                                <span>Suivi précis des recettes et dépenses.</span>
                            </div>
                        </div>
                        <div class="point-item">
                            <div class="point-icon">🛡️</div>
                            <div class="point-text">
                                <strong>Transparence</strong>
                                <span>Des comptes clairs pour tous les adhérents.</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

    </main>
{% endblock %}