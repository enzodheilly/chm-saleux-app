{% extends 'base.html.twig' %}

{% block title %}Membre du Bureau - CHM Saleux{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/menu_dropdown/membres_du_bureau/membre_bureau/membre_bureau.css') }}">
{% endblock %}

{% block body %}

    {# --- HEADER IMMERSIF --- #}
    <header class="page-header">
        {# Image de fond #}
        <div class="header-bg" style="background-image: url('{{ asset('images/menu_dropdown/services_du_club/evenements/1.jpg') }}');"></div>
        <div class="header-overlay"></div>
        
        <div class="container header-content">
            <a href="{{ path('home') }}" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Retour à l'accueil</span>
            </a>
            
            <div class="header-title-box">
                <span class="subtitle">Bénévolat & Action</span>
                <h1>Membre du Bureau</h1>
                <p>Découvrez les acteurs de terrain qui œuvrent chaque jour pour faire vivre l'association et maintenir notre esprit convivial.</p>
            </div>
        </div>
    </header>

    <main class="main-container">

        <section class="profile-card">
            <div class="profile-grid">
                
                {# --- COLONNE PHOTO --- #}
                <div class="profile-image-wrapper">
                    <div class="image-frame">
                        <img src="{{ asset('images/menu_dropdown/membres_du_bureau/membre_bureau/1.png') }}" alt="Marianne Boulanger-Bailleux">
                    </div>
                    
                    {# Badge Statut #}
                    <div class="badge-status">
                        <span class="icon">✨</span>
                        <span class="label">Membre Actif</span>
                    </div>
                </div>

                {# --- COLONNE TEXTE --- #}
                <div class="profile-content">
                    <span class="role-tag">Membre du Bureau</span>
                    <h2>Marianne Boulanger-Bailleux</h2>
                    
                    <div class="bio-text">
                        <p>
                            Marianne Boulanger-Bailleux est une figure active du bureau du CHM Saleux. Engagée et disponible, elle participe à la gestion opérationnelle du club et contribue à la réussite des événements qui rythment notre saison.
                        </p>
                        <p>
                            Son rôle est essentiel pour maintenir le lien entre les adhérents et l'équipe dirigeante. Elle veille au quotidien à ce que l'esprit d'entraide et la convivialité, chers à notre association, soient toujours au rendez-vous.
                        </p>
                    </div>

                    {# Qualités / Missions #}
                    <div class="qualities-grid">
                        <div class="quality-item">
                            <div class="quality-icon">🤝</div>
                            <span>Lien Social</span>
                        </div>
                        <div class="quality-item">
                            <div class="quality-icon">🗓️</div>
                            <span>Organisation</span>
                        </div>
                        <div class="quality-item">
                            <div class="quality-icon">👂</div>
                            <span>Écoute</span>
                        </div>
                    </div>

                </div>
            </div>
        </section>

    </main>
{% endblock %}