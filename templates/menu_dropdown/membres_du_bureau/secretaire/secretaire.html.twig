{% extends 'base.html.twig' %}

{% block title %}Secrétaire - CHM Saleux{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/menu_dropdown/membres_du_bureau/secretaire/secretaire.css') }}">
{% endblock %}

{% block body %}

    <header class="page-header-sport secretaire-page-header">
        <div class="header-overlay-gradient"></div>

        <div class="header-content">
            <div class="page-container">
                <nav class="breadcrumb-nav">
                    <a href="{{ path('home') }}" class="back-link-minimal">
                        <i class="fa-solid fa-chevron-left"></i> <span>Retour à l'accueil</span>
                    </a>
                </nav>

                <div class="header-main-box">
                    <div class="badge-accent">Organisation & Lien Social</div>
                    <h1>Le <span class="text-outline">Secrétariat</span></h1>
                    <p class="lead">
                        Découvrez celle qui orchestre la vie administrative du club et assure le lien entre le bureau et les adhérents.
                    </p>
                </div>
            </div>
        </div>
    </header>

    <main class="secretaire-root page-shell">
        <section class="page-container section-spacer">
            <div class="profile-card-elite">
                <div class="profile-grid">
                    
                    <div class="profile-image-side">
                        <div class="image-container">
                            <img src="{{ asset('images/menu_dropdown/membres_du_bureau/secretaire/secretaire.png') }}" alt="Ema BERTRAND">
                            <div class="experience-badge">
                                <span class="exp-label">En poste depuis</span>
                                <span class="exp-year">2024</span>
                            </div>
                        </div>
                    </div>

                    <div class="profile-text-side">
                        <span class="role-tag">Secrétaire du Club</span>
                        <h2>Ema <span>BERTRAND</span></h2>
                        
                        <div class="bio-content">
                            <p>
                                Ema BERTRAND est la cheville ouvrière de l'association. Elle assure la gestion administrative quotidienne, du suivi des licences à la coordination des réunions.
                            </p>
                            <p>
                                Grâce à sa rigueur, elle fluidifie la circulation de l'information et veille à ce que chaque projet du club se déroule dans les meilleures conditions.
                            </p>
                        </div>

                        <div class="missions-flex">
                            <div class="mission-tag-elite"><i class="fa-solid fa-folder-open"></i> Administration</div>
                            <div class="mission-tag-elite"><i class="fa-solid fa-bullhorn"></i> Communication</div>
                            <div class="mission-tag-elite"><i class="fa-solid fa-handshake"></i> Relation Adhérents</div>
                        </div>
                    </div>

                </div>
            </div>
        </section>
    </main>
{% endblock %}