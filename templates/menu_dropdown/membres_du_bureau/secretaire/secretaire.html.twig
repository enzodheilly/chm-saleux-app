{% extends 'base.html.twig' %}

{% block title %}Secrétaire - CHM Saleux{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/menu_dropdown/membres_du_bureau/secretaire/secretaire.css') }}">
{% endblock %}

{% block body %}

    {# --- HEADER IMMERSIF --- #}
    <header class="page-header">
        {# Image de fond #}
        <div class="header-bg" style="background-image: url('{{ asset('images/menu_dropdown/services_du_club/evenements/2.jpg') }}'); top:120px;"></div>
        <div class="header-overlay"></div>
        
        <div class="container header-content">
            <a href="{{ path('home') }}" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Retour à l'accueil</span>
            </a>
            
            <div class="header-title-box">
                <span class="subtitle">Organisation & Lien Social</span>
                <h1>Le Secrétariat</h1>
                <p>Découvrez celle qui orchestre la vie administrative du club et assure le lien entre le bureau et les adhérents.</p>
            </div>
        </div>
    </header>

    <main class="main-container">

        <section class="profile-card">
            <div class="profile-grid">
                
                {# --- COLONNE PHOTO --- #}
                <div class="profile-image-wrapper">
                    <div class="image-frame">
                        <img src="{{ asset('images/menu_dropdown/membres_du_bureau/secretaire/secretaire.png') }}" alt="Ema BERTRAND">
                    </div>
                    
                    {# Badge Ancienneté #}
                    <div class="badge-since">
                        <span class="label">En poste depuis</span>
                        <span class="year">2024</span>
                    </div>
                </div>

                {# --- COLONNE TEXTE --- #}
                <div class="profile-content">
                    <span class="role-tag">Secrétaire du Club</span>
                    <h2>Ema BERTRAND</h2>
                    
                    <div class="bio-text">
                        <p>
                            Ema BERTRAND a rejoint le bureau du CHM Saleux en 2024. Véritable cheville ouvrière de l'association, elle assure la gestion administrative quotidienne, du suivi des licences à la coordination des réunions.
                        </p>
                        <p>
                            Grâce à sa rigueur et son sens du contact, elle fluidifie la circulation de l'information et veille à ce que chaque événement ou projet du club se déroule dans les meilleures conditions.
                        </p>
                    </div>

                    {# Missions Clés (Focus Organisation) #}
                    <div class="missions-grid">
                        <div class="mission-item">
                            <div class="mission-icon">📂</div>
                            <span>Gestion Administrative</span>
                        </div>
                        <div class="mission-item">
                            <div class="mission-icon">📢</div>
                            <span>Communication Interne</span>
                        </div>
                        <div class="mission-item">
                            <div class="mission-icon">🤝</div>
                            <span>Relation Adhérents</span>
                        </div>
                    </div>

                </div>
            </div>
        </section>

    </main>
{% endblock %}