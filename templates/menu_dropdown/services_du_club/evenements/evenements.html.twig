{% extends 'base.html.twig' %}

{% block title %}Vie du Club & Événements - CHM Saleux{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/menu_dropdown/services_du_club/evenements/evenements.css') }}">
{% endblock %}

{% block body %}

    {# --- HEADER IMMERSIF --- #}
    <header class="page-header">
        <div class="header-bg" style="background-image: url('{{ asset('images/menu_dropdown/services_du_club/evenements/1.jpg') }}');"></div>
        <div class="header-overlay"></div>
        
        <div class="container header-content">
            <a href="{{ path('home') }}" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Retour à l'accueil</span>
            </a>
            
            <div class="header-title-box">
                <span class="subtitle">Convivialité & Partage</span>
                <h1>La Vie du Club</h1>
                <p>Parce qu'un club de sport, c'est aussi une famille. Découvrez les moments festifs qui nous rassemblent hors des plateaux d'entraînement.</p>
            </div>
        </div>
    </header>

<main class="main-container">

        {# --- SECTION 1 : L'ESPRIT CLUB (Intro) --- #}
        <section class="club-spirit-intro">
            <div class="container-narrow">
                <div class="spirit-badge">Esprit d'équipe</div>
                <h2>Plus qu'une salle, <span class="highlight-text">une famille.</span></h2>
                <p class="spirit-desc">
                    La performance c'est bien, mais les souvenirs c'est mieux. 
                    Au CHM Saleux, nous croyons que la cohésion se forge autant autour d'un bon repas que sous une barre chargée.
                    Découvrez les traditions qui rythment notre année.
                </p>
            </div>
        </section>

        {# --- SECTION 2 : LE CALENDRIER FESTIF (Grid) --- #}
        <section class="events-timeline">
            <div class="events-grid">
                
                {# JANVIER - GALETTE #}
                <article class="event-card winter">
                    <div class="card-bg-icon"><i class="fa-solid fa-crown"></i></div>
                    <div class="event-header">
                        <span class="month-badge">Janvier</span>
                        <div class="icon-circle"><i class="fa-solid fa-crown"></i></div>
                    </div>
                    <div class="event-body">
                        <h3>Galette des Rois</h3>
                        <p>On commence l'année par un classique ! Après l'effort, le réconfort. Qui sera le roi ou la reine de la saison ?</p>
                    </div>
                </article>

                {# AVRIL - PÂQUES #}
                <article class="event-card spring">
                    <div class="card-bg-icon"><i class="fa-solid fa-egg"></i></div>
                    <div class="event-header">
                        <span class="month-badge">Avril</span>
                        <div class="icon-circle"><i class="fa-solid fa-egg"></i></div>
                    </div>
                    <div class="event-body">
                        <h3>Fête de Pâques</h3>
                        <p>Chasse aux œufs et chocolats pour les petits (et les grands). Un moment familial incontournable au club.</p>
                    </div>
                </article>

                {# DÉCEMBRE - NOËL #}
                <article class="event-card winter-red">
                    <div class="card-bg-icon"><i class="fa-solid fa-gift"></i></div>
                    <div class="event-header">
                        <span class="month-badge">Décembre</span>
                        <div class="icon-circle"><i class="fa-solid fa-gift"></i></div>
                    </div>
                    <div class="event-body">
                        <h3>Repas de Noël</h3>
                        <p>Le grand rassemblement. On troque les tenues de sport pour une soirée festive, un bon repas et beaucoup de rires.</p>
                    </div>
                </article>

                {# TOUTE L'ANNÉE - SURPRISES #}
                <article class="event-card summer">
                    <div class="card-bg-icon"><i class="fa-solid fa-fire"></i></div>
                    <div class="event-header">
                        <span class="month-badge">Toute l'année</span>
                        <div class="icon-circle"><i class="fa-solid fa-fire"></i></div>
                    </div>
                    <div class="event-body">
                        <h3>Les "Imprévus"</h3>
                        <p>Barbecues improvisés, challenges internes, sorties... Parce que les meilleurs moments ne sont pas toujours planifiés.</p>
                    </div>
                </article>

            </div>
        </section>

        {# --- SECTION 3 : COMMUNICATION (CTA WhatsApp) --- #}
        <section class="connect-section">
            <div class="connect-card">
                <div class="connect-visual">
                    <div class="phone-mockup">
                        <i class="fa-brands fa-whatsapp"></i>
                    </div>
                    <div class="pulse-ring"></div>
                </div>
                
                <div class="connect-content">
                    <h3>Ne ratez aucune info !</h3>
                    <p>
                        L'organisation des événements, les sondages pour les dates et les infos de dernière minute circulent sur notre groupe privé.
                    </p>
                    
                    <div class="connect-actions">
                        <a href="https://chat.whatsapp.com/TON-LIEN" target="_blank" class="btn-whatsapp-large">
                            <i class="fa-brands fa-whatsapp"></i> Rejoindre le groupe Membres
                        </a>
                        <p class="secure-note"><i class="fa-solid fa-lock"></i> Accès réservé aux licenciés</p>
                    </div>
                </div>
            </div>
        </section>

    </main>
{% endblock %}