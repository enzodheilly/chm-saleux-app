{% extends 'base.html.twig' %}

{% block title %}Événements · CHM Saleux{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/menu_dropdown/services_du_club/evenements/evenements.css') }}">
{% endblock %}

{% block body %}

	<header class="page-header-sport evenements-page-header">
		<div class="header-overlay-gradient"></div>
		<div class="header-content">
			<div class="page-container">
				{% include 'components/breadcrumb.html.twig' with { items: [{ label: 'Le Club' }, { label: 'Événements' }] } %}
				<div class="header-main-box">
					<h1>La Vie
						<span class="text-outline">du Club</span>
					</h1>
					<p class="lead">Parce qu'un club de sport, c'est aussi une famille. Découvrez les moments festifs qui nous rassemblent hors des plateaux.</p>
				</div>
			</div>
		</div>
	</header>

	<main class="events-root page-shell">
		<div class="ev-wm page-wm" aria-hidden="true">ÉVÉNEMENTS</div>

		{# --- INTRO --- #}
		<section class="ev-section ev-intro">
			<div class="page-container">
				<div class="ev-section-head">
					<h2 class="ev-h2">Plus qu'une salle,<br><span>une famille.</span></h2>
					<p class="ev-desc">La performance c'est bien, mais les souvenirs c'est mieux. Au CHM Saleux, nous croyons que la cohésion se forge autant autour d'un bon repas que sous une barre chargée.</p>
				</div>
				<div class="ev-pillars">
					<div class="ev-pillar">
						<div class="ev-pillar-icon"><i class="fa-solid fa-handshake-angle"></i></div>
						<h4>Cohésion</h4>
						<p>Des moments partagés qui renforcent les liens entre membres, bien au-delà des entraînements.</p>
					</div>
					<div class="ev-pillar">
						<div class="ev-pillar-icon"><i class="fa-solid fa-champagne-glasses"></i></div>
						<h4>Convivialité</h4>
						<p>On s'entraîne dur, mais on sait aussi s'amuser. La bonne humeur fait partie de notre ADN.</p>
					</div>
					<div class="ev-pillar">
						<div class="ev-pillar-icon"><i class="fa-solid fa-calendar-heart"></i></div>
						<h4>Traditions</h4>
						<p>Galette, Pâques, Noël… Des rendez-vous immanquables qui rythment la saison du club.</p>
					</div>
				</div>
			</div>
		</section>

		{# --- CALENDRIER FESTIF --- #}
		<section class="ev-section ev-calendar">
			<div class="page-container">
				<div class="ev-section-head">
					<h2 class="ev-h2">Notre <span>Calendrier</span></h2>
					<p class="ev-desc">Des événements réguliers qui rendent la vie du club unique et soudée.</p>
				</div>
				<div class="ev-cards">
					<div class="ev-card">
						<div class="ev-card-top ev-card-top--gold">
							<span class="ev-card-date">Janvier</span>
							<div class="ev-card-icon"><i class="fa-solid fa-crown"></i></div>
						</div>
						<div class="ev-card-body">
							<h3>Galette des Rois</h3>
							<p>On commence l'année par un classique ! Après l'effort, le réconfort. Qui sera le roi ou la reine de la saison ?</p>
						</div>
					</div>
					<div class="ev-card">
						<div class="ev-card-top ev-card-top--blue">
							<span class="ev-card-date">Avril</span>
							<div class="ev-card-icon ev-card-icon--blue"><i class="fa-solid fa-egg"></i></div>
						</div>
						<div class="ev-card-body">
							<h3>Fête de Pâques</h3>
							<p>Chasse aux œufs et chocolats pour les petits (et les grands). Un moment familial incontournable au club.</p>
						</div>
					</div>
					<div class="ev-card">
						<div class="ev-card-top ev-card-top--red">
							<span class="ev-card-date">Décembre</span>
							<div class="ev-card-icon ev-card-icon--red"><i class="fa-solid fa-gift"></i></div>
						</div>
						<div class="ev-card-body">
							<h3>Repas de Noël</h3>
							<p>Le grand rassemblement. On troque les tenues de sport pour une soirée festive et un bon repas entre membres.</p>
						</div>
					</div>
					<div class="ev-card">
						<div class="ev-card-top ev-card-top--green">
							<span class="ev-card-date">Toute l'année</span>
							<div class="ev-card-icon ev-card-icon--green"><i class="fa-solid fa-fire"></i></div>
						</div>
						<div class="ev-card-body">
							<h3>Les "Imprévus"</h3>
							<p>Barbecues improvisés, challenges internes, sorties… Parce que les meilleurs moments ne sont pas planifiés.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		{# --- WHATSAPP --- #}
		<section class="ev-section ev-wa-section">
			<div class="page-container">
				<div class="ev-wa-card">
					<div class="ev-wa-icon"><i class="fa-brands fa-whatsapp"></i></div>
					<div class="ev-wa-content">
						<h3>Ne ratez <span>aucune info</span> !</h3>
						<p>L'organisation des événements et les sondages circulent sur notre groupe privé réservé aux membres. Rejoignez-le pour être informé en temps réel.</p>
						<a href="https://chat.whatsapp.com/TON-LIEN" target="_blank" rel="noopener noreferrer" class="ev-btn-wa">
							<i class="fa-brands fa-whatsapp"></i>
							Rejoindre le groupe Membres
						</a>
					</div>
					<div class="ev-wa-bubbles" aria-hidden="true">
						<div class="ev-bubble ev-bubble--received">Prochain BBQ Samedi !</div>
						<div class="ev-bubble ev-bubble--sent">Qui vient pour Noël ?</div>
						<div class="ev-bubble ev-bubble--received">J'apporte les desserts</div>
					</div>
				</div>
			</div>
		</section>

	</main>
{% endblock %}
