{% extends 'base.html.twig' %}

{% block title %}Vie du Club & Événements - CHM Saleux{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/menu_dropdown/services_du_club/evenements/evenements.css') }}">
{% endblock %}

{% block body %}

    {# --- HEADER IMMERSIF --- #}
    <header class="page-header">
        <div class="header-bg" style="background-image: url('{{ asset('images/menu_dropdown/services_du_club/evenements/1.jpg') }}');"></div>
        <div class="header-overlay"></div>
        
        <div class="container header-content">
            <a href="{{ path('home') }}" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Retour à l'accueil</span>
            </a>
            
            <div class="header-title-box">
                <span class="subtitle">Convivialité & Partage</span>
                <h1>La Vie du Club</h1>
                <p>Parce qu'un club de sport, c'est aussi une famille. Découvrez les moments festifs qui nous rassemblent hors des plateaux d'entraînement.</p>
            </div>
        </div>
    </header>

    <main class="main-container">

        {# --- SECTION 1 : LES TEMPS FORTS (Cartes) --- #}
        <section class="events-section">
            <div class="intro-text text-center">
                <h2>Nos Rendez-vous Annuels</h2>
                <p>Tout au long de l'année, le CHM Saleux organise des moments de détente pour souder les liens entre adhérents.</p>
            </div>

            <div class="events-grid">
                
                {# Carte Galette #}
                <article class="event-card">
                    <div class="card-icon icon-galette">👑</div>
                    <div class="card-content">
                        <h3>La Galette des Rois</h3>
                        <span class="event-period">Janvier</span>
                        <p>Pour bien commencer l'année, on tire les rois ! Un moment gourmand pour se retrouver après les fêtes.</p>
                    </div>
                </article>

                {# Carte Pâques #}
                <article class="event-card">
                    <div class="card-icon icon-paques">🥚</div>
                    <div class="card-content">
                        <h3>Pâques</h3>
                        <span class="event-period">Avril</span>
                        <p>Chasse aux œufs ou distribution de chocolats, c'est le rendez-vous des gourmands (avant de retourner s'entraîner !).</p>
                    </div>
                </article>

                {# Carte Noël #}
                <article class="event-card">
                    <div class="card-icon icon-noel">🎁</div>
                    <div class="card-content">
                        <h3>Repas de Noël</h3>
                        <span class="event-period">Décembre</span>
                        <p>Le grand rassemblement de fin d'année. Repas commun, bonne humeur et célébration de la saison écoulée.</p>
                    </div>
                </article>

                {# Carte Surprises #}
                <article class="event-card">
                    <div class="card-icon icon-surprise">🎉</div>
                    <div class="card-content">
                        <h3>Événements Surprises</h3>
                        <span class="event-period">Toute l'année</span>
                        <p>Barbecues, sorties, challenges internes... Nous aimons improviser des moments sympas pour casser la routine.</p>
                    </div>
                </article>

            </div>
        </section>

        {# --- SECTION 2 : RESTER INFORMÉ (Communication) --- #}
        <section class="communication-section">
            <div class="comm-box">
                <div class="comm-icon">
                    <svg width="40" height="40" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.897.001-6.113 4.974-11.085 11.092-11.085 2.962.002 5.748 1.155 7.842 3.25 2.094 2.094 3.246 4.88 3.245 7.842-.001 6.113-4.976 11.086-11.094 11.086-1.928-.001-3.824-.492-5.526-1.427l-5.659 1.495z"/></svg>
                </div>
                <div class="comm-content">
                    <h3>Ne ratez aucune date !</h3>
                    <p>
                        L'organisation des événements, les dates précises et les inscriptions se font exclusivement via nos canaux de communication internes.
                    </p>
                    <a href="#" class="btn-whatsapp">Rejoindre le groupe WhatsApp</a>
                    <span class="sub-note">Réservé aux membres du club</span>
                </div>
            </div>
        </section>

    </main>
{% endblock %}