{% extends 'base.html.twig' %}

{% block title %}Séance d'Essai Gratuite - CHM Saleux{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/menu_dropdown/services_du_club/seance_essai/index.css') }}">
{% endblock %}

{% block body %}

    <header class="page-header-sport seance-essai-page-header">
        <div class="header-overlay-gradient"></div>

        <div class="header-content">
            <div class="page-container">
                <nav class="breadcrumb-nav">
                    <a href="{{ path('home') }}" class="back-link-minimal">
                        <i class="fa-solid fa-chevron-left"></i> <span>Retour à l'accueil</span>
                    </a>
                </nav>

                <div class="header-main-box">
                    <div class="badge-accent">100% Gratuit & Sans Engagement</div>
                    <h1>Votre Séance <span class="text-outline">Découverte</span></h1>
                    <p class="lead">
                        N'ayez pas peur de pousser la porte. Venez tester nos équipements, rencontrer l'équipe
                        et ressentir l'ambiance du club avant de vous décider.
                    </p>
                </div>
            </div>
        </div>
    </header>

    <main class="page-shell seance-essai-root">

        <section class="reassurance-section section-spacer">
            <div class="page-container">
                <div class="container-narrow">
                    <div class="intro-badge">Gratuit & Sans Engagement</div>

                    <h2 class="section-heading centered">
                        Poussez la porte, <span class="highlight-text">on s'occupe du reste.</span>
                    </h2>

                    <p class="intro-desc">
                        Nous savons que la première fois dans une salle peut être intimidante.
                        Au CHM Saleux, pas de jugement. Juste une équipe passionnée prête à vous accueillir,
                        quel que soit votre niveau ou votre âge.
                    </p>
                </div>
            </div>
        </section>

        <section class="reasons-section section-spacer">
            <div class="page-container">
                <div class="reasons-grid">
                    <div class="reason-card">
                        <div class="card-icon blue">
                            <i class="fa-solid fa-dumbbell"></i>
                        </div>
                        <h3>Matériel Pro</h3>
                        <p>Testez nos barres Eleiko, nos plateaux d'haltéro et nos machines guidées. La qualité fait la différence.</p>
                    </div>

                    <div class="reason-card">
                        <div class="card-icon yellow">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <h3>Ambiance Club</h3>
                        <p>Ici, on se dit bonjour. Ressentez l'entraide et la convivialité qui font la réputation du club.</p>
                    </div>

                    <div class="reason-card">
                        <div class="card-icon green">
                            <i class="fa-solid fa-user-check"></i>
                        </div>
                        <h3>Conseils Coach</h3>
                        <p>Profitez de votre essai pour poser vos questions à un coach diplômé et corriger vos mouvements.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="how-it-works-section section-spacer">
            <div class="page-container">
                <div class="section-header">
                    <h2 class="section-heading centered">Comment ça se passe ?</h2>
                    <p class="desc-text-large">Votre première visite en 3 étapes simples.</p>
                </div>

                <div class="steps-container">
                    <div class="step-item">
                        <div class="step-number">1</div>
                        <div class="step-content">
                            <h3>Venez aux horaires d'ouverture</h3>
                            <p>Présentez-vous à l'accueil lors des créneaux encadrés (soir ou mercredi après-midi).</p>
                        </div>
                    </div>

                    <div class="step-connector"></div>

                    <div class="step-item">
                        <div class="step-number">2</div>
                        <div class="step-content">
                            <h3>Dites "Je viens pour un essai"</h3>
                            <p>L'équipe vous fera visiter, vous expliquera le fonctionnement et vous montrera les vestiaires.</p>
                        </div>
                    </div>

                    <div class="step-connector"></div>

                    <div class="step-item">
                        <div class="step-number">3</div>
                        <div class="step-content">
                            <h3>Entraînez-vous !</h3>
                            <p>Profitez de votre séance. N'oubliez pas votre bouteille d'eau et votre serviette.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="final-cta-section section-spacer">
            <div class="page-container">
                <div class="cta-card">
                    <div class="cta-left">
                        <h3>🎒 Dans votre sac</h3>
                        <ul class="checklist">
                            <li><i class="fa-solid fa-check"></i> Tenue de sport</li>
                            <li><i class="fa-solid fa-check"></i> Baskets propres</li>
                            <li><i class="fa-solid fa-check"></i> Serviette & Eau</li>
                        </ul>
                    </div>

                    <div class="cta-right">
                        <h3>On vous attend !</h3>
                        <p>Pas besoin de réserver, mais si vous avez une question, n'hésitez pas.</p>

                        <div class="action-buttons">
                            <a href="{{ path('contact') }}" class="btn-contact">
                                <i class="fa-regular fa-envelope"></i> Prévenir de ma venue
                            </a>
                            <a href="https://www.google.com/maps/dir//CHM+Saleux" target="_blank" class="btn-map">
                                <i class="fa-solid fa-location-arrow"></i> Itinéraire
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </main>
{% endblock %}