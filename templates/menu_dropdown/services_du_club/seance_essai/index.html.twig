{% extends 'base.html.twig' %}

{% block title %}Séance d'Essai · CHM Saleux{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/menu_dropdown/services_du_club/seance_essai/index.css') }}">
{% endblock %}

{% block body %}

	<header class="page-header-sport seance-essai-page-header">
		<div class="header-overlay-gradient"></div>
		<div class="header-content">
			<div class="page-container">
				{% include 'components/breadcrumb.html.twig' with { items: [{ label: 'Le Club' }, { label: 'Séance d\'essai' }] } %}
				<div class="header-main-box">
					<h1>Votre Séance
						<span class="text-outline">Découverte</span>
					</h1>
					<p class="lead">
						N'ayez pas peur de pousser la porte. Venez tester nos équipements, rencontrer l'équipe
						et ressentir l'ambiance du club avant de vous décider.
					</p>
				</div>
			</div>
		</div>
	</header>

	<main class="page-shell seance-essai-root">
		<div class="se-wm page-wm" aria-hidden="true">DÉCOUVERTE</div>

		{# --- POURQUOI NOUS --- #}
		<section class="se-section se-reasons">
			<div class="page-container">
				<div class="se-section-head">
					<h2 class="se-h2">Poussez la porte,<br><span>on s'occupe du reste.</span></h2>
					<p class="se-desc">Nous savons que la première fois dans une salle peut être intimidante. Au CHM Saleux, pas de jugement — juste une équipe passionnée prête à vous accueillir, quel que soit votre niveau.</p>
				</div>
				<div class="se-cards">
					<div class="se-card">
						<div class="se-card-icon">
							<i class="fa-solid fa-dumbbell"></i>
						</div>
						<h3>Matériel Pro</h3>
						<p>Testez nos barres Eleiko, nos plateaux d'haltéro et nos machines guidées. La qualité fait la différence.</p>
					</div>
					<div class="se-card">
						<div class="se-card-icon">
							<i class="fa-solid fa-users"></i>
						</div>
						<h3>Ambiance Club</h3>
						<p>Ici, on se dit bonjour. Ressentez l'entraide et la convivialité qui font la réputation du club.</p>
					</div>
					<div class="se-card">
						<div class="se-card-icon">
							<i class="fa-solid fa-user-check"></i>
						</div>
						<h3>Conseils Coach</h3>
						<p>Profitez de votre essai pour poser vos questions à un coach diplômé et corriger vos mouvements.</p>
					</div>
				</div>
			</div>
		</section>

		{# --- COMMENT ÇA SE PASSE --- #}
		<section class="se-section se-steps-section">
			<div class="page-container">
				<div class="se-section-head">
					<h2 class="se-h2">Comment ça <span>se passe ?</span></h2>
					<p class="se-desc">Votre première visite en 3 étapes simples.</p>
				</div>
				<div class="se-steps">
					<div class="se-step">
						<div class="se-step-num">01</div>
						<div class="se-step-body">
							<h3>Venez aux horaires d'ouverture</h3>
							<p>Présentez-vous à l'accueil lors des créneaux encadrés (soir ou mercredi après-midi).</p>
						</div>
					</div>
					<div class="se-step">
						<div class="se-step-num">02</div>
						<div class="se-step-body">
							<h3>Dites "Je viens pour un essai"</h3>
							<p>L'équipe vous fera visiter, vous expliquera le fonctionnement et vous montrera les vestiaires.</p>
						</div>
					</div>
					<div class="se-step">
						<div class="se-step-num">03</div>
						<div class="se-step-body">
							<h3>Entraînez-vous !</h3>
							<p>Profitez de votre séance. N'oubliez pas votre bouteille d'eau et votre serviette.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		{# --- CTA FINAL --- #}
		<section class="se-section se-cta-section">
			<div class="page-container">
				<div class="se-cta-card">
					<div class="se-cta-left">
						<ul class="se-checklist">
							<li><i class="fa-solid fa-check"></i> Tenue de sport</li>
							<li><i class="fa-solid fa-check"></i> Baskets propres</li>
							<li><i class="fa-solid fa-check"></i> Serviette & Eau</li>
						</ul>
					</div>
					<div class="se-cta-divider"></div>
					<div class="se-cta-right">
						<h3>On vous attend !</h3>
						<p>Pas besoin de réserver, mais si vous avez une question, n'hésitez pas à nous contacter.</p>
						<div class="se-cta-btns">
							<a href="{{ path('contact') }}" class="se-btn-primary">
								<i class="fa-regular fa-envelope"></i>
								Prévenir de ma venue
							</a>
							<a href="https://www.google.com/maps/dir//CHM+Saleux" target="_blank" class="se-btn-outline">
								<i class="fa-solid fa-location-arrow"></i>
								Itinéraire
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

	</main>
{% endblock %}
