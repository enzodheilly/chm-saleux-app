{% extends 'base.html.twig' %}

{% block title %}Séance d'Essai Gratuite - CHM Saleux{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/menu_dropdown/services_du_club/seance_essai/index.css') }}">
{% endblock %}

{% block body %}

    {# --- HEADER IMMERSIF --- #}
    <header class="page-header">
        <div class="header-bg" style="background-image: url('{{ asset('images/menu_dropdown/services_du_club/journee_essai/1.jpg') }}');"></div>
        <div class="header-overlay"></div>
        
        <div class="container header-content">
            <a href="{{ path('home') }}" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Retour à l'accueil</span>
            </a>
            
            <div class="header-title-box">
                <span class="subtitle">100% Gratuit & Sans Engagement</span>
                <h1>Votre Séance Découverte</h1>
                <p>N'ayez pas peur de pousser la porte. Venez tester nos équipements, rencontrer l'équipe et ressentir l'ambiance du club avant de vous décider.</p>
            </div>
        </div>
    </header>

<main class="main-container">

        {# --- SECTION 1 : LA PROMESSE (Rassurante) --- #}
        <section class="reassurance-section">
            <div class="container-narrow">
                <div class="intro-badge">Gratuit & Sans Engagement</div>
                <h2>Poussez la porte, <span class="highlight-text">on s'occupe du reste.</span></h2>
                <p class="intro-desc">
                    Nous savons que la première fois dans une salle peut être intimidante. 
                    Au CHM Saleux, pas de jugement. Juste une équipe passionnée prête à vous accueillir, 
                    quel que soit votre niveau ou votre âge.
                </p>
            </div>
        </section>

        {# --- SECTION 2 : 3 BONNES RAISONS (Cartes Illustrées) --- #}
        <section class="reasons-section">
            <div class="reasons-grid">
                
                {# Carte 1 #}
                <div class="reason-card">
                    <div class="card-icon blue">
                        <i class="fa-solid fa-dumbbell"></i>
                    </div>
                    <h3>Matériel Pro</h3>
                    <p>Testez nos barres Eleiko, nos plateaux d'haltéro et nos machines guidées. La qualité fait la différence.</p>
                </div>

                {# Carte 2 #}
                <div class="reason-card yellow">
                    <div class="card-icon yellow">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <h3>Ambiance Club</h3>
                    <p>Ici, on se dit bonjour. Ressentez l'entraide et la convivialité qui font la réputation du club.</p>
                </div>

                {# Carte 3 #}
                <div class="reason-card green">
                    <div class="card-icon green">
                        <i class="fa-solid fa-user-check"></i>
                    </div>
                    <h3>Conseils Coach</h3>
                    <p>Profitez de votre essai pour poser vos questions à un coach diplômé et corriger vos mouvements.</p>
                </div>

            </div>
        </section>

        {# --- SECTION 3 : LE GUIDE PRATIQUE (Timeline) --- #}
        <section class="how-it-works-section">
            <div class="section-header">
                <h2>Comment ça se passe ?</h2>
                <p>Votre première visite en 3 étapes simples.</p>
            </div>

            <div class="steps-container">
                {# Etape 1 #}
                <div class="step-item">
                    <div class="step-number">1</div>
                    <div class="step-content">
                        <h3>Venez aux horaires d'ouverture</h3>
                        <p>Présentez-vous à l'accueil lors des créneaux encadrés (Soir ou Mercredi après-midi).</p>
                    </div>
                </div>

                {# Connecteur #}
                <div class="step-connector"></div>

                {# Etape 2 #}
                <div class="step-item">
                    <div class="step-number">2</div>
                    <div class="step-content">
                        <h3>Dites "Je viens pour un essai"</h3>
                        <p>L'équipe vous fera visiter, vous expliquera le fonctionnement et vous montrera les vestiaires.</p>
                    </div>
                </div>

                {# Connecteur #}
                <div class="step-connector"></div>

                {# Etape 3 #}
                <div class="step-item">
                    <div class="step-number">3</div>
                    <div class="step-content">
                        <h3>Entraînez-vous !</h3>
                        <p>Profitez de votre séance. N'oubliez pas votre bouteille d'eau et votre serviette.</p>
                    </div>
                </div>
            </div>
        </section>

        {# --- SECTION 4 : CTA FINAL (Checklist + Action) --- #}
        <section class="final-cta-section">
            <div class="cta-card">
                <div class="cta-left">
                    <h3>🎒 Dans votre sac</h3>
                    <ul class="checklist">
                        <li><i class="fa-solid fa-check"></i> Tenue de sport</li>
                        <li><i class="fa-solid fa-check"></i> Baskets propres</li>
                        <li><i class="fa-solid fa-check"></i> Serviette & Eau</li>
                    </ul>
                </div>
                
                <div class="cta-right">
                    <h3>On vous attend !</h3>
                    <p>Pas besoin de réserver, mais si vous avez une question, n'hésitez pas.</p>
                    <div class="action-buttons">
                        <a href="{{ path('contact') }}" class="btn-contact">
                            <i class="fa-regular fa-envelope"></i> Prévenir de ma venue
                        </a>
                        <a href="https://www.google.com/maps/dir//CHM+Saleux" target="_blank" class="btn-map">
                            <i class="fa-solid fa-location-arrow"></i> Itinéraire
                        </a>
                    </div>
                </div>
            </div>
        </section>

    </main>
{% endblock %}