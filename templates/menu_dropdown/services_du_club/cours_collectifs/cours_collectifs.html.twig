{% extends 'base.html.twig' %}

{% block title %}Cours Collectifs - CHM Saleux{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/menu_dropdown/services_du_club/cours_collectifs/cours_collectifs.css') }}">
{% endblock %}

{% block body %}

    {# --- HEADER IMMERSIF --- #}
    <header class="page-header">
        <div class="header-bg" style="background-image: url('{{ asset('images/menu_dropdown/services_du_club/cours_collectifs/cours-co.jpg') }}');"></div>
        <div class="header-overlay"></div>
        
        <div class="container header-content">
            <a href="{{ path('home') }}" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Retour à l'accueil</span>
            </a>
            
            <div class="header-title-box">
                <span class="subtitle">Fitness & Cardio</span>
                <h1>L'Énergie Collective</h1>
                <p>Plus qu'un simple cours, une expérience de groupe. Trouvez la motivation, dépassez vos limites et progressez ensemble.</p>
            </div>
        </div>
    </header>

    <main class="main-container">

        {# --- SECTION 1 : INTRO IMPACTANTE AVEC INFOS CLÉS --- #}
        <section class="energy-intro">
            <div class="container">
                <div class="intro-badge">Saison 2025 / 2026</div>
                <h2>Plus qu'un sport, <span class="text-highlight">une tribu.</span></h2>
                <p class="intro-text">
                    Oubliez la monotonie de l'entraînement en solo. Ici, on transpire ensemble, on se motive ensemble et on progresse ensemble. 
                    Que vous veniez pour brûler des calories ou sculpter votre silhouette, l'énergie du groupe vous poussera toujours plus loin.
                </p>

                {# --- NOUVEAU : BARRE D'INFOS CLÉS --- #}
                <div class="key-facts-wrapper">
                    <div class="fact-item">
                        <div class="fact-icon"><i class="fa-regular fa-clock"></i></div>
                        <div class="fact-text">
                            <strong>45 Minutes</strong>
                            <span>Durée de séance</span>
                        </div>
                    </div>
                    <div class="fact-divider"></div>
                    <div class="fact-item">
                        <div class="fact-icon"><i class="fa-solid fa-calendar-days"></i></div>
                        <div class="fact-text">
                            <strong>Mardi & Jeudi</strong>
                            <span>Créneaux du soir</span>
                        </div>
                    </div>
                    <div class="fact-divider"></div>
                    <div class="fact-item">
                        <div class="fact-icon"><i class="fa-solid fa-fire"></i></div>
                        <div class="fact-text">
                            <strong>2 Séances</strong>
                            <span>Par semaine</span>
                        </div>
                    </div>
                </div>
                {# --- FIN AJOUT --- #}

            </div>
        </section>

        {# --- SECTION 2 : NOS UNIVERS (Grid Cards) --- #}
        <section class="activities-section">
            <div class="container">
                <div class="activities-grid">
                    
                    {# Carte 1 : Cardio #}
                    <div class="activity-card">
                        <div class="card-icon cardio">
                            <i class="fa-solid fa-fire-flame-curved"></i>
                        </div>
                        <div class="card-content">
                            <h3>Cardio & Intense</h3>
                            <p>Pour ceux qui veulent se défouler. Augmentez votre endurance et brûlez un max de calories sur des rythmes entraînants.</p>
                            <ul class="tags">
                                <li>Step</li>
                                <li>LIA</li>
                                <li>HIIT</li>
                            </ul>
                        </div>
                    </div>

                    {# Carte 2 : Renforcement #}
                    <div class="activity-card">
                        <div class="card-icon strength">
                            <i class="fa-solid fa-dumbbell"></i>
                        </div>
                        <div class="card-content">
                            <h3>Renforcement</h3>
                            <p>Sculptez votre corps en profondeur. Des exercices ciblés pour tonifier les abdos, fessiers, cuisses et le haut du corps.</p>
                            <ul class="tags">
                                <li>CAF</li>
                                <li>Pump</li>
                                <li>Abdos-Fessiers</li>
                            </ul>
                        </div>
                    </div>

                    {# Carte 3 : Bien-être #}
                    <div class="activity-card">
                        <div class="card-icon zen">
                            <i class="fa-solid fa-spa"></i>
                        </div>
                        <div class="card-content">
                            <h3>Mobilité & Zen</h3>
                            <p>Prenez soin de vos articulations et améliorez votre souplesse pour un corps fonctionnel et sans douleurs.</p>
                            <ul class="tags">
                                <li>Stretching</li>
                                <li>Pilates</li>
                                <li>Mobilité</li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        {# --- SECTION 3 : COACH PROFILE (Design Asymétrique) --- #}
        <section class="coach-spotlight">
            <div class="container">
                <div class="coach-wrapper">
                    
                    <div class="coach-visual">
                        <div class="image-frame">
                            <img src="{{ asset('images/menu_dropdown/services_du_club/cours_collectifs/3.jpg') }}" alt="Coach Ema">
                        </div>
                        <div class="floating-badge">
                            <i class="fa-solid fa-certificate"></i> Coach Certifiée
                        </div>
                    </div>

                    <div class="coach-text">
                        <span class="sub-title">L'âme du groupe</span>
                        <h2>Rencontrez Ema</h2>
                        <p class="bio">
                            Passionnée et énergique, Ema ne se contente pas de montrer les mouvements : elle vous accompagne. 
                            Son super-pouvoir ? Adapter chaque exercice pour que débutants et confirmés s'amusent dans le même cours.
                        </p>
                        
                        <div class="coach-quote">
                            <i class="fa-solid fa-quote-left"></i>
                            <p>Mon but n'est pas que vous souffriez, mais que vous soyez fiers de vous à la fin de chaque séance.</p>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        {# --- SECTION 4 : PLANNING & CTA --- #}
        <section class="planning-cta-section">
            <div class="cta-box">
                <div class="cta-content">
                    <h2>📅 Vos Rendez-vous de la semaine</h2>
                    <p>
                        Rejoignez-nous tous les <strong>Mardi et Jeudi soirs</strong> pour vos sessions de 45 minutes.<br>
                        Inscrivez-vous sur le groupe pour valider votre présence !
                    </p>
                    
                    <div class="cta-buttons">
                        {# Bouton WhatsApp #}
                        <a href="https://chat.whatsapp.com/TON-LIEN" target="_blank" class="btn-whatsapp">
                            <i class="fa-brands fa-whatsapp"></i> Rejoindre le groupe Info
                        </a>
                        
                        {# Bouton Contact/Essai #}
                        <a href="{{ path('contact') }}" class="btn-trial">
                            Réserver une séance d'essai
                        </a>
                    </div>
                    <p class="cta-note">* Planning susceptible de modifications pendant les vacances scolaires.</p>
                </div>
            </div>
        </section>

    </main>
{% endblock %}