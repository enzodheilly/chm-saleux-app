{% extends 'base.html.twig' %}

{% block title %}Cours Collectifs - CHM Saleux{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/menu_dropdown/services_du_club/cours_collectifs/cours_collectifs.css') }}">
{% endblock %}

{% block body %}

    {# --- HEADER IMMERSIF --- #}
    <header class="page-header">
        <div class="header-bg" style="background-image: url('{{ asset('images/menu_dropdown/services_du_club/cours_collectifs/cours-co.jpg') }}');"></div>
        <div class="header-overlay"></div>
        
        <div class="container header-content">
            <a href="{{ path('home') }}" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Retour à l'accueil</span>
            </a>
            
            <div class="header-title-box">
                <span class="subtitle">Fitness & Cardio</span>
                <h1>L'Énergie Collective</h1>
                <p>Plus qu'un simple cours, une expérience de groupe. Trouvez la motivation, dépassez vos limites et progressez ensemble.</p>
            </div>
        </div>
    </header>

    <main class="main-container">

        {# --- SECTION 1 : LE CONCEPT (Design Poster) --- #}
        <section class="concept-section">
            <div class="concept-grid">
                
                {# Image avec Texte en fond #}
                <div class="concept-visual">
                    <div class="text-backdrop">
                        <span>COLLECTIF</span>
                        <span>ENERGY</span>
                        <span>MOTIVATION</span>
                        <span>COLLECTIF</span>
                    </div>
                    <div class="image-wrapper">
                        <img src="{{ asset('images/menu_dropdown/services_du_club/cours_collectifs/12.jpg') }}" alt="Ambiance Cours Collectifs">
                    </div>
                </div>

                {# Texte Explicatif #}
                <div class="concept-content">
                    <h2 class="section-heading">Bouger Ensemble</h2>
                    <p class="lead-text">
                        Nos cours collectifs sont conçus pour créer une dynamique de groupe où chacun puise sa motivation dans l'énergie des autres.
                    </p>
                    <p>
                        Que vous soyez débutant cherchant à vous remettre en forme ou sportif confirmé en quête de performance, vous trouverez ici un environnement bienveillant et stimulant. Du <strong>Cardio</strong> intense au <strong>Renforcement</strong> profond, en passant par le <strong>Stretching</strong>, chaque séance est une nouvelle étape vers vos objectifs.
                    </p>
                    
                    <div class="benefits-pills">
                        <span>🔥 Cardio</span>
                        <span>💪 Renfo</span>
                        <span>🧘 Bien-être</span>
                        <span>🤝 Convivialité</span>
                    </div>
                </div>
            </div>
        </section>

        {# --- SECTION 2 : LE COACH (Profil) --- #}
        <section class="coach-section">
            <div class="coach-card">
                <div class="coach-image">
                    <img src="{{ asset('images/menu_dropdown/services_du_club/cours_collectifs/3.jpg') }}" alt="Coach Ema">
                </div>
                <div class="coach-info">
                    <span class="coach-label">Votre Coach</span>
                    <h2>Ema</h2>
                    <p class="coach-bio">
                        Avec plusieurs années d'expérience dans le fitness et le bien-être, Ema est l'âme de nos cours collectifs. Sa pédagogie ? Adapter chaque mouvement à votre niveau pour que personne ne soit laissé de côté.
                    </p>
                    <p class="coach-philosophy">
                        <span class="quote-mark">“</span>
                        Ma philosophie : rendre chaque séance dynamique et accessible. Je suis là pour vous faire transpirer avec le sourire !
                        <span class="quote-mark">”</span>
                    </p>
                </div>
            </div>
        </section>

        {# --- SECTION 3 : INSCRIPTION (CTA) --- #}
        <section class="join-section">
            <div class="join-content">
                <h2>Prêt à nous rejoindre ?</h2>
                <p>Venez tester l'ambiance ! Profitez d'une <strong>séance d'essai gratuite</strong>.</p>
                
                <div class="join-actions">
                    <a href="https://chat.whatsapp.com/TON-LIEN-WHATSAPP" target="_blank" class="btn-whatsapp">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.897.001-6.113 4.974-11.085 11.092-11.085 2.962.002 5.748 1.155 7.842 3.25 2.094 2.094 3.246 4.88 3.245 7.842-.001 6.113-4.976 11.086-11.094 11.086-1.928-.001-3.824-.492-5.526-1.427l-5.659 1.495z"/></svg>
                        Rejoindre le groupe WhatsApp
                    </a>
                    <p class="sub-text">Inscriptions auprès du bureau ou via le groupe.</p>
                </div>
            </div>
        </section>

    </main>
{% endblock %}