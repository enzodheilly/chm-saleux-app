{% extends 'base.html.twig' %}

{% block title %}Espace Sauna · CHM Saleux{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/menu_dropdown/services_du_club/sauna/sauna.css') }}">
{% endblock %}

{% block body %}

	<header class="page-header-sport sauna-page-header">
		<div class="header-overlay-gradient"></div>
		<div class="header-content">
			<div class="page-container">
				{% include 'components/breadcrumb.html.twig' with { items: [{ label: 'Le Club' }, { label: 'Sauna' }] } %}
				<div class="header-main-box">
					<h1>Espace
						<span class="text-outline">Sauna</span>
					</h1>
					<p class="lead">Optimisez votre récupération. La chaleur sèche est l'alliée indispensable de l'athlète pour détendre les tissus et éliminer les toxines.</p>
				</div>
			</div>
		</div>
	</header>

	<main class="sauna-root page-shell">
		<div class="sn-wm page-wm" aria-hidden="true">SAUNA</div>

		{# --- BIENFAITS --- #}
		<section class="sn-benefits-section page-container">
			<div class="sn-section-head">
				<h2 class="sn-title">La Performance <span>par le Chaud</span></h2>
				<p class="sn-sub">Le sauna au CHM Saleux n'est pas qu'un moment de détente — c'est un véritable outil de récupération active. Il stimule la circulation sanguine et permet une relaxation mentale totale après vos séances.</p>
			</div>

			<div class="sn-benefits-grid">
				<div class="sn-benefit-card">
					<div class="sn-benefit-icon">
						<i class="fa-solid fa-dumbbell"></i>
					</div>
					<h4>Récupération musculaire</h4>
					<p>La chaleur dilate les vaisseaux et accélère l'évacuation de l'acide lactique, réduisant courbatures et raideurs post-entraînement.</p>
				</div>
				<div class="sn-benefit-card">
					<div class="sn-benefit-icon">
						<i class="fa-solid fa-heart-pulse"></i>
					</div>
					<h4>Circulation sanguine</h4>
					<p>L'alternance chaud/froid stimule le système cardiovasculaire et améliore l'oxygénation des muscles et des organes.</p>
				</div>
				<div class="sn-benefit-card">
					<div class="sn-benefit-icon">
						<i class="fa-solid fa-brain"></i>
					</div>
					<h4>Détente mentale</h4>
					<p>La chaleur libère des endorphines et réduit le cortisol. Une déconnexion totale, idéale après une semaine intense.</p>
				</div>
				<div class="sn-benefit-card">
					<div class="sn-benefit-icon">
						<i class="fa-solid fa-droplet"></i>
					</div>
					<h4>Élimination des toxines</h4>
					<p>La transpiration permet une élimination naturelle des déchets métaboliques accumulés lors de l'effort physique.</p>
				</div>
			</div>
		</section>

		{# --- INFOS PRATIQUES --- #}
		<section class="sn-infos-section">
			<div class="page-container">
				<div class="sn-section-head">
					<h2 class="sn-title">Infos <span>Pratiques</span></h2>
					<p class="sn-sub">Tout ce qu'il faut savoir avant de profiter de l'espace sauna.</p>
				</div>

				<div class="sn-infos-grid">
					<div class="sn-info-card sn-info-card--featured">
						<div class="sn-info-icon">
							<i class="fa-solid fa-calendar-day"></i>
						</div>
						<h3>Le Vendredi soir</h3>
						<p>Le sauna est mis en chauffe exclusivement le <strong>vendredi</strong> pour clôturer votre semaine d'entraînement en beauté.</p>
						<span class="sn-badge">Inclus dans l'adhésion</span>
					</div>

					<div class="sn-info-card">
						<div class="sn-info-icon">
							<i class="fa-solid fa-users"></i>
						</div>
						<h3>Capacité 4 places</h3>
						<p>Pour préserver votre confort et la qualité de l'air, l'accès est limité à <strong>4 personnes</strong> simultanément.</p>
					</div>

					<div class="sn-info-card">
						<div class="sn-info-icon">
							<i class="fa-solid fa-shower"></i>
						</div>
						<h3>Hygiène stricte</h3>
						<p>Une douche est obligatoire avant d'entrer dans le sauna. Pensez à apporter une serviette propre.</p>
					</div>
				</div>
			</div>
		</section>

		{# --- PRÉCAUTIONS --- #}
		<section class="sn-caution-section page-container">
			<div class="sn-caution-card">
				<div class="sn-caution-icon">
					<i class="fa-solid fa-triangle-exclamation"></i>
				</div>
				<div class="sn-caution-content">
					<h3>Précautions médicales</h3>
					<p>L'utilisation du sauna est déconseillée en cas de troubles cardiaques, d'hypertension ou de problèmes circulatoires. Hydratez-vous abondamment avant et après la séance. En cas de doute, consultez votre médecin.</p>
				</div>
			</div>
		</section>

	</main>
{% endblock %}
