{% extends 'base.html.twig' %}

{% block title %}Tarifs & Adhésions — CHM Saleux{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/pricing/index.css') }}">
    {# FontAwesome pour les icônes #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
{% endblock %}

{% block body %}

    {# --- HEADER SPORTIF IMMERSIF --- #}
    <header class="page-header-sport" style="--bg-image: url('{{ asset('images/page.jpg') }}');">
        <div class="header-overlay-gradient"></div>
        <div class="container header-content">
            <nav class="breadcrumb-nav">
                <a href="{{ path('home') }}" class="back-link-minimal">
                    <i class="fa-solid fa-chevron-left"></i> <span>Retour à l'accueil</span>
                </a>
            </nav>

            <div class="header-main-box">
                <div class="badge-accent">Saison 2025 / 2026</div>
                <h1>Tarifs & <span class="text-outline">Adhésions</span></h1>
                <p class="lead">Une structure de haut niveau accessible à tous. Choisissez la formule qui correspond à vos objectifs sportifs.</p>
            </div>
        </div>
    </header>

    <main class="pricing-root">

        {# --- SECTION 1 : GRILLE DES TARIFS --- #}
        <section class="container section-spacer">
            <div class="section-header-center">
                <h2 class="title-with-bar center-bar" style="color:#fff;">Nos <span>Formules</span></h2>
                <p>Accès illimité 800m² : Cardio, Musculation, Haltérophilie et Cours Collectifs.</p>
            </div>

            {# Sélecteur de profil (Standard / Étudiant) #}
            <div class="pricing-selector-wrapper">
                <div class="pricing-selector">
                    <input type="radio" id="type-standard" name="pricing-type" value="standard" checked>
                    <label for="type-standard">Standard</label>
                    
                    <input type="radio" id="type-student" name="pricing-type" value="student">
                    <label for="type-student">Étudiant <span class="discount-badge">-10€</span></label>
                    
                    <div class="selector-highlight"></div>
                </div>
            </div>

            {# Grille d'abonnements (mêmes cards que ton exemple sleek) #}
<div class="pricing-grid">
    {% for plan in plans|default([]) %}

        {# --- PRICE LOGIC (standard vs student) --- #}
        {% set standardPrice = plan.price %}
        {% set studentPrice = plan.price %}

        {% if standardPrice is not null %}
            {% set studentPrice = (standardPrice + 0) - 10 %}
        {% endif %}
        {# --- END LOGIC --- #}

        <article class="sleek-card {{ plan.isPopular ? 'popular-card' : '' }}">

            {% if plan.isPopular %}
                <div class="popular-badge">Le plus choisi</div>
            {% endif %}

            <div class="card-header">
                <h3 class="plan-title">{{ plan.name }}</h3>

                <div class="plan-price">
                    <span class="currency">€</span>
                    <span class="price-value"
                          data-standard="{{ standardPrice }}"
                          data-student="{{ studentPrice }}">
                        {{ standardPrice }}
                    </span>

                    <span class="period">
                        /
                        {% set period = plan.billingPeriod %}
                        {% if period == 'year' %}an
                        {% elseif period == 'month' %}mois
                        {% elseif period == 'quarter' %}trimestre
                        {% elseif period == 'semester' %}semestre
                        {% else %}session{% endif %}
                    </span>
                </div>

                {% if plan.monthlyPrice %}
                    <div class="monthly-detail">Soit ~{{ plan.monthlyPrice|number_format(0) }}€ / mois</div>
                {% else %}
                    <div class="monthly-detail invisible">-</div>
                {% endif %}
            </div>

            <div class="card-body">
                <div class="trial-info">
                    <i class="fa-solid fa-check-circle" aria-hidden="true"></i>
                    <span>Séance d'essai incluse</span>
                </div>

                <ul class="features-list">
                    {% for benefit in plan.benefits %}
                        {% set parts = benefit|split('|') %}
                        <li>
                            <i class="fa-solid fa-check icon-check" aria-hidden="true"></i>
                            <span>
                                {% if parts|length > 1 %}
                                    {{ parts[1]|trim }}
                                {% else %}
                                    {{ benefit }}
                                {% endif %}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <div class="card-footer">
                <a href="{{ path('contact') }}"
                   class="btn-select {{ plan.isPopular ? 'btn-red' : 'btn-dark' }}">
                    Sélectionner
                </a>
            </div>

        </article>

    {% endfor %}
</div>

        <div class="info-note">
  <p>
    <strong>Important :</strong>
    Pour valider votre adhésion, merci de remplir le formulaire officiel de licence <strong>FFHM</strong>.
    Vous pouvez le télécharger <a href="{{ asset('docs/formulaire-licence-ffhm.pdf') }}" target="_blank" rel="noopener">ici</a>.
    Une fois votre paiement effectué, vous pourrez remettre le formulaire complété au bureau du club.
  </p>
</div>

        </section>

        {# --- IMAGE DE TRANSITION 1 (PARALLAX) --- #}
        <div class="parallax-separator" style="background-image: url('{{ asset('images/club4.jpg') }}');">
            <div class="parallax-overlay"></div>
            <div class="parallax-content">
                <h2>L'esprit d'équipe</h2>
                <p>Plus qu'une salle, une communauté soudée pour performer.</p>
            </div>
        </div>

        {# --- SECTION 2 : OFFRES SPÉCIFIQUES --- #}
        <section class="bg-dark-alternate section-spacer">
            <div class="container">
                <div class="section-header-center">
                    <h2 class="title-with-bar center-bar" style="color:#fff;">Offres <span>Spécifiques</span></h2>
                    <p>Familles nombreuses ou compétiteurs, nous avons pensé à vous.</p>
                </div>

                <div class="specials-grid">
                    {# Carte Famille #}
                    <div class="special-card">
                        <div class="icon-box"><i class="fa-solid fa-users"></i></div>
                        <h3>Offre Famille</h3>
                        <p>Réduction pour les membres d'un même foyer.</p>
                        <ul class="special-list">
                            <li><span>2ème licence</span> <strong>-10%</strong></li>
                            <li><span>3ème licence</span> <strong>-15%</strong></li>
                            <li><span>4ème et +</span> <strong>-20%</strong></li>
                        </ul>
                    </div>

                    {# Carte Compétition #}
                    <div class="special-card">
                        <div class="icon-box gold"><i class="fa-solid fa-trophy"></i></div>
                        <h3>Compétition FFHM</h3>
                        <p>Rejoignez nos équipes en championnat.</p>
                        <ul class="special-list">
                            <li><span>Benjamins (8-13 ans)</span> <strong>50 €*</strong></li>
                            <li><span>Cadets/Juniors</span> <strong>75 €</strong></li>
                            <li><span>Séniors (+21 ans)</span> <strong>95 €</strong></li>
                        </ul>
                        <small class="text-muted">* Gratuit si un parent est inscrit au club.</small>
                    </div>
                </div>
            </div>
        </section>

        {# --- IMAGE DE TRANSITION 2 (PARALLAX) --- #}
        <div class="parallax-separator" style="background-image: url('{{ asset('images/club9.jpg') }}');">
            <div class="parallax-overlay"></div>
            <div class="parallax-content">
                <h2>Inscription en cours d'année ?</h2>
                <p>Ne payez que ce que vous consommez avec nos tarifs dégressifs.</p>
            </div>
        </div>

        {# --- SECTION 3 : TARIFS DÉGRESSIFS --- #}
        <section class="container section-spacer">
            <div class="section-header-center">
                <h2 class="title-with-bar center-bar" style="color:#fff;">Tarifs <span>Dégressifs</span></h2>
                <p>Prorata temporis selon votre mois d'arrivée.</p>
            </div>

            <div class="table-container-modern">
                <table class="pricing-table">
                    <thead>
                        <tr>
                            <th>Mois d'inscription</th>
                            <th>Tarif Plein</th>
                            <th>Tarif Réduit</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>Septembre — Décembre</td><td><strong>200 €</strong></td><td>185 €</td></tr>
                        <tr><td>Janvier</td><td><strong>185 €</strong></td><td>175 €</td></tr>
                        <tr><td>Février</td><td><strong>170 €</strong></td><td>160 €</td></tr>
                        <tr><td>Mars</td><td><strong>150 €</strong></td><td>140 €</td></tr>
                        <tr><td>Avril</td><td><strong>125 €</strong></td><td>115 €</td></tr>
                        <tr><td>Mai</td><td><strong>100 €</strong></td><td>90 €</td></tr>
                        <tr><td>Juin</td><td><strong>80 €</strong></td><td>70 €</td></tr>
                        <tr><td>Juillet</td><td><strong>60 €</strong></td><td>50 €</td></tr>
                        <tr><td>Août</td><td><strong>30 €</strong></td><td>30 €</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        {# --- SECTION 4 : FACILITÉS DE PAIEMENT --- #}
        <section class="bg-dark-alternate section-spacer">
            <div class="container">
                <div class="split-layout">
                    <div class="text-content">
                        <div class="badge-accent">Facilités de paiement</div>
                        <h2 class="title-with-bar" style="color:#fff;">Payez à <span>Votre Rythme</span></h2>
                        <p class="desc-text" style="color:#ddd;">
                            Nous croyons que le budget ne doit pas être un frein à la pratique du sport. 
                            Étalez votre cotisation annuelle sur 3 mois, par chèque, sans aucun frais supplémentaire.
                        </p>
                        <ul class="feature-check-list">
                            <li><i class="fa-solid fa-circle-check"></i> <strong>Sans frais</strong> : Pas d'intérêts cachés.</li>
                            <li><i class="fa-solid fa-circle-check"></i> <strong>Simple</strong> : 3 chèques remis à l'inscription.</li>
                            <li><i class="fa-solid fa-circle-check"></i> <strong>Garanti</strong> : Encaissements différés chaque mois.</li>
                        </ul>
                    </div>

                    <div class="timeline-visual">
                        <div class="timeline-step current">
                            <div class="step-icon">1</div>
                            <div class="step-info">
                                <strong>Inscription</strong>
                                <span>~67 € (1er chèque)</span>
                            </div>
                        </div>
                        <div class="timeline-connector"></div>
                        <div class="timeline-step">
                            <div class="step-icon">2</div>
                            <div class="step-info">
                                <strong>Mois +1</strong>
                                <span>~67 € (2ème chèque)</span>
                            </div>
                        </div>
                        <div class="timeline-connector"></div>
                        <div class="timeline-step">
                            <div class="step-icon">3</div>
                            <div class="step-info">
                                <strong>Mois +2</strong>
                                <span>~66 € (Dernier chèque)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const radios = document.querySelectorAll('input[name="pricing-type"]');
            const priceValues = document.querySelectorAll('.price-value');

            radios.forEach(radio => {
                radio.addEventListener('change', (e) => {
                    const type = e.target.value; // 'standard' ou 'student'
                    
                    priceValues.forEach(el => {
                        const newPrice = el.dataset[type];
                        
                        // Petite animation de transition
                        el.style.opacity = '0';
                        el.style.transform = 'translateY(-10px)';
                        
                        setTimeout(() => {
                            el.textContent = newPrice ? newPrice : '-';
                            el.style.opacity = '1';
                            el.style.transform = 'translateY(0)';
                        }, 200);
                    });
                });
            });
        });
    </script>
{% endblock %}