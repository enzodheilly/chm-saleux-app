{% extends 'base.html.twig' %}

{% block title %}Tarifs & Adhésions - CHM Saleux{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/pricing/index.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
{% endblock %}

{% block body %}

    {# --- HEADER IMMERSIF --- #}
    <header class="page-header">
        <div class="header-bg" style="background-image: url('{{ asset('images/club/banner.jpg') }}');"></div>
        <div class="header-overlay"></div>
        
        <div class="container header-content">
            <a href="{{ path('home') }}" class="back-link">
                <i class="fa-solid fa-arrow-left"></i> Retour à l'accueil
            </a>
            
            <div class="header-title-box">
                <span class="subtitle">Saison 2025 / 2026</span>
                <h1>Tarifs & Adhésions</h1>
                <p>Une structure de haut niveau accessible à tous. Choisissez la formule qui correspond à vos objectifs.</p>
            </div>
        </div>
    </header>

    {# --- SECTION DES CARTES (DESIGN UPGRADÉ) --- #}
<section class="sleek-pricing-section">
  <div class="container-narrow">
    
    <div class="pricing-header">
      <h2 class="section-title">Choisissez votre formule</h2>
      <p class="section-subtitle">
        Tarifs fixes pour la saison 2025 / 2026. <br>Accès illimité 800m², cardio, muscu, haltéro.
      </p>
    </div>

    <div class="pricing-selector-wrapper">
      <div class="pricing-selector">
        <input type="radio" id="type-standard" name="pricing-type" value="standard" class="js-pricing-trigger" checked>
        <label for="type-standard" class="selector-item">Standard</label>
        
        <input type="radio" id="type-student" name="pricing-type" value="student" class="js-pricing-trigger">
        <label for="type-student" class="selector-item">
          Étudiant <span class="discount-tag">-10€</span>
        </label>
        <div class="selector-glider"></div> 
      </div>
    </div>

    <div class="pricing-grid">
      {% for plan in plans %}
        {% set standardPrice = plan.prix %}
        {% set studentPrice = plan.prix >= 195 ? 185 : (plan.prix_etudiant ?? plan.prix) %}

        <article class="sleek-card {{ plan.isPopular ? 'popular-card' : '' }}">
          {% if plan.isPopular %}
            <div class="popular-badge">Le plus choisi</div>
          {% endif %}

          <div class="card-header">
            <h3 class="plan-title">{{ plan.nom }}</h3>
            <div class="plan-price">
              <span class="currency">€</span>
              <span class="price-value js-price-value" data-standard="{{ standardPrice }}" data-student="{{ studentPrice }}">
                {{ standardPrice }}
              </span>
              <span class="period">/ {{ plan.frequence|lower }}</span>
            </div>
            {% if plan.mensualite %}
              <div class="monthly-detail">Soit ~{{ plan.mensualite|number_format(0) }}€ / mois</div>
            {% endif %}
          </div>

          <div class="card-body">
            <div class="trial-info">
              <i class="fa-solid fa-check-circle"></i> Séance d'essai incluse
            </div>
            <ul class="features-list">
              {% for avantage in plan.avantages %}
                <li><i class="fa-solid fa-check icon-check"></i> <span>{{ avantage|split('|')|last }}</span></li>
              {% endfor %}
            </ul>
          </div>

          <div class="card-footer">
            <a href="{{ path('contact') }}" class="btn-select {{ plan.isPopular ? 'btn-red' : 'btn-dark' }}">Sélectionner</a>
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="pricing-note">
      <i class="fa-solid fa-circle-info"></i>
      <p><strong>Note :</strong> Pensez à remplir et remettre votre formulaire de licence au bureau avant le paiement.</p>
    </div>
  </div>
</section>

{# --- IMAGE DE TRANSITION 1 (PARALLAX) --- #}
<div class="parallax-divider pricing-parallax" style="background-image: url('{{ asset('images/club/pricing.jpg') }}');">
    <div class="parallax-overlay"></div>
    <div class="parallax-content">
        <h2>L'esprit d'équipe</h2>
        <p>Plus qu'une salle, une communauté.</p>
    </div>
</div>

{# --- OFFRES SPÉCIFIQUES --- #}
<section class="section-light">
    <h2 class="section-title text-center">Offres Spécifiques</h2>
    <p class="section-subtitle text-center">Familles nombreuses ou compétiteurs, nous avons pensé à vous.</p>

    <div class="info-grid">
        <div class="info-card family">
            <div class="info-icon" style="color:#005b94;"><i class="fa-solid fa-users"></i></div>
            <h3 style="font-weight: 800; margin-bottom: 15px;">OFFRE FAMILLE</h3>
            <p style="color:#64748b; margin-bottom:20px;">Réduction pour les membres d'un même foyer.</p>
            <table class="custom-table" style="box-shadow:none; border:1px solid #f1f5f9;">
                <tr><td>2ème licence</td><td style="color:#10b981; font-weight:800; text-align: right;">- 10 %</td></tr>
                <tr><td>3ème licence</td><td style="color:#10b981; font-weight:800; text-align: right;">- 15 %</td></tr>
                <tr><td>4ème licence et +</td><td style="color:#10b981; font-weight:800; text-align: right;">- 20 %</td></tr>
            </table>
        </div>

        <div class="info-card comp">
            <div class="info-icon" style="color:#fbbf24;"><i class="fa-solid fa-trophy"></i></div>
            <h3 style="font-weight: 800; margin-bottom: 15px;">COMPÉTITION FFHM</h3>
            <p style="color:#64748b; margin-bottom:20px;">Rejoignez l'équipe compétition.</p>
            <table class="custom-table" style="box-shadow:none; border:1px solid #f1f5f9;">
                <tr><td>Benjamins (8-13 ans)</td><td style="font-weight:700; text-align: right;">50,00 €*</td></tr>
                <tr><td>Cadets/Juniors</td><td style="font-weight:700; text-align: right;">75,00 €</td></tr>
                <tr><td>Séniors (+21 ans)</td><td style="font-weight:700; text-align: right;">95,00 €</td></tr>
            </table>
            <div style="font-size:0.8rem; color:#94a3b8; margin-top:10px;">* Gratuit si un parent est inscrit.</div>
        </div>
    </div>
</section>

{# --- IMAGE DE TRANSITION 2 (PARALLAX) --- #}
<div class="parallax-divider" style="background-image: url('{{ asset('images/ecole.jpg') }}'); height: 300px;">
    <div class="parallax-overlay"></div>
    <div class="parallax-content">
        <h2>Inscription en cours d'année ?</h2>
        <p>Ne payez que ce que vous consommez.</p>
    </div>
</div>

{# --- TABLEAU DÉGRESSIF --- #}
<section class="section-white">
    <h2 class="section-title text-center">Tarifs Dégressifs</h2>
    <div class="table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Mois d'inscription</th>
                    <th style="text-align: center;">Tarif Plein</th>
                    <th style="text-align: center;">Tarif Réduit</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>Septembre à Décembre</td><td style="text-align: center; font-weight:700;">200,00 €</td><td style="text-align: center;">185,00 €</td></tr>
                <tr><td>Janvier</td><td style="text-align: center; font-weight:700;">185,00 €</td><td style="text-align: center;">175,00 €</td></tr>
                <tr><td>Mars</td><td style="text-align: center; font-weight:700;">150,00 €</td><td style="text-align: center;">140,00 €</td></tr>
                <tr><td>Mai</td><td style="text-align: center; font-weight:700;">100,00 €</td><td style="text-align: center;">90,00 €</td></tr>
                <tr><td>Août</td><td style="text-align: center; font-weight:700;">30,00 €</td><td style="text-align: center;">30,00 €</td></tr>
            </tbody>
        </table>
    </div>
</section>

{# --- FOOTER PAIEMENT --- #}
<footer class="payment-footer">
    <h3>Moyens de paiement acceptés</h3>
    <div class="payment-icons">
        <i class="fa-solid fa-money-bill-1-wave"></i>
        <i class="fa-solid fa-money-check"></i>
        <i class="fa-regular fa-credit-card"></i>
    </div>
    <div style="background: rgba(255,255,255,0.1); display: inline-block; padding: 10px 20px; border-radius: 50px;">
        <i class="fa-solid fa-info-circle"></i> Paiement en <strong>2 ou 3 fois</strong> possible.
    </div>
</footer>
{% endblock %}