{% extends 'base.html.twig' %}

{% block title %}Devenir Partenaire — CHM Saleux
{% endblock %}

{% block og_title %}Devenir Partenaire — CHM Saleux
{% endblock %}

{% block og_description %}Associez votre entreprise aux valeurs de performance et de dépassement de soi du CHM Saleux. Visibilité locale, déduction fiscale 60%, partenariat sur-mesure.
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/partenaires/index.css') }}">
{% endblock %}

{% block body %}

	<header class="page-header-sport partner-page-header">
		<div class="header-overlay-gradient"></div>
		<div class="header-content">
			<div class="page-container">
				<nav class="breadcrumb-nav">
					<a href="{{ path('home') }}" class="back-link-minimal">
						<i class="fa-solid fa-chevron-left"></i>
						<span>Accueil</span>
					</a>
				</nav>
				<div class="header-main-box">
					<div class="badge-accent">Sponsoring & Mécénat</div>
					<h1>Devenez
						<span class="text-outline">Partenaire</span>
					</h1>
					<p class="lead">
						Associez l'image de votre entreprise aux valeurs de performance,<br>
						de dépassement de soi et de solidarité du CHM Saleux.
					</p>
					<div class="hero-cta-row">
						<a href="{{ path('contact') }}" class="hero-btn-primary">
							Discuter d'un partenariat
							<i class="fa-solid fa-arrow-right"></i>
						</a>
					</div>
				</div>
			</div>
		</div>
	</header>

	<main class="page-shell partner-root">

		{# --- ARGUMENTS --- #}
		<section class="partner-args-section page-container">
			<div class="partner-section-head">
				<span class="section-eyebrow">Pourquoi nous soutenir ?</span>
				<h2 class="section-heading">Une visibilité
					<span>locale & nationale</span>
				</h2>
				<p class="section-sub">Chaque partenariat est une opportunité concrète de rayonner auprès d'une communauté sportive engagée.</p>
			</div>

			<div class="arguments-grid">
				<div class="arg-card">
					<div class="arg-icon-wrap">
						<i class="fa-solid fa-eye"></i>
					</div>
					<div class="arg-body">
						<h3>Visibilité Locale</h3>
						<p>Votre logo sur nos tenues, affiches et réseaux sociaux. Touchez une audience locale large et engagée tout au long de la saison.</p>
					</div>
				</div>

				<div class="arg-card">
					<div class="arg-icon-wrap">
						<i class="fa-solid fa-medal"></i>
					</div>
					<div class="arg-body">
						<h3>Image Positive</h3>
						<p>Associez votre marque au dynamisme, à la santé et à la réussite sportive. Renforcez votre ancrage territorial durablement.</p>
					</div>
				</div>

				<div class="arg-card">
					<div class="arg-icon-wrap">
						<i class="fa-solid fa-handshake"></i>
					</div>
					<div class="arg-body">
						<h3>Réseau B2B</h3>
						<p>Intégrez le cercle des partenaires. Participez à nos événements et développez vos relations professionnelles locales.</p>
					</div>
				</div>

				<div class="arg-card">
					<div class="arg-icon-wrap">
						<i class="fa-solid fa-trophy"></i>
					</div>
					<div class="arg-body">
						<h3>Compétitions FFHM</h3>
						<p>Votre marque visible lors des championnats régionaux et nationaux, relayée sur les médias sportifs officiels.</p>
					</div>
				</div>
			</div>
		</section>

		{# --- FISCALITÉ --- #}
		<section class="tax-section page-container">
			<div class="tax-card">
				<div class="tax-visual">
					<div class="tax-circle">
						<span class="tax-pct">60%</span>
						<span class="tax-pct-lbl">de déduction</span>
					</div>
				</div>
				<div class="tax-content">
					<span class="badge-tax">Loi Mécénat — Art. 238 bis CGI</span>
					<h2>Un avantage fiscal<br>immédiat</h2>
					<p>Le CHM Saleux est une association reconnue d'intérêt général. Votre don ouvre droit à une réduction d'impôt de <strong>60%</strong> du montant versé, dans la limite de 20 000 € ou 5 ‰ de votre chiffre d'affaires HT.</p>
					<div class="tax-example">
						<div class="tax-ex-item">
							<span class="tax-ex-label">Don de</span>
							<span class="tax-ex-val">500 €</span>
						</div>
						<i class="fa-solid fa-arrow-right tax-ex-arrow"></i>
						<div class="tax-ex-item">
							<span class="tax-ex-label">Coût réel</span>
							<span class="tax-ex-val tax-ex-val--orange">200 €</span>
						</div>
					</div>
					<p class="tax-legal">*Déduction applicable sur IS ou IR. Soumis aux conditions légales en vigueur.</p>
				</div>
			</div>
		</section>

		{# --- TYPES DE SOUTIEN --- #}
		<section class="support-section page-container">
			<div class="partner-section-head">
				<span class="section-eyebrow">Modalités</span>
				<h2 class="section-heading">Trois façons de
					<span>nous aider</span>
				</h2>
			</div>

			<div class="support-grid">
				<div class="support-card">
					<div class="support-num-badge">01</div>
					<div class="support-icon"><i class="fa-solid fa-coins"></i></div>
					<h4>Mécénat Financier</h4>
					<p>Financement direct de matériel olympique, de déplacements en compétition nationale ou de travaux d'aménagement.</p>
				</div>
				<div class="support-card">
					<div class="support-num-badge">02</div>
					<div class="support-icon"><i class="fa-solid fa-box-open"></i></div>
					<h4>Mécénat en Nature</h4>
					<p>Don de matériel, dotation pour nos événements, ravitaillement pour nos athlètes ou mise à disposition d'équipements.</p>
				</div>
				<div class="support-card">
					<div class="support-num-badge">03</div>
					<div class="support-icon"><i class="fa-solid fa-lightbulb"></i></div>
					<h4>Mécénat de Compétences</h4>
					<p>Mise à disposition de savoir-faire dans les domaines de la communication, de la logistique ou de l'aménagement.</p>
				</div>
			</div>
		</section>

		{# --- PARTENAIRES ACTUELS --- #}
		<section class="current-partners-section page-container">
			<div class="partner-section-head">
				<span class="section-eyebrow">Ils nous font confiance</span>
				<h2 class="section-heading">Nos partenaires
					<span>actuels</span>
				</h2>
			</div>
			<div class="partners-logos-row">
				<div class="partner-logo-item">
					<img src="{{ asset('images/sponsors/logo-conseil-departemental-somme.png') }}" alt="Conseil Départemental de la Somme" loading="lazy">
				</div>
				<div class="partner-logo-item">
					<img src="{{ asset('images/sponsors/logo-hdf.png') }}" alt="Hauts-de-France" loading="lazy">
				</div>
				<div class="partner-logo-item">
					<img src="{{ asset('images/sponsors/logo-vectoriel-amiens-metropole.png') }}" alt="Amiens Métropole" loading="lazy">
				</div>
				<div class="partner-logo-item">
					<img src="{{ asset('images/sponsors/FFHMFAC.png') }}" alt="FFHM FAC" loading="lazy">
				</div>
				<div class="partner-logo-item">
					<img src="{{ asset('images/sponsors/Logo-legue-chauffage.png') }}" alt="Legue Chauffage" loading="lazy">
				</div>
				<div class="partner-logo-item">
					<img src="{{ asset('images/sponsors/mairie-saleux.jpg') }}" alt="Mairie de Saleux" loading="lazy">
				</div>
				<div class="partner-logo-item">
					<img src="{{ asset('images/sponsors/nicolas-coiffeur.jpg') }}" alt="L'Atelier de Nicolas" loading="lazy">
				</div>
			</div>
		</section>

		{# --- CTA FINAL --- #}
		<section class="partner-cta-section page-container">
			<div class="partner-cta-card">
				<div class="cta-deco-line"></div>
				<div class="cta-inner">
					<div class="cta-text-side">
						<span class="section-eyebrow section-eyebrow--orange">Prêt à nous rejoindre ?</span>
						<h2 class="cta-title">Construisons un projet<br>
							<span>ensemble</span>
						</h2>
						<p>Nous étudions chaque demande pour créer un partenariat sur-mesure, adapté à vos objectifs de communication et à votre budget.</p>
					</div>
					<div class="cta-actions-side">
						<a href="{{ path('contact') }}" class="cta-btn-main">
							<i class="fa-solid fa-calendar-check"></i>
							Prendre rendez-vous
						</a>
						<a href="tel:0322897257" class="cta-btn-phone">
							<i class="fa-solid fa-phone"></i>
							03.22.89.72.57
						</a>
						<p class="cta-reassure">Réponse garantie sous 48h ouvrées</p>
					</div>
				</div>
			</div>
		</section>

	</main>
{% endblock %}
