{# templates/partials/_register_modal.html.twig #}
<div class="modal-overlay" id="registerModal" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="registerModalTitle">

        <button class="modal-close" type="button" aria-label="Fermer" id="closeRegisterModal">×</button>

        <!-- === ÉTAPE 1 : Choix social/email === -->
        <div id="modal-step-social" class="register-step-social" aria-hidden="false">
            <h3 id="registerModalTitle" class="modal-title register-modal-title-main">
                LA FORCE SE CONSTRUIT. COMMENCE AUJOURD’HUI !
            </h3>

            <div class="modal-actions">
                <div class="button-wrap-payment">
                    <a class="btn-payment" href="{{ path('oauth_google_start') }}">
                        <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google" width="20" height="20">
                        <span class="register-google-text">CONTINUER AVEC GOOGLE</span>
                    </a>
                    <div class="button-shadow"></div>
                </div>
            </div>

            <div class="modal-divider">
                <span>ou</span>
            </div>

            <p class="modal-sep">
                Inscris-toi avec ton
                <a href="#" id="js-switch-to-email">Adresse e-mail</a>
            </p>

            <p class="modal-footer">
                Tu as déjà un compte ?
                <a href="#" class="js-open-login-modal">Se connecter</a>
            </p>
        </div>

        <!-- === ÉTAPE 2 : Inscription par e-mail === -->
        <div id="modal-step-email" class="register-step-email is-relative" hidden aria-hidden="true">
            <div class="email-register-card">
                <h3 class="modal-title register-modal-title-strong">CRÉER UN COMPTE</h3>

                <form id="emailRegisterForm"
                      class="email-register-form"
                      action="{{ path('app_register') }}"
                      method="POST"
                      novalidate
                      autocomplete="on">

                    <input type="hidden" name="_token" value="{{ csrf_token('register') }}">

                    <div class="form-group">
                        <label for="register-firstname">Prénom</label>
                        <input type="text"
                               id="register-firstname"
                               name="registration_form[firstName]"
                               placeholder="Votre prénom"
                               required
                               autocomplete="given-name">
                    </div>

                    <div class="form-group">
                        <label for="register-lastname">Nom</label>
                        <input type="text"
                               id="register-lastname"
                               name="registration_form[lastName]"
                               placeholder="Votre nom"
                               required
                               autocomplete="family-name">
                    </div>

                    <div class="form-group">
                        <label for="register-email">Email</label>
                        <input type="email"
                               id="register-email"
                               name="registration_form[email]"
                               placeholder="exemple@email.com"
                               required
                               autocomplete="email">
                    </div>

                    <div class="form-group password-group">
                        <div class="password-criteria-modal" id="passwordRulesModal">
                            <div class="password-criteria-content">
                                <h2>Critères du mot de passe</h2>
                                <p class="password-rules-intro">
                                    Conformément aux recommandations RGPD, ton mot de passe doit respecter ces critères
                                    pour garantir une sécurité optimale de ton compte :
                                </p>
                                <ul>
                                    <li id="rule-length">Au moins <strong>12 caractères</strong></li>
                                    <li id="rule-uppercase">Contenir <strong>une majuscule</strong></li>
                                    <li id="rule-lowercase">Contenir <strong>une minuscule</strong></li>
                                    <li id="rule-number">Contenir <strong>un chiffre</strong></li>
                                    <li id="rule-special">Contenir <strong>un caractère spécial</strong></li>
                                </ul>
                                <button type="button" class="btn-close-rules" id="closePasswordRules">Fermer</button>
                            </div>
                        </div>

                        <div class="password-label-wrapper">
                            <label for="register-password">Mot de passe</label>
                            <span class="password-rules-link" id="openPasswordRules">Voir les critères</span>
                        </div>

                        <div class="password-input-wrapper">
                            <input type="password"
                                   id="register-password"
                                   name="registration_form[password][first]"
                                   placeholder="Mot de passe"
                                   required
                                   minlength="12"
                                   maxlength="128"
                                   autocomplete="new-password">
                            <span class="toggle-password" data-target="register-password">
                                <img src="{{ asset('images/eye/eye-open.png') }}" alt="Afficher" class="eye-open eye-icon-register">
                                <img src="{{ asset('images/eye/eye-closed.png') }}" alt="Cacher" class="eye-closed hide eye-icon-register">
                            </span>
                        </div>
                    </div>

                    <div class="form-group password-group">
                        <label for="register-confirm-password">Confirmer le mot de passe</label>
                        <div class="password-input-wrapper">
                            <input type="password"
                                   id="register-confirm-password"
                                   name="registration_form[password][second]"
                                   placeholder="Confirmez le mot de passe"
                                   required
                                   minlength="12"
                                   maxlength="128"
                                   autocomplete="new-password">
                            <span class="toggle-password" data-target="register-confirm-password">
                                <img src="{{ asset('images/eye/eye-open.png') }}" alt="Afficher" class="eye-open eye-icon-register">
                                <img src="{{ asset('images/eye/eye-closed.png') }}" alt="Cacher" class="eye-closed hide eye-icon-register">
                            </span>
                        </div>
                    </div>

                    <div class="checkbox-group">
                        <label>
                            <input type="checkbox" name="registration_form[acceptedTerms]" required>
                            En m’inscrivant, j’accepte les
                            <a href="#">Conditions générales</a>
                            et la
                            <a href="#">Politique de confidentialité</a>.
                        </label>
                    </div>

                    <div id="form-error-message" class="form-error-message" hidden aria-hidden="true"></div>

                    <div class="form-group text-center mt-3">
                        <div class="cf-turnstile"
                             data-sitekey="{{ turnstile_site_key }}"
                             data-theme="light"
                             data-size="normal"></div>
                    </div>

                    <button type="submit" class="btn-register">
                        <span class="btn-text">S'INSCRIRE</span>
                        <span class="btn-spinner" hidden aria-hidden="true">
                            <div class="mini-spinner"></div>
                        </span>
                    </button>

                    <p class="modal-footer">
                        <a href="#" id="js-back-to-social">← Retour</a>
                    </p>
                </form>
            </div>
        </div>

        <!-- === ÉTAPE 3 : Vérification code === -->
        <div id="modal-step-verify" class="register-step-email is-relative" hidden aria-hidden="true">
            <div class="email-register-card">
                <h3 class="modal-title register-modal-title-strong">Vérification de votre compte</h3>
                <p class="modal-subtitle">Entrez le code à 6 chiffres reçu par e-mail.</p>

                <form id="verify-form" action="{{ path('app_verify_code') }}" method="POST" novalidate autocomplete="off">
                    <input type="hidden" name="_token" value="{{ csrf_token('verify_code') }}">

                    <div class="verify-code-inputs">
                        {% for i in 1..6 %}
                            <input type="text"
                                   maxlength="1"
                                   inputmode="numeric"
                                   pattern="[0-9]*"
                                   class="code-input"
                                   name="code_digit_{{ i }}"
                                   data-index="{{ i }}"
                                   required
                                   {% if i == 1 %}autocomplete="one-time-code"{% else %}autocomplete="off"{% endif %}>
                        {% endfor %}
                    </div>

                    <input type="hidden" name="code" id="verify-full-code">

                    <div id="verifyMessage" class="verify-message" hidden aria-hidden="true"></div>

                    <button type="submit" id="verifyButton" class="btn-register">
                        <span class="btn-text">Vérifier mon compte</span>
                        <span class="btn-spinner" hidden aria-hidden="true">
                            <div class="mini-spinner"></div>
                        </span>
                    </button>
                </form>

                <div class="resend">
                    <span>Pas reçu ?</span>
                    <form id="resendCodeForm" action="{{ path('app_resend_code') }}" method="POST" class="inline-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('resend_code') }}">
                        <button type="submit" id="resendCodeBtn" class="link-like-button">Renvoyer un nouveau code</button>
                    </form>
                </div>

                <p class="modal-footer">
                    <a href="#" id="js-back-to-email">← Retour à l’inscription</a>
                </p>
            </div>
        </div>

        <!-- === ÉTAPE 4 : Connexion === -->
        <div id="modal-step-login" class="register-step-email is-relative" hidden aria-hidden="true">
            <div class="email-register-card">
                <h3 class="modal-title register-modal-title-strong">CONNEXION</h3>

                <form id="login-form" action="{{ path('app_login') }}" method="POST" novalidate autocomplete="on">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="form-group">
                        <label for="login-email">Adresse e-mail</label>
                        <input type="email"
                               id="login-email"
                               name="email"
                               placeholder="exemple@email.com"
                               required
                               autocomplete="email">
                    </div>

                    <div class="form-group password-group">
                        <label for="login-password">Mot de passe</label>
                        <div class="password-input-wrapper">
                            <input type="password"
                                   id="login-password"
                                   name="password"
                                   placeholder="Votre mot de passe"
                                   required
                                   autocomplete="current-password">
                            <span class="toggle-password" data-target="login-password">
                                <img src="{{ asset('images/eye/eye-open.png') }}" alt="Afficher" class="eye-open eye-icon-login">
                                <img src="{{ asset('images/eye/eye-closed.png') }}" alt="Cacher" class="eye-closed hide eye-icon-login">
                            </span>
                        </div>
                    </div>

                    <div class="checkbox-group remember-me">
                        <label>
                            <input type="checkbox" name="_remember_me">
                            Se souvenir de moi
                        </label>
                    </div>

                    <div class="form-group text-center mt-3">
                        <div class="cf-turnstile"
                             data-sitekey="{{ turnstile_site_key }}"
                             data-theme="light"
                             data-size="normal"></div>
                    </div>

                    <div id="loginError" class="login-error" hidden aria-hidden="true"></div>

                    <button type="submit" id="loginButton" class="btn-register">
                        <span class="btn-text">SE CONNECTER</span>
                        <span class="btn-spinner" hidden aria-hidden="true">
                            <div class="mini-spinner"></div>
                        </span>
                    </button>
                </form>

                <p class="forgot-password">
                    <a href="#" id="js-forgot-password" class="js-open-reset-modal">Mot de passe oublié ?</a>
                </p>

                <p class="modal-back">
                    <a href="#" id="js-back-to-social-login" class="modal-back-home-link">← Retour à l’accueil</a>
                </p>
            </div>
        </div>

        <!-- === ÉTAPE 5 : Mot de passe oublié === -->
        <div id="modal-step-reset-email" class="register-step-email is-relative" hidden aria-hidden="true">
            <div class="email-register-card text-center">
                <h3 class="modal-title register-modal-title-strong">MOT DE PASSE OUBLIÉ</h3>
                <p class="modal-subtitle">Entrez votre adresse e-mail pour recevoir un lien de réinitialisation.</p>

                <div id="resetError" class="verify-message" hidden aria-hidden="true"></div>

                <form id="resetRequestForm" action="{{ path('app_reset_password_request') }}" method="POST" novalidate>
                    <input type="hidden" name="_token" value="{{ csrf_token('reset_request') }}">
                    <input type="email" name="email" id="resetEmail" placeholder="Votre adresse e-mail" required autocomplete="email">

                    <div class="form-group text-center mt-3">
                        <div class="cf-turnstile"
                             data-sitekey="{{ turnstile_site_key }}"
                             data-theme="light"
                             data-size="normal"></div>
                    </div>

                    <button type="submit" id="resetRequestBtn" class="btn-register reset-request-btn">
                        <span class="btn-text">ENVOYER</span>
                        <span class="btn-spinner" hidden aria-hidden="true">
                            <span class="mini-spinner"></span>
                        </span>
                    </button>
                </form>

                <p class="modal-footer">
                    <a href="#" id="js-back-to-login" class="back-to-login-link">← Retour à la connexion</a>
                </p>
            </div>
        </div>

        <!-- === ÉTAPE 6 : Nouveau mot de passe === -->
        <div id="modal-step-reset-new" class="register-step-email is-relative" hidden aria-hidden="true">
            <div class="email-register-card text-center">
                <h3 class="modal-title register-modal-title-reset">NOUVEAU MOT DE PASSE</h3>
                <p class="modal-subtitle">Saisissez votre nouveau mot de passe.</p>

                <div id="resetNewError" class="verify-message" hidden aria-hidden="true"></div>

                <form id="resetNewForm" action="{{ path('app_reset_password_final') }}" method="POST" novalidate>
                    <input type="hidden" name="_token" value="{{ csrf_token('reset_final') }}">
                    <input type="hidden" id="resetToken" name="token" value="">

                    <div class="password-group">
                        <div class="password-input-wrapper">
                            <input type="password"
                                   id="newPassword"
                                   name="newPassword"
                                   placeholder="Nouveau mot de passe"
                                   minlength="12"
                                   maxlength="128"
                                   required
                                   autocomplete="new-password"
                                   class="reset-password-input">
                            <span class="toggle-password" data-target="newPassword">
                                <img class="eye-open reset-eye-icon" src="{{ asset('images/eye/eye-open.png') }}" alt="Afficher">
                                <img class="eye-closed hide reset-eye-icon" src="{{ asset('images/eye/eye-closed.png') }}" alt="Cacher">
                            </span>
                        </div>
                    </div>

                    <div class="password-group">
                        <div class="password-input-wrapper">
                            <input type="password"
                                   id="confirmPassword"
                                   name="confirmPassword"
                                   placeholder="Confirmer le mot de passe"
                                   minlength="12"
                                   maxlength="128"
                                   required
                                   autocomplete="new-password"
                                   class="reset-password-input">
                            <span class="toggle-password" data-target="confirmPassword">
                                <img class="eye-open reset-eye-icon" src="{{ asset('images/eye/eye-open.png') }}" alt="Afficher">
                                <img class="eye-closed hide reset-eye-icon" src="{{ asset('images/eye/eye-closed.png') }}" alt="Cacher">
                            </span>
                        </div>
                    </div>

                    <button type="submit" id="resetNewBtn" class="btn-register reset-new-btn">
                        <span class="btn-text">CHANGER LE MOT DE PASSE</span>
                        <span class="btn-spinner" hidden aria-hidden="true">
                            <span class="mini-spinner"></span>
                        </span>
                    </button>
                </form>

                <p class="modal-footer reset-footer-spacing">
                    <a href="#" id="js-back-to-login-from-reset" class="reset-back-link">← Retour à la connexion</a>
                </p>
            </div>
        </div>
    </div>
</div>

{% if app.user and app.user.getNeedsPassword() %}
    <div class="modal-overlay is-open" id="setPasswordModal" aria-hidden="false">
        <div class="modal-card modal-card-set-password" role="dialog" aria-modal="true" aria-labelledby="setPasswordTitle">

            <h3 id="setPasswordTitle" class="modal-title">Définir votre mot de passe</h3>
            <p class="modal-subtitle">Assurez-vous de choisir un mot de passe sécurisé pour protéger votre compte.</p>

            {% for message in app.flashes('error') %}
                <div class="form-error-message set-password-error">{{ message }}</div>
            {% endfor %}

            <form action="{{ path('set_password') }}" method="POST" class="email-register-form" novalidate autocomplete="on">
                <input type="hidden" name="_token" value="{{ csrf_token('set_password') }}">

                <div class="form-group password-group">
                    <label for="password">Mot de passe</label>
                    <div class="password-input-wrapper">
                        <input type="password" id="password" name="password" placeholder="Mot de passe" required minlength="12" maxlength="128" autocomplete="new-password">
                        <span class="toggle-password" data-target="password">
                            <img class="eye-open" src="{{ asset('images/eye/eye-open.png') }}" alt="Afficher">
                            <img class="eye-closed hide" src="{{ asset('images/eye/eye-closed.png') }}" alt="Cacher">
                        </span>
                    </div>
                </div>

                <div class="form-group password-group">
                    <label for="confirm_password">Confirmer le mot de passe</label>
                    <div class="password-input-wrapper">
                        <input type="password" id="confirm_password" name="confirm_password" placeholder="Confirmez le mot de passe" required minlength="12" maxlength="128" autocomplete="new-password">
                        <span class="toggle-password" data-target="confirm_password">
                            <img class="eye-open" src="{{ asset('images/eye/eye-open.png') }}" alt="Afficher">
                            <img class="eye-closed hide" src="{{ asset('images/eye/eye-closed.png') }}" alt="Cacher">
                        </span>
                    </div>
                </div>

                <div class="checkbox-group">
                    <label>
                        <input type="checkbox" name="acceptedTerms" required>
                        J’accepte les <a href="#">Conditions générales</a> et la <a href="#">Politique de confidentialité</a>.
                    </label>
                </div>

                <button type="submit" class="btn-register">Enregistrer</button>
            </form>
        </div>
    </div>
{% endif %}