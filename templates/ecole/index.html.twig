{% extends 'base.html.twig' %}

{% block title %}École d'Haltérophilie
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/ecole/index.css') }}">
{% endblock %}

{% block body %}

	<!-- HERO -->
<header class="hero-header">
    <div class="hero-backgrounds">
        <div class="hero-bg" style="background-image: url('{{ asset('images/club/bg2.jpg') }}');"></div>
        <div class="hero-bg" style="background-image: url('{{ asset('images/club/bg1.jpg') }}');"></div>
        <div class="hero-bg" style="background-image: url('{{ asset('images/club/bg3.jpg') }}');"></div>
    </div>
    
    <div class="hero-content">
        <h1>L'ÉCOLE D'HALTÉROPHILIE</h1>
        <p>Toutes les infos sur nos entraînements, catégories et activités</p>
<a href="#entrainements" class="cta-button">Découvrir notre école</a>
</header>

	<main>
		<!-- SECTION 1 -->
		<section id="entrainements" class="section">
			<div class="section-content">
				<h2>LICENCES COMPÉTITION</h2>
				<p>
					<b>Catégories :</b>
					U15, U17, U20, Séniors</p>
				<p>
					<b>Entraînements :</b>
					Lundi, Mercredi, Vendredi de 17h00 à 19h00</p>
				<p>Nos athlètes bénéficient d’un suivi personnalisé avec des programmes adaptés à chaque catégorie, incluant la technique, la force et la préparation mentale.</p>
			</div>
			<div class="section-image">
				<img src="{{ asset('images/club/photo2.jpg') }}" alt="Compétition">
			</div>
		</section>

		<!-- SECTION 2 -->
		<section class="section">
			<div class="section-content">
				<h2>U13 / DÉBUTANTS</h2>
				<p>
					<b>Catégorie :</b>
					Initiation pour jeunes et débutants</p>
				<p>
					<b>Entraînements :</b>
					Lundi, Mercredi, Vendredi de 17h30 à 19h00</p>
				<p>Cette section initie les plus jeunes aux bases de l’haltérophilie dans un environnement sécurisé et ludique, en mettant l’accent sur la posture et le respect des règles.</p>
			</div>
			<div class="section-image">
				<img src="{{ asset('images/club/photo3.jpg') }}" alt="Débutants">
			</div>
		</section>

		<!-- SECTION 3 -->
		<section class="section">
			<div class="section-content">
				<h2>LICENCES LOISIR</h2>
				<p>
					<b>Catégorie :</b>
					École d’Haltérophilie et Initiation</p>
				<p>
					<b>Entraînements :</b>
					Mercredi de 17h30 à 19h00</p>
				<p>Idéal pour ceux qui souhaitent pratiquer l’haltérophilie de manière ponctuelle, en découvrant la discipline sans pression de compétition.</p>
			</div>
			<div class="section-image">
				<img src="{{ asset('images/club/photo4.jpg') }}" alt="Loisir">
			</div>
		</section>

		<!-- NOUVELLE SECTION: Nos Coachs -->
		<section class="section">
			<div class="section-content">
				<h2>NOS COACHS</h2>
				<p>Notre équipe est composée de coachs diplômés et expérimentés, passionnés par la pédagogie et la performance. Chaque coach apporte un suivi personnalisé selon les besoins et les objectifs des élèves.</p>
				<p>Ils supervisent la progression technique, la sécurité des mouvements et l’encouragement dans la pratique quotidienne.</p>
			</div>
		<div class="section-image">
		<div class="coach-wrapper">
    <div class="coach-slider">
        <button class="prev-btn">‹</button>

        <div class="slides">
            <img src="{{ asset('images/club/3.jpg') }}" alt="Coach 1" data-name="Ema">
            <img src="{{ asset('images/club/florian.jpg') }}" alt="Coach 2" data-name="Florian">
            <img src="{{ asset('images/club/jeanne.jpg') }}" alt="Coach 3" data-name="Jeanne">
			<img src="{{ asset('images/club/robert.jpg') }}" alt="Coach 4" data-name="Robert">
        </div>

        <button class="next-btn">›</button>
    </div>

	<p id="coach-name">Ema</p>
	</div>
</div>

		</section>

		<!-- NOUVELLE SECTION: Nos Valeurs -->
		<section class="section">
			<div class="section-content">
				<h2>NOS VALEURS</h2>
				<p>Respect, discipline et persévérance sont les piliers de notre école. Nous valorisons le dépassement de soi dans un environnement bienveillant et stimulant.</p>
				<p>Nous encourageons l’esprit d’équipe, le fair-play et la passion pour l’haltérophilie, quel que soit le niveau de pratique.</p>
			</div>
			<div class="section-image">
<img src="{{ asset('images/valeur.jpg') }}" class="valeur-img" alt="Valeurs">
			</div>
		</section>

		<!-- TABLE -->
		<div class="table-container">
			<h2>CATÉGORIES D’ÂGE</h2>

			<div class="modern-table">
				<div class="table-header">
					<div>Catégorie</div>
					<div>Nom</div>
					<div>Âge</div>
				</div>

				<div class="table-row">
					<div>U10</div>
					<div>Benjamin</div>
					<div>7 à 10 ans</div>
				</div>

				<div class="table-row">
					<div>U13</div>
					<div>Minime</div>
					<div>11 à 13 ans</div>
				</div>

				<div class="table-row">
					<div>U15</div>
					<div>Cadet 1</div>
					<div>14 à 15 ans</div>
				</div>

				<div class="table-row">
					<div>U17</div>
					<div>Cadet 2</div>
					<div>16 à 17 ans</div>
				</div>

				<div class="table-row">
					<div>U20</div>
					<div>Junior</div>
					<div>18 à 20 ans</div>
				</div>

				<div class="table-row">
					<div>Sénior</div>
					<div>Sénior</div>
					<div>21 à 34 ans</div>
				</div>
			</div>
		</div>

		<!-- CTA -->
		<div class="prices-link">
			<p>Consultez nos
				<a href="{{ path('home') }}#abonnements">tarifs et abonnements</a>
				pour plus d’infos.</p>
		</div>
	</main>
{% endblock %}

{% block javascripts %}
    {{ parent() }} {# charge d'abord le JS du base.html.twig #}
    <script src="{{ asset('js/halterophilie/ecole/ecole.js') }}"></script>
{% endblock %}