{% extends 'base.html.twig' %}

{% block title %}École d'Haltérophilie — CHM Saleux{% endblock %}
{% block og_title %}École d'Haltérophilie — CHM Saleux{% endblock %}
{% block og_description %}Notre école forme des athlètes complets. Entraîneurs diplômés, respect, discipline et persévérance au CHM Saleux.{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/ecole/index.css') }}">
{% endblock %}

{% block body %}

	{# --- HEADER --- #}
	<header class="page-header-sport ecole-header-bg">
		<div class="header-overlay-gradient"></div>
		<div class="header-content">
			<div class="page-container">
				{% include 'components/breadcrumb.html.twig' with { items: [{ label: 'Notre École' }] } %}
				<div class="header-main-box">
					<h1>L'École
						<span class="text-outline">d'Haltérophilie</span>
					</h1>
					<p class="lead">De l'initiation à la compétition : une structure encadrée pour apprendre la technique, développer sa force et grandir.</p>
				</div>
			</div>
		</div>
	</header>

	<main class="ecole-root">

		{# --- SECTION 1 : NOS PÔLES DE FORMATION --- #}
		<section class="ecole-section ecole-programs-section">
			<div class="ecole-wm ecole-wm--poles page-wm" aria-hidden="true">FORMATION</div>

			<div class="page-container ecole-section-inner">
				<div class="ecole-section-head">
					<h2 class="ecole-title">Nos Pôles<br><span>De Formation</span></h2>
					<p class="ecole-subtitle">Des groupes de niveaux adaptés pour progresser à son rythme.</p>
				</div>

				<div class="programs-grid">
					<article class="program-card">
						<div class="program-card-eyebrow">Initiation</div>
						<div class="program-card-body">
							<div class="program-icon-wrap"><i class="fa-solid fa-child-reaching"></i></div>
							<div>
								<h3>U13 / Débutants</h3>
								<div class="program-schedule">
									<span><i class="fa-regular fa-calendar"></i> Lun, Mer, Ven</span>
									<span><i class="fa-regular fa-clock"></i> 17h30 – 19h00</span>
								</div>
							</div>
						</div>
						<p>Découverte ludique et sécurisée. L'accent est mis sur la coordination, la posture et l'apprentissage technique sans charge lourde.</p>
					</article>

					<article class="program-card program-card--featured">
						<span class="program-card-badge">Performance</span>
						<div class="program-card-eyebrow">Haute Performance</div>
						<div class="program-card-body">
							<div class="program-icon-wrap"><i class="fa-solid fa-trophy"></i></div>
							<div>
								<h3>Pôle Compétition</h3>
								<div class="program-schedule">
									<span><i class="fa-regular fa-calendar"></i> Lun, Mer, Ven</span>
									<span><i class="fa-regular fa-clock"></i> 17h00 – 19h00</span>
								</div>
							</div>
						</div>
						<p>Suivi personnalisé et planification. Objectif : maîtrise technique parfaite, force et préparation aux championnats.</p>
					</article>

					<article class="program-card">
						<div class="program-card-eyebrow">Loisir & Découverte</div>
						<div class="program-card-body">
							<div class="program-icon-wrap"><i class="fa-solid fa-heart-pulse"></i></div>
							<div>
								<h3>Licence Loisir</h3>
								<div class="program-schedule">
									<span><i class="fa-regular fa-calendar"></i> Mercredi</span>
									<span><i class="fa-regular fa-clock"></i> 17h30 – 19h00</span>
								</div>
							</div>
						</div>
						<p>Pour apprendre l'haltérophilie en complément (CrossTraining) ou pour le plaisir, sans la pression des compétitions.</p>
					</article>
				</div>
			</div>
		</section>

		{# --- SECTION 2 : COACH SLIDER --- #}
		<section class="ecole-section ecole-coach-section">
			<div class="ecole-wm ecole-wm--coaching page-wm" aria-hidden="true">COACHING</div>

			<div class="page-container ecole-section-inner">
				<div class="ecole-coach-grid">
					<div class="coach-avatars-wrap">
					<div class="coach-avatars">
						<div class="coach-avatar-top">
							<div class="coach-avatar">
								<img src="{{ asset('images/club/ema.jpg') }}" alt="Ema" loading="lazy">
								<div class="coach-avatar-info">
									<span class="coach-avatar-name">Ema</span>
									<span class="coach-avatar-role">Coach Fédéral</span>
								</div>
							</div>
						</div>
						<div class="coach-avatar-bottom">
							<div class="coach-avatar">
								<img src="{{ asset('images/club/florian.jpg') }}" alt="Florian" loading="lazy">
								<div class="coach-avatar-info">
									<span class="coach-avatar-name">Florian</span>
									<span class="coach-avatar-role">Coach Fédéral</span>
								</div>
							</div>
							<div class="coach-avatar">
								<img src="{{ asset('images/club/robert2.jpg') }}" alt="Robert" loading="lazy">
								<div class="coach-avatar-info">
									<span class="coach-avatar-name">Robert</span>
									<span class="coach-avatar-role">Coach Fédéral</span>
								</div>
							</div>
						</div>
					</div>
					</div>

					<div class="coach-text">
						<h2 class="ecole-title">L'Équipe<br><span>Technique</span></h2>
						<p class="coach-desc">Nos coachs sont diplômés d'État et fédéraux. Ils assurent un encadrement pédagogique de qualité, veillant à la sécurité physique et à la progression de chaque élève.</p>
						<ul class="feature-list">
							<li><i class="fa-solid fa-check"></i> Suivi individualisé</li>
							<li><i class="fa-solid fa-check"></i> Programmation sur mesure</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		{# --- SECTION 3 : VALEURS --- #}
		<section class="ecole-section ecole-valeurs-section">
			<div class="ecole-wm ecole-wm--valeurs page-wm" aria-hidden="true">VALEURS</div>

			<div class="page-container ecole-section-inner">
				<div class="ecole-valeurs-grid">
					<div class="valeurs-text">
						<h2 class="ecole-title">Nos Valeurs<br><span>Fondamentales</span></h2>
						<div class="valeurs-badges">
							<div class="valeur-badge">
								<div class="valeur-badge-icon"><i class="fa-solid fa-handshake"></i></div>
								<div class="valeur-badge-text">
									<span class="valeur-label">Respect</span>
									<span class="valeur-desc">Envers soi-même et les autres</span>
								</div>
							</div>
							<div class="valeur-badge">
								<div class="valeur-badge-icon"><i class="fa-solid fa-bolt"></i></div>
								<div class="valeur-badge-text">
									<span class="valeur-label">Discipline</span>
									<span class="valeur-desc">Rigueur et régularité à l'entraînement</span>
								</div>
							</div>
							<div class="valeur-badge">
								<div class="valeur-badge-icon"><i class="fa-solid fa-fire"></i></div>
								<div class="valeur-badge-text">
									<span class="valeur-label">Persévérance</span>
									<span class="valeur-desc">Ne jamais abandonner ses objectifs</span>
								</div>
							</div>
						</div>
					</div>
					<div class="valeurs-athlete-col">
						<img loading="lazy" src="{{ asset('images/club/contact.jpg') }}" alt="" aria-hidden="true" class="valeurs-athlete-img">
					</div>
				</div>
			</div>
		</section>

		{# --- SECTION 4 : CATÉGORIES D'ÂGE --- #}
		<section class="ecole-section ecole-categories-section">
			<div class="ecole-wm ecole-wm--categories page-wm" aria-hidden="true">NIVEAUX</div>

			<div class="page-container ecole-section-inner">
				<div class="ecole-section-head">
					<h2 class="ecole-title">Catégories<br><span>D'Âge</span></h2>
					<p class="ecole-subtitle">Chaque athlète évolue dans la catégorie correspondant à son année de naissance.</p>
				</div>

				<div class="categories-grid">
					<div class="cat-card"><span class="cat-code u-tag">U10</span><h4 class="cat-name">Benjamin</h4><span class="cat-years">2016 – 2019</span></div>
					<div class="cat-card"><span class="cat-code u-tag">U13</span><h4 class="cat-name">Minime</h4><span class="cat-years">2013 – 2015</span></div>
					<div class="cat-card"><span class="cat-code u-tag">U15</span><h4 class="cat-name">Cadet 1</h4><span class="cat-years">2011 – 2012</span></div>
					<div class="cat-card"><span class="cat-code u-tag">U17</span><h4 class="cat-name">Cadet 2</h4><span class="cat-years">2009 – 2010</span></div>
					<div class="cat-card"><span class="cat-code u-tag">U20</span><h4 class="cat-name">Junior</h4><span class="cat-years">2006 – 2008</span></div>
					<div class="cat-card cat-card--senior"><span class="cat-code s-tag">Sénior</span><h4 class="cat-name">Sénior</h4><span class="cat-years">1992 – 2005</span></div>
				</div>

				<div class="cta-box">
					<p>Prêt à rejoindre l'aventure ?</p>
					<a href="{{ path('app_pricing') }}" class="ecole-cta-btn">
						Voir les tarifs & Inscriptions
					</a>
				</div>
			</div>
		</section>

	</main>

	<script nonce="{{ csp_nonce('script') }}">
	(function() {
		var wms = document.querySelectorAll('.ecole-wm');
		if (!wms.length) return;
		var obs = new IntersectionObserver(function(entries) {
			entries.forEach(function(e) {
				if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); }
			});
		}, { threshold: 0.15 });
		wms.forEach(function(el) { obs.observe(el); });
	})();
	</script>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('js/ecole/index.js') }}"></script>
{% endblock %}
