{% extends 'admin/base_admin.html.twig' %}

{% block title %}Mode maintenance{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1>Mode maintenance</h1>
        <p>Rend le site inaccessible au public tout en gardant l'API mobile active.</p>
    </div>
</div>

{% for type, msgs in app.flashes %}
    {% for msg in msgs %}
        <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'warning' ? 'warning' : 'danger') }}">{{ msg }}</div>
    {% endfor %}
{% endfor %}

<div class="settings-layout">

    {# ── État actuel ── #}
    <div class="settings-card" style="border-top: 2px solid {% if maintenanceEnabled %}#f87171{% else %}#22c55e{% endif %}">
        <h3 class="settings-card-title">État actuel</h3>

        <div style="display:flex;align-items:center;gap:14px;margin-bottom:20px;">
            <span style="display:inline-flex;align-items:center;gap:8px;padding:8px 16px;font-size:.85rem;font-weight:700;
                background:{% if maintenanceEnabled %}rgba(248,113,113,.1){% else %}rgba(34,197,94,.1){% endif %};
                color:{% if maintenanceEnabled %}#f87171{% else %}#22c55e{% endif %};">
                <span style="width:8px;height:8px;border-radius:50%;background:currentColor;display:inline-block;"></span>
                {% if maintenanceEnabled %}Maintenance active — site inaccessible{% else %}Site en ligne{% endif %}
            </span>
        </div>

        <p style="font-size:.84rem;color:var(--text-muted);margin:0 0 24px;line-height:1.7;">
            {% if maintenanceEnabled %}
                Le site est actuellement inaccessible au public. Les visiteurs voient la page de maintenance.<br>
                <strong style="color:#fff;">L'API mobile (<code>/api/*</code>) reste entièrement fonctionnelle.</strong>
            {% else %}
                Le site est accessible normalement. Activer la maintenance rendra toutes les pages publiques
                inaccessibles (HTTP 503), hors <code>/api/*</code> (application mobile non affectée).
            {% endif %}
        </p>

        <form id="maintenance-form" method="post" action="{{ path('admin_settings_maintenance_toggle') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('maintenance_toggle') }}">
            <button type="button" id="maintenance-btn"
                class="{% if maintenanceEnabled %}btn-save{% else %}btn-delete{% endif %}"
                data-active="{{ maintenanceEnabled ? '1' : '0' }}">
                {% if maintenanceEnabled %}
                    <i class="fa-solid fa-circle-check"></i>&nbsp; Désactiver la maintenance
                {% else %}
                    <i class="fa-solid fa-triangle-exclamation"></i>&nbsp; Activer la maintenance
                {% endif %}
            </button>
        </form>
    </div>

    {# ── Infos bypass ── #}
    <div class="settings-card">
        <h3 class="settings-card-title">Accès équipe (bypass)</h3>
        <p style="font-size:.84rem;color:var(--text-muted);margin:0 0 12px;line-height:1.7;">
            Pour accéder au site pendant la maintenance, ouvrez cette URL dans votre navigateur.
            Un cookie signé (30 jours) sera posé automatiquement.
        </p>
        <code style="font-size:.8rem;background:var(--bg-input,#1a1a1a);padding:8px 14px;display:block;color:var(--accent);word-break:break-all;">
            /team-access/<em style="color:var(--text-muted);">{MAINTENANCE_BYPASS_TOKEN}</em>
        </code>
        <p style="font-size:.76rem;color:var(--text-muted);margin:10px 0 0;">
            Le token est défini dans <code>.env.local</code> sur le serveur (<code>MAINTENANCE_BYPASS_TOKEN</code>).
        </p>
    </div>

</div>

{# ── Modale confirmation ── #}
<div id="maintenance-modal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.75);align-items:center;justify-content:center;">
    <div style="background:var(--bg-card,#1a1a1a);border:1px solid var(--border-color);padding:32px 28px;max-width:420px;width:90%;text-align:center;">
        <p style="font-size:1.3rem;margin:0 0 8px;">⚠️</p>
        <h3 id="modal-title" style="font-size:1rem;font-weight:700;margin:0 0 12px;color:var(--text-primary);"></h3>
        <p id="modal-body" style="font-size:.85rem;color:var(--text-muted);margin:0 0 24px;line-height:1.6;"></p>
        <div style="display:flex;gap:12px;justify-content:center;">
            <button id="modal-cancel" style="padding:8px 20px;font-size:.82rem;background:transparent;border:1px solid var(--border-color);color:var(--text-muted);cursor:pointer;">Annuler</button>
            <button id="modal-confirm" style="padding:8px 20px;font-size:.82rem;font-weight:700;border:none;color:#fff;cursor:pointer;">Confirmer</button>
        </div>
    </div>
</div>

<script nonce="{{ csp_nonce('script') }}">
(function () {
    var btn    = document.getElementById('maintenance-btn');
    var modal  = document.getElementById('maintenance-modal');
    var title  = document.getElementById('modal-title');
    var body   = document.getElementById('modal-body');
    var cancel = document.getElementById('modal-cancel');
    var confirm= document.getElementById('modal-confirm');
    var form   = document.getElementById('maintenance-form');

    if (!btn || !modal) return;

    btn.addEventListener('click', function () {
        var active = btn.dataset.active === '1';
        if (active) {
            title.textContent   = 'Désactiver la maintenance';
            body.textContent    = 'Le site va redevenir accessible au public. Continuer ?';
            confirm.style.background = '#22c55e';
        } else {
            title.textContent   = 'Activer la maintenance';
            body.textContent    = 'Le site va devenir inaccessible au public. Seule l\'API mobile reste active. Confirmer ?';
            confirm.style.background = '#f87171';
        }
        modal.style.display = 'flex';
    });

    cancel.addEventListener('click', function () { modal.style.display = 'none'; });
    modal.addEventListener('click',  function (e) { if (e.target === modal) modal.style.display = 'none'; });
    confirm.addEventListener('click',function () { form.submit(); });
})();
</script>
{% endblock %}
