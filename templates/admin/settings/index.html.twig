{% extends 'admin/base_admin.html.twig' %}

{% block title %}Paramètres du compte{% endblock %}

{% block stylesheets %}
<style>
    /* =================== SETTINGS CONTAINER =================== */
    .form-container { max-width: 800px; margin: 0 auto; }

    /* Header */
    .page-header {
        margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem;
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--text-main); }
    .page-header p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; }

    /* Cards */
    .settings-card {
        background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 6px; padding: 2rem; margin-bottom: 2rem;
    }
    .card-title {
        font-size: 0.85rem; font-weight: 700; color: var(--text-main); margin: 0 0 1.5rem 0;
        padding-bottom: 1rem; border-bottom: 1px solid var(--border-color); text-transform: uppercase; letter-spacing: 0.05em;
        display: flex; align-items: center; gap: 10px;
    }
    .card-title::before { content: ""; width: 3px; height: 14px; background: var(--accent); border-radius: 2px; }

    /* Form UI */
    .form-group { margin-bottom: 1.5rem; }
    .form-label { display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.8rem; }
    
    .form-control {
        width: 100%; background: var(--bg-body); border: 1px solid var(--border-color); color: var(--text-main);
        padding: 0.75rem 1rem; border-radius: 4px; font-size: 0.95rem; box-sizing: border-box; outline: none;
    }
    
    /* Readonly style */
    .form-control[readonly] {
        background: rgba(255,255,255,0.02); color: var(--text-muted); border-style: dashed; cursor: default;
    }

    /* Info Data */
    .data-mono { font-family: monospace; color: var(--text-main); font-size: 0.9rem; background: var(--bg-body); padding: 4px 8px; border-radius: 4px; }

    /* Buttons */
    .btn {
        padding: 0.7rem 1.2rem; border-radius: 4px; font-weight: 700; cursor: pointer; transition: 0.2s; border: none; font-size: 0.85rem; display: inline-block; text-transform: uppercase;
    }
    .btn-primary { background: var(--text-main); color: var(--bg-body); }
    .btn-primary:hover { opacity: 0.9; }
    
    .btn-outline-danger { background: transparent; border: 1px solid var(--danger); color: var(--danger); }
    .btn-outline-danger:hover { background: var(--danger); color: #fff; }

    /* --- TOGGLE SWITCH REVISITED --- */
    .switch-row { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; }
    .switch-info h4 { margin: 0; font-size: 0.95rem; color: var(--text-main); font-weight: 600; }
    .switch-info p { margin: 4px 0 0 0; font-size: 0.85rem; color: var(--text-muted); }

    .switch { position: relative; display: inline-block; width: 44px; height: 24px; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider {
        position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
        background-color: var(--bg-body); border: 1px solid var(--border-color);
        transition: .3s; border-radius: 24px;
    }
    .slider:before {
        position: absolute; content: ""; height: 16px; width: 16px; left: 3px; bottom: 3px;
        background-color: var(--text-muted); transition: .3s; border-radius: 50%;
    }
    input:checked + .slider { background-color: var(--accent); border-color: var(--accent); }
    input:checked + .slider:before { transform: translateX(20px); background-color: #fff; }

</style>
{% endblock %}

{% block body %}
<div class="form-container">
    
    <div class="page-header">
        <h1>Paramètres</h1>
        <p>Gérez vos préférences de compte et les options d'affichage.</p>
    </div>

    {# SECTION PROFIL #}
    <div class="settings-card">
        <h3 class="card-title">Informations de profil</h3>
        
        <div class="form-group">
            <label class="form-label">Identité</label>
            <input type="text" class="form-control" value="{{ app.user.firstName }} {{ app.user.lastName }}" readonly>
        </div>

        <div class="form-group">
            <label class="form-label">Email de connexion</label>
            <input type="email" class="form-control" value="{{ app.user.email }}" readonly>
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
            <a href="#" class="btn btn-primary">Modifier le mot de passe</a>
        </div>
    </div>

    {# SECTION APPARENCE #}
    <div class="settings-card">
        <h3 class="card-title">Préférences d'affichage</h3>
        
        <div class="switch-row">
            <div class="switch-info">
                <h4>Mode Sombre</h4>
                <p>Réduit la fatigue oculaire dans les environnements peu éclairés.</p>
            </div>
            <label class="switch">
                <input type="checkbox" id="themeToggleCheckbox">
                <span class="slider"></span>
            </label>
        </div>
    </div>

    {# SECTION SÉCURITÉ #}
    <div class="settings-card">
        <h3 class="card-title">Historique & Sécurité</h3>
        
        <div class="form-group">
            <label class="form-label">Dernière activité</label>
            <span class="data-mono">
                {{ app.user.lastLoginAt ? app.user.lastLoginAt|date('d/m/Y à H:i:s') : 'Session actuelle uniquement' }}
            </span>
        </div>

        <div class="form-group">
            <label class="form-label">Dernière adresse IP enregistrée</label>
            <span class="data-mono">{{ app.user.lastLoginIp ?? 'IP non tracée' }}</span>
        </div>

        <div style="margin-top: 2rem; border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
            <button class="btn btn-outline-danger" onclick="alert('Cette action va réinitialiser vos tokens de connexion.');">
                Réinitialiser les sessions actives
            </button>
        </div>
    </div>

</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.getElementById('themeToggleCheckbox');
        const htmlElement = document.documentElement;
        
        // Initialiser l'état selon le localStorage
        const savedTheme = localStorage.getItem('theme') || 'dark';
        htmlElement.setAttribute('data-theme', savedTheme);
        toggle.checked = (savedTheme === 'dark');

        toggle.addEventListener('change', () => {
            const theme = toggle.checked ? 'dark' : 'light';
            htmlElement.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
        });
    });
</script>
{% endblock %}