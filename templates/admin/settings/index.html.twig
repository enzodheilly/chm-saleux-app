{% extends 'admin/base_admin.html.twig' %}

{% block title %}Paramètres du compte
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/settings/index.css') }}">
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Paramètres</h1>
			<p>Gérez vos préférences de compte et les options d'affichage.</p>
		</div>
	</div>

	<div class="settings-layout">

		<div class="settings-card">
			<div class="card-body">
				<h3 class="card-title">Informations de profil</h3>

				<div class="form-grid">
					<div>
						<span class="tool-label">Identité</span>
						<input type="text" class="input" value="{{ app.user.firstName }} {{ app.user.lastName }}" readonly>
					</div>

					<div>
						<span class="tool-label">Email de connexion</span>
						<input type="email" class="input" value="{{ app.user.email }}" readonly>
					</div>

					<div class="actions-row">
						<a href="#" class="btn-create">Modifier le mot de passe</a>
					</div>
				</div>
			</div>
		</div>

		<div class="settings-card">
			<div class="card-body">
				<h3 class="card-title">Préférences d'affichage</h3>

				<div class="switch-row">
					<div class="switch-info">
						<h4>Mode sombre</h4>
						<p>Réduit la fatigue oculaire dans les environnements peu éclairés.</p>
					</div>

					<label class="switch">
						<input type="checkbox" id="themeToggleCheckbox">
						<span class="slider"></span>
					</label>
				</div>
			</div>
		</div>

		<div class="settings-card">
			<div class="card-body">
				<h3 class="card-title">Historique & sécurité</h3>

				<div class="form-grid">
					<div>
						<span class="tool-label">Dernière activité</span>
						<span class="data-mono">
							{{ app.user.lastLoginAt ? app.user.lastLoginAt|date('d/m/Y à H:i:s') : 'Session actuelle uniquement' }}
						</span>
					</div>

					<div>
						<span class="tool-label">Dernière adresse IP enregistrée</span>
						<span class="data-mono">{{ app.user.lastLoginIp ?? 'IP non tracée' }}</span>
					</div>

					<div class="section-divider">
						<button class="btn-danger-outline" onclick="alert('Cette action va réinitialiser vos tokens de connexion.');">
							Réinitialiser les sessions actives
						</button>
					</div>
				</div>
			</div>
		</div>

	</div>
{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/settings/index.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
