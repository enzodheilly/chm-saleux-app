{% extends 'admin/base_admin.html.twig' %}

{% block title %}Paramètres du compte
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Paramètres</h1>
			<p>Gérez vos préférences de compte et les options d'affichage.</p>
		</div>
	</div>

	<div
		class="settings-layout">
		{# Profil #}
		<div class="settings-card">
			<h3 class="settings-card-title">Informations de profil</h3>
			<div class="form-grid">
				<div class="form-group">
					<label class="tool-label">Identité</label>
					<input type="text" class="input input-readonly" value="{{ app.user.firstName }} {{ app.user.lastName }}" readonly>
				</div>
				<div class="form-group">
					<label class="tool-label">Email de connexion</label>
					<input type="email" class="input input-readonly" value="{{ app.user.email }}" readonly>
				</div>
				<div class="form-actions">
					<a href="#" class="btn-create">Modifier le mot de passe</a>
				</div>
			</div>
		</div>

		{# Thème - Utilisation du Switch #}
		<div class="settings-card flex-row">
			<div class="switch-info">
				<h4>Mode sombre</h4>
				<p>Réduit la fatigue oculaire dans l'obscurité.</p>
			</div>
			<label
				class="switch">
				{# L'ID est utilisé par le JS global pour synchroniser le thème #}
				<input type="checkbox" id="themeToggleCheckbox">
				<span class="slider"></span>
			</label>
		</div>

		{# Bannière d'annonce #}
		<div class="settings-card">
			<h3 class="settings-card-title">Bannière d'annonce</h3>
			<p style="font-size:.82rem;color:var(--text-muted,#888);margin:0 0 16px;">
				Affiche un message court en haut de toutes les pages du site. Laissez le texte vide ou désactivez pour masquer la bannière.
			</p>
			<form method="post" action="{{ path('admin_settings_banner_update') }}">
				<input type="hidden" name="_token" value="{{ csrf_token('update_banner') }}">
				<div class="form-group" style="margin-bottom:14px;">
					<label class="tool-label" for="banner-message">Texte de la bannière</label>
					<input
						type="text"
						id="banner-message"
						name="message"
						class="input"
						maxlength="500"
						placeholder="Ex : Inscriptions au Challenge Muscu ouvertes !"
						value="{{ banner.message ?? '' }}"
					>
				</div>
				<div class="settings-card flex-row" style="padding:0;background:none;border:none;box-shadow:none;margin-bottom:18px;">
					<div class="switch-info">
						<h4 style="margin:0 0 2px;font-size:.88rem;">Bannière active</h4>
						<p style="margin:0;font-size:.78rem;color:var(--text-muted,#888);">
							{{ banner.isActive ? 'Actuellement visible sur le site' : 'Actuellement masquée' }}
						</p>
					</div>
					<label class="switch">
						<input type="checkbox" name="is_active" value="1" {% if banner.isActive %}checked{% endif %}>
						<span class="slider"></span>
					</label>
				</div>
				<div class="form-actions">
					<button type="submit" class="btn-create">Enregistrer la bannière</button>
				</div>
				{% if banner.updatedAt %}
					<p style="font-size:.72rem;color:var(--text-muted,#888);margin:10px 0 0;">
						Dernière mise à jour : {{ banner.updatedAt|date('d/m/Y à H:i') }}
					</p>
				{% endif %}
			</form>
		</div>

		{# Sécurité #}
		<div class="settings-card">
			<h3 class="settings-card-title">Historique & Sécurité</h3>
			<div class="security-info-grid">
				<div class="title-stack">
					<span class="td-mono-sm">DERNIÈRE ACTIVITÉ</span>
					<strong>{{ app.user.lastLoginAt ? app.user.lastLoginAt|date('d/m/Y à H:i') : 'Session actuelle' }}</strong>
				</div>
				<div class="title-stack">
					<span class="td-mono-sm">IP ENREGISTRÉE</span>
					<strong class="td-mono text-accent">{{ app.user.lastLoginIp ?? '—' }}</strong>
				</div>
			</div>
			<div
				class="section-divider">
				{# MODIFICATION : Ajout de la classe js-confirm-link pour réutiliser le moteur de confirmation #}
				<button class="btn-danger-outline js-confirm-link" id="btn-reset-sessions" data-confirm="⚠️ Cela vous déconnectera de tous vos autres appareils. Continuer ?">
					RÉINITIALISER LES SESSIONS ACTIVES
				</button>
			</div>
		</div>
	</div>
{% endblock %}
