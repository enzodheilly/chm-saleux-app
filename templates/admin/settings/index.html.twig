{% extends 'admin/base_admin.html.twig' %}

{% block title %}Paramètres du compte
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Paramètres</h1>
			<p>Gérez vos préférences de compte et les options d'affichage.</p>
		</div>
	</div>

	<div
		class="settings-layout">
		{# Profil #}
		<div class="settings-card">
			<h3 class="settings-card-title">Informations de profil</h3>
			<div class="form-grid">
				<div class="form-group">
					<label class="tool-label">Identité</label>
					<input type="text" class="input input-readonly" value="{{ app.user.firstName }} {{ app.user.lastName }}" readonly>
				</div>
				<div class="form-group">
					<label class="tool-label">Email de connexion</label>
					<input type="email" class="input input-readonly" value="{{ app.user.email }}" readonly>
				</div>
				<div class="form-actions">
					<a href="#" class="btn-create">Modifier le mot de passe</a>
				</div>
			</div>
		</div>

		{# Thème - Utilisation du Switch #}
		<div class="settings-card flex-row">
			<div class="switch-info">
				<h4>Mode sombre</h4>
				<p>Réduit la fatigue oculaire dans l'obscurité.</p>
			</div>
			<label
				class="switch">
				{# L'ID est utilisé par le JS global pour synchroniser le thème #}
				<input type="checkbox" id="themeToggleCheckbox">
				<span class="slider"></span>
			</label>
		</div>

		{# Bannière d'annonce #}
		<div class="settings-card">
			<h3 class="settings-card-title">Bannière d'annonce</h3>
			<p style="font-size:.82rem;color:var(--text-muted,#888);margin:0 0 20px;">
				Affiche un ou plusieurs messages en rotation en haut de toutes les pages.
				Si aucun message n'est actif, la bannière est masquée.
			</p>

			{# ── Liste des messages ── #}
			{% if messages is empty %}
				<p style="font-size:.84rem;color:var(--text-muted,#888);margin:0 0 20px;font-style:italic;">
					Aucun message — ajoutez-en un ci-dessous.
				</p>
			{% else %}
				<div class="banner-msg-list">
					{% for msg in messages %}
						<div class="banner-msg-row">
							<span class="banner-msg-text">{{ msg.text }}</span>

							<div class="banner-msg-actions">
								{# Toggle actif/inactif #}
								<form method="post" action="{{ path('admin_settings_banner_toggle', {id: msg.id}) }}">
									<input type="hidden" name="_token" value="{{ csrf_token('banner_toggle_' ~ msg.id) }}">
									<button type="submit" class="banner-btn banner-btn-toggle {% if msg.isActive %}is-active{% endif %}"
										title="{{ msg.isActive ? 'Désactiver' : 'Activer' }}">
										{{ msg.isActive ? 'ON' : 'OFF' }}
									</button>
								</form>

								{# Monter #}
								{% if not loop.first %}
									<form method="post" action="{{ path('admin_settings_banner_move', {id: msg.id, direction: 'up'}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('banner_move_' ~ msg.id) }}">
										<button type="submit" class="banner-btn banner-btn-icon" title="Monter">↑</button>
									</form>
								{% else %}
									<span class="banner-btn banner-btn-icon banner-btn-disabled">↑</span>
								{% endif %}

								{# Descendre #}
								{% if not loop.last %}
									<form method="post" action="{{ path('admin_settings_banner_move', {id: msg.id, direction: 'down'}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('banner_move_' ~ msg.id) }}">
										<button type="submit" class="banner-btn banner-btn-icon" title="Descendre">↓</button>
									</form>
								{% else %}
									<span class="banner-btn banner-btn-icon banner-btn-disabled">↓</span>
								{% endif %}

								{# Supprimer #}
								<form method="post" action="{{ path('admin_settings_banner_delete', {id: msg.id}) }}"
									onsubmit="return confirm('Supprimer ce message ?')">
									<input type="hidden" name="_token" value="{{ csrf_token('banner_delete_' ~ msg.id) }}">
									<button type="submit" class="banner-btn banner-btn-delete" title="Supprimer">✕</button>
								</form>
							</div>
						</div>
					{% endfor %}
				</div>
			{% endif %}

			{# ── Ajouter un message ── #}
			<form method="post" action="{{ path('admin_settings_banner_add') }}" style="margin-top:16px;">
				<input type="hidden" name="_token" value="{{ csrf_token('banner_add') }}">
				<div style="display:flex;gap:10px;align-items:center;">
					<input
						type="text"
						name="text"
						class="input"
						maxlength="500"
						placeholder="Nouveau message (max 500 caractères)…"
						style="flex:1;"
						required
					>
					<button type="submit" class="btn-create" style="white-space:nowrap;">+ Ajouter</button>
				</div>
			</form>
		</div>

		<style>
		.banner-msg-list { display:flex; flex-direction:column; gap:8px; margin-bottom:4px; }
		.banner-msg-row  {
			display:flex; align-items:center; gap:10px;
			padding:10px 14px;
			background:var(--bg-secondary,rgba(255,255,255,.04));
			border:1px solid var(--border,rgba(255,255,255,.08));
			border-radius: 0;
		}
		.banner-msg-text { flex:1; font-size:.84rem; line-height:1.4; }
		.banner-msg-actions { display:flex; align-items:center; gap:6px; flex-shrink:0; }
		.banner-btn {
			display:inline-flex; align-items:center; justify-content:center;
			border:none; border-radius: 0; cursor:pointer;
			font-size:.75rem; font-weight:700; padding:4px 8px;
			background:var(--bg-secondary,rgba(255,255,255,.08));
			color:var(--text-muted,#888);
			transition:background .15s, color .15s;
		}
		.banner-btn:hover { background:rgba(255,255,255,.14); color:#fff; }
		.banner-btn-toggle        { min-width:38px; }
		.banner-btn-toggle.is-active { background:#22c55e22; color:#22c55e; }
		.banner-btn-icon          { min-width:28px; }
		.banner-btn-disabled      { opacity:.25; cursor:default; min-width:28px; text-align:center; font-weight:700; font-size:.75rem; }
		.banner-btn-delete        { color:#f87171; }
		.banner-btn-delete:hover  { background:#f8717122; color:#f87171; }
		</style>

		{# Sécurité #}
		<div class="settings-card">
			<h3 class="settings-card-title">Historique & Sécurité</h3>
			<div class="security-info-grid">
				<div class="title-stack">
					<span class="td-mono-sm">DERNIÈRE ACTIVITÉ</span>
					<strong>{{ app.user.lastLoginAt ? app.user.lastLoginAt|date('d/m/Y à H:i') : 'Session actuelle' }}</strong>
				</div>
				<div class="title-stack">
					<span class="td-mono-sm">IP ENREGISTRÉE</span>
					<strong class="td-mono text-accent">{{ app.user.lastLoginIp ?? '—' }}</strong>
				</div>
			</div>
			<div
				class="section-divider">
				{# MODIFICATION : Ajout de la classe js-confirm-link pour réutiliser le moteur de confirmation #}
				<button class="btn-danger-outline js-confirm-link" id="btn-reset-sessions" data-confirm="⚠️ Cela vous déconnectera de tous vos autres appareils. Continuer ?">
					RÉINITIALISER LES SESSIONS ACTIVES
				</button>
			</div>
		</div>
	</div>
{% endblock %}
