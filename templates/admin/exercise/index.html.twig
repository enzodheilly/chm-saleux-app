{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des exercices
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Exercices</h1>
			<p>Gérez la liste des exercices disponibles.</p>
		</div>
		<div class="toolbar">
			<input type="text" id="searchExercise" class="search-input" placeholder="Rechercher un exercice...">
			<a href="{{ path('admin_exercise_new') }}" class="btn-create">+ Ajouter</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="table-scroll">
			<table class="admin-table" id="exerciseTable">
				<thead>
					<tr>
						<th width="120">ID</th>
						<th>Exercice</th>
						<th class="th-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for exercise in exercises %}
						<tr>
							<td>
								<span class="td-mono">#{{ exercise.id }}</span>
							</td>
							<td>
								<div class="product-info">
									<div class="title-stack">
										<strong class="exercise-name">{{ exercise.name }}</strong>
										{# Espace réservé pour une future catégorie (ex: Jambes, Dos...) #}
									</div>
								</div>
							</td>
							<td>
								<div class="actions">
									<a href="{{ path('admin_exercise_edit', {id: exercise.id}) }}" class="act-link">Modifier</a>

									{# MODIFICATION : Suppression du onsubmit inline #}
									<form method="post" action="{{ path('admin_exercise_delete', {id: exercise.id}) }}" class="js-confirm-form" data-confirm="❓ Supprimer l'exercice '{{ exercise.name }}' ? Cela pourrait affecter les routines qui l'utilisent.">
										<input type="hidden" name="_token" value="{{ csrf_token('delete_exercise_' ~ exercise.id) }}">
										<button class="act-link act-del">Supprimer</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="3" class="td-empty">Aucun exercice enregistré.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
