{% extends 'base.html.twig' %}

{% block title %}Modifier un exercice{% endblock %}

{% block body %}
<div class="container mt-4">
  <h1 class="mb-3">Modifier l'exercice</h1>

  {{ form_start(form) }}
    {{ form_row(form.name) }}
    <button class="btn btn-primary">Enregistrer</button>
    <a class="btn btn-secondary" href="{{ path('admin_exercise_index') }}">Retour</a>
  {{ form_end(form) }}
</div>
{% endblock %}
