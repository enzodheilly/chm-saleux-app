{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier l'utilisateur
{% endblock %}
{% block page_title %}Modifier l'utilisateur
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/users/global.css') }}">
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Modifier le profil</h1>
			<p>
				Édition du compte
				<span class="user-id-badge">#{{ user.id }}</span>
				:
				<span class="user-email-highlight">{{ user.email|pseudonymize_email }}</span>
			</p>
		</div>
		<div class="toolbar">
			<a href="{{ path('admin_users_index') }}" class="btn-outline">Retour</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="card-body">
			{{ form_start(form) }}

			<div class="form-error">{{ form_errors(form) }}</div>

			<div class="form-grid">
				<div class="form-row-2">
					<div>
						<span class="tool-label">Prénom</span>
						{{ form_widget(form.firstName, { attr: { class: 'input' } }) }}
						<div class="form-error">{{ form_errors(form.firstName) }}</div>
					</div>

					<div>
						<span class="tool-label">Nom</span>
						{{ form_widget(form.lastName, { attr: { class: 'input' } }) }}
						<div class="form-error">{{ form_errors(form.lastName) }}</div>
					</div>
				</div>

				<div>
					<span class="tool-label">Email</span>
					{{ form_widget(form.email, { attr: { class: 'input' } }) }}
					<div class="form-error">{{ form_errors(form.email) }}</div>
				</div>

				<div>
					<span class="tool-label">Mot de passe (modification)</span>
					{{ form_widget(form.password, { attr: { class: 'input', placeholder: 'Laisser vide pour conserver le mot de passe actuel' } }) }}
					<span class="form-help">
						Ne remplissez ce champ que si vous souhaitez changer le mot de passe de l'utilisateur.
					</span>
					<div class="form-error">{{ form_errors(form.password) }}</div>
				</div>

				<div>
					<span class="tool-label">Rôles & permissions</span>
					{{ form_widget(form.roles, { attr: { class: 'input input-roles' } }) }}
					<div class="form-error">{{ form_errors(form.roles) }}</div>
				</div>

				<div class="form-actions">
					{% if user.id != app.user.id %}
						<a href="{{ path('admin_users_delete', {'id': user.id}) }}" class="btn-danger-link" data-confirm="Attention, cette suppression est définitive.">
							Supprimer ce compte
						</a>
					{% endif %}

					<a href="{{ path('admin_users_index') }}" class="btn-outline">Annuler</a>
					<button type="submit" class="btn-create">Mettre à jour</button>
				</div>
			</div>

			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/users/edit.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
