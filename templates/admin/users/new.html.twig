{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouvel utilisateur
{% endblock %}
{% block page_title %}Nouvel utilisateur
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/users/global.css') }}">
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Créer un compte</h1>
			<p>Ajouter un nouvel utilisateur à la base de données.</p>
		</div>
		<div class="toolbar">
			<a href="{{ path('admin_users_index') }}" class="btn-outline">Retour</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="card-body">
			{{ form_start(form) }}

			<div class="form-error">{{ form_errors(form) }}</div>

			<div class="form-grid">
				<div class="form-row-2">
					<div>
						<span class="tool-label">Prénom</span>
						{{ form_widget(form.firstName, { attr: { class: 'input', placeholder: 'Ex: Thomas' } }) }}
						<div class="form-error">{{ form_errors(form.firstName) }}</div>
					</div>

					<div>
						<span class="tool-label">Nom</span>
						{{ form_widget(form.lastName, { attr: { class: 'input', placeholder: 'Ex: Anderson' } }) }}
						<div class="form-error">{{ form_errors(form.lastName) }}</div>
					</div>
				</div>

				<div>
					<span class="tool-label">Email professionnel / personnel</span>
					{{ form_widget(form.email, { attr: { class: 'input', placeholder: 'utilisateur@domaine.com' } }) }}
					<div class="form-error">{{ form_errors(form.email) }}</div>
				</div>

				<div>
					<span class="tool-label">Mot de passe initial</span>
					{{ form_widget(form.password, { attr: { class: 'input' } }) }}
					<span class="form-help">Minimum 6 caractères. L'utilisateur pourra le changer plus tard.</span>
					<div class="form-error">{{ form_errors(form.password) }}</div>
				</div>

				<div>
					<span class="tool-label">Niveau d'accréditation</span>
					{{ form_widget(form.roles, { attr: { class: 'input input-roles' } }) }}
					<span class="form-help">Maintenez CTRL (ou CMD) pour sélectionner plusieurs rôles si nécessaire.</span>
					<div class="form-error">{{ form_errors(form.roles) }}</div>
				</div>

				<div class="form-actions">
					<button type="submit" class="btn-create">Enregistrer</button>
					<a href="{{ path('admin_users_index') }}" class="btn-outline">Annuler</a>
				</div>
			</div>

			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}
