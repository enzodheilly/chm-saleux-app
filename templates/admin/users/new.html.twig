{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouvel utilisateur{% endblock %}

{% block stylesheets %}
<style>
    /* =================== CONTAINER =================== */
    .form-container {
        max-width: 800px; /* Plus étroit pour la lisibilité */
        margin: 0 auto;
    }

    /* =================== HEADER =================== */
    .page-header {
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 1.5rem;
        display: flex; justify-content: space-between; align-items: flex-end;
    }
    .page-header h1 { 
        font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--text-main); 
    }
    .page-header p { 
        margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; 
    }
    .back-link {
        font-size: 0.85rem; color: var(--text-muted); font-weight: 500;
        text-decoration: underline; cursor: pointer;
    }
    .back-link:hover { color: var(--text-main); }

    /* =================== FORM CARD =================== */
    .form-card {
        background: var(--bg-sidebar);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 2rem;
    }

    /* Groupes de champs */
    .form-group { margin-bottom: 1.5rem; }

    /* Labels */
    .form-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }

    /* Inputs (Text, Email, Password, Select) */
    .form-control {
        width: 100%;
        background: var(--bg-body); /* Fond sombre pour contraste avec la carte */
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 0.75rem 1rem;
        border-radius: 4px;
        font-size: 0.95rem;
        font-family: inherit;
        transition: border-color 0.2s, box-shadow 0.2s;
        box-sizing: border-box;
    }

    .form-control:focus {
        border-color: var(--accent);
        outline: none;
        box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.1); /* Lueur orange subtile */
    }

    .form-control::placeholder { color: var(--text-muted); opacity: 0.5; }

    /* Grid Layout pour Prénom/Nom */
    .form-row-2 {
        display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;
    }
    @media(max-width: 600px) { .form-row-2 { grid-template-columns: 1fr; gap: 0; } }

    /* Help Text & Errors */
    .form-help {
        display: block; margin-top: 0.4rem;
        font-size: 0.8rem; color: var(--text-muted); opacity: 0.8;
    }
    .form-error {
        color: var(--danger); font-size: 0.85rem; margin-top: 0.4rem; display: block;
    }
    .form-error ul { padding: 0; margin: 0; list-style: none; }

    /* Actions Footer */
    .form-actions {
        margin-top: 2rem; padding-top: 1.5rem;
        border-top: 1px solid var(--border-color);
        display: flex; justify-content: flex-end; gap: 1rem;
    }

    .btn-cancel {
        padding: 0.7rem 1.2rem;
        color: var(--text-muted);
        font-weight: 600; font-size: 0.9rem;
        border-radius: 4px;
        transition: color 0.2s;
    }
    .btn-cancel:hover { color: var(--text-main); }

    .btn-save {
        background: var(--text-main); /* Style Noir/Blanc "Pro" */
        color: var(--bg-body);
        padding: 0.7rem 1.5rem;
        border-radius: 4px;
        font-weight: 700; font-size: 0.9rem;
        border: none; cursor: pointer;
        transition: opacity 0.2s;
    }
    .btn-save:hover { opacity: 0.9; }

</style>
{% endblock %}

{% block body %}
<div class="form-container">
    
    <div class="page-header">
        <div>
            <h1>Créer un compte</h1>
            <p>Ajouter un nouvel utilisateur à la base de données.</p>
        </div>
        <a href="{{ path('admin_users_index') }}" class="back-link">Retour à la liste</a>
    </div>

    <div class="form-card">
        {{ form_start(form) }}
        
        {# Ligne Prénom / Nom #}
        <div class="form-row-2">
            <div class="form-group">
                {{ form_label(form.firstName, 'Prénom', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.firstName, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Thomas'}}) }}
                <div class="form-error">{{ form_errors(form.firstName) }}</div>
            </div>
            <div class="form-group">
                {{ form_label(form.lastName, 'Nom', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Anderson'}}) }}
                <div class="form-error">{{ form_errors(form.lastName) }}</div>
            </div>
        </div>

        {# Email #}
        <div class="form-group">
            {{ form_label(form.email, 'Email Professionnel / Personnel', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'utilisateur@domaine.com'}}) }}
            <div class="form-error">{{ form_errors(form.email) }}</div>
        </div>

        {# Password #}
        <div class="form-group">
            {{ form_label(form.password, 'Mot de passe initial', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
            <span class="form-help">Minimum 6 caractères. L'utilisateur pourra le changer plus tard.</span>
            <div class="form-error">{{ form_errors(form.password) }}</div>
        </div>

        {# Rôles #}
        <div class="form-group">
            {{ form_label(form.roles, 'Niveau d\'accréditation', {'label_attr': {'class': 'form-label'}}) }}
            {# 
               Note : Si 'roles' est un ChoiceType(multiple=true), Symfony peut générer un select ou des checkboxes.
               La classe .form-control s'adapte bien aux <select>.
            #}
            {{ form_widget(form.roles, {'attr': {'class': 'form-control', 'style': 'height: auto;'}}) }}
            <span class="form-help">Maintenez CTRL (ou CMD) pour sélectionner plusieurs rôles si nécessaire.</span>
            <div class="form-error">{{ form_errors(form.roles) }}</div>
        </div>

        <div class="form-actions">
            <a href="{{ path('admin_users_index') }}" class="btn-cancel">Annuler</a>
            <button type="submit" class="btn-save">Enregistrer l'utilisateur</button>
        </div>

        {{ form_end(form) }}
    </div>

</div>
{% endblock %}