{% extends 'admin/base_admin.html.twig' %}

{% block title %}Utilisateurs - Chm Saleux
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Annuaire</h1>
			<p>Supervision des accès et sécurité du panel.</p>
		</div>
		<div class="toolbar">
			<input type="text" id="searchInput" class="search-input" placeholder="Nom ou email...">
			<a href="{{ path('admin_users_new') }}" class="btn-create">+ Créer un compte</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="table-scroll">
			<table class="admin-table" id="userTable">
				<thead>
					<tr>
						<th width="80">ID</th>
						<th>Utilisateur</th>
						<th>Rôle</th>
						<th>Sécurité 2FA</th>
						<th>Inscription</th>
						<th class="th-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for user in users %}
						<tr>
							<td>
								<span class="td-mono">#{{ user.id }}</span>
							</td>
							<td>
								<div
									class="product-info">
									{# La classe user-avatar remplace le style inline #}
									<div class="user-avatar">
										{{ user.firstname|first|upper }}{{ user.lastname|first|upper }}
									</div>
									<div class="title-stack">
										<strong>{{ user.firstname }}
											{{ user.lastname|upper }}</strong>
										<span class="td-mono-sm">{{ user.email }}</span>
									</div>
								</div>
							</td>
							<td>
								{% if 'ROLE_ADMIN' in user.roles %}
									<span class="badge badge-active">Administrateur</span>
								{% else %}
									<span class="badge badge-neutral">Membre</span>
								{% endif %}
							</td>
							<td>
								{% if user.isTotpConfirmed %}
									<span class="badge badge-2fa-on">● 2FA ACTIF</span>
								{% else %}
									<span class="badge badge-2fa-off">○ 2FA INACTIF</span>
								{% endif %}
							</td>
							<td class="td-mono-sm">{{ user.createdAt ? user.createdAt|date('d/m/Y') : '-' }}</td>
							<td>
								<div class="actions">
									{% if user.isTotpConfirmed and user.id != app.user.id %}
										{# MODIFICATION : Lien Reset 2FA #}
										<a href="{{ path('admin_security_reset_2fa', {'id': user.id}) }}" class="act-link act-warn js-confirm-link" data-confirm="🔐 Réinitialiser le 2FA pour {{ user.firstname }} ? Cela l'obligera à scanner un nouveau QR code.">
											Reset 2FA
										</a>
									{% endif %}

									<a href="{{ path('admin_users_edit', {'id': user.id}) }}" class="act-link">Éditer</a>

									{% if user.id != app.user.id %}
										{# MODIFICATION : Formulaire de suppression #}
										<form method="post" action="{{ path('admin_users_delete', {'id': user.id}) }}" class="inline-form js-confirm-form" data-confirm="🚫 Supprimer définitivement le compte de {{ user.firstname }} {{ user.lastname|upper }} ?">
											<button class="act-link act-del">Supprimer</button>
										</form>
									{% endif %}
								</div>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
