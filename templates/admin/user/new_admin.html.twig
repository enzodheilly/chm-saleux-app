{% extends 'admin/base_admin.html.twig' %}

{% block title %}Ajouter un Administrateur{% endblock %}

{% block stylesheets %}
<style>
    /* =================== CONTAINER =================== */
    .form-container {
        max-width: 800px;
        margin: 0 auto;
    }

    /* =================== HEADER =================== */
    .page-header {
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 1.5rem;
        display: flex; justify-content: space-between; align-items: flex-end;
    }
    .page-header h1 { 
        font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--text-main); 
    }
    .page-header p { 
        margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; 
    }
    .back-link {
        font-size: 0.85rem; color: var(--text-muted); font-weight: 500;
        text-decoration: underline; cursor: pointer;
    }
    .back-link:hover { color: var(--text-main); }

    /* =================== FORM CARD =================== */
    .form-card {
        background: var(--bg-sidebar);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 2rem;
    }

    .form-group { margin-bottom: 1.5rem; }

    /* Labels */
    .form-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }
    
    /* Tag optionnel dans le label */
    .label-tag {
        font-weight: 400; text-transform: none; 
        font-size: 0.8em; color: var(--text-muted); opacity: 0.7; margin-left: 5px;
    }

    /* Inputs */
    .form-control {
        width: 100%;
        background: var(--bg-body);
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 0.75rem 1rem;
        border-radius: 4px;
        font-size: 0.95rem;
        font-family: inherit;
        transition: border-color 0.2s, box-shadow 0.2s;
        box-sizing: border-box;
    }

    .form-control:focus {
        border-color: var(--accent);
        outline: none;
        box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.1);
    }

    /* Grille */
    .form-row-2 {
        display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;
    }
    @media(max-width: 600px) { .form-row-2 { grid-template-columns: 1fr; gap: 0; } }

    /* Info Box (Astuce) */
    .info-box {
        background: rgba(255, 102, 0, 0.05); /* Fond orange très léger */
        border-left: 3px solid var(--accent);
        padding: 1rem;
        margin-bottom: 1.5rem;
        border-radius: 0 4px 4px 0;
    }
    .info-text {
        font-size: 0.85rem; color: var(--text-main); line-height: 1.4; margin: 0;
    }
    .info-text strong { color: var(--accent); }

    /* Actions */
    .form-actions {
        margin-top: 2rem; padding-top: 1.5rem;
        border-top: 1px solid var(--border-color);
        display: flex; justify-content: flex-end; gap: 1rem;
    }

    .btn-cancel {
        padding: 0.7rem 1.2rem;
        color: var(--text-muted);
        font-weight: 600; font-size: 0.9rem;
        border-radius: 4px; transition: color 0.2s;
    }
    .btn-cancel:hover { color: var(--text-main); }

    .btn-save {
        background: var(--text-main);
        color: var(--bg-body);
        padding: 0.7rem 1.5rem;
        border-radius: 4px;
        font-weight: 700; font-size: 0.9rem;
        border: none; cursor: pointer; transition: opacity 0.2s;
    }
    .btn-save:hover { opacity: 0.9; }

</style>
{% endblock %}

{% block body %}
<div class="form-container">
    
    <div class="page-header">
        <div>
            <h1>Ajouter un Administrateur</h1>
            <p>Promouvoir un membre ou créer un accès.</p>
        </div>
        <a href="{{ path('admin_users_index') }}" class="back-link">Retour à l'annuaire</a>
    </div>

    <div class="form-card">
        
        <div class="info-box">
            <p class="info-text">
                <strong>Mode Hybride :</strong> Si vous entrez l'email d'un membre existant, il sera promu Administrateur immédiatement. 
                Sinon, remplissez les champs suivants pour créer un nouveau compte.
            </p>
        </div>

        <form method="POST" autocomplete="off">
            
            <div class="form-group">
                <label class="form-label">
                    Email de l'utilisateur
                </label>
                <input type="email" name="email" list="users_list" class="form-control" placeholder="Rechercher ou saisir un email..." required autofocus>
                
                <datalist id="users_list">
                    {% for user in users %}
                        <option value="{{ user.email }}">{{ user.firstName }} {{ user.lastName }}</option>
                    {% endfor %}
                </datalist>
            </div>

            <hr style="border: 0; border-top: 1px dashed var(--border-color); margin: 2rem 0; opacity: 0.5;">

            <div style="opacity: 0.9;"> <p style="font-size: 0.8rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 1rem;">
                    Uniquement si création de compte
                </p>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label">Prénom <span class="label-tag">(Optionnel si existant)</span></label>
                        <input type="text" name="firstname" class="form-control" placeholder="Ex: Jean">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Nom <span class="label-tag">(Optionnel si existant)</span></label>
                        <input type="text" name="lastname" class="form-control" placeholder="Ex: Dupont">
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Mot de passe <span class="label-tag">(Optionnel si existant)</span></label>
                    <input type="password" name="password" class="form-control" autocomplete="new-password">
                    <span style="display: block; font-size: 0.8rem; color: var(--text-muted); margin-top: 5px;">
                        Laissez vide si l'utilisateur existe déjà (son mot de passe sera conservé).
                    </span>
                </div>
            </div>

            <div class="form-actions">
                <a href="{{ path('admin_users_index') }}" class="btn-cancel">Annuler</a>
                <button type="submit" class="btn-save">Valider & Promouvoir</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}