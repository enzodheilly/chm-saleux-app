{% extends 'admin/base_admin.html.twig' %}

{% block title %}Ajouter un Administrateur
{% endblock %}

{# Le bloc stylesheets est supprimé pour utiliser le Master CSS centralisé #}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Ajouter un Administrateur</h1>
			<p>Promouvoir un membre ou créer un accès.</p>
		</div>

		<div class="toolbar">
			<a href="{{ path('admin_users_index') }}" class="btn-outline">Retour</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="card-body">
			<form method="POST" autocomplete="off" class="admin-form">
				<input type="hidden" name="_token" value="{{ csrf_token('new_admin') }}">

				<div class="form-grid">
					<div class="info-box">
						<p class="info-text">
							<strong>Mode hybride :</strong>
							Si vous entrez l’email d’un membre existant, il sera promu administrateur immédiatement.
														                            Sinon, complétez les champs suivants pour créer un nouveau compte.
						</p>
					</div>

					<div class="form-group">
						<label class="tool-label">Email de l'utilisateur</label>
						<input type="email" name="email" list="users_list" class="input" placeholder="Rechercher ou saisir un email..." required autofocus>

						<datalist id="users_list">
							{% for user in users %}
								<option value="{{ user.email }}">{{ user.firstName }}
									{{ user.lastName }}</option>
							{% endfor %}
						</datalist>
					</div>

					<hr class="section-separator">

					<p class="subsection-title">Uniquement si création de compte</p>

					<div class="form-row-2">
						<div class="form-group">
							<label class="tool-label">
								Prénom
								<span class="label-tag-muted">(optionnel si existant)</span>
							</label>
							<input type="text" name="firstname" class="input" placeholder="Ex: Jean">
						</div>

						<div class="form-group">
							<label class="tool-label">
								Nom
								<span class="label-tag-muted">(optionnel si existant)</span>
							</label>
							<input type="text" name="lastname" class="input" placeholder="Ex: Dupont">
						</div>
					</div>

					<div class="form-group">
						<label class="tool-label">
							Mot de passe
							<span class="label-tag-muted">(optionnel si existant)</span>
						</label>
						<input type="password" name="password" class="input" autocomplete="new-password">
						<span class="form-help">
							Laissez vide si l'utilisateur existe déjà. Son mot de passe actuel sera conservé.
						</span>
					</div>

					<div class="form-actions-footer">
						<button type="submit" class="btn-create">Valider & promouvoir</button>
						<a href="{{ path('admin_users_index') }}" class="btn-outline">Annuler</a>
					</div>
				</div>
			</form>
		</div>
	</div>
{% endblock %}
