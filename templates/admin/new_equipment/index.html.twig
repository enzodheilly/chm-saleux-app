{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des machines{% endblock %}

{% block stylesheets %}
<style>
    /* =================== HEADER & TOOLS =================== */
    .page-header {
        display: flex; justify-content: space-between; align-items: flex-end;
        margin-bottom: 2rem; padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--text-main); }
    .page-header p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; }

    .btn-create {
        background: var(--text-main);
        color: var(--bg-body);
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        font-weight: 700; font-size: 0.85rem;
        cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em;
        transition: 0.2s; border: none; text-decoration: none; display: inline-block;
    }
    .btn-create:hover { opacity: 0.9; }

    /* =================== TABLEAU =================== */
    .table-wrapper {
        background: var(--bg-sidebar);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        overflow: hidden;
    }
    
    .admin-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    
    .admin-table th {
        background: rgba(255,255,255,0.02);
        color: var(--text-muted);
        font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.75rem;
        text-align: left; padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
    }
    
    .admin-table td {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-main); vertical-align: middle;
    }
    .admin-table tr:last-child td { border-bottom: none; }
    .admin-table tr:hover td { background: rgba(255,255,255,0.01); }

    /* Machine Specifics */
    .machine-info { display: flex; align-items: center; gap: 15px; }
    
    .machine-img {
        width: 70px; height: 50px; object-fit: cover; 
        border-radius: 4px; border: 1px solid var(--border-color);
        background: var(--bg-body);
    }
    
    .no-img {
        width: 70px; height: 50px; border-radius: 4px; 
        background: var(--bg-body); border: 1px dashed var(--border-color);
        display: flex; align-items: center; justify-content: center;
        font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase;
    }

    .machine-name { font-weight: 600; font-size: 0.95rem; color: var(--text-main); }

    /* Actions */
    .actions { display: flex; gap: 15px; justify-content: flex-end; }
    .act-link { 
        font-size: 0.75rem; font-weight: 600; text-transform: uppercase; 
        letter-spacing: 0.05em; cursor: pointer; transition: 0.2s; opacity: 0.7; 
        background: none; border: none; padding: 0;
    }
    .act-link:hover { opacity: 1; text-decoration: underline; }
    .act-edit { color: var(--text-main); }
    .act-del { color: var(--danger); }

</style>
{% endblock %}

{% block page_title %}Inventaire Machines{% endblock %}

{% block body %}

    <div class="page-header">
        <div>
            <h1>Machines & Équipements</h1>
            <p>Gérez le catalogue de matériel disponible au club.</p>
        </div>
        <div class="toolbar">
            <a href="{{ path('admin_new_equipment_new') }}" class="btn-create">
                + Ajouter un équipement
            </a>
        </div>
    </div>

    <div class="table-wrapper">
        <div style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th width="40%">Équipement</th>
                        <th width="30%">Date d'acquisition</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for equipment in newEquipments %}
                        <tr>
                            <td>
                                <div class="machine-info">
                                    {% if equipment.image %}
                                        <img src="{{ asset('uploads/machines/' ~ equipment.image) }}" alt="{{ equipment.name }}" class="machine-img">
                                    {% else %}
                                        <div class="no-img">Aucun</div>
                                    {% endif %}
                                    <span class="machine-name">{{ equipment.name }}</span>
                                </div>
                            </td>

                            <td style="color: var(--text-muted); font-family: monospace; font-size: 0.85rem;">
                                {{ equipment.createdAt|date('d/m/Y') }}
                            </td>

                            <td>
                                <div class="actions">
                                    <a href="{{ path('admin_new_equipment_edit', {id: equipment.id}) }}" class="act-link act-edit">Modifier</a>

                                    <form method="post" action="{{ path('admin_new_equipment_delete', {id: equipment.id}) }}"
                                          onsubmit="return confirm('Supprimer cet équipement de l\'inventaire ?');"
                                          style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ equipment.id) }}">
                                        <button class="act-link act-del">Supprimer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" style="text-align: center; padding: 4rem; color: var(--text-muted);">
                                Aucun équipement n'a été ajouté pour le moment.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

{% endblock %}
