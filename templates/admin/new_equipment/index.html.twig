{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des machines
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/new_equipment/index.css') }}">
{% endblock %}

{% block body %}

	<div class="page-header">
		<div>
			<h1>Machines & Équipements</h1>
			<p>Gérez le catalogue de matériel disponible au club.</p>
		</div>
		<div class="toolbar">
			<a href="{{ path('admin_new_equipment_new') }}" class="btn-create">
				+ Ajouter un équipement
			</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div style="overflow-x: auto;">
			<table class="admin-table">
				<thead>
					<tr>
						<th width="40%">Équipement</th>
						<th width="30%">Date d'acquisition</th>
						<th style="text-align: right;">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for equipment in newEquipments %}
						<tr>
							<td>
								<div class="machine-info">
									{% if equipment.image %}
										<img src="{{ asset('uploads/machines/' ~ equipment.image) }}" alt="{{ equipment.name }}" class="machine-img">
									{% else %}
										<div class="no-img">Aucun</div>
									{% endif %}
									<span class="machine-name">{{ equipment.name }}</span>
								</div>
							</td>

							<td style="color: var(--text-muted); font-family: monospace; font-size: 0.85rem;">
								{{ equipment.createdAt|date('d/m/Y') }}
							</td>

							<td>
								<div class="actions">
									<a href="{{ path('admin_new_equipment_edit', {id: equipment.id}) }}" class="act-link act-edit">Modifier</a>

									<form method="post" action="{{ path('admin_new_equipment_delete', {id: equipment.id}) }}" onsubmit="return confirm('Supprimer cet équipement de l\'inventaire ?');" style="display:inline;">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ equipment.id) }}">
										<button class="act-link act-del">Supprimer</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="3" style="text-align: center; padding: 4rem; color: var(--text-muted);">
								Aucun équipement n'a été ajouté pour le moment.
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>

{% endblock %}
