{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des machines
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Machines & Équipements</h1>
			<p>Gérez le catalogue de matériel disponible au club.</p>
		</div>
		<div class="toolbar">
			<a href="{{ path('admin_new_equipment_new') }}" class="btn-create">+ Ajouter un équipement</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="table-scroll">
			<table class="admin-table">
				<thead>
					<tr>
						<th width="45%">Équipement</th>
						<th width="30%">Date d'acquisition</th>
						<th class="th-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for equipment in newEquipments %}
						<tr>
							<td>
								<div class="product-info">
									{% if equipment.image %}
										<img src="{{ asset('uploads/machines/' ~ equipment.image) }}" alt="" class="product-img">
									{% else %}
										{# Classe placeholder-na pour remplacer le style inline #}
										<div class="product-img placeholder-na">AUCUN</div>
									{% endif %}
									<div class="title-stack">
										<strong>{{ equipment.name }}</strong>
										<span class="td-mono-sm">ID #{{ equipment.id }}</span>
									</div>
								</div>
							</td>

							<td class="td-mono-sm">
								{{ equipment.createdAt|date('d/m/Y') }}
							</td>

							<td>
								<div class="actions">
									<a href="{{ path('admin_new_equipment_edit', {id: equipment.id}) }}" class="act-link">Modifier</a>

									{# MODIFICATION : Remplacement du onsubmit par js-confirm-form #}
									<form method="post" action="{{ path('admin_new_equipment_delete', {id: equipment.id}) }}" class="js-confirm-form" data-confirm="⚙️ Confirmer la suppression de l'équipement : {{ equipment.name }} ?">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ equipment.id) }}">
										<button class="act-link act-del">Supprimer</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="3" class="td-empty">Aucun équipement enregistré.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
