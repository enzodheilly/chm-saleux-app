{% extends 'admin/base_admin.html.twig' %}

{% block title %}Sauvegardes Système{% endblock %}

{% block stylesheets %}
<style>
    /* =================== BACKUP LAYOUT =================== */
    .dashboard-container { width: 100%; max-width: 1200px; margin: 0 auto; }

    /* Header & Action */
    .page-header {
        display: flex; justify-content: space-between; align-items: flex-end;
        margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem;
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--text-main); }
    .page-header p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; }

    .btn-create {
        background: var(--accent); color: #fff; padding: 0.7rem 1.5rem; border-radius: 4px;
        font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: 0.2s; border: none;
        text-transform: uppercase; letter-spacing: 0.05em; text-decoration: none;
    }
    .btn-create:hover { background: var(--accent-hover); transform: translateY(-1px); }

    /* Table & Content */
    .table-wrapper { background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 6px; overflow: hidden; }
    .admin-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    
    .admin-table th {
        background: rgba(255,255,255,0.02); color: var(--text-muted); font-weight: 600; text-transform: uppercase; 
        letter-spacing: 0.05em; font-size: 0.75rem; text-align: left; padding: 1rem 1.5rem; border-bottom: 1px solid var(--border-color);
    }
    
    .admin-table td { padding: 1rem 1.5rem; border-bottom: 1px solid var(--border-color); color: var(--text-main); vertical-align: middle; }
    .admin-table tr:last-child td { border-bottom: none; }
    .admin-table tr:hover td { background: rgba(255,255,255,0.01); }

    /* File Specs */
    .filename { font-family: monospace; color: var(--text-main); font-weight: 500; font-size: 0.85rem; background: var(--bg-body); padding: 4px 8px; border-radius: 4px; }
    .file-size { color: var(--text-muted); font-family: monospace; font-size: 0.85rem; }
    .date-text { color: var(--text-muted); font-size: 0.85rem; }

    /* Actions */
    .actions-group { display: flex; gap: 15px; justify-content: flex-end; }
    .act-btn { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; text-decoration: none; transition: 0.2s; }
    
    .act-download { color: var(--accent); }
    .act-download:hover { text-decoration: underline; }
    
    .act-delete { color: var(--danger); opacity: 0.7; }
    .act-delete:hover { opacity: 1; text-decoration: underline; }

</style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    
    <div class="page-header">
        <div>
            <h1>Sauvegardes Système</h1>
            <p>Gestion des points de restauration et archives de données.</p>
        </div>
        <div>
            <a href="{{ path('admin_backups_create') }}" class="btn-create">
                📦 Générer une sauvegarde
            </a>
        </div>
    </div>

    <div class="table-wrapper">
        <div style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th width="40%">Archive (ZIP)</th>
                        <th width="15%">Poids</th>
                        <th width="25%">Date de génération</th>
                        <th style="text-align: right;">Options</th>
                    </tr>
                </thead>
                <tbody>
                    {% for file in files %}
                        <tr>
                            <td>
                                <span class="filename">{{ file.name }}</span>
                            </td>
                            
                            <td>
                                <span class="file-size">
                                    {% set size = file.size %}
                                    {% if size < 1024 %}
                                        {{ size }} B
                                    {% elseif size < 1048576 %}
                                        {{ (size / 1024)|number_format(1, ',', ' ') }} KB
                                    {% elseif size < 1073741824 %}
                                        {{ (size / 1048576)|number_format(1, ',', ' ') }} MB
                                    {% else %}
                                        {{ (size / 1073741824)|number_format(2, ',', ' ') }} GB
                                    {% endif %}
                                </span>
                            </td>

                            <td class="date-text">
                                {# Parsing sécurisé de la date depuis le nom du fichier #}
                                {% set parts = file.name|split('_') %}
                                {% if parts|length >= 3 %}
                                    {% set datePart = parts[1] %}
                                    {% set timePart = parts[2]|replace({'.zip': '', '-': ':'}) %}
                                    {{ datePart|date('d/m/Y') }} à {{ timePart }}
                                {% else %}
                                    <span style="opacity: 0.5;">Date inconnue</span>
                                {% endif %}
                            </td>

                            <td>
                                <div class="actions-group">
                                    <a href="{{ path('admin_backups_download', { filename: file.name }) }}" class="act-btn act-download">
                                        Télécharger
                                    </a>
                                    
                                    <a href="{{ path('admin_backups_delete', { filename: file.name }) }}" 
                                       class="act-btn act-delete" 
                                       onclick="return confirm('⚠️ ALERTE SÉCURITÉ\n\nCette sauvegarde sera définitivement effacée du serveur. Continuer ?')">
                                        Supprimer
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 5rem; color: var(--text-muted);">
                                <div style="font-size: 2rem; margin-bottom: 1rem;">📂</div>
                                Aucune archive disponible sur le serveur.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}