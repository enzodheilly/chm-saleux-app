{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des athlètes
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Athletes Management</h1>
			<p>List of athlete profiles and categories.</p>
		</div>
		<div class="toolbar">
			<input type="text" id="searchInput" class="search-input" placeholder="Search an athlete...">
			<a href="{{ path('admin_athlete_new') }}" class="btn-create">+ Add Athlete</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="table-scroll">
			<table class="admin-table" id="athleteTable">
				<thead>
					<tr>
						<th width="80">ID</th>
						<th width="30%">Athlete</th>
						<th width="15%">Category</th>
						<th width="15%">Weight</th>
						<th width="15%">Birth date</th>
						<th class="th-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for athlete in athletes %}
						<tr>
							<td>
								<span class="td-mono">#{{ athlete.id }}</span>
							</td>

							<td>
								<div class="product-info">
									{% if athlete.image %}
										{# Classe avatar-circle remplace le style inline #}
										<img src="{{ asset('uploads/athletes/' ~ athlete.image) }}" alt="" class="product-img avatar-circle">
									{% else %}
										<div class="product-img avatar-circle avatar-placeholder">
											{{ athlete.firstName|first|upper }}{{ athlete.lastName|first|upper }}
										</div>
									{% endif %}

									<div class="title-stack">
										<strong>{{ athlete.firstName }}
											{{ athlete.lastName|upper }}</strong>
										<span class="td-mono-sm gender-tag">{{ athlete.gender|capitalize }}</span>
									</div>
								</div>
							</td>

							<td>
								<span class="badge badge-neutral">
									{{ athlete.category ?: '—' }}
								</span>
							</td>

							<td>
								<span class="td-mono weight-tag">
									{{ athlete.weightClass ?: '—' }}
								</span>
							</td>

							<td class="td-mono-sm">
								{{ athlete.birthDate ? athlete.birthDate|date('d/m/Y') : '—' }}
							</td>

							<td>
								<div class="actions">
									<a href="{{ path('admin_athlete_edit', {'id': athlete.id}) }}" class="act-link">Edit</a>

									{# MODIFICATION : Formulaire de suppression #}
									<form method="post" action="{{ path('admin_athlete_delete', {'id': athlete.id}) }}" class="js-confirm-form" data-confirm="🗑️ Delete athlete {{ athlete.firstName }} {{ athlete.lastName|upper }}? All associated performance data will be lost.">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ athlete.id) }}">
										<button class="act-link act-del">Delete</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="td-empty">No athletes found.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
