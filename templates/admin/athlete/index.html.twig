{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des athlètes
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/athlete/index.css') }}">
{% endblock %}

{% block body %}

	<div class="page-header">
		<div>
			<h1>Athletes Management</h1>
			<p>List of athlete profiles and categories.</p>
		</div>
		<div class="toolbar">
			<input type="text" id="searchInput" class="search-input" placeholder="Search an athlete...">
			<button class="btn-create" data-href="{{ path('admin_athlete_new') }}">
				+ Add
			</button>
		</div>
	</div>

	<div class="table-wrapper">
		<div style="overflow-x: auto;">
			<table class="admin-table" id="athleteTable">
				<thead>
					<tr>
						<th width="80">ID</th>
						<th width="35%">Athlete</th>
						<th width="15%">Category</th>
						<th width="15%">Weight class</th>
						<th width="15%">Birth date</th>
						<th style="text-align: right;">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for athlete in athletes %}
						<tr>
							<td>
								<span style="font-family: monospace; color: var(--text-muted);">#{{ athlete.id }}</span>
							</td>

							<td>
								<div class="athlete-cell">
									{% if athlete.image %}
										<img src="{{ asset('uploads/athletes/' ~ athlete.image) }}" alt="{{ athlete.firstName }}" class="athlete-avatar">
									{% else %}
										<div class="athlete-initials">
											{{ athlete.firstName|first|upper }}{{ athlete.lastName|first|upper }}
										</div>
									{% endif %}

									<div class="athlete-info">
										<span class="athlete-name">
											{{ athlete.firstName }}
											{{ athlete.lastName|upper }}
										</span>

										<span class="athlete-meta">
											{% if athlete.gender == 'male' %}
												Male
											{% elseif athlete.gender == 'female' %}
												Female
											{% else %}
												—
											{% endif %}
										</span>
									</div>
								</div>
							</td>

							<td>
								{% if athlete.category %}
									<span class="cat-badge">{{ athlete.category }}</span>
								{% else %}
									<span style="color: var(--text-muted); font-size: 0.8rem;">—</span>
								{% endif %}
							</td>

							<td>
								{% if athlete.weightClass %}
									<span style="font-family: monospace; font-weight: 600;">
										{{ athlete.weightClass }}
									</span>
								{% else %}
									<span style="color: var(--text-muted); font-size: 0.8rem;">—</span>
								{% endif %}
							</td>

							<td style="color: var(--text-muted); font-size: 0.85rem;">
								{{ athlete.birthDate ? athlete.birthDate|date('d/m/Y') : '—' }}
							</td>

							<td>
								<div class="actions">
									<a href="{{ path('admin_athlete_edit', {'id': athlete.id}) }}" class="act-link act-edit">
										Edit
									</a>

									<form method="post" action="{{ path('admin_athlete_delete', {'id': athlete.id}) }}" style="display:inline;" onsubmit="return confirm('Confirm deletion of {{ athlete.firstName }} {{ athlete.lastName }} ?');">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ athlete.id) }}">
										<button class="act-link act-del">Delete</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" style="text-align: center; padding: 3rem; color: var(--text-muted);">
								No athletes found.
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>

{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/athlete/index.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
