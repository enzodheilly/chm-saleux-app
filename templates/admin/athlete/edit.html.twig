{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier l'athlète{% endblock %}

{% block stylesheets %}
<style>
    /* =================== CONTAINER =================== */
    .form-container { max-width: 800px; margin: 0 auto; }

    /* =================== HEADER =================== */
    .page-header {
        margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem;
        display: flex; justify-content: space-between; align-items: flex-end;
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--text-main); }
    .page-header p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; }
    
    .back-link { font-size: 0.85rem; color: var(--text-muted); font-weight: 500; text-decoration: underline; cursor: pointer; }
    .back-link:hover { color: var(--text-main); }

    /* =================== FORM CARD =================== */
    .form-card { background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 6px; padding: 2rem; }
    .form-group { margin-bottom: 1.5rem; }

    /* Labels */
    .form-label { display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }

    /* Inputs */
    .form-control {
        width: 100%; background: var(--bg-body); border: 1px solid var(--border-color); color: var(--text-main);
        padding: 0.75rem 1rem; border-radius: 4px; font-size: 0.95rem; font-family: inherit; transition: border-color 0.2s, box-shadow 0.2s; box-sizing: border-box;
    }
    .form-control:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.1); }

    /* File Input Styling */
    input[type="file"].form-control { padding: 0.5rem; cursor: pointer; }
    input[type="file"]::file-selector-button {
        background: var(--bg-darker); border: 1px solid var(--border-color); color: var(--text-main);
        padding: 0.3rem 0.8rem; margin-right: 1rem; border-radius: 4px; cursor: pointer; transition: 0.2s;
    }
    input[type="file"]::file-selector-button:hover { background: var(--border-color); }

    /* Preview Image */
    .preview-container { margin-bottom: 1rem; display: flex; align-items: center; gap: 15px; }
    .current-avatar { 
        width: 80px; height: 80px; object-fit: cover; 
        border-radius: 50%; /* Rond pour le profil */
        border: 2px solid var(--border-color); 
        background: var(--bg-body);
    }
    .preview-label { font-size: 0.8rem; color: var(--text-muted); }

    /* Grilles */
    .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    @media(max-width: 600px) { .form-row-2 { grid-template-columns: 1fr; gap: 0; } }

    /* Errors */
    .form-error { color: var(--danger); font-size: 0.85rem; margin-top: 0.4rem; }

    /* =================== ACTIONS (Edit Mode) =================== */
    .form-actions { 
        margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color); 
        display: flex; justify-content: space-between; align-items: center; 
    }
    
    .btn-group-right { display: flex; gap: 1rem; }

    .btn-cancel { padding: 0.7rem 1.2rem; color: var(--text-muted); font-weight: 600; font-size: 0.9rem; border-radius: 4px; transition: color 0.2s; }
    .btn-cancel:hover { color: var(--text-main); }
    
    .btn-save { background: var(--text-main); color: var(--bg-body); padding: 0.7rem 1.5rem; border-radius: 4px; font-weight: 700; font-size: 0.9rem; border: none; cursor: pointer; transition: opacity 0.2s; }
    .btn-save:hover { opacity: 0.9; }

    .btn-delete { color: var(--danger); background: none; border: none; font-size: 0.9rem; font-weight: 600; cursor: pointer; padding: 0.5rem 0; opacity: 0.8; transition: opacity 0.2s; }
    .btn-delete:hover { opacity: 1; text-decoration: underline; }

</style>
{% endblock %}

{% block body %}
<div class="form-container">
    
    <div class="page-header">
        <div>
            <h1>Modifier le profil</h1>
            <p>
                Mise à jour de :
                <span style="font-weight:700; color:var(--text-main);">
                    {{ athlete.firstName }} {{ athlete.lastName }}
                </span>
            </p>
        </div>
        <a href="{{ path('admin_athlete_index') }}" class="back-link">Retour à la liste</a>
    </div>

    <div class="form-card">
        {{ form_start(form) }}

        <div class="form-row-2">
            <div class="form-group">
                {{ form_label(form.firstName, 'Prénom', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.firstName, {'attr': {'class': 'form-control'}}) }}
                <div class="form-error">{{ form_errors(form.firstName) }}</div>
            </div>

            <div class="form-group">
                {{ form_label(form.lastName, 'Nom', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.lastName, {'attr': {'class': 'form-control'}}) }}
                <div class="form-error">{{ form_errors(form.lastName) }}</div>
            </div>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                {{ form_label(form.birthDate, 'Date de naissance', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.birthDate, {'attr': {'class': 'form-control'}}) }}
                <div class="form-error">{{ form_errors(form.birthDate) }}</div>
            </div>

            <div class="form-group">
                {{ form_label(form.gender, 'Genre', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.gender, {'attr': {'class': 'form-control'}}) }}
                <div class="form-error">{{ form_errors(form.gender) }}</div>
            </div>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                {{ form_label(form.category, 'Catégorie sportive', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.category, {'attr': {'class': 'form-control'}}) }}
                <div class="form-error">{{ form_errors(form.category) }}</div>
            </div>

            <div class="form-group">
                {{ form_label(form.weightClass, 'Catégorie de poids', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.weightClass, {'attr': {'class': 'form-control'}}) }}
                <div class="form-error">{{ form_errors(form.weightClass) }}</div>
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.image, 'Photo de profil', {'label_attr': {'class': 'form-label'}}) }}
            
            {% if athlete.image %}
                <div class="preview-container">
                    <img src="{{ asset('uploads/athletes/' ~ athlete.image) }}" alt="Actuelle" class="current-avatar">
                    <div class="preview-label">
                        Image actuelle<br>
                        <small>Laissez le champ vide pour la conserver.</small>
                    </div>
                </div>
            {% endif %}

            {{ form_widget(form.image, {'attr': {'class': 'form-control'}}) }}
            <div class="form-error">{{ form_errors(form.image) }}</div>
        </div>

        <div class="form-actions">
            <button type="button" class="btn-delete"
                onclick="if(confirm('⚠️ Attention : Voulez-vous vraiment supprimer cet athlète de la base de données ?')) document.getElementById('delete-form').submit();">
                Supprimer le profil
            </button>

            <div class="btn-group-right">
                <a href="{{ path('admin_athlete_index') }}" class="btn-cancel">Annuler</a>
                <button type="submit" class="btn-save">Mettre à jour</button>
            </div>
        </div>

        {{ form_end(form) }}
    </div>

    <form id="delete-form" method="post"
          action="{{ path('admin_athlete_delete', {'id': athlete.id}) }}"
          style="display:none;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ athlete.id) }}">
    </form>
</div>
{% endblock %}
