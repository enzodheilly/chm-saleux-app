{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier l'athlète{% endblock %}

{% block stylesheets %}
<style>
:root {
    --bg-dark: #0e0e10;
    --bg-darker: #141416;
    --bg-light: #1c1c1f;
    --text-main: #e5e7eb;
    --text-muted: #9ca3af;
    --accent: #ff6600;
    --border: #2a2a2d;
}

body {
    margin: 0;
    font-family: "Inter", system-ui, sans-serif;
}

.main-content {
    flex: 1;
    margin-left: 100px;
    padding: 2rem 1rem;
    background: var(--bg-dark);
    min-height: 100vh;
}

input, select {
    width: 100%;
    padding: 0.5rem 0.8rem;
    border-radius: 5px;
    border: 1px solid var(--border);
    background: var(--bg-darker);
    color: var(--text-main);
    margin-bottom: 1rem;
}

.btn-submit {
    padding: 0.6rem 1.2rem;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-weight: 600;
}
</style>
{% endblock %}

{% block body %}
<div class="main-content">
    <h1>✏️ Modifier l'athlète</h1>

    {{ form_start(form) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.prenom) }}
        {{ form_row(form.dateNaissance) }}
        {{ form_row(form.equipe) }}
        {{ form_row(form.categorie) }}
        {{ form_row(form.image) }}

        <button type="submit" class="btn-submit">Enregistrer les modifications</button>
    {{ form_end(form) }}
</div>
{% endblock %}
