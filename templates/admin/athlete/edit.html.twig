{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier l'athlète{% endblock %}
{% block page_title %}Modifier l'athlète{% endblock %}

{% block stylesheets %}
<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
        gap: 1rem;
        flex-wrap: wrap;
    }

    .page-header h1 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: var(--text-main);
    }

    .page-header p {
        margin: 5px 0 0 0;
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    .toolbar {
        display: flex;
        gap: 0.75rem;
        align-items: flex-end;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .btn-create {
        background: var(--text-main);
        color: var(--bg-body);
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: 0.2s;
        border: none;
        text-decoration: none;
        display: inline-block;
        white-space: nowrap;
    }

    .btn-create:hover {
        opacity: 0.9;
    }

    .btn-outline {
        background: transparent;
        color: var(--text-main);
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: 0.2s;
        border: 1px solid var(--border-color);
        text-decoration: none;
        display: inline-block;
        white-space: nowrap;
        opacity: 0.9;
    }

    .btn-outline:hover {
        opacity: 1;
        border-color: var(--text-main);
    }

    .btn-danger-link {
        background: transparent;
        color: var(--danger);
        padding: 0.6rem 0;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: 0.2s;
        border: none;
        text-decoration: none;
        display: inline-block;
        white-space: nowrap;
    }

    .btn-danger-link:hover {
        opacity: 0.85;
        text-decoration: underline;
    }

    .table-wrapper {
        background: var(--bg-sidebar);
        border: 1px solid var(--border-color);
        border-radius: 6px;
    }

    .card-body {
        padding: 1.5rem;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.2rem;
        max-width: 900px;
    }

    .form-row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.2rem;
    }

    .tool-label {
        display: block;
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.35rem;
    }

    .input {
        background: transparent;
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 0.6rem 1rem;
        border-radius: 4px;
        outline: none;
        font-size: 0.9rem;
        transition: border-color 0.2s;
        width: 100%;
        box-sizing: border-box;
    }

    .input:focus {
        border-color: var(--text-main);
    }

    .input::placeholder {
        color: var(--text-muted);
        opacity: 0.6;
    }

    input[type="file"].input {
        padding: 0.45rem;
        cursor: pointer;
    }

    input[type="file"]::file-selector-button {
        background: var(--bg-body);
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 0.35rem 0.8rem;
        margin-right: 0.8rem;
        border-radius: 4px;
        cursor: pointer;
        transition: 0.2s;
    }

    input[type="file"]::file-selector-button:hover {
        background: rgba(255,255,255,0.05);
    }

    .preview-container {
        margin-bottom: 0.9rem;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .current-avatar {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid var(--border-color);
        background: var(--bg-body);
    }

    .preview-label {
        font-size: 0.82rem;
        color: var(--text-muted);
        line-height: 1.45;
    }

    .form-error {
        color: var(--danger);
        font-size: 0.85rem;
        margin-top: 0.35rem;
    }

    .form-error ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .form-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 0.5rem;
    }

    .form-actions-right {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        flex-wrap: wrap;
    }

    @media (max-width: 700px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .toolbar {
            justify-content: flex-start;
            width: 100%;
        }

        .form-row-2 {
            grid-template-columns: 1fr;
        }

        .form-actions {
            align-items: flex-start;
            flex-direction: column;
        }

        .form-actions-right {
            width: 100%;
        }
    }
</style>
{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Modifier le profil</h1>
            <p>
                Mise à jour de :
                <span style="font-weight:700; color:var(--text-main);">
                    {{ athlete.firstName }} {{ athlete.lastName }}
                </span>
            </p>
        </div>

        <div class="toolbar">
            <a href="{{ path('admin_athlete_index') }}" class="btn-outline">Retour à la liste</a>
        </div>
    </div>

    <div class="table-wrapper">
        <div class="card-body">
            {{ form_start(form) }}

                <div class="form-error">{{ form_errors(form) }}</div>

                <div class="form-grid">
                    <div class="form-row-2">
                        <div>
                            <span class="tool-label">Prénom</span>
                            {{ form_widget(form.firstName, {'attr': {'class': 'input'}}) }}
                            <div class="form-error">{{ form_errors(form.firstName) }}</div>
                        </div>

                        <div>
                            <span class="tool-label">Nom</span>
                            {{ form_widget(form.lastName, {'attr': {'class': 'input'}}) }}
                            <div class="form-error">{{ form_errors(form.lastName) }}</div>
                        </div>
                    </div>

                    <div class="form-row-2">
                        <div>
                            <span class="tool-label">Date de naissance</span>
                            {{ form_widget(form.birthDate, {'attr': {'class': 'input'}}) }}
                            <div class="form-error">{{ form_errors(form.birthDate) }}</div>
                        </div>

                        <div>
                            <span class="tool-label">Genre</span>
                            {{ form_widget(form.gender, {'attr': {'class': 'input'}}) }}
                            <div class="form-error">{{ form_errors(form.gender) }}</div>
                        </div>
                    </div>

                    <div class="form-row-2">
                        <div>
                            <span class="tool-label">Catégorie sportive</span>
                            {{ form_widget(form.category, {'attr': {'class': 'input'}}) }}
                            <div class="form-error">{{ form_errors(form.category) }}</div>
                        </div>

                        <div>
                            <span class="tool-label">Catégorie de poids</span>
                            {{ form_widget(form.weightClass, {'attr': {'class': 'input'}}) }}
                            <div class="form-error">{{ form_errors(form.weightClass) }}</div>
                        </div>
                    </div>

                    <div>
                        <span class="tool-label">Photo de profil</span>

                        {% if athlete.image %}
                            <div class="preview-container">
                                <img src="{{ asset('uploads/athletes/' ~ athlete.image) }}" alt="Actuelle" class="current-avatar">
                                <div class="preview-label">
                                    Image actuelle<br>
                                    <small>Laissez le champ vide pour la conserver.</small>
                                </div>
                            </div>
                        {% endif %}

                        {{ form_widget(form.image, {'attr': {'class': 'input'}}) }}
                        <div class="form-error">{{ form_errors(form.image) }}</div>
                    </div>

                    <div class="form-actions">
                        <button
                            type="button"
                            class="btn-danger-link"
                            onclick="if(confirm('⚠️ Attention : Voulez-vous vraiment supprimer cet athlète de la base de données ?')) document.getElementById('delete-form').submit();"
                        >
                            Supprimer le profil
                        </button>

                        <div class="form-actions-right">
                            <a href="{{ path('admin_athlete_index') }}" class="btn-outline">Annuler</a>
                            <button type="submit" class="btn-create">Mettre à jour</button>
                        </div>
                    </div>
                </div>

            {{ form_end(form) }}
        </div>
    </div>

    <form id="delete-form" method="post"
          action="{{ path('admin_athlete_delete', {'id': athlete.id}) }}"
          style="display:none;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ athlete.id) }}">
    </form>
{% endblock %}