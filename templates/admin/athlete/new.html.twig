{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouvel Athlète
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/athlete/new.css') }}">
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Add an Athlete</h1>
			<p>Create an athlete profile for competitions.</p>
		</div>

		<div class="toolbar">
			<a href="{{ path('admin_athlete_index') }}" class="btn-outline">Back to list</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="card-body">
			{{ form_start(form) }}

			<div class="form-error">{{ form_errors(form) }}</div>

			<div class="form-grid">
				<div class="form-row-2">
					<div>
						<span class="tool-label">First name</span>
						{{ form_widget(form.firstName, {'attr': {'class': 'input', 'placeholder': 'e.g. Sarah'}}) }}
						<div class="form-error">{{ form_errors(form.firstName) }}</div>
					</div>

					<div>
						<span class="tool-label">Last name</span>
						{{ form_widget(form.lastName, {'attr': {'class': 'input', 'placeholder': 'e.g. Connor'}}) }}
						<div class="form-error">{{ form_errors(form.lastName) }}</div>
					</div>
				</div>

				<div class="form-row-2">
					<div>
						<span class="tool-label">Birth date</span>
						{{ form_widget(form.birthDate, {'attr': {'class': 'input'}}) }}
						<div class="form-error">{{ form_errors(form.birthDate) }}</div>
					</div>

					<div>
						<span class="tool-label">Gender</span>
						{{ form_widget(form.gender, {'attr': {'class': 'input'}}) }}
						<div class="form-error">{{ form_errors(form.gender) }}</div>
					</div>
				</div>

				<div class="form-row-2">
					<div>
						<span class="tool-label">Category</span>
						{{ form_widget(form.category, {'attr': {'class': 'input', 'placeholder': 'e.g. Senior'}}) }}
						<div class="form-error">{{ form_errors(form.category) }}</div>
					</div>

					<div>
						<span class="tool-label">Weight class</span>
						{{ form_widget(form.weightClass, {'attr': {'class': 'input', 'placeholder': 'e.g. -71kg'}}) }}
						<div class="form-error">{{ form_errors(form.weightClass) }}</div>
					</div>
				</div>

				<div>
					<span class="tool-label">Profile photo (optional)</span>
					{{ form_widget(form.image, {'attr': {'class': 'input'}}) }}
					<div class="form-error">{{ form_errors(form.image) }}</div>
					<span class="form-help">
						Recommended formats: JPG / PNG / WebP, square format (e.g. 500x500px).
					</span>
				</div>

				<div class="form-actions">
					<button type="submit" class="btn-create">Save</button>
					<a href="{{ path('admin_athlete_index') }}" class="btn-outline">Cancel</a>
				</div>
			</div>

			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}
