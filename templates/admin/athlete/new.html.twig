{% extends 'admin/base_admin.html.twig' %}

{% block title %}➕ Ajouter un nouvel athlète{% endblock %}

{% block stylesheets %}
<style>
:root {
    --bg-dark: #0e0e10;
    --bg-darker: #141416;
    --bg-light: #1c1c1f;
    --text-main: #e5e7eb;
    --text-muted: #9ca3af;
    --accent: #ff6600;
    --border: #2a2a2d;
    --success: #22c55e;
}

body {
    font-family: "Inter", system-ui, sans-serif;
    background: var(--bg-dark);
    color: var(--text-main);
    margin: 0;
    min-height: 100vh;
}

.main-content {
    flex: 1;
    margin-left: 100px;
    padding: 2.5rem 3rem;
    display: flex;
    flex-direction: column;
    background: var(--bg-dark);
    min-height: 100vh;
}

.dashboard-container {
    transform: scale(1.00);
    transform-origin: top left;
    width: 100%;
}

h1 {
    font-size: 2.3rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
}

.section-card {
    background: var(--bg-light);
    border: 1px solid var(--border);
    padding: 1.8rem;
    max-width: 800px;
}

label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text-main);
}

input[type="text"],
input[type="date"],
input[type="file"],
select,
textarea {
    width: 95%;
    background: var(--bg-darker);
    color: var(--text-main);
    border: 1px solid var(--border);
    padding: 0.7rem 1rem;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease;
    border-radius: 5px;
}

input[type="text"]:focus,
input[type="date"]:focus,
input[type="file"]:focus,
select:focus,
textarea:focus {
    border-color: var(--accent);
}

textarea {
    resize: vertical;
    min-height: 120px;
}

.form-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.8rem;
}

.btn-success {
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border: none;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    box-shadow: 0 3px 10px rgba(255, 102, 0, 0.25);
    border-radius: 5px;
}

.btn-success:hover {
    background: #e25500;
    transform: translateY(-2px);
}

.btn-secondary {
    background: var(--bg-darker);
    color: var(--text-main);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--border);
    cursor: pointer;
    transition: background 0.2s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
}

.btn-secondary:hover {
    background: #2a2a2d;
}

.alert-success {
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.4);
    color: var(--success);
    padding: 0.8rem 1rem;
    margin-bottom: 1.2rem;
    font-weight: 500;
}

.alert-error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #ef4444;
    padding: 0.8rem 1rem;
    margin-bottom: 1.2rem;
    font-weight: 500;
}

.form-group {
    margin-bottom: 1rem;
}
</style>
{% endblock %}

{% block body %}
<div class="main-content">
    <div class="dashboard-container">
        <h1>➕ Ajouter un nouvel athlète</h1>

        <div class="section-card">

            {% for message in app.flashes('error') %}
                <div class="alert-error">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('success') %}
                <div class="alert-success">{{ message }}</div>
            {% endfor %}

            {{ form_start(form) }}

            <div class="form-group">
                {{ form_label(form.prenom, 'Prénom') }}
                {{ form_widget(form.prenom) }}
                {{ form_errors(form.prenom) }}
            </div>

            <div class="form-group">
                {{ form_label(form.nom, 'Nom') }}
                {{ form_widget(form.nom) }}
                {{ form_errors(form.nom) }}
            </div>

            <div class="form-group">
                {{ form_label(form.dateNaissance, 'Date de naissance') }}
                {{ form_widget(form.dateNaissance) }}
                {{ form_errors(form.dateNaissance) }}
            </div>

            <div class="form-group">
                {{ form_label(form.equipe, 'Équipe') }}
                {{ form_widget(form.equipe) }}
                {{ form_errors(form.equipe) }}
            </div>

            <div class="form-group">
                {{ form_label(form.categorie, 'Catégorie') }}
                {{ form_widget(form.categorie) }}
                {{ form_errors(form.categorie) }}
            </div>

            <div class="form-group">
                {{ form_label(form.categoriePoids, 'Catégorie poids') }}
                {{ form_widget(form.categoriePoids, {'attr': {'placeholder': 'Ex: 63 kg'}}) }}
                {{ form_errors(form.categoriePoids) }}
            </div>

            <div class="form-group">
                {{ form_label(form.image, 'Photo') }}
                {{ form_widget(form.image) }}
                {{ form_errors(form.image) }}
            </div>

            <div class="form-actions">
                <button class="btn-success">💾 Enregistrer</button>
                <a href="{{ path('admin_athlete_index') }}" class="btn-secondary">⬅️ Retour</a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
