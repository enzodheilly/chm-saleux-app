{% extends 'admin/base_admin.html.twig' %}

{% block title %}📋 Liste des machines{% endblock %}

{% block stylesheets %}
<style>
.section-card {
	background: var(--bg-light);
	border: 1px solid var(--border);
	padding: 1.5rem;
	margin-top: 1rem;
}

.table {
	width: 100%;
	border-collapse: collapse;
	margin-top: 1.5rem;
}

.table th {
	text-align: left;
	color: var(--text-muted);
	border-bottom: 1px solid var(--border);
	padding: 0.8rem;
	font-size: 0.85rem;
	letter-spacing: 0.5px;
}

.table td {
	padding: 1rem 0.8rem;
	border-bottom: 1px solid var(--border);
}

.table img {
	width: 90px;
	border-radius: 6px;
}

.action-btn {
	display: inline-block;
	padding: 0.45rem 0.9rem;
	border: 1px solid var(--border);
	border-radius: 5px;
	font-size: 0.85rem;
	cursor: pointer;
	text-decoration: none;
	transition: 0.2s ease;
}

.btn-edit {
	color: #fff;
	background: #444;
}

.btn-edit:hover {
	background: #555;
}

.btn-delete {
	color: #ef4444;
	background: rgba(239, 68, 68, 0.1);
}

.btn-delete:hover {
	background: rgba(239, 68, 68, 0.2);
}
</style>
{% endblock %}

{% block body %}
<div class="main-content">
	<div class="dashboard-container">

		<h1>📋 Liste des machines</h1>

		<a href="{{ path('admin_machine_new') }}" class="btn-success" style="margin-bottom: 1.5rem; display:inline-block;">
			➕ Ajouter une machine
		</a>

		<div class="section-card">
			<table class="table">
				<thead>
					<tr>
						<th>ID</th>
						<th>Image</th>
						<th>Nom</th>
						<th>Date</th>
						<th style="width:150px;">Actions</th>
					</tr>
				</thead>

				<tbody>
					{% for machine in machines %}
						<tr>
							<td>{{ machine.id }}</td>

							<td>
								<img src="{{ asset('uploads/machines/' ~ machine.image) }}" alt="{{ machine.name }}">
							</td>

							<td>{{ machine.name }}</td>

							<td>{{ machine.createdAt|date('d/m/Y') }}</td>

							<td>
								<a href="{{ path('admin_machine_edit', {id: machine.id}) }}" class="action-btn btn-edit">✏ Modifier</a>
								<a href="{{ path('admin_machine_delete', {id: machine.id}) }}" class="action-btn btn-delete"
								   onclick="return confirm('Supprimer cette machine ?')">🗑 Supprimer</a>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="5" style="text-align:center; padding:1.5rem; color:var(--text-muted);">
								Aucune machine enregistrée.
							</td>
						</tr>
					{% endfor %}
				</tbody>

			</table>
		</div>

	</div>
</div>
{% endblock %}
