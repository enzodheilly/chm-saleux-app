{% extends 'admin/base_admin.html.twig' %}

{% block title %}✏️ Modifier un produit{% endblock %}

{% block body %}
<div class="main-content">
    <div class="dashboard-container">
        <h1>✏️ Modifier le produit "{{ produit.titre }}"</h1>

        <div class="section-card">
            {% for message in app.flashes('success') %}
                <div class="alert-success">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert-error">{{ message }}</div>
            {% endfor %}

            {{ form_start(form) }}

            <div class="form-group" style="margin-bottom: 1rem;">
                {{ form_label(form.titre, 'Titre du produit') }}
                {{ form_widget(form.titre) }}
                {{ form_errors(form.titre) }}
            </div>

            <div class="form-group" style="margin-bottom: 1rem;">
                {{ form_label(form.description, 'Description') }}
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="form-group" style="margin-bottom: 1rem;">
                {{ form_label(form.prix, 'Prix (€)') }}
                {{ form_widget(form.prix) }}
                {{ form_errors(form.prix) }}
            </div>

            <div class="form-group" style="margin-bottom: 1rem;">
                {{ form_label(form.image, 'Image du produit') }}
                {{ form_widget(form.image) }}
                {{ form_errors(form.image) }}
            </div>

            <div class="form-actions">
                <button class="btn-success">💾 Enregistrer</button>
                <a href="{{ path('admin_product_index') }}" class="btn-secondary">⬅️ Retour</a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
