{% extends 'admin/base_admin.html.twig' %}

{% block page_title %}Séance d'initiation{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		.dlx-toolbar { display: flex; gap: 10px; align-items: center; margin-bottom: 14px; flex-wrap: wrap; justify-content: space-between; }
		.dlx-search { min-width: 240px; }
		.si-pill-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
		.si-pill {
			padding: 6px 14px;
			font-size: 0.75rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.03em;
			color: var(--text-secondary);
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			cursor: pointer;
		}
		.si-pill.active { color: #111; background: var(--accent); border-color: var(--accent); }
		.si-alert { display: flex; gap: 14px; padding: 16px 18px; border-radius: 0; margin-top: 20px; }
		.si-alert--danger { background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.3); }
		.si-alert--success { background: rgba(34, 197, 94, 0.08); border: 1px solid rgba(34, 197, 94, 0.3); align-items: center; }
		.si-alert-icon { font-size: 1.2rem; flex-shrink: 0; }
		.si-alert--danger .si-alert-icon { color: var(--danger); }
		.si-alert--success .si-alert-icon { color: var(--success); }
		.si-alert-title { font-weight: 700; font-size: 0.9rem; margin: 0 0 4px; color: var(--danger); }
		.si-alert--success .si-alert-title { color: var(--success); margin: 0; }
		.si-alert-sub { font-size: 0.82rem; color: var(--text-secondary); margin: 0 0 10px; }
		.si-found-item { display: flex; gap: 8px; align-items: flex-start; font-size: 0.85rem; color: var(--text-main); margin-bottom: 6px; line-height: 1.5; }
		.si-found-item i { flex-shrink: 0; margin-top: 4px; font-size: 0.55rem; }
		.badge-accent { color: var(--accent); background: var(--accent-soft); border-color: rgba(232, 114, 12, 0.35); }
		.badge-info { color: #60a5fa; background: rgba(96, 165, 250, 0.12); border-color: rgba(96, 165, 250, 0.3); }
	</style>
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Séance d'initiation</h1>
			<p>Vérifiez si la personne est déjà connue du système avant de faire remplir le formulaire papier.</p>
		</div>
	</div>

	<div class="dlx-toolbar">
		<span class="tool-label" style="margin:0;">Vérification avant séance</span>
		<form method="GET" action="{{ path('admin_seance_essai_index') }}" style="display:flex; gap:10px; align-items:center;">
			<input type="search" name="q" value="{{ query|e('html_attr') }}" placeholder="Nom ou prénom de la personne…" autocomplete="off" class="input dlx-search" autofocus>
			<button type="submit" class="btn-outline"><i class="fa-solid fa-magnifying-glass"></i> Vérifier</button>
			{% if query %}
				<a href="{{ path('admin_seance_essai_index') }}" class="act-link" title="Effacer la recherche"><i class="fa-solid fa-xmark"></i> Effacer</a>
			{% endif %}
		</form>
	</div>

	{# ── Résultats de recherche ── #}
	{% if searched %}
		<div class="table-wrapper" style="margin-top: 1.5rem;">
			<div class="card-body">
				{% set totalResults = searchEssais|length + searchLicences|length %}

				{% if totalResults > 0 %}
					{# BLOQUÉ : résultats trouvés #}
					<div class="si-alert si-alert--danger" style="margin-top:0;">
						<div class="si-alert-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
						<div>
							<p class="si-alert-title">Accès au formulaire bloqué</p>
							<p class="si-alert-sub">Cette personne est déjà connue dans le système :</p>

							{% for essai in searchEssais %}
								<div class="si-found-item">
									<i class="fa-solid fa-circle badge-accent" style="border:none;padding:0;"></i>
									<span>
										<strong>{{ essai.prenom }} {{ essai.nom }}</strong>
										a déjà effectué une séance d'initiation <strong>{{ essai.sport }}</strong>
										le {{ essai.dateSeance|date('d/m/Y') }}.
									</span>
								</div>
							{% endfor %}

							{% for licence in searchLicences %}
								<div class="si-found-item">
									<i class="fa-solid fa-circle badge-info" style="border:none;padding:0;"></i>
									<span>
										<strong>{{ licence.firstName }} {{ licence.lastName }}</strong>
										est licencié(e) — licence n°&nbsp;<strong>{{ licence.number }}</strong>,
										expire le {{ licence.expiryDate|date('d/m/Y') }}.
									</span>
								</div>
							{% endfor %}
						</div>
					</div>
				{% else %}
					{# LIBRE : aucun résultat → formulaire #}
					<div class="si-alert si-alert--success" style="margin-top:0;">
						<div class="si-alert-icon"><i class="fa-solid fa-circle-check"></i></div>
						<p class="si-alert-title">Aucun enregistrement trouvé — vous pouvez procéder à la séance d'initiation.</p>
					</div>

					<p class="form-help" style="margin-top:14px;">Recherche effectuée pour : <strong>{{ query }}</strong>. Remplissez les champs ci-dessous.</p>

					<form method="POST" action="{{ path('admin_seance_essai_new') }}" style="margin-top: 16px;">
						<input type="hidden" name="_token" value="{{ csrf_token('seance_essai_new') }}">

						<div class="form-grid" style="grid-template-columns: 1fr 1fr;">
							<div>
								<span class="tool-label">Nom *</span>
								<input type="text" name="nom" value="" required maxlength="100" class="input" autocomplete="off" placeholder="NOM de famille">
							</div>
							<div>
								<span class="tool-label">Prénom *</span>
								<input type="text" name="prenom" value="" required maxlength="100" class="input" autocomplete="off" placeholder="Prénom">
							</div>
						</div>

						<div class="form-grid" style="grid-template-columns: 1fr 1fr; margin-top: 14px;">
							<div>
								<span class="tool-label">Sport pratiqué</span>
								<select name="sport" required class="input">
									{% for sport in sports %}
										<option value="{{ sport }}">{{ sport }}</option>
									{% endfor %}
								</select>
							</div>
							<div>
								<span class="tool-label">Date de la séance</span>
								<input type="date" name="date_seance" value="{{ "now"|date("Y-m-d") }}" required class="input">
							</div>
						</div>

						<div class="form-grid" style="grid-template-columns: 1fr 1fr; margin-top: 14px;">
							<div>
								<span class="tool-label">Sexe</span>
								<select name="sexe" class="input">
									<option value="">—</option>
									<option value="F">Féminin</option>
									<option value="M">Masculin</option>
								</select>
							</div>
							<div>
								<span class="tool-label">Date de naissance</span>
								<input type="date" name="date_naissance" class="input">
							</div>
						</div>

						<div class="form-grid" style="grid-template-columns: 1fr 1fr; margin-top: 14px;">
							<div>
								<span class="tool-label">Téléphone</span>
								<input type="tel" name="telephone" maxlength="30" class="input" autocomplete="off">
							</div>
							<div>
								<span class="tool-label">Email</span>
								<input type="email" name="email" maxlength="180" class="input" autocomplete="off">
							</div>
						</div>

						<div style="margin-top: 14px;">
							<span class="tool-label">Adresse</span>
							<input type="text" name="adresse" maxlength="255" class="input" autocomplete="off">
						</div>

						<p class="form-help" style="margin-top:18px;">Responsable légal — à remplir uniquement si le pratiquant est mineur.</p>

						<div class="form-grid" style="grid-template-columns: 1fr 1fr; margin-top: 10px;">
							<div>
								<span class="tool-label">Nom &amp; prénom du responsable</span>
								<input type="text" name="responsable_nom" maxlength="150" class="input" autocomplete="off">
							</div>
							<div>
								<span class="tool-label">Lien de parenté</span>
								<input type="text" name="responsable_lien" maxlength="100" class="input" autocomplete="off">
							</div>
						</div>

						<div class="form-grid" style="grid-template-columns: 1fr 1fr; margin-top: 14px;">
							<div>
								<span class="tool-label">Téléphone du responsable</span>
								<input type="tel" name="responsable_telephone" maxlength="30" class="input" autocomplete="off">
							</div>
							<div>
								<span class="tool-label">Email du responsable</span>
								<input type="email" name="responsable_email" maxlength="180" class="input" autocomplete="off">
							</div>
						</div>

						<div style="margin-top: 14px; max-width: 260px;">
							<span class="tool-label">Lieu de signature</span>
							<input type="text" name="lieu_signature" value="Saleux" maxlength="100" class="input" autocomplete="off">
						</div>

						<button type="submit" class="btn-create" style="margin-top: 20px;">
							<i class="fa-solid fa-print"></i> Enregistrer &amp; imprimer le formulaire
						</button>
					</form>
				{% endif %}
			</div>
		</div>
	{% endif %}

	{# ── Historique ── #}
	<div class="dlx-toolbar" style="margin-top: 2rem;">
		<span class="tool-label" style="margin:0;">Historique des séances <span class="badge badge-neutral" style="margin-left:6px;">{{ seances|length }}</span></span>
		<div class="si-pill-row">
			<input type="text" id="si-history-search" class="input dlx-search" placeholder="Rechercher un nom…" autocomplete="off">
			<div class="si-pill-row">
				<div class="si-pill active" data-days="30">30 jours</div>
				<div class="si-pill" data-days="90">3 mois</div>
				<div class="si-pill" data-days="365">1 an</div>
				<div class="si-pill" data-days="0">Tout</div>
			</div>
		</div>
	</div>

	<div class="table-wrapper">
		{% if seances is empty %}
			<div class="td-empty"><i class="fa-solid fa-clipboard-list" style="display:block; font-size:1.6rem; margin-bottom:10px; opacity:0.4;"></i>Aucune séance enregistrée pour l'instant.</div>
		{% else %}
			<div class="table-scroll">
				<table class="admin-table" id="si-history-table">
					<thead>
						<tr>
							<th>Date</th>
							<th>Nom</th>
							<th>Prénom</th>
							<th>Sport</th>
							<th class="th-right">Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for seance in seances %}
							<tr data-date="{{ seance.dateSeance|date('Y-m-d') }}" data-search="{{ (seance.nom ~ ' ' ~ seance.prenom)|lower }}">
								<td class="td-mono-sm">{{ seance.dateSeance|date('d/m/Y') }}</td>
								<td><strong>{{ seance.nom|upper }}</strong></td>
								<td>{{ seance.prenom }}</td>
								<td><span class="badge {{ seance.sport == 'Haltérophilie' ? 'badge-accent' : 'badge-info' }}">{{ seance.sport }}</span></td>
								<td>
									<div class="actions">
										<a href="{{ path('admin_seance_essai_print', {id: seance.id}) }}" class="act-link"><i class="fa-solid fa-file-lines"></i> Détails</a>
									</div>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
			<p class="si-no-result-history td-empty" style="display:none;">Aucun résultat pour ce filtre.</p>
		{% endif %}
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script nonce="{{ csp_nonce('script') }}">
	(function () {
		var histSearch  = document.getElementById('si-history-search');
		var periodBtns  = document.querySelectorAll('.si-pill[data-days]');
		var histTable   = document.getElementById('si-history-table');
		var noResultMsg = document.querySelector('.si-no-result-history');

		var activeDays = 30;

		function filterHistory() {
			if (!histTable) return;
			var term  = histSearch ? histSearch.value.toLowerCase().trim() : '';
			var now   = new Date();
			var rows  = histTable.querySelectorAll('tbody tr');
			var visible = 0;

			rows.forEach(function (row) {
				var rowDate   = new Date(row.dataset.date);
				var rowSearch = row.dataset.search || '';
				var daysDiff  = (now - rowDate) / (1000 * 60 * 60 * 24);

				var matchPeriod = activeDays === 0 || daysDiff <= activeDays;
				var matchTerm   = term === '' || rowSearch.indexOf(term) !== -1;

				if (matchPeriod && matchTerm) {
					row.style.display = '';
					visible++;
				} else {
					row.style.display = 'none';
				}
			});

			if (noResultMsg) noResultMsg.style.display = visible === 0 ? 'block' : 'none';
		}

		if (histSearch) histSearch.addEventListener('input', filterHistory);

		periodBtns.forEach(function (btn) {
			btn.addEventListener('click', function () {
				periodBtns.forEach(function (b) { b.classList.remove('active'); });
				btn.classList.add('active');
				activeDays = parseInt(btn.dataset.days, 10);
				filterHistory();
			});
		});

		filterHistory();
	})();
	</script>
{% endblock %}
