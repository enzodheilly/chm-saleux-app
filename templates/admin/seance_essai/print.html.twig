<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Séance d'initiation – {{ seance.prenom }} {{ seance.nom }}</title>
    <style nonce="{{ csp_nonce('style') }}">
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: 'Helvetica Neue', Arial, sans-serif;
            color: #1a1a1a;
            font-size: 10.3pt;
            background: #0f0f12;
        }

        /* ── Barre de contrôle (non imprimée) ── */
        .ctrl-bar {
            position: fixed;
            top: 0; left: 0; right: 0;
            height: 52px;
            background: #0f0f12;
            border-bottom: 1px solid rgba(255,255,255,0.07);
            display: flex;
            align-items: center;
            padding: 0 2rem;
            gap: 16px;
            z-index: 100;
        }
        .ctrl-back {
            display: flex;
            align-items: center;
            gap: 7px;
            color: #9696a8;
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .ctrl-back:hover { color: #e2e2eb; }
        .ctrl-divider { width: 1px; height: 20px; background: rgba(255,255,255,0.07); }
        .ctrl-label { font-size: 0.8rem; font-weight: 700; color: #e2e2eb; }
        .ctrl-sub { font-size: 0.75rem; color: #5c5c70; }
        .ctrl-spacer { flex: 1; }
        .ctrl-info { font-size: 0.75rem; color: #5c5c70; }
        .ctrl-btn {
            display: flex;
            align-items: center;
            gap: 7px;
            border: 1px solid rgba(255,255,255,0.13);
            background: #1a1a1f;
            color: #e2e2eb;
            padding: 8px 18px;
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            border-radius: 3px;
            cursor: pointer;
            font-family: inherit;
            text-decoration: none;
        }
        .ctrl-btn:hover { background: #21212a; }
        .ctrl-btn.primary { background: #e8720c; border-color: #e8720c; color: #ffffff; }
        .ctrl-btn.primary:hover { background: #f08228; border-color: #f08228; }

        .page-shell { padding: 72px 24px 40px; display: flex; justify-content: center; }

        /* ── Page A4 (identique au PDF) ── */
        .page {
            width: 210mm;
            min-height: 297mm;
            background: #fff;
            box-shadow: 0 8px 40px rgba(0,0,0,0.18);
            padding-bottom: 26mm;
        }

        table { border-collapse: collapse; width: 100%; table-layout: fixed; }
        td { vertical-align: top; padding: 0; }

        .header-table td { vertical-align: middle; }
        .header-table { padding: 8mm 16mm 5mm 16mm; width: 100%; border-bottom: 1.4pt solid #1a1a1a; }
        .header-table img { width: 13mm; height: 13mm; }
        .logo-table { table-layout: auto; width: auto; }
        .club-name { font-size: 10pt; letter-spacing: 2px; color: #1a1a1a; font-weight: 700; text-transform: uppercase; margin: 0 0 1mm 0; }
        .club-sub { font-size: 8pt; color: #6b6b6b; margin: 0; }
        .title-block { text-align: right; }
        .title-block h1 { font-size: 13pt; white-space: nowrap; margin: 0; font-weight: 700; color: #1a1a1a; }
        .title-block p { margin: 2mm 0 0 0; font-size: 8.5pt; color: #6b6b6b; letter-spacing: 0.6px; text-transform: uppercase; }

        .content { padding: 7mm 16mm 0 16mm; }

        .section-title-table { margin: 0 0 2.5mm 0; table-layout: auto; width: auto; }
        .section-title-table td { vertical-align: middle; }
        .num {
            width: 6mm; height: 6mm; border-radius: 50%; border: 1.1pt solid #1a1a1a; color: #1a1a1a;
            font-size: 9pt; font-weight: 700; text-align: center; line-height: 5.6mm;
        }
        .section-title-table h2 { font-size: 11.5pt; margin: 0 0 0 3mm; color: #1a1a1a; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; }

        .field-table { margin-bottom: 2.5mm; }
        .field-table td { padding-right: 8mm; width: 50%; }
        .field-table td:last-child { padding-right: 0; }
        label.f {
            display: block; font-size: 8pt; color: #6b6b6b; text-transform: uppercase;
            letter-spacing: 0.4px; margin-bottom: 1.3mm; font-weight: 600;
        }
        .line { border-bottom: 0.6pt solid #b0b0b0; height: 5mm; font-size: 10pt; padding-bottom: 0.5mm; }
        .line-value { color: #1a1a1a; font-size: 10pt; }

        .checkbox {
            display: inline-block; width: 3.6mm; height: 3.6mm; border: 1.1pt solid #1a1a1a;
            text-align: center; line-height: 3.2mm; font-size: 8pt; font-weight: 700; color: #1a1a1a;
            vertical-align: middle;
        }
        .opt-label { font-size: 9.5pt; vertical-align: middle; padding-left: 2mm; padding-right: 6mm; }

        .date-cell { font-size: 9.5pt; }
        .date-box { display: inline-block; border-bottom: 0.6pt solid #b0b0b0; height: 5mm; width: 12mm; text-align: center; }
        .date-box.year { width: 18mm; }
        .date-sep { color: #6b6b6b; padding: 0 1.5mm; }

        .divider { height: 0.5pt; background: #d8d8d8; margin: 3.5mm 0; }

        .declaration-box {
            background: #ffffff; border: 0.8pt solid #1a1a1a; padding: 3.5mm 5mm;
            font-size: 9pt; line-height: 1.4; color: #1a1a1a;
        }
        .declaration-box p { margin: 0 0 3mm 0; }
        .declaration-box p:last-child { margin-bottom: 0; }
        .signee-line { border-bottom: 0.6pt solid #b0b0b0; display: inline-block; min-width: 90mm; }
        .declaration-note { font-size: 7pt; color: #bbb; font-style: italic; margin-top: 2mm; }

        .sign-box {
            margin-top: 3mm; height: 18mm; border: 0.8pt solid #1a1a1a; border-radius: 1mm; background: #ffffff;
            position: relative;
        }
        .approved { position: absolute; bottom: 3mm; right: 4mm; font-size: 8pt; font-style: italic; color: #9a9a9a; }

        .footer {
            border-top: 1pt solid #1a1a1a; padding: 3.5mm 16mm; text-align: center; margin-top: 6mm;
        }
        .footer .name { font-weight: 700; font-size: 9.5pt; color: #1a1a1a; letter-spacing: 1px; margin: 0 0 1.5mm 0; text-transform: uppercase; }
        .footer p { margin: 0.6mm 0; font-size: 8pt; color: #6b6b6b; }

        /* ── Mobile ── */
        @media (max-width: 720px) {
            .page-shell { padding: 64px 0 24px; }
            .page { width: 100%; min-height: auto; box-shadow: none; }
            .ctrl-info { display: none; }
            .ctrl-sub { display: none; }
        }

        /* ── @media print ── */
        @media print {
            .ctrl-bar { display: none !important; }
            body { background: #fff; }
            .page-shell { padding: 0; display: block; }
            .page { width: 100%; min-height: auto; box-shadow: none; padding-bottom: 0; }
            .footer { position: static; }
        }
    </style>
</head>
<body>

    <div class="ctrl-bar">
        <a href="{{ path('admin_seance_essai_index') }}" class="ctrl-back">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            Retour
        </a>
        <div class="ctrl-divider"></div>
        <div>
            <div class="ctrl-label">{{ seance.prenom }} {{ seance.nom|upper }}</div>
            <div class="ctrl-sub">{{ seance.sport }} · {{ seance.dateSeance|date('d/m/Y') }}</div>
        </div>
        <div class="ctrl-spacer"></div>
        <span class="ctrl-info">Faire signer puis archiver</span>
        <a href="{{ path('admin_seance_essai_pdf', {id: seance.id}) }}" class="ctrl-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Télécharger le PDF
        </a>
        <button id="btn-print" class="ctrl-btn primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
            Imprimer
        </button>
    </div>

    <div class="page-shell">
        <div class="page">

            <table class="header-table"><tr>
                <td style="width:58%;">
                    <table class="logo-table"><tr>
                        <td style="width:13mm;"><img src="{{ asset('images/favicon/icon2.png') }}" alt="CHM Saleux"></td>
                        <td style="padding-left:4mm; white-space:nowrap;">
                            <p class="club-name">CHM Saleux</p>
                            <p class="club-sub">Club d'Haltérophilie &amp; Musculation</p>
                        </td>
                    </tr></table>
                </td>
                <td class="title-block" style="width:42%;">
                    <h1>Séance d'initiation</h1>
                    <p>Fiche d'inscription</p>
                </td>
            </tr></table>

            <div class="content">

                {# ── Section 1 ── #}
                <table class="section-title-table"><tr>
                    <td style="width:6mm;"><div class="num">1</div></td>
                    <td><h2>Informations du pratiquant</h2></td>
                </tr></table>

                <table class="field-table"><tr>
                    <td colspan="2">
                        <label class="f">Nom &amp; Prénom</label>
                        <div class="line line-value">{{ seance.prenom }} {{ seance.nom|upper }}</div>
                    </td>
                </tr></table>

                <table class="field-table"><tr>
                    <td>
                        <label class="f">Sport pratiqué</label>
                        <div class="line" style="height:6mm; padding-top:0.8mm;">
                            <span class="checkbox">{{ seance.sport == 'Haltérophilie' ? 'X' : '' }}</span><span class="opt-label">Haltérophilie</span>
                            <span class="checkbox">{{ seance.sport == 'Musculation' ? 'X' : '' }}</span><span class="opt-label">Musculation</span>
                        </div>
                    </td>
                    <td>
                        <label class="f">Sexe</label>
                        <div class="line" style="height:6mm; padding-top:0.8mm;">
                            <span class="checkbox">{{ seance.sexe == 'F' ? 'X' : '' }}</span><span class="opt-label">Féminin</span>
                            <span class="checkbox">{{ seance.sexe == 'M' ? 'X' : '' }}</span><span class="opt-label">Masculin</span>
                        </div>
                    </td>
                </tr></table>

                <table class="field-table"><tr>
                    <td>
                        <label class="f">Date de naissance</label>
                        <div class="line date-cell" style="height:6mm; padding-top:0.8mm;">
                            <span class="date-box">{{ seance.dateNaissance ? seance.dateNaissance|date('d') : '' }}</span>
                            <span class="date-sep">/</span>
                            <span class="date-box">{{ seance.dateNaissance ? seance.dateNaissance|date('m') : '' }}</span>
                            <span class="date-sep">/</span>
                            <span class="date-box year">{{ seance.dateNaissance ? seance.dateNaissance|date('Y') : '' }}</span>
                        </div>
                    </td>
                    <td>
                        <label class="f">Téléphone</label>
                        <div class="line line-value">{{ seance.telephone }}</div>
                    </td>
                </tr></table>

                <table class="field-table"><tr>
                    <td colspan="2">
                        <label class="f">Adresse</label>
                        <div class="line line-value">{{ seance.adresse }}</div>
                    </td>
                </tr></table>

                <table class="field-table"><tr>
                    <td colspan="2">
                        <label class="f">Adresse email</label>
                        <div class="line line-value">{{ seance.email }}</div>
                    </td>
                </tr></table>

                <div class="divider"></div>

                {# ── Section 2 ── #}
                <table class="section-title-table"><tr>
                    <td style="width:6mm;"><div class="num">2</div></td>
                    <td><h2>Responsable légal <span style="font-size:8.5pt; font-weight:400; text-transform:none; letter-spacing:0; color:#6b6b6b;">(si pratiquant mineur)</span></h2></td>
                </tr></table>

                <table class="field-table"><tr>
                    <td>
                        <label class="f">Nom &amp; Prénom du responsable</label>
                        <div class="line line-value">{{ seance.responsableNom }}</div>
                    </td>
                    <td>
                        <label class="f">Lien de parenté</label>
                        <div class="line line-value">{{ seance.responsableLien }}</div>
                    </td>
                </tr></table>

                <table class="field-table"><tr>
                    <td>
                        <label class="f">Téléphone</label>
                        <div class="line line-value">{{ seance.responsableTelephone }}</div>
                    </td>
                    <td>
                        <label class="f">Email</label>
                        <div class="line line-value">{{ seance.responsableEmail }}</div>
                    </td>
                </tr></table>

                <div class="divider"></div>

                {# ── Section 3 ── #}
                <table class="section-title-table"><tr>
                    <td style="width:6mm;"><div class="num">3</div></td>
                    <td><h2>Décharge de responsabilité</h2></td>
                </tr></table>

                <div class="declaration-box">
                    <p>Je soussigné(e) <span class="signee-line">{{ seance.prenom }} {{ seance.nom|upper }}</span>, reconnais avoir pris connaissance du règlement intérieur du CHM Saleux et m'engage à le respecter.</p>
                    <p>Je certifie sur l'honneur être apte à pratiquer une activité sportive et ne pas avoir de contre-indication médicale connue. Je déclare participer à cette séance d'initiation sous ma propre responsabilité, en pleine connaissance des risques inhérents à la pratique sportive.</p>
                    <p>Je décharge le Club d'Haltérophilie &amp; Musculation de Saleux (CHM Saleux) de toute responsabilité en cas d'accident survenu du fait de ma propre négligence ou du non-respect des consignes données par les encadrants.</p>
                    <p class="declaration-note">⚠ Texte provisoire — à remplacer par la version définitive validée par le président du club.</p>
                </div>

                <table style="margin-top:4mm;" class="field-table"><tr>
                    <td>
                        <label class="f">Fait à</label>
                        <div class="line line-value">{{ seance.lieuSignature ?: 'Saleux' }}</div>
                    </td>
                    <td>
                        <label class="f">Le</label>
                        <div class="line date-cell" style="height:6mm; padding-top:0.8mm;">
                            <span class="date-box">{{ (seance.dateSignature ?: seance.dateSeance)|date('d') }}</span>
                            <span class="date-sep">/</span>
                            <span class="date-box">{{ (seance.dateSignature ?: seance.dateSeance)|date('m') }}</span>
                            <span class="date-sep">/</span>
                            <span class="date-box year">{{ (seance.dateSignature ?: seance.dateSeance)|date('Y') }}</span>
                        </div>
                    </td>
                </tr></table>

                <label class="f">Signature du pratiquant (ou responsable légal)</label>
                <div class="sign-box"><span class="approved">« Lu et approuvé »</span></div>

            </div>

            <div class="footer">
                <p class="name">CHM Saleux</p>
                <p>8 Rue Max Dormoy, Complexe multisports de la Grenouillère, 80480 Saleux</p>
                <p>Tél. club : 03 22 89 72 57 &nbsp;·&nbsp; chm.saleux@orange.fr &nbsp;·&nbsp; chm-saleux.fr</p>
                <p style="margin-top:1.5mm; color:#9a9a9a;">Agréé Jeunesse et Sports — Association Loi 1901</p>
            </div>

        </div>
    </div>

    <script nonce="{{ csp_nonce('script') }}">
        document.getElementById('btn-print').addEventListener('click', function () {
            window.print();
        });

        window.onload = function () {
            setTimeout(function () { window.print(); }, 500);
        };
    </script>

</body>
</html>
