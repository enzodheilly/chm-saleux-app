{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier la licence
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/licence/edit.css') }}">
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Modifier la licence</h1>
			<p>Mise à jour des informations pour la licence #{{ licence.number }}</p>
		</div>

		<div class="toolbar">
			<a href="{{ path('admin_licence_index') }}" class="btn-outline">Retour</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="card-body">
			{{ form_start(form) }}

			<div class="form-error">{{ form_errors(form) }}</div>

			<div class="form-grid">
				<div class="form-row-2">
					<div>
						<span class="tool-label">Prénom</span>
						{{ form_widget(form.firstName, { attr: { class: 'input' } }) }}
						<div class="form-error">{{ form_errors(form.firstName) }}</div>
					</div>

					<div>
						<span class="tool-label">Nom</span>
						{{ form_widget(form.lastName, { attr: { class: 'input' } }) }}
						<div class="form-error">{{ form_errors(form.lastName) }}</div>
					</div>
				</div>

				<div class="form-row-2">
					<div>
						<span class="tool-label">Email</span>
						{{ form_widget(form.email, { attr: { class: 'input' } }) }}
						<div class="form-error">{{ form_errors(form.email) }}</div>
					</div>

					<div>
						<span class="tool-label">Numéro de licence</span>
						{{ form_widget(form.number, { attr: { class: 'input' } }) }}
						<div class="form-error">{{ form_errors(form.number) }}</div>
					</div>
				</div>

				<div class="form-row-2">
					<div>
						<span class="tool-label">Forfait associé</span>
						{{ form_widget(form.membershipPlan, { attr: { class: 'input' } }) }}
						<div class="form-error">{{ form_errors(form.membershipPlan) }}</div>
						<div id="membership-plan-benefits" class="avantages-preview"></div>
					</div>

					<div>
						<span class="tool-label">Date d'expiration</span>
						{{ form_widget(form.expiryDate, { attr: { class: 'input' } }) }}
						<div class="form-error">{{ form_errors(form.expiryDate) }}</div>
					</div>
				</div>

				<div class="form-actions">
					<button type="button" class="btn-danger-link" data-confirm="⚠️ Attention : Cette action est irréversible. Voulez-vous vraiment supprimer la licence {{ licence.number }} ?" data-submit="delete-form">
						Supprimer cette licence
					</button>

					<div class="form-actions-right">
						<a href="{{ path('admin_licence_index') }}" class="btn-outline">Annuler</a>
						<button type="submit" class="btn-create">Mettre à jour</button>
					</div>
				</div>
			</div>

			{{ form_end(form) }}
		</div>
	</div>

	<form id="delete-form" method="post" action="{{ path('admin_licence_delete', {id: licence.id}) }}" class="form-hidden">
		<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ licence.id) }}">
	</form>

{% endblock %}

{% block javascripts %} <script nonce="{{ csp_nonce('script') }}">
	        window.licenceData = {
	            benefitsUrl: "{{ path('admin_licence_membership_plan_benefits', {'id': '__ID__'}) }}"
	        };
	    </script>
	 <script src="{{ asset('js/admin/licence/edit.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
