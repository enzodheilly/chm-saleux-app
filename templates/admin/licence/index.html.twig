{% extends 'admin/base_admin.html.twig' %}
{% import 'admin/_macros.html.twig' as m %}

{% block title %}Archives licences FFHM{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		.saison-tabs { display: flex; gap: 6px; margin-bottom: 20px; flex-wrap: wrap; }
		.saison-tab {
			padding: 6px 16px;
			font-size: 0.8rem;
			font-weight: 700;
			color: var(--text-secondary);
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			text-decoration: none;
		}
		.saison-tab.active { color: #111; background: var(--accent); border-color: var(--accent); }
		.archives-search { padding: 6px 12px; font-size: 0.82rem; border: 1px solid var(--border-color); background: var(--bg-card); color: var(--text-main); min-width: 240px; margin-left: auto; }
	</style>
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Archives licences FFHM</h1>
			<p>Toutes les licences créées depuis les demandes — actives et en attente d'activation.</p>
		</div>
		<div class="toolbar">
		</div>
	</div>

	<div class="saison-tabs">
		{% if saisons is not empty %}
			<a href="{{ path('admin_licence_index') }}" class="saison-tab {{ saisonActive is null ? 'active' : '' }}">Toutes</a>
			{% for saison in saisons %}
				<a href="{{ path('admin_licence_index', {saison: saison}) }}" class="saison-tab {{ saisonActive == saison ? 'active' : '' }}">
					Saison {{ (saison - 1) ~ '/' ~ saison }}
				</a>
			{% endfor %}
		{% endif %}
		<input type="text" class="archives-search" id="searchLicence" placeholder="Nom, prénom, email, numéro…">
	</div>

	<div class="table-wrapper">
		<div class="table-scroll">
			<table class="admin-table" id="licenceTable">
				<thead>
					<tr>
						<th width="80">ID</th>
						<th>Numéro</th>
						<th>Titulaire</th>
						<th>Email</th>
						<th>Type</th>
						<th>Saison</th>
						<th>Statut</th>
						<th width="70">QR</th>
						<th class="th-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for licence in licences %}
						<tr>
							<td><span class="td-mono">#{{ licence.id }}</span></td>
							<td><span class="td-mono licence-number">{{ licence.number }}</span></td>
							<td>
								<div class="identity-cell">
									<span class="sender-name">{{ licence.firstName }} {{ licence.lastName|upper }}</span>
									{% if licence.historique %}<span class="badge badge-neutral" style="font-size:0.65rem; margin-top:2px;">Historique</span>{% endif %}
								</div>
							</td>
							<td class="td-mono-sm sender-email">{{ licence.email ? (licence.email|pseudonymize_email) : '—' }}</td>
							<td>{{ m.formule_badge(licence.type) }}</td>
							<td class="td-mono-sm">{{ licence.saisonLabel }}</td>
							<td>
								{% if not licence.activee %}
									<span class="badge badge-pending">En attente</span>
								{% elseif licence.expiryDate < date() %}
									<span class="badge badge-danger">Expirée</span>
								{% else %}
									<span class="badge badge-active">Active</span>
								{% endif %}
							</td>
							<td>
								{% if licence.historique %}
									<span class="td-mono-sm" style="opacity:0.4;">—</span>
								{% elseif qrCodeImages[licence.id] is defined %}
									<a href="{{ path('admin_licence_edit', {id: licence.id}) }}#qrcode" title="Voir le QR code d'accès">
										<img src="{{ qrCodeImages[licence.id] }}" alt="QR code" width="44" height="44" class="qr-thumb">
									</a>
								{% else %}
									<span class="td-mono-sm">—</span>
								{% endif %}
							</td>
							<td>
								<div class="actions">
									<a href="{{ path('admin_licence_edit', {id: licence.id}) }}" class="act-link">Modifier</a>
									<form method="post" action="{{ path('admin_licence_delete', {id: licence.id}) }}" class="js-confirm-form" data-confirm="🪪 Supprimer la licence n°{{ licence.number }} appartenant à {{ licence.firstName }} {{ licence.lastName|upper }} ?">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ licence.id) }}">
										<button type="submit" class="act-link act-del">Supprimer</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="9" class="td-empty">Aucune licence FFHM enregistrée{% if saisonActive %} pour cette saison{% endif %}.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('js/admin/licence/index.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
