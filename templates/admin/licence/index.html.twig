{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des licences
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Licences</h1>
			<p>Suivi des licences sportives et dates d'expiration.</p>
		</div>
		<div class="toolbar">
			<input type="text" id="searchLicence" class="search-input" placeholder="Nom ou numéro...">
			<a href="{{ path('admin_licence_new') }}" class="btn-create">Créer une licence</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="table-scroll">
			<table class="admin-table" id="licenceTable">
				<thead>
					<tr>
						<th width="80">ID</th>
						<th>Numéro</th>
						<th>Titulaire</th>
						<th>Type</th>
						<th>Validité</th>
						<th>Statut</th>
						<th class="th-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for licence in licences %}
						{# Logique Twig conservée, mais styles déportés #}
						{% set isExpired = licence.expiryDate < date() %}
						<tr>
							<td>
								<span class="td-mono">#{{ licence.id }}</span>
							</td>
							<td>
								{# La classe licence-number remplace le style inline #}
								<span class="td-mono licence-number">{{ licence.number }}</span>
							</td>
							<td>
								<div class="identity-cell">
									<span class="sender-name">{{ licence.firstName }}
										{{ licence.lastName|upper }}</span>
									<span class="td-mono-sm sender-email">{{ licence.email|pseudonymize_email }}</span>
								</div>
							</td>
							<td>
								{# On réutilise badge-neutral #}
								<span class="badge badge-neutral">{{ licence.type|capitalize }}</span>
							</td>
							<td class="td-mono-sm">{{ licence.expiryDate ? licence.expiryDate|date('d/m/Y') : '—' }}</td>
							<td>
								{% if isExpired %}
									<span class="badge badge-danger">Expirée</span>
								{% else %}
									<span class="badge badge-active">Active</span>
								{% endif %}
							</td>
							<td>
								<div class="actions">
									<a href="{{ path('admin_licence_edit', {id: licence.id}) }}" class="act-link">Modifier</a>

									{# MODIFICATION : Suppression du JS inline #}
									<form method="post" action="{{ path('admin_licence_delete', {id: licence.id}) }}" class="js-confirm-form" data-confirm="🪪 Supprimer la licence n°{{ licence.number }} appartenant à {{ licence.firstName }} {{ licence.lastName|upper }} ?">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ licence.id) }}">
										<button type="submit" class="act-link act-del">Supprimer</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="7" class="td-empty">Aucune licence enregistrée.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
