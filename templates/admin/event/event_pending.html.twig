<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Inscription réussie</title>
    <style>
        /* Reset & base */
        * { margin:0; padding:0; box-sizing:border-box; font-family: "Inter", sans-serif; }
        body {
            background-color: #111;
            color: #fff;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Container principal */
        .confirmation-card {
            background-color: #242424;
            padding: 2rem 3rem;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.6);
            text-align: center;
            max-width: 400px;
            animation: slideFadeIn 0.6s ease-out forwards;
            opacity: 0;
            transform: translateY(-30px);
        }

        /* Animation */
        @keyframes slideFadeIn {
            0% { opacity: 0; transform: translateY(-30px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        /* Icone succès */
        .confirmation-card .icon {
            font-size: 3rem;
            color: #22c55e;
            margin-bottom: 1rem;
        }

        /* Titre */
        .confirmation-card h1 {
            font-size: 1.6rem;
            margin-bottom: 0.5rem;
        }

        /* Texte */
        .confirmation-card p {
            font-size: 1rem;
            margin-bottom: 2rem;
        }

        /* Bouton retour */
        .btn-return {
            display: inline-block;
            padding: 0.6rem 1.5rem;
            background: linear-gradient(90deg, #005b94 0%, #003d66 100%);
            color: #fff;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 700;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-return:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.4);
        }

        /* Responsive */
        @media(max-width:500px) {
            .confirmation-card { padding: 1.5rem 2rem; }
            .confirmation-card h1 { font-size: 1.4rem; }
        }
    </style>
</head>
<body>
    <div class="confirmation-card">
        <div class="icon">✅</div>
        <h1>Inscription réussie !</h1>
        <p>Vous êtes bien inscrit à l'événement <strong>{{ eventName }}</strong>.</p>
        <a href="/espace-adherent" class="btn-return">Retour à mon espace adhérent</a>
    </div>
</body>
</html>
