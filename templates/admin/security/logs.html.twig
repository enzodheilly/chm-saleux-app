{% extends 'admin/base_admin.html.twig' %}

{% block title %}Journal des connexions{% endblock %}

{% block stylesheets %}
<style>
    /* =================== PAGE STYLE =================== */
    .dashboard-container { width: 100%; max-width: 1600px; margin: 0 auto; }

    /* Header */
    .page-header {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem;
    }
    .page-header h1 { margin: 0; font-size: 1.6rem; font-weight: 700; color: var(--text-main); letter-spacing: -0.5px; }
    .page-header p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; }

    /* Toolbar & Filters */
    .toolbar-container {
        display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: center;
        margin-bottom: 1.5rem; background: var(--bg-sidebar); padding: 1rem; border: 1px solid var(--border-color); border-radius: 6px;
    }

    .search-bar {
        background: var(--bg-body); border: 1px solid var(--border-color); color: var(--text-main);
        padding: 0.6rem 1rem; border-radius: 4px; outline: none; min-width: 250px; font-size: 0.9rem;
    }
    .search-bar:focus { border-color: var(--accent); }

    .filter-group { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .filter-btn {
        background: var(--bg-body); border: 1px solid var(--border-color); color: var(--text-muted);
        padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.75rem; font-weight: 700; cursor: pointer; transition: 0.2s;
        text-transform: uppercase; letter-spacing: 0.05em;
    }
    .filter-btn:hover { color: var(--text-main); border-color: var(--text-muted); }
    .filter-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }

    /* Buttons Actions */
    .btn-danger-outline {
        background: transparent; color: var(--danger); padding: 0.6rem 1.2rem; border: 1px solid var(--danger); border-radius: 4px;
        font-weight: 700; font-size: 0.8rem; cursor: pointer; transition: 0.2s; text-transform: uppercase; text-decoration: none;
    }
    .btn-danger-outline:hover { background: var(--danger); color: #fff; }

    .btn-export {
        background: var(--bg-body); color: var(--text-main); border: 1px solid var(--border-color);
        padding: 0.6rem 1.2rem; border-radius: 4px; font-size: 0.8rem; font-weight: 700;
        text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: 0.2s;
    }
    .btn-export:hover { border-color: var(--accent); color: var(--accent); }

    /* Table */
    .content-card { background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 6px; overflow: hidden; }
    .table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .table th {
        background: rgba(255,255,255,0.02); color: var(--text-muted); font-weight: 600; text-align: left;
        padding: 1rem 1.5rem; border-bottom: 1px solid var(--border-color); text-transform: uppercase; font-size: 0.7rem;
    }
    .table td { padding: 1rem 1.5rem; border-bottom: 1px solid var(--border-color); color: var(--text-main); vertical-align: middle; }
    .table tr:hover td { background: rgba(255,255,255,0.01); }

    /* Badges & Indicators */
    .log-success { color: #22c55e; font-weight: 700; }
    .log-failed { color: var(--danger); font-weight: 700; }
    .log-warning-row { background: rgba(245, 158, 11, 0.03) !important; }
    
    .badge-nocturne { background: rgba(99, 102, 241, 0.1); color: #6366f1; border: 1px solid rgba(99, 102, 241, 0.2); padding: 2px 8px; border-radius: 12px; font-size: 0.65rem; font-weight: 700; }
    .badge-weekend { background: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.2); padding: 2px 8px; border-radius: 12px; font-size: 0.65rem; font-weight: 700; }

    .ip-address { font-family: monospace; color: var(--accent); background: rgba(255,102,0,0.05); padding: 2px 6px; border-radius: 4px; font-size: 0.8rem; font-weight: 600; }
    .geo-info { font-size: 0.7rem; color: var(--text-muted); font-weight: 500; margin-top: 4px; display: block; }

    /* Stats Target */
    .target-card { background: var(--bg-body); padding: 1rem; border-radius: 6px; border-left: 4px solid var(--danger); flex: 1; min-width: 220px; border: 1px solid var(--border-color); border-left: 4px solid var(--danger); }
    
    .btn-ban { color: var(--danger); font-size: 1.1rem; padding: 5px; opacity: 0.7; transition: 0.2s; text-decoration: none; }
    .btn-ban:hover { opacity: 1; transform: scale(1.2); }

</style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message|raw }}</div>
    {% endfor %}

    <div class="page-header">
        <div>
            <h1>Journal des connexions</h1>
            <p>Authentifications, activités système et alertes de sécurité en temps réel.</p>
        </div>
        <div>
            <a href="{{ path('admin_security_purge_logs') }}" class="btn-danger-outline" onclick="return confirm('⚠️ Action irréversible : Purger l\'historique ?');">
                Purger les journaux
            </a>
        </div>
    </div>

    <div class="content-card" style="margin-bottom: 2rem; padding: 1.5rem;">
        <h3 style="margin: 0 0 1.2rem 0; font-size: 0.9rem; color: var(--text-main); text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 8px;">
            🚨 Comptes les plus visés (Échecs)
        </h3>
        <div style="display: flex; gap: 1.2rem; flex-wrap: wrap;">
            {% for target in topTargets|default([]) %}
                {% set targetUser = target.user is defined ? target.user : (target[0] is defined ? target[0] : null) %}
                <div class="target-card">
                    <div style="font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px; font-weight: 700;">Utilisateur cible</div>
                    <div style="font-weight: 700; color: var(--text-main); font-size: 0.9rem; word-break: break-all;">
                        {{ targetUser ? targetUser.email : 'Utilisateur inconnu' }}
                    </div>
                    <div style="margin-top: 10px; font-size: 1.3rem; font-weight: 800; color: var(--danger);">
                        {{ target.attempts }} <span style="font-size: 0.75rem; font-weight: 500; opacity: 0.8;">échecs</span>
                    </div>
                </div>
            {% else %}
                <div style="color: var(--text-muted); font-size: 0.85rem; font-style: italic; padding: 1rem;">
                    Aucune activité suspecte détectée sur les comptes utilisateurs.
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="toolbar-container">
        <div class="filter-group">
            <button class="filter-btn active" data-filter="all">Tous</button>
            <button class="filter-btn" data-filter="success">Succès</button>
            <button class="filter-btn" data-filter="failed">Échecs</button>
            <button class="filter-btn" data-filter="session">Alertes</button>
        </div>

        <div style="display: flex; gap: 12px; align-items: center;">        
            <a href="{{ path('admin_security_export_csv') }}" class="btn-export">
                📥 Exporter CSV
            </a>
            <input type="text" id="searchLogs" class="search-bar" placeholder="Chercher un utilisateur, une IP...">
        </div>
    </div>

    <div class="content-card">
        <div class="table-responsive">
            <table class="table" id="logsTable">
                <thead>
                    <tr>
                        <th width="80">Date</th>
                        <th width="180">Utilisateur</th>
                        <th width="200">Localisation (IP)</th>
                        <th width="120">Appareil</th>
                        <th>Message / Événement</th>
                        <th width="100">Statut</th>
                        <th width="60" style="text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for log in logs|default([]) %}
                        {% set rowStatus = (log.type == 'erreur') ? 'failed' : (log.type == 'Session' ? 'session' : 'success') %}

                        <tr class="log-row {% if log.type == 'Session' %}log-warning-row{% endif %}" data-status="{{ rowStatus }}">
                            <td class="date-cell" style="color: var(--text-muted); font-family: monospace; font-size: 0.8rem;">
                                {{ log.createdAt|date('d/m/Y') }}<br>
                                <span style="opacity: 0.6;">{{ log.createdAt|date('H:i:s') }}</span>
                            </td>
                            
                            <td>
                                <strong style="color: var(--text-main);">
                                    {{ log.user ? log.user.email : 'Système' }}
                                </strong>
                            </td>

                            <td>
                                <span class="ip-address ip-lookup" data-ip="{{ log.ip|default('') }}">{{ log.ip|default('—') }}</span>
                                <span class="geo-info" id="geo-{{ loop.index }}">Recherche...</span>
                            </td>

                            <td style="font-size: 0.8rem; color: var(--text-muted);">
                                {% if log.userAgent %}
                                    {% if 'Mobi' in log.userAgent %}📱 Mobile
                                    {% elseif 'Windows' in log.userAgent %}💻 PC
                                    {% elseif 'Macintosh' in log.userAgent %}🖥️ Mac
                                    {% else %}🌐 Web{% endif %}
                                    <div style="font-size: 0.7rem; opacity: 0.5; margin-top: 3px;" title="{{ log.userAgent }}">
                                        {{ log.userAgent|slice(0, 20) }}...
                                    </div>
                                {% else %}—{% endif %}
                            </td>

                            <td>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    {% if log.type == 'Session' %}<span style="color:#f59e0b">⚠️</span>{% endif %}
                                    <span>{{ log.message ?? '—' }}</span>
                                </div>
                                
                                <div style="margin-top: 6px; display: flex; gap: 6px;">
                                    {% set hour = log.createdAt|date('H') %}
                                    {% if hour < 7 or hour > 21 %}
                                        <span class="badge-nocturne">🌙 Nocturne ({{ hour }}h)</span>
                                    {% endif %}
                                    {% if log.createdAt|date('N') >= 6 %}
                                        <span class="badge-weekend">🗓️ Week-end</span>
                                    {% endif %}
                                </div>
                            </td>

                            <td>
                                {% if log.type == 'erreur' %}
                                    <span class="log-failed">BLOQUÉ</span>
                                {% else %}
                                    <span class="log-success">AUTORISÉ</span>
                                {% endif %}
                            </td>

                            <td style="text-align: right;">
                                {% if log.ip and log.ip not in ['127.0.0.1', '::1', '—'] %}
                                    <a href="{{ path('admin_security_ban_ip', {'ip': log.ip}) }}" 
                                       class="btn-ban" 
                                       onclick="return confirm('🚫 Bannir l\'IP {{ log.ip }} ?');"
                                       title="Bannir l'IP">
                                        🚫
                                    </a>
                                {% else %}
                                    <span style="opacity: 0.2;">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 5rem; color: var(--text-muted);">
                                Aucun log de sécurité enregistré.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div id="noResults" style="display:none; text-align:center; padding:3rem; color:var(--text-muted); font-style: italic;">
            Aucune correspondance trouvée pour ces critères.
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchLogs');
    const filterButtons = document.querySelectorAll('.filter-btn');
    const tableRows = document.querySelectorAll('.log-row');
    const noResultsMsg = document.getElementById('noResults');

    function applyFilters() {
        const activeFilter = document.querySelector('.filter-btn.active').dataset.filter;
        const searchText = searchInput.value.toLowerCase();
        let visibleCount = 0;

        tableRows.forEach(row => {
            const status = row.dataset.status;
            const text = row.innerText.toLowerCase();
            const matchesFilter = (activeFilter === 'all') || (status === activeFilter);
            const matchesSearch = text.includes(searchText);

            if (matchesFilter && matchesSearch) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        noResultsMsg.style.display = (visibleCount === 0) ? 'block' : 'none';
    }

    filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            filterButtons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            applyFilters();
        });
    });

    searchInput.addEventListener('input', applyFilters);

    const ipElements = document.querySelectorAll('.ip-lookup');
    const uniqueIps = [...new Set(Array.from(ipElements).map(el => el.dataset.ip))]
        .filter(ip => ip && !['127.0.0.1', '::1', '—'].includes(ip));

    uniqueIps.forEach(ip => {
        fetch(`https://ipapi.co/${ip}/json/`)
            .then(res => res.json())
            .then(data => {
                if (data.city) {
                    const info = `${data.city}, ${data.country_name}`;
                    const flag = data.country_code
                        ? `https://flagcdn.com/16x12/${data.country_code.toLowerCase()}.png`
                        : '';

                    document.querySelectorAll(`.ip-lookup[data-ip="${ip}"]`).forEach(el => {
                        el.nextElementSibling.innerHTML = flag
                            ? `<img src="${flag}" style="vertical-align:middle; margin-right:4px;"> ${info}`
                            : info;
                    });
                } else {
                    document.querySelectorAll(`.ip-lookup[data-ip="${ip}"]`).forEach(el => {
                        el.nextElementSibling.innerText = "Origine inconnue";
                    });
                }
            })
            .catch(() => {
                document.querySelectorAll(`.ip-lookup[data-ip="${ip}"]`).forEach(el => {
                    el.nextElementSibling.innerText = "Non localisable";
                });
            });
    });
});
</script>
{% endblock %}