{% extends 'admin/base_admin.html.twig' %}

{% block title %}Journal des connexions
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/security/logs.css') }}">
{% endblock %}

{% block body %}
	<div class="dashboard-container">

		{% for message in app.flashes('success') %}
			<div class="alert alert-success">{{ message|raw }}</div>
		{% endfor %}

		<div class="page-header">
			<div>
				<h1>Journal des connexions</h1>
				<p>Authentifications, activités système et alertes de sécurité en temps réel.</p>
			</div>
			<div>
				<a href="{{ path('admin_security_purge_logs') }}" class="btn-danger-outline" onclick="return confirm('⚠️ Action irréversible : Purger l\'historique ?');">
					Purger les journaux
				</a>
			</div>
		</div>

		<div class="content-card" style="margin-bottom: 2rem; padding: 1.5rem;">
			<h3 style="margin: 0 0 1.2rem 0; font-size: 0.9rem; color: var(--text-main); text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 8px;">
				🚨 Comptes les plus visés (Échecs)
			</h3>
			<div style="display: flex; gap: 1.2rem; flex-wrap: wrap;">
				{% for target in topTargets|default([]) %}
					{% set targetUser = target.user is defined ? target.user : (target[0] is defined ? target[0] : null) %}
					<div class="target-card">
						<div style="font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px; font-weight: 700;">Utilisateur cible</div>
						<div style="font-weight: 700; color: var(--text-main); font-size: 0.9rem; word-break: break-all;">
							{{ targetUser ? targetUser.email : 'Utilisateur inconnu' }}
						</div>
						<div style="margin-top: 10px; font-size: 1.3rem; font-weight: 800; color: var(--danger);">
							{{ target.attempts }}
							<span style="font-size: 0.75rem; font-weight: 500; opacity: 0.8;">échecs</span>
						</div>
					</div>
				{% else %}
					<div style="color: var(--text-muted); font-size: 0.85rem; font-style: italic; padding: 1rem;">
						Aucune activité suspecte détectée sur les comptes utilisateurs.
					</div>
				{% endfor %}
			</div>
		</div>

		<div class="toolbar-container">
			<div class="filter-group">
				<button class="filter-btn active" data-filter="all">Tous</button>
				<button class="filter-btn" data-filter="success">Succès</button>
				<button class="filter-btn" data-filter="failed">Échecs</button>
				<button class="filter-btn" data-filter="session">Alertes</button>
			</div>

			<div style="display: flex; gap: 12px; align-items: center;">
				<a href="{{ path('admin_security_export_csv') }}" class="btn-export">
					📥 Exporter CSV
				</a>
				<input type="text" id="searchLogs" class="search-bar" placeholder="Chercher un utilisateur, une IP...">
			</div>
		</div>

		<div class="content-card">
			<div class="table-responsive">
				<table class="table" id="logsTable">
					<thead>
						<tr>
							<th width="80">Date</th>
							<th width="180">Utilisateur</th>
							<th width="200">Localisation (IP)</th>
							<th width="120">Appareil</th>
							<th>Message / Événement</th>
							<th width="100">Statut</th>
							<th width="60" style="text-align: right;">Action</th>
						</tr>
					</thead>
					<tbody>
						{% for log in logs|default([]) %}
							{% set rowStatus = (log.type == 'erreur') ? 'failed' : (log.type == 'Session' ? 'session' : 'success') %}

							<tr class="log-row {% if log.type == 'Session' %}log-warning-row{% endif %}" data-status="{{ rowStatus }}">
								<td class="date-cell" style="color: var(--text-muted); font-family: monospace; font-size: 0.8rem;">
									{{ log.createdAt|date('d/m/Y') }}<br>
									<span style="opacity: 0.6;">{{ log.createdAt|date('H:i:s') }}</span>
								</td>

								<td>
									<strong style="color: var(--text-main);">
										{{ log.user ? log.user.email : 'Système' }}
									</strong>
								</td>

								<td>
									<span class="ip-address ip-lookup" data-ip="{{ log.ip|default('') }}">{{ log.ip|default('—') }}</span>
									<span class="geo-info" id="geo-{{ loop.index }}">Recherche...</span>
								</td>

								<td style="font-size: 0.8rem; color: var(--text-muted);">
									{% if log.userAgent %}
										{% if 'Mobi' in log.userAgent %}📱 Mobile
											{% elseif 'Windows' in log.userAgent %}💻 PC
											{% elseif 'Macintosh' in log.userAgent %}🖥️ Mac
											{% else %}🌐 Web
										{% endif %}
										<div style="font-size: 0.7rem; opacity: 0.5; margin-top: 3px;" title="{{ log.userAgent }}">
											{{ log.userAgent|slice(0, 20) }}...
										</div>
										{% else %}—
									{% endif %}
								</td>

								<td>
									<div style="display: flex; align-items: center; gap: 8px;">
										{% if log.type == 'Session' %}
											<span style="color:#f59e0b">⚠️</span>
										{% endif %}
										<span>{{ log.message ?? '—' }}</span>
									</div>

									<div style="margin-top: 6px; display: flex; gap: 6px;">
										{% set hour = log.createdAt|date('H') %}
										{% if hour < 7 or hour > 21 %}
											<span class="badge-nocturne">🌙 Nocturne ({{ hour }}h)</span>
										{% endif %}
										{% if log.createdAt|date('N') >= 6 %}
											<span class="badge-weekend">🗓️ Week-end</span>
										{% endif %}
									</div>
								</td>

								<td>
									{% if log.type == 'erreur' %}
										<span class="log-failed">BLOQUÉ</span>
									{% else %}
										<span class="log-success">AUTORISÉ</span>
									{% endif %}
								</td>

								<td style="text-align: right;">
									{% if log.ip and log.ip not in ['127.0.0.1', '::1', '—'] %}
										<a href="{{ path('admin_security_ban_ip', {'ip': log.ip}) }}" class="btn-ban" onclick="return confirm('🚫 Bannir l\'IP {{ log.ip|e('js') }} ?');" title="Bannir l'IP">
											🚫
										</a>
									{% else %}
										<span style="opacity: 0.2;">—</span>
									{% endif %}
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="7" style="text-align: center; padding: 5rem; color: var(--text-muted);">
									Aucun log de sécurité enregistré.
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
			<div id="noResults" style="display:none; text-align:center; padding:3rem; color:var(--text-muted); font-style: italic;">
				Aucune correspondance trouvée pour ces critères.
			</div>
		</div>
	</div>

{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/security/logs.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
