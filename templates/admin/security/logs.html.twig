{% extends 'admin/base_admin.html.twig' %}

{% block title %}Journal des connexions
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Journal des connexions</h1>
			<p>Activités système et alertes de sécurité en temps réel.</p>
		</div>
		<div
			class="toolbar">
			{# MODIFICATION 1 : Le bouton Purger #}
			<a href="{{ path('admin_security_purge_logs') }}" class="btn-danger-outline js-confirm-link" data-confirm="⚠️ Purger tout l'historique ? Cette action est irréversible.">
				Purger les journaux
			</a>
		</div>
	</div>

	{# Grille de surveillance (Top Targets) #}
	<div class="security-grid">
		{% for target in topTargets|default([]) %}
			<div class="target-card">
				<div class="td-mono-sm card-label">CIBLE PRIORITAIRE</div>
				<div class="target-email">{{ (target.email ?? 'Inconnu')|pseudonymize_email }}</div>
				<div class="badge badge-danger">{{ target.attempts }}
					ÉCHECS</div>
			</div>
		{% endfor %}
	</div>

	<div class="toolbar-container flex-between">
		<div class="actions group-left">
			<button class="btn-tab active">TOUS</button>
			<button class="btn-tab">SUCCÈS</button>
			<button class="btn-tab">ÉCHECS</button>
		</div>
		<div class="toolbar-right">
			<a href="{{ path('admin_security_export_csv') }}" class="btn-tab">📥 EXPORTER</a>
			<input type="text" id="searchLogs" class="search-input" placeholder="Chercher IP ou Email...">
		</div>
	</div>

	<div class="table-wrapper">
		<div class="table-scroll">
			<table class="admin-table" id="logsTable">
				<thead>
					<tr>
						<th width="120">Date</th>
						<th width="200">Utilisateur</th>
						<th width="180">IP / Géo</th>
						<th width="120">Appareil</th>
						<th>Message</th>
						<th width="100">Statut</th>
						<th class="th-right">Action</th>
					</tr>
				</thead>
				<tbody>
					{% for log in logs|default([]) %}
						<tr class="{{ log.type == 'Session' ? 'row-session' : '' }}">
							<td class="td-mono-sm">
								<strong>{{ log.createdAt|date('d/m/Y') }}</strong><br>
								<span class="time-dimmed">{{ log.createdAt|date('H:i:s') }}</span>
							</td>
							<td>
								<strong>{{ log.user ? log.user.email|pseudonymize_email : 'SYSTÈME' }}</strong>
							</td>
							<td>
								<span class="td-mono ip-accent">{{ log.ip|default('—') }}</span>
							</td>
							<td>
								<span class="td-muted device-tag">
									{% if 'Mobi' in log.userAgent %}📱 Mobile
										{% elseif 'Windows' in log.userAgent %}💻 PC
										{% else %}🌐 Web
									{% endif %}
								</span>
							</td>
							<td>
								<div class="time-info">
									<span class="log-message">{{ log.message }}</span>
									{% if log.createdAt|date('H') < 7 or log.createdAt|date('H') > 21 %}
										<span class="badge badge-nocturnal">🌙 NOCTURNE</span>
									{% endif %}
								</div>
							</td>
							<td>
								<span class="badge {{ log.type == 'erreur' ? 'badge-danger' : 'badge-active' }}">
									{{ log.type == 'erreur' ? 'BLOQUÉ' : 'OK' }}
								</span>
							</td>
							<td class="td-right">
								{% if log.ip and log.ip not in ['127.0.0.1', '::1', '—'] %}
									{# MODIFICATION 2 : Le lien de bannissement #}
									<a href="{{ path('admin_security_ban_ip', {'ip': log.ip}) }}" class="act-link act-del fs-large js-confirm-link" data-confirm="🚫 Bannir définitivement l'adresse IP {{ log.ip }} ?" title="Bannir">🚫</a>
								{% endif %}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/security/logs.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
