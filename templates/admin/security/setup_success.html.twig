{% extends 'admin/base_admin.html.twig' %}

{% block title %}Codes de Secours - Sécurité
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/security/setup_success.css') }}">
{% endblock %}

{% block body %}
	<div class="viewport">
		<div class="backup-card">
			<div class="check-icon">
				<i class="fas fa-check-circle"></i>
			</div>
			<h1>Accès sécurisé</h1>
			<p class="subtitle">La double authentification est active.</p>

			<div class="alert-box">
				<p>Sauvegardez ces codes dans un endroit sûr. Ils ne seront plus affichés après cette étape.</p>
			</div>

			<div class="codes-container">
				{% for code in backupCodes %}
					<div class="code-row">{{ code }}</div>
				{% endfor %}
			</div>

			<button class="btn-print" id="btn-print">IMPRIMER LES CODES</button>
			<a href="{{ path('admin_dashboard') }}" class="btn-back">Continuer vers le Dashboard →</a>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/security/setup_success.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
