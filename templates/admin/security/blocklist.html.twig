{% extends 'admin/base_admin.html.twig' %}

{% block title %}Blocklist & Sécurité
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Restriction & Bannissements</h1>
			<p>Comptes et adresses IP dont l'accès a été révoqué.</p>
		</div>
	</div>

	<div class="toolbar-container security-summary">
		<input type="text" id="searchBlock" class="search-input" placeholder="Chercher un email ou une IP...">
		<div class="td-mono stats-highlight">
			{{ blockedIps|length }}
			ENTRÉES ACTIVES
		</div>
	</div>

	<div class="table-wrapper">
		<div class="table-scroll">
			<table class="admin-table" id="blockTable">
				<thead>
					<tr>
						<th>Identité / Email</th>
						<th width="180">Dernière IP</th>
						<th>Motif</th>
						<th width="220">Échéance</th>
						<th class="th-right">Opération</th>
					</tr>
				</thead>
				<tbody>
					{% for row in blockedIps|default([]) %}
						<tr>
							<td>
								<div class="title-stack">
									<strong>{{ row.email }}</strong>
									<span class="td-mono-sm">ID Utilisateur: #{{ row.id }}</span>
								</div>
							</td>
							<td>
								<span class="td-mono ip-accent">{{ row.ip }}</span>
							</td>
							<td>
								<div class="product-info">
									<span class="badge badge-danger">VERROUILLÉ</span>
									<span class="td-muted reason-text">{{ row.reason }}</span>
								</div>
							</td>
							<td class="td-mono-sm">
								<div class="time-info">
									<span>Expire le :</span>
									<strong class="expiry-date">{{ row.blockedAt ? row.blockedAt|date('d/m/Y à H:i') : 'PERMANENT' }}</strong>
								</div>
							</td>
							<td>
								<div
									class="actions">
									{# MODIFICATION ICI : class ajoutée + data-confirm #}
									<a href="{{ path('admin_security_unlock_user', {id: row.id}) }}" class="btn-unlock js-confirm-link" data-confirm="🔓 Débloquer cet accès ?">
										DÉBLOQUER
									</a>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="5" class="td-empty">🛡️ Aucune restriction active.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
