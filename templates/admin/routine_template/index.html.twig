{% extends 'admin/base_admin.html.twig' %}

{% block title %}Routines (templates){% endblock %}

{% block stylesheets %}
<style>
    /* =================== HEADER & TOOLS =================== */
    .page-header {
        display: flex; justify-content: space-between; align-items: flex-end;
        margin-bottom: 2rem; padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--text-main); }
    .page-header p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; }

    .toolbar { display: flex; gap: 1rem; align-items: center; }

    .search-input, .select-input {
        background: var(--bg-sidebar);
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 0.6rem 1rem;
        border-radius: 4px;
        font-size: 0.9rem;
        font-family: inherit;
        transition: 0.2s;
    }
    .search-input { min-width: 250px; }
    .search-input:focus, .select-input:focus { border-color: var(--accent); outline: none; }
    
    .select-input option { background: var(--bg-sidebar); color: var(--text-main); }

    .btn-create {
        background: var(--text-main);
        color: var(--bg-body);
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        font-weight: 700; font-size: 0.85rem;
        cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em;
        transition: 0.2s; border: none; text-decoration: none; display: inline-block;
    }
    .btn-create:hover { opacity: 0.9; }

    /* =================== TABLEAU =================== */
    .table-wrapper {
        background: var(--bg-sidebar);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        overflow: hidden;
    }
    
    .admin-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    
    .admin-table th {
        background: rgba(255,255,255,0.02);
        color: var(--text-muted);
        font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.75rem;
        text-align: left; padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
    }
    
    .admin-table td {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-main); vertical-align: middle;
    }
    .admin-table tr:last-child td { border-bottom: none; }
    .admin-table tr:hover td { background: rgba(255,255,255,0.01); }

    /* Badges & Tags Style */
    .tag-accent { 
        font-family: 'JetBrains Mono', 'Fira Code', monospace; 
        color: var(--accent); 
        background: rgba(255, 102, 0, 0.08); 
        padding: 4px 8px; 
        border-radius: 4px; 
        font-size: 0.8rem;
        border: 1px solid rgba(255, 102, 0, 0.15);
    }

    .status-badge {
        font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
        padding: 4px 8px; border-radius: 4px; letter-spacing: 0.05em;
    }
    .status-published { color: #22c55e; background: rgba(34, 197, 94, 0.1); }
    .status-draft { color: var(--text-muted); background: rgba(255, 255, 255, 0.05); }

    /* Actions */
    .actions { display: flex; gap: 15px; justify-content: flex-end; }
    .act-link { 
        font-size: 0.75rem; font-weight: 600; text-transform: uppercase; 
        letter-spacing: 0.05em; cursor: pointer; transition: 0.2s; opacity: 0.7; 
        background: none; border: none; padding: 0; text-decoration: none;
    }
    .act-link:hover { opacity: 1; text-decoration: underline; }
    .act-edit { color: var(--text-main); }
    .act-del { color: var(--danger); }

</style>
{% endblock %}

{% block body %}
<div class="dashboard-container">

    <div class="page-header">
        <div>
            <h1>Routines (templates)</h1>
            <p>Créez des séances prêtes à l'emploi selon objectif / niveau.</p>
        </div>

        <div class="toolbar">
            <input type="text" id="searchTpl" class="search-input" placeholder="Rechercher un template..." />

            <select id="filterGoal" class="select-input">
                <option value="">Objectif (tous)</option>
                <option value="prise_de_masse">Prise de masse</option>
                <option value="perte_de_poids">Perte de poids</option>
                <option value="renfo">Renforcement</option>
            </select>

            <select id="filterLevel" class="select-input">
                <option value="">Niveau (tous)</option>
                <option value="debutant">Débutant</option>
                <option value="intermediaire">Intermédiaire</option>
                <option value="avance">Avancé</option>
            </select>

            <a href="{{ path('admin_routine_template_new') }}" class="btn-create">
                Créer un template
            </a>
        </div>
    </div>

    <div class="table-wrapper">
        <div style="overflow-x: auto;">
            <table class="admin-table" id="tplTable">
                <thead>
                    <tr>
                        <th width="60">ID</th>
                        <th>Nom du template</th>
                        <th>Objectif</th>
                        <th>Niveau</th>
                        <th>Groupe</th>
                        <th>Durée</th>
                        <th>Statut</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for tpl in templates %}
                        <tr data-goal="{{ tpl.goal }}" data-level="{{ tpl.level }}">
                            <td><span style="font-family: monospace; color: var(--text-muted);">#{{ tpl.id }}</span></td>

                            <td>
                                <strong style="display: block; color: var(--text-main);">{{ tpl.name }}</strong>
                                <span style="font-size: 0.8rem; color: var(--text-muted);">{{ tpl.templateExercises|length }} exercice(s)</span>
                            </td>

                            <td>
                                <span class="tag-accent">
                                    {{ tpl.goal|replace({'_':' '})|capitalize }}
                                </span>
                            </td>

                            <td>
                                <span style="font-weight: 500;">{{ tpl.level|capitalize }}</span>
                            </td>

                            <td>
                                <span style="color: var(--text-muted);">{{ tpl.muscleGroup }}</span>
                            </td>

                            <td>
                                <span style="font-size: 0.85rem;">{{ tpl.estimatedDurationMin ? tpl.estimatedDurationMin ~ ' min' : '—' }}</span>
                            </td>

                            <td>
                                {% if tpl.isPublished %}
                                    <span class="status-badge status-published">Publié</span>
                                {% else %}
                                    <span class="status-badge status-draft">Brouillon</span>
                                {% endif %}
                            </td>

                            <td>
                                <div class="actions">
                                    <a href="{{ path('admin_routine_template_edit', {id: tpl.id}) }}" class="act-link act-edit">Modifier</a>

                                    <form method="post" action="{{ path('admin_routine_template_delete', {id: tpl.id}) }}"
                                          onsubmit="return confirm('Supprimer définitivement le template « {{ tpl.name }} » ?');"
                                          style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_template_' ~ tpl.id) }}">
                                        <button class="act-link act-del">Supprimer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" style="text-align:center; padding:4rem; color: var(--text-muted);">
                                Aucun template enregistré.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    const search = document.getElementById('searchTpl');
    const goal = document.getElementById('filterGoal');
    const level = document.getElementById('filterLevel');
    const rows = () => document.querySelectorAll('#tplTable tbody tr:not(:last-child)');

    function applyFilters() {
        const q = (search.value || '').toLowerCase();
        const g = goal.value;
        const l = level.value;

        document.querySelectorAll('#tplTable tbody tr').forEach(row => {
            if (row.cells.length < 2) return; // Ignore la ligne "Aucun template"

            const text = row.textContent.toLowerCase();
            const rowGoal = row.getAttribute('data-goal') || '';
            const rowLevel = row.getAttribute('data-level') || '';

            const matchQ = !q || text.includes(q);
            const matchG = !g || rowGoal === g;
            const matchL = !l || rowLevel === l;

            row.style.display = (matchQ && matchG && matchL) ? '' : 'none';
        });
    }

    [search, goal, level].forEach(el => el.addEventListener('input', applyFilters));
</script>
{% endblock %}