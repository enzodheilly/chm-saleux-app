{% extends 'admin/base_admin.html.twig' %}

{% block title %}Ajouter un exercice{% endblock %}

{% block stylesheets %}
<style>
    .dashboard-container { width: 100%; max-width: 900px; margin: 0 auto; }

    /* =================== HEADER =================== */
    .page-header {
        display: flex; justify-content: space-between; align-items: flex-end;
        margin-bottom: 2rem; padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--text-main); }
    .page-header p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; }

    /* =================== FORM CONTAINER =================== */
    .form-wrapper {
        background: var(--bg-sidebar);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 2rem;
    }

    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    @media(max-width: 768px){ .form-row { grid-template-columns: 1fr; } }

    .form-group { margin-bottom: 1.5rem; }
    
    .label {
        display: block; 
        font-size: 0.75rem; 
        font-weight: 600; 
        color: var(--text-muted);
        text-transform: uppercase; 
        letter-spacing: 0.05em; 
        margin-bottom: 0.6rem;
    }

    .control {
        width: 100%; 
        background: rgba(255,255,255,0.03); 
        border: 1px solid var(--border-color); 
        color: var(--text-main);
        padding: 0.75rem 1rem; 
        border-radius: 4px; 
        outline: none; 
        font-size: 0.9rem;
        font-family: inherit;
        transition: 0.2s;
    }
    .control:focus { border-color: var(--accent); background: rgba(255,255,255,0.05); }

    .errors { color: var(--danger); font-size: 0.8rem; margin-top: 0.4rem; font-weight: 500; }

    /* =================== BUTTONS =================== */
    .footer-toolbar { 
        display: flex; gap: 1rem; justify-content: flex-end; 
        padding-top: 2rem; margin-top: 1rem; 
        border-top: 1px solid var(--border-color); 
    }

    .btn-save {
        background: var(--text-main);
        color: var(--bg-body);
        padding: 0.7rem 1.8rem;
        border-radius: 4px;
        font-weight: 700; font-size: 0.85rem;
        cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em;
        transition: 0.2s; border: none; text-decoration: none;
    }
    .btn-save:hover { opacity: 0.9; }

    .btn-cancel {
        background: transparent; 
        border: 1px solid var(--border-color); 
        color: var(--text-muted);
        padding: 0.6rem 1.2rem; 
        border-radius: 4px; 
        font-weight: 600; font-size: 0.85rem;
        text-transform: uppercase; letter-spacing: 0.05em;
        text-decoration: none; transition: 0.2s;
    }
    .btn-cancel:hover { border-color: var(--text-muted); color: var(--text-main); }

    .template-badge {
        font-family: 'JetBrains Mono', monospace;
        color: var(--accent);
        background: rgba(255, 102, 0, 0.08);
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.85rem;
    }
</style>
{% endblock %}

{% block body %}
<div class="dashboard-container">

    <div class="page-header">
        <div>
            <h1>Ajouter un exercice</h1>
            <p>Configuration pour le template : <span class="template-badge">{{ template.name }}</span></p>
        </div>
        <a href="{{ path('admin_routine_template_edit', {id: template.id}) }}" class="btn-cancel" style="padding: 0.5rem 1rem; font-size: 0.75rem;">Retour</a>
    </div>

    <div class="form-wrapper">
        {{ form_start(form) }}

        <div class="form-group">
            <span class="label">Sélectionner l'exercice</span>
            {{ form_widget(form.exercise, {'attr': {'class': 'control'}}) }}
            <div class="errors">{{ form_errors(form.exercise) }}</div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <span class="label">Position (Ordre)</span>
                {{ form_widget(form.position, {'attr': {'class': 'control', 'placeholder': 'Ex: 1'}}) }}
                <div class="errors">{{ form_errors(form.position) }}</div>
            </div>

            <div class="form-group">
                <span class="label">Nombre de séries</span>
                {{ form_widget(form.sets, {'attr': {'class': 'control', 'placeholder': 'Ex: 3'}}) }}
                <div class="errors">{{ form_errors(form.sets) }}</div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <span class="label">Répétitions min</span>
                {{ form_widget(form.repsMin, {'attr': {'class': 'control', 'placeholder': '8'}}) }}
                <div class="errors">{{ form_errors(form.repsMin) }}</div>
            </div>
            <div class="form-group">
                <span class="label">Répétitions max</span>
                {{ form_widget(form.repsMax, {'attr': {'class': 'control', 'placeholder': '12'}}) }}
                <div class="errors">{{ form_errors(form.repsMax) }}</div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <span class="label">Repos (sec)</span>
                {{ form_widget(form.restSeconds, {'attr': {'class': 'control', 'placeholder': '90'}}) }}
                <div class="errors">{{ form_errors(form.restSeconds) }}</div>
            </div>

            <div class="form-group">
                <span class="label">RIR cible</span>
                {{ form_widget(form.rir, {'attr': {'class': 'control', 'placeholder': 'Ex: 1-2'}}) }}
                <div class="errors">{{ form_errors(form.rir) }}</div>
            </div>
        </div>

        <div class="form-group">
            <span class="label">Notes & Instructions</span>
            {{ form_widget(form.notes, {'attr': {'class': 'control', 'rows': 3, 'placeholder': 'Consignes techniques, tempo, ou variante...'}}) }}
            <div class="errors">{{ form_errors(form.notes) }}</div>
        </div>

        <div class="footer-toolbar">
            <a href="{{ path('admin_routine_template_edit', {id: template.id}) }}" class="btn-cancel">Annuler</a>
            <button class="btn-save" type="submit">Ajouter au template</button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}