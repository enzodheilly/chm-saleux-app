{% extends 'admin/base_admin.html.twig' %}

{% block title %}Ajouter un exercice
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/routine_template/global.css') }}">
{% endblock %}

{% block body %}
	<div class="dashboard-container">

		<div class="page-header">
			<div>
				<h1>Ajouter un exercice</h1>
				<p>Configuration pour le template :
					<span class="template-badge">{{ template.name }}</span>
				</p>
			</div>
			<a href="{{ path('admin_routine_template_edit', {id: template.id}) }}" class="btn-cancel btn-cancel-sm">Retour</a>
		</div>

		<div class="form-wrapper">
			{{ form_start(form) }}

			<div class="form-group">
				<span class="label">Sélectionner l'exercice</span>
				{{ form_widget(form.exercise, {'attr': {'class': 'control'}}) }}
				<div class="errors">{{ form_errors(form.exercise) }}</div>
			</div>

			<div class="form-row">
				<div class="form-group">
					<span class="label">Position (Ordre)</span>
					{{ form_widget(form.position, {'attr': {'class': 'control', 'placeholder': 'Ex: 1'}}) }}
					<div class="errors">{{ form_errors(form.position) }}</div>
				</div>

				<div class="form-group">
					<span class="label">Nombre de séries</span>
					{{ form_widget(form.sets, {'attr': {'class': 'control', 'placeholder': 'Ex: 3'}}) }}
					<div class="errors">{{ form_errors(form.sets) }}</div>
				</div>
			</div>

			<div class="form-row">
				<div class="form-group">
					<span class="label">Répétitions min</span>
					{{ form_widget(form.repsMin, {'attr': {'class': 'control', 'placeholder': '8'}}) }}
					<div class="errors">{{ form_errors(form.repsMin) }}</div>
				</div>
				<div class="form-group">
					<span class="label">Répétitions max</span>
					{{ form_widget(form.repsMax, {'attr': {'class': 'control', 'placeholder': '12'}}) }}
					<div class="errors">{{ form_errors(form.repsMax) }}</div>
				</div>
			</div>

			<div class="form-row">
				<div class="form-group">
					<span class="label">Repos (sec)</span>
					{{ form_widget(form.restSeconds, {'attr': {'class': 'control', 'placeholder': '90'}}) }}
					<div class="errors">{{ form_errors(form.restSeconds) }}</div>
				</div>

				<div class="form-group">
					<span class="label">RIR cible</span>
					{{ form_widget(form.rir, {'attr': {'class': 'control', 'placeholder': 'Ex: 1-2'}}) }}
					<div class="errors">{{ form_errors(form.rir) }}</div>
				</div>
			</div>

			<div class="form-group">
				<span class="label">Notes & Instructions</span>
				{{ form_widget(form.notes, {'attr': {'class': 'control', 'rows': 3, 'placeholder': 'Consignes techniques, tempo, ou variante...'}}) }}
				<div class="errors">{{ form_errors(form.notes) }}</div>
			</div>

			<div class="footer-toolbar">
				<a href="{{ path('admin_routine_template_edit', {id: template.id}) }}" class="btn-cancel">Annuler</a>
				<button class="btn-save" type="submit">Ajouter au template</button>
			</div>

			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}
