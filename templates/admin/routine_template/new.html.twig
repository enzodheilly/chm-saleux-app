{% extends 'admin/base_admin.html.twig' %}

{% block title %}Créer un template{% endblock %}
{% block page_title %}Créer un template{% endblock %}

{% block stylesheets %}
<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
        gap: 1rem;
        flex-wrap: wrap;
    }

    .page-header h1 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: var(--text-main);
    }

    .page-header p {
        margin: 5px 0 0 0;
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    .toolbar {
        display: flex;
        gap: 0.75rem;
        align-items: flex-end;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .btn-create {
        background: var(--text-main);
        color: var(--bg-body);
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: 0.2s;
        border: none;
        text-decoration: none;
        display: inline-block;
        white-space: nowrap;
    }

    .btn-create:hover {
        opacity: 0.9;
    }

    .btn-outline {
        background: transparent;
        color: var(--text-main);
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: 0.2s;
        border: 1px solid var(--border-color);
        text-decoration: none;
        display: inline-block;
        white-space: nowrap;
        opacity: 0.9;
    }

    .btn-outline:hover {
        opacity: 1;
        border-color: var(--text-main);
    }

    .table-wrapper {
        background: var(--bg-sidebar);
        border: 1px solid var(--border-color);
        border-radius: 6px;
    }

    .card-body {
        padding: 1.5rem;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.2rem;
        max-width: 900px;
    }

    .form-row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.2rem;
    }

    .tool-label {
        display: block;
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.35rem;
    }

    .input {
        background: transparent;
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 0.6rem 1rem;
        border-radius: 4px;
        outline: none;
        font-size: 0.9rem;
        transition: border-color 0.2s;
        width: 100%;
        box-sizing: border-box;
    }

    .input:focus {
        border-color: var(--text-main);
    }

    .input::placeholder {
        color: var(--text-muted);
        opacity: 0.6;
    }

    .toggle-card {
        display: flex;
        gap: 0.9rem;
        align-items: flex-start;
        padding: 1rem;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        background: rgba(255,255,255,0.01);
        transition: background 0.2s;
    }

    .toggle-card:hover {
        background: rgba(255,255,255,0.03);
    }

    .toggle-input {
        width: 1.1rem;
        height: 1.1rem;
        accent-color: var(--accent);
        margin-top: 0.1rem;
        cursor: pointer;
        flex-shrink: 0;
    }

    .toggle-title {
        display: block;
        font-weight: 600;
        color: var(--text-main);
        font-size: 0.9rem;
    }

    .toggle-desc {
        display: block;
        margin-top: 0.2rem;
        color: var(--text-muted);
        font-size: 0.8rem;
        line-height: 1.45;
    }

    .form-error {
        color: var(--danger);
        font-size: 0.85rem;
        margin-top: 0.35rem;
    }

    .form-error ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .form-actions {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 0.5rem;
    }

    @media (max-width: 768px) {
        .form-row-2 {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 700px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .toolbar {
            justify-content: flex-start;
            width: 100%;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1>Créer un template</h1>
        <p>Définissez l’objectif, le niveau et le groupe musculaire de la routine.</p>
    </div>

    <div class="toolbar">
        <a href="{{ path('admin_routine_template_index') }}" class="btn-outline">Retour</a>
    </div>
</div>

<div class="table-wrapper">
    <div class="card-body">
        {{ form_start(form) }}

            <div class="form-error">{{ form_errors(form) }}</div>

            <div class="form-grid">
                <div>
                    <span class="tool-label">Nom du template</span>
                    {{ form_widget(form.name, {'attr': {'class': 'input', 'placeholder': 'Ex: Full Body Evolution'}}) }}
                    <div class="form-error">{{ form_errors(form.name) }}</div>
                </div>

                <div class="form-row-2">
                    <div>
                        <span class="tool-label">Objectif</span>
                        {{ form_widget(form.goal, {'attr': {'class': 'input'}}) }}
                        <div class="form-error">{{ form_errors(form.goal) }}</div>
                    </div>

                    <div>
                        <span class="tool-label">Niveau requis</span>
                        {{ form_widget(form.level, {'attr': {'class': 'input'}}) }}
                        <div class="form-error">{{ form_errors(form.level) }}</div>
                    </div>
                </div>

                <div class="form-row-2">
                    <div>
                        <span class="tool-label">Groupe musculaire</span>
                        {{ form_widget(form.muscleGroup, {'attr': {'class': 'input', 'placeholder': 'Ex: Pectoraux / Dos'}}) }}
                        <div class="form-error">{{ form_errors(form.muscleGroup) }}</div>
                    </div>

                    <div>
                        <span class="tool-label">Durée estimée (minutes)</span>
                        {{ form_widget(form.estimatedDurationMin, {'attr': {'class': 'input', 'placeholder': '60'}}) }}
                        <div class="form-error">{{ form_errors(form.estimatedDurationMin) }}</div>
                    </div>
                </div>

                <div>
                    <span class="tool-label">Visibilité</span>
                    <label class="toggle-card">
                        {{ form_widget(form.isPublished, {'attr': {'class': 'toggle-input'}}) }}
                        <div>
                            <span class="toggle-title">Rendre ce template disponible immédiatement</span>
                            <span class="toggle-desc">Le template sera visible et utilisable dès son enregistrement.</span>
                        </div>
                    </label>
                    <div class="form-error">{{ form_errors(form.isPublished) }}</div>
                </div>

                <div class="form-actions">
                    <button class="btn-create" type="submit">Enregistrer le template</button>
                    <a href="{{ path('admin_routine_template_index') }}" class="btn-outline">Annuler</a>
                </div>
            </div>

        {{ form_end(form, {'render_rest': false}) }}
    </div>
</div>
{% endblock %}