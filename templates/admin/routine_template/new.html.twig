{% extends 'admin/base_admin.html.twig' %}

{% block title %}Créer un template
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/routine_template/new.css') }}">
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Créer un template</h1>
			<p>Définissez l’objectif, le niveau et le groupe musculaire de la routine.</p>
		</div>

		<div class="toolbar">
			<a href="{{ path('admin_routine_template_index') }}" class="btn-outline">Retour</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="card-body">
			{{ form_start(form) }}

			<div class="form-error">{{ form_errors(form) }}</div>

			<div class="form-grid">
				<div>
					<span class="tool-label">Nom du template</span>
					{{ form_widget(form.name, {'attr': {'class': 'input', 'placeholder': 'Ex: Full Body Evolution'}}) }}
					<div class="form-error">{{ form_errors(form.name) }}</div>
				</div>

				<div class="form-row-2">
					<div>
						<span class="tool-label">Objectif</span>
						{{ form_widget(form.goal, {'attr': {'class': 'input'}}) }}
						<div class="form-error">{{ form_errors(form.goal) }}</div>
					</div>

					<div>
						<span class="tool-label">Niveau requis</span>
						{{ form_widget(form.level, {'attr': {'class': 'input'}}) }}
						<div class="form-error">{{ form_errors(form.level) }}</div>
					</div>
				</div>

				<div class="form-row-2">
					<div>
						<span class="tool-label">Groupe musculaire</span>
						{{ form_widget(form.muscleGroup, {'attr': {'class': 'input', 'placeholder': 'Ex: Pectoraux / Dos'}}) }}
						<div class="form-error">{{ form_errors(form.muscleGroup) }}</div>
					</div>

					<div>
						<span class="tool-label">Durée estimée (minutes)</span>
						{{ form_widget(form.estimatedDurationMin, {'attr': {'class': 'input', 'placeholder': '60'}}) }}
						<div class="form-error">{{ form_errors(form.estimatedDurationMin) }}</div>
					</div>
				</div>

				<div>
					<span class="tool-label">Visibilité</span>
					<label class="toggle-card">
						{{ form_widget(form.isPublished, {'attr': {'class': 'toggle-input'}}) }}
						<div>
							<span class="toggle-title">Rendre ce template disponible immédiatement</span>
							<span class="toggle-desc">Le template sera visible et utilisable dès son enregistrement.</span>
						</div>
					</label>
					<div class="form-error">{{ form_errors(form.isPublished) }}</div>
				</div>

				<div class="form-actions">
					<button class="btn-create" type="submit">Enregistrer le template</button>
					<a href="{{ path('admin_routine_template_index') }}" class="btn-outline">Annuler</a>
				</div>
			</div>

			{{ form_end(form, {'render_rest': false}) }}
		</div>
	</div>
{% endblock %}
