{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier un template
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/routine_template/global.css') }}">
{% endblock %}

{% block body %}
	<div class="dashboard-container">

		<div class="page-header">
			<div>
				<h1>Modifier le template</h1>
				<p>{{ template.name }}
					—
					<span class="mono">{{ template.goal|replace({'_':' '})|upper }}</span>
				</p>
			</div>
			<div class="toolbar">
				<a href="{{ path('admin_routine_template_index') }}" class="btn-cancel">Retour</a>
				<a href="{{ path('admin_routine_template_exercise_new', {id: template.id}) }}" class="btn-create">
					+ Ajouter un exercice
				</a>
			</div>
		</div>

		<div class="form-wrapper">
			{{ form_start(form) }}
			<div class="form-group">
				<span class="label">Nom du template</span>
				{{ form_widget(form.name, {'attr': {'class': 'control'}}) }}
				<div class="errors">{{ form_errors(form.name) }}</div>
			</div>

			<div class="form-row">
				<div class="form-group">
					<span class="label">Objectif</span>
					{{ form_widget(form.goal, {'attr': {'class': 'control'}}) }}
				</div>
				<div class="form-group">
					<span class="label">Niveau</span>
					{{ form_widget(form.level, {'attr': {'class': 'control'}}) }}
				</div>
			</div>

			<div class="form-row">
				<div class="form-group">
					<span class="label">Groupe Musculaire</span>
					{{ form_widget(form.muscleGroup, {'attr': {'class': 'control'}}) }}
				</div>
				<div class="form-group">
					<span class="label">Durée (min)</span>
					{{ form_widget(form.estimatedDurationMin, {'attr': {'class': 'control'}}) }}
				</div>
			</div>

			<div class="form-group">
				<span class="label">Visibilité</span>
				<div class="checkbox-wrapper">
					{{ form_widget(form.isPublished) }}
					<span class="info-secondary text-main">Publier ce template (visible par les utilisateurs)</span>
				</div>
			</div>

			<div class="form-actions-end">
				<button class="btn-create" type="submit">Enregistrer les modifications</button>
			</div>
			{{ form_end(form, {'render_rest': false}) }}
		</div>

		<div class="page-header no-border">
			<div>
				<h1>Exercices inclus</h1>
				<p>Gérez l'ordre et la configuration des mouvements.</p>
			</div>
		</div>

		<div class="table-wrapper">
			<div class="table-scroll">
				<table class="admin-table">
					<thead>
						<tr>
							<th width="60">Ordre</th>
							<th>Exercice</th>
							<th>Séries</th>
							<th>Reps</th>
							<th>Repos</th>
							<th>RIR</th>
							<th class="th-right">Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for item in items %}
							<tr>
								<td class="mono td-muted">#{{ item.position }}</td>
								<td>
									<strong class="tpl-name">{{ item.exercise.name }}</strong>
									<span class="info-secondary">{{ item.exercise.muscleGroup }}</span>
								</td>
								<td>
									<span class="mono">{{ item.sets }}</span>
								</td>
								<td>
									<span class="mono">{{ item.repsMin }}–{{ item.repsMax }}</span>
								</td>
								<td>
									<span class="info-secondary">{{ item.restSeconds }}s</span>
								</td>
								<td>
									<span class="mono">{{ item.rir ?? '—' }}</span>
								</td>
								<td>
									<div class="actions-end">
										<form method="post" action="{{ path('admin_routine_template_exercise_delete', {id: item.id}) }}" data-confirm="Retirer cet exercice ?">
											<input type="hidden" name="_token" value="{{ csrf_token('delete_tpl_item_' ~ item.id) }}">
											<button class="act-link act-del">Supprimer</button>
										</form>
									</div>
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="7" class="td-empty">Aucun exercice dans ce template.</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/routine_template/edit.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
