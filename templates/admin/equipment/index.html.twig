{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des machines
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Machines & Équipements</h1>
			<p>Gérez le catalogue de matériel disponible.</p>
		</div>
		<div class="toolbar">
			<a href="{{ path('admin_equipment_new') }}" class="btn-create">+ Ajouter une machine</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="table-scroll">
			<table class="admin-table">
				<thead>
					<tr>
						<th width="55%">Équipement</th>
						<th width="25%">Marque</th>
						<th class="th-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for equipment in equipments %}
						<tr>
							<td>
								<div class="product-info">
									<div class="title-stack">
										<strong>{{ equipment.name }}</strong>
										<span class="td-mono-sm equipment-id">ID: #{{ equipment.id }}</span>
									</div>
								</div>
							</td>
							<td>
								{# Utilisation de la classe badge-neutral créée pour les athlètes #}
								<span class="badge badge-neutral">
									{{ equipment.brand|default('—') }}
								</span>
							</td>
							<td>
								<div class="actions">
									<a href="{{ path('admin_equipment_edit', {id: equipment.id}) }}" class="act-link">Modifier</a>

									{# MODIFICATION : Passage en V20 JS #}
									<form method="post" action="{{ path('admin_equipment_delete', {id: equipment.id}) }}" class="js-confirm-form" data-confirm="🏋️‍♂️ Supprimer la machine '{{ equipment.name }}' {% if equipment.brand %}({{ equipment.brand }}){% endif %} ?">
										<input type="hidden" name="_token" value="{{ csrf_token('delete_equipment_' ~ equipment.id) }}">
										<button class="act-link act-del">Supprimer</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="3" class="td-empty">Aucun équipement enregistré.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
