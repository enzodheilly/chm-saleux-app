{# templates/admin/equipment/index.html.twig #}
{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des machines
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/equipment/index.css') }}">
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Machines & Équipements</h1>
			<p>Gérez le catalogue de matériel disponible.</p>
		</div>

		<div class="toolbar">
			<a href="{{ path('admin_equipment_new') }}" class="btn-create">
				+ Ajouter une machine
			</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div style="overflow-x: auto;">
			<table class="admin-table">
				<thead>
					<tr>
						<th width="55%">Équipement</th>
						<th width="25%">Marque</th>
						<th style="text-align: right;">Actions</th>
					</tr>
				</thead>

				<tbody>
					{% for equipment in equipments %}
						<tr>
							<td>
								<div class="machine-info">
									<span class="machine-name">{{ equipment.name }}</span>
								</div>
							</td>

							<td style="color: var(--text-muted); font-family: monospace; font-size: 0.85rem;">
								{{ equipment.brand ?? '-' }}
							</td>

							<td>
								<div class="actions">
									<a href="{{ path('admin_equipment_edit', {id: equipment.id}) }}" class="act-link act-edit">
										Modifier
									</a>

									<form method="post" action="{{ path('admin_equipment_delete', {id: equipment.id}) }}" onsubmit="return confirm('Supprimer cet équipement ?');" style="display:inline;">
										<input type="hidden" name="_token" value="{{ csrf_token('delete_equipment_' ~ equipment.id) }}">
										<button class="act-link act-del">Supprimer</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="3" style="text-align: center; padding: 4rem; color: var(--text-muted);">
								Aucun équipement n'a été ajouté pour le moment.
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
