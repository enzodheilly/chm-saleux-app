{# templates/admin/equipment/new.html.twig #}
{% extends 'admin/base_admin.html.twig' %}

{% block title %}Ajouter un équipement
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/equipment/new.css') }}">
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Nouvel équipement</h1>
			<p>Ajoutez une machine / matériel à l’inventaire.</p>
		</div>
		<div class="toolbar">
			<a href="{{ path('admin_equipment_index') }}" class="btn-outline">Retour</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="card-body">
			{{ form_start(form) }}

			<div class="form-error">{{ form_errors(form) }}</div>

			<div class="form-grid">
				<div>
					<span class="tool-label">Nom de la machine</span>
					{{ form_widget(form.name, { attr: { class: 'input', placeholder: 'Ex: Presse à cuisses inclinée' } }) }}
					<div class="form-error">{{ form_errors(form.name) }}</div>
				</div>

				<div>
					<span class="tool-label">Marque (optionnel)</span>
					{{ form_widget(form.brand, { attr: { class: 'input', placeholder: 'Ex: Matrix' } }) }}
					<div class="form-error">{{ form_errors(form.brand) }}</div>
				</div>

				<div class="form-actions">
					<button type="submit" class="btn-create">Enregistrer</button>
					<a href="{{ path('admin_equipment_index') }}" class="btn-outline">Annuler</a>
				</div>
			</div>

			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}
