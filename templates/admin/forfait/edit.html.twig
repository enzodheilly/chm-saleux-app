{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier le forfait{% endblock %}

{% block stylesheets %}
<style>
    /* =================== COPIE EXACTE DU STYLE "NEW" =================== */
    .form-container { max-width: 800px; margin: 0 auto; }

    .page-header {
        margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem;
        display: flex; justify-content: space-between; align-items: flex-end;
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--text-main); }
    .page-header p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; }
    .back-link { font-size: 0.85rem; color: var(--text-muted); font-weight: 500; text-decoration: underline; cursor: pointer; }
    .back-link:hover { color: var(--text-main); }

    .form-card { background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 6px; padding: 2rem; }
    .form-group { margin-bottom: 1.5rem; }

    .form-label { display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }

    .form-control {
        width: 100%; background: var(--bg-body); border: 1px solid var(--border-color); color: var(--text-main);
        padding: 0.75rem 1rem; border-radius: 4px; font-size: 0.95rem; font-family: inherit; transition: border-color 0.2s, box-shadow 0.2s; box-sizing: border-box;
    }
    .form-control:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.1); }
    
    .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; }
    @media(max-width: 700px) { .form-row-3 { grid-template-columns: 1fr; gap: 0; } }

    .toggle-wrapper { display: flex; align-items: center; gap: 10px; cursor: pointer; user-select: none; margin-top: 2rem; padding: 1rem; border: 1px solid var(--border-color); border-radius: 4px; background: rgba(255,255,255,0.01); transition: background 0.2s; }
    .toggle-wrapper:hover { background: rgba(255,255,255,0.03); }
    .toggle-input { width: 1.2rem; height: 1.2rem; accent-color: var(--accent); cursor: pointer; }
    .toggle-label { font-weight: 600; color: var(--text-main); cursor: pointer; }
    .toggle-desc { display: block; font-size: 0.8rem; color: var(--text-muted); margin-left: 30px; margin-top: 2px; }

    .help-box { margin-top: 0.5rem; padding: 0.8rem; background: rgba(255,255,255,0.02); border-left: 3px solid var(--text-muted); border-radius: 0 4px 4px 0; font-size: 0.85rem; color: var(--text-muted); }
    .help-box code { background: rgba(0,0,0,0.2); padding: 2px 4px; border-radius: 3px; font-family: monospace; color: var(--accent); }

    /* =================== ACTIONS SPECIFIQUES EDIT =================== */
    .form-actions { 
        margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color); 
        display: flex; justify-content: space-between; /* Espace entre Delete et Save */
        align-items: center;
    }
    
    .btn-group-right { display: flex; gap: 1rem; }

    .btn-cancel { padding: 0.7rem 1.2rem; color: var(--text-muted); font-weight: 600; font-size: 0.9rem; border-radius: 4px; transition: color 0.2s; }
    .btn-cancel:hover { color: var(--text-main); }
    
    .btn-save { background: var(--text-main); color: var(--bg-body); padding: 0.7rem 1.5rem; border-radius: 4px; font-weight: 700; font-size: 0.9rem; border: none; cursor: pointer; transition: opacity 0.2s; }
    .btn-save:hover { opacity: 0.9; }

    .btn-delete { color: var(--danger); background: none; border: none; font-size: 0.9rem; font-weight: 600; cursor: pointer; padding: 0.5rem 0; opacity: 0.8; transition: opacity 0.2s; }
    .btn-delete:hover { opacity: 1; text-decoration: underline; }

</style>
{% endblock %}

{% block body %}
<div class="form-container">
    
    <div class="page-header">
        <div>
            <h1>Modifier l'offre</h1>
            <p>Édition de : <span style="font-weight: 700; color: var(--text-main);">{{ forfait.nom }}</span></p>
        </div>
        <a href="{{ path('admin_forfait_index') }}" class="back-link">Retour à la liste</a>
    </div>

    <div class="form-card">
        {{ form_start(form) }}

        <div class="form-group">
            {{ form_label(form.nom, 'Nom commercial', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
            <div style="color: var(--danger); font-size: 0.85rem;">{{ form_errors(form.nom) }}</div>
        </div>

        <div class="form-row-3">
            <div class="form-group">
                {{ form_label(form.prix, 'Prix Total (€)', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.prix, {'attr': {'class': 'form-control', 'id': 'input-price'}}) }}
                <div style="color: var(--danger); font-size: 0.85rem;">{{ form_errors(form.prix) }}</div>
            </div>
            
            <div class="form-group">
                {{ form_label(form.frequence, 'Période', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.frequence, {'attr': {'class': 'form-control', 'id': 'input-freq'}}) }}
                <div style="color: var(--danger); font-size: 0.85rem;">{{ form_errors(form.frequence) }}</div>
            </div>

            <div class="form-group">
                {{ form_label(form.mensualite, 'Coût mensuel (Est.)', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.mensualite, {'attr': {'class': 'form-control', 'id': 'input-monthly', 'readonly': 'readonly', 'style': 'opacity: 0.7; cursor: not-allowed;'}}) }}
                <small style="display:block; color:var(--text-muted); font-size:0.75rem; margin-top:4px;">Recalculé à la modification</small>
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.description, 'Phrase d\'accroche', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="form-group">
            {{ form_label(form.avantages, 'Liste des avantages', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.avantages, {'attr': {'class': 'form-control', 'rows': 6}}) }}
            
            <div class="help-box">
                Format optionnel : <code>icone | texte</code>.<br>
                Une ligne par avantage.
            </div>
        </div>

        <div class="toggle-wrapper" onclick="document.getElementById('{{ form.isPopular.vars.id }}').click()">
            {{ form_widget(form.isPopular, {'attr': {'class': 'toggle-input'}}) }}
            <div>
                <label for="{{ form.isPopular.vars.id }}" class="toggle-label">Offre Populaire</label>
                <span class="toggle-desc">Cochez cette case pour mettre ce forfait en avant sur le site.</span>
            </div>
        </div>

        <div class="form-actions">
            <button type="button" class="btn-delete" onclick="if(confirm('Attention : Supprimer cette offre peut affecter l\'affichage du site.\n\nÊtes-vous sûr ?')) document.getElementById('delete-form').submit();">
                Supprimer l'offre
            </button>

            <div class="btn-group-right">
                <a href="{{ path('admin_forfait_index') }}" class="btn-cancel">Annuler</a>
                <button type="submit" class="btn-save">Mettre à jour</button>
            </div>
        </div>

        {{ form_end(form) }}
    </div>

    <form id="delete-form" method="post" action="{{ path('admin_forfait_delete', {'id': forfait.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ forfait.id) }}">
    </form>

</div>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const priceInput = document.getElementById('input-price');
        const freqSelect = document.getElementById('input-freq');
        const monthlyInput = document.getElementById('input-monthly');

        function calculateMonthly() {
            let price = parseFloat(priceInput.value);
            let text = freqSelect.options[freqSelect.selectedIndex].text.toLowerCase();
            
            if (isNaN(price)) {
                monthlyInput.value = '';
                return;
            }

            let divisor = 1;
            if (text.includes('trimestre') || text.includes('3 mois')) divisor = 3;
            else if (text.includes('semestre') || text.includes('6 mois')) divisor = 6;
            else if (text.includes('an') || text.includes('12 mois')) divisor = 12;

            let result = price / divisor;
            monthlyInput.value = result.toFixed(2);
        }

        if(priceInput && freqSelect) {
            priceInput.addEventListener('input', calculateMonthly);
            freqSelect.addEventListener('change', calculateMonthly);
            
            // Calcul initial au chargement de la page (important pour l'Edit !)
            calculateMonthly();
        }
    });
</script>
{% endblock %}