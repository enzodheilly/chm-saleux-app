{% extends 'admin/base_admin.html.twig' %}

{% block title %}Abonnés newsletter
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Abonnés Newsletter</h1>
			<p>Audience actuelle et liste de diffusion.</p>
		</div>
		<div class="toolbar">
			<input type="text" id="searchSubs" class="search-input" placeholder="Rechercher par email...">
		</div>
	</div>

	<div class="table-wrapper">
		<div class="table-scroll">
			<table class="admin-table" id="subsTable">
				<thead>
					<tr>
						<th width="80">#</th>
						<th>Adresse Email</th>
						<th>Date d'inscription</th>
						<th class="th-right">Statut</th>
					</tr>
				</thead>
				<tbody>
					{% for s in subscribers %}
						<tr>
							<td>
								<span class="td-mono index-col">{{ loop.index|format("%02d") }}</span>
							</td>
							<td>
								{# La classe link-accent remplace le style inline #}
								<a href="mailto:{{ s.email }}" class="link-accent">
									{{ s.email }}
								</a>
							</td>
							<td class="td-mono-sm">
								{{ s.subscribedAt|date('d/m/Y') }}
								<span class="time-dimmed">{{ s.subscribedAt|date('H:i') }}</span>
							</td>
							<td class="td-right">
								{% if s.isConfirmed %}
									<span class="badge badge-active">Confirmé</span>
								{% else %}
									{# On utilise badge-neutral pour l'attente #}
									<span class="badge badge-pending">En attente</span>
								{% endif %}
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="4" class="td-empty">Aucun abonné enregistré.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
