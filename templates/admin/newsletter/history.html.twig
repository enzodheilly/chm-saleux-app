{% extends 'admin/base_admin.html.twig' %}

{% block title %}Performances Newsletter
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/newsletter/history.css') }}">
{% endblock %}

{% block body %}
	<div class="dashboard-container">

		<div class="page-header">
			<div>
				<h1>Analyse Newsletter</h1>
				<p>Suivi de l'engagement et des taux de conversion.</p>
			</div>
			<div>
				<span class="rate-text">Dernière mise à jour :
					{{ "now"|date("H:i") }}</span>
			</div>
		</div>

		{# KPI CARDS #}
		<div class="stats-grid">
			<div class="stat-card">
				<div class="stat-label">Envois Totaux</div>
				<div class="stat-value">{{ messages|length }}</div>
			</div>

			{% set totalRecipients = messages|reduce((carry, m) => carry + m.recipientCount, 0) %}
			<div class="stat-card">
				<div class="stat-label">Portée Globale</div>
				<div class="stat-value">{{ totalRecipients }}</div>
			</div>

			{% set totalOpens = messages|reduce((carry, m) => carry + (m.openCount ?? 0), 0) %}
			{% set avgOpenRate = totalRecipients > 0 ? (totalOpens / totalRecipients * 100) : 0 %}
			<div class="stat-card">
				<div class="stat-label">Taux d'Ouverture Moyen</div>
				<div class="stat-value stat-value-green">{{ avgOpenRate|number_format(1) }}%</div>
			</div>

			{% set totalClicks = messages|reduce((carry, m) => carry + (m.clickCount ?? 0), 0) %}
			{% set avgClickRate = totalRecipients > 0 ? (totalClicks / totalRecipients * 100) : 0 %}
			<div class="stat-card">
				<div class="stat-label">Réactivité (Clics)</div>
				<div class="stat-value stat-value-blue">{{ avgClickRate|number_format(1) }}%</div>
			</div>
		</div>

		{# CHART #}
		<div class="chart-card">
			<div class="chart-header">
				<span class="chart-title">Évolution des Taux de Performance</span>
				<select id="periodSelect" class="filter-select">
					<option value="10">10 dernières campagnes</option>
					<option value="30">30 derniers jours</option>
				</select>
			</div>
			<canvas id="newsletterStatsChart" height="70"></canvas>
		</div>

		{# HISTORICAL TABLE #}
		<div class="table-wrapper">
			<table class="admin-table">
				<thead>
					<tr>
						<th width="30%">Objet de la campagne</th>
						<th width="15%">Envoyé le</th>
						<th width="10%">Volume</th>
						<th width="15%">Ouvertures</th>
						<th width="15%">Clics</th>
						<th class="th-right">Contenu</th>
					</tr>
				</thead>
				<tbody>
					{% for msg in messages %}
						{% set openRate = msg.recipientCount > 0 ? (msg.openCount / msg.recipientCount * 100) : 0 %}
						{% set clickRate = msg.recipientCount > 0 ? (msg.clickCount / msg.recipientCount * 100) : 0 %}
						<tr>
							<td class="td-bold">{{ msg.subject }}</td>
							<td class="td-date">{{ msg.sentAt|date('d/m/Y H:i') }}</td>
							<td class="td-mono">{{ msg.recipientCount }}</td>

							<td>
								<div class="progress-container">
									<div class="progress-bar bar-open" data-width="{{ openRate }}"></div>
								</div>
								<span class="rate-text">{{ openRate|number_format(1) }}%</span>
							</td>

							<td>
								<div class="progress-container">
									<div class="progress-bar bar-click" data-width="{{ clickRate }}"></div>
								</div>
								<span class="rate-text">{{ clickRate|number_format(1) }}%</span>
							</td>

							<td class="td-right">
								<button class="btn-preview" data-id="{{ msg.id }}">Aperçu</button>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="td-empty">Aucun historique de campagne trouvé.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>

	{# MODAL #}
	<div id="previewModal" class="modal">
		<div class="modal-content">
			<div class="modal-header">
				<h2 id="modalSubject" class="modal-title"></h2>
				<span class="modal-close" id="closeModal">&times;</span>
			</div>
			<div class="modal-body" id="modalBody"></div>
		</div>
	</div>

{% endblock %}

{% block javascripts %} <script src="https://cdn.jsdelivr.net/npm/chart.js" nonce="{{ csp_nonce('script') }}"></script>

	 <script nonce="{{ csp_nonce('script') }}">
			window.newsletterData = {
				campaigns: {{ messages|map(m => {id: m.id, subject: m.subject, content: m.content})|json_encode|raw }},
				rawData: {{ messages|map(m => {
					subject: m.subject,
					sentAt: m.sentAt|date('d/m'),
					recipientCount: m.recipientCount,
					openCount: m.openCount ?? 0,
					clickCount: m.clickCount ?? 0
				})|json_encode|reverse|raw }}
			};
		</script>

	 <script src="{{ asset('js/admin/newsletter/history.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
