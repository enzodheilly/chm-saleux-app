{% extends 'admin/base_admin.html.twig' %}

{% block title %}Tableau de bord
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/dashboard.css') }}">
{% endblock %}


{% block body %}

	{# ================================================================= #}
	{# 🔒 LOCK SCREEN (SI QR CODE REQUIS)                               #}
	{# ================================================================= #}

		{% if qrCodeContent is defined and qrCodeContent %}

			<div class="gatekeeper-overlay"> <div class="gatekeeper-card">

				<div class="gatekeeper-logo">
					<img src="{{ asset('images/favicon/icon2.png') }}" width="50">
				</div>

				<h1 class="gatekeeper-title">Vérification requise</h1>
				<p class="gatekeeper-subtitle">
					Scannez le code QR avec votre application 2FA pour accéder au panel administrateur.
				</p>

				<div class="gatekeeper-qr">
					<img src="{{ qr_code_data_uri(qrCodeContent) }}" alt="QR Code" width="180" height="180">
				</div>

				<form method="POST">
					<input type="text" name="auth_code" class="gatekeeper-input" placeholder="000000" autofocus autocomplete="off" maxlength="6">
					<button type="submit" class="btn-unlock">Accéder au Dashboard</button>
				</form>

				<a href="{{ path('home') }}" class="gatekeeper-back">
					Retour au site
				</a>

			</div>
		</div>

	{% else %}

		{# ================================================================= #}
		{# 📊 DASHBOARD CONTENT                                             #}
		{# ================================================================= #}

			<div class="dashboard-header"> <div>
				<h2>Bienvenue,
					{{ app.user.firstname|default('Admin') }}</h2>
				<p>Voici ce qui se passe sur votre plateforme aujourd'hui.</p>
			</div>
			<div></div>
		</div>

		{# 1. KPIs #}
		<div class="stats-grid">

			<div class="stat-card">
				<div class="stat-label">Utilisateurs</div>
				<div class="stat-value">{{ totalUsers|default(0) }}</div>
				<div class="stat-trend trend-up">
					<span class="stat-accent">{{ verifiedUsers|default(0) }}</span>
					vérifiés
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-label">Newsletter</div>
				<div class="stat-value">{{ newsletterSubscribers|default(0) }}</div>
				<div class="stat-trend trend-up">
					+{{ newSubscribersToday|default(0) }}
					aujourd'hui
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-label">Sécurité</div>
				<div class="stat-value">{{ successfulAttempts|default(0) }}</div>
				<div class="stat-trend">Connexions (24h)</div>
			</div>

			<div class="stat-card">
				<div class="stat-label">Athlètes</div>
				<div class="stat-value">{{ totalAthletes|default(0) }}</div>
				<div class="stat-trend">Actifs</div>
			</div>

		</div>

		{# 2. GRAPHIQUES & TABLEAUX #}
		<div
			class="grid-split">

			{# COLONNE GAUCHE #}
			<div>

				<div class="card">
					<div class="card-header">
						<h3 class="card-title">Trafic & Connexions (7 jours)</h3>
					</div>
					<div class="card-body">
						<canvas id="loginChart" height="80"></canvas>
					</div>
				</div>

				<div class="card">
					<div class="card-header">
						<h3 class="card-title">Dernières tentatives d'accès</h3>
					</div>
					<div class="card-body no-padding">
						<div class="table-scroll">
							<table class="clean-table">
								<thead>
									<tr>
										<th>Utilisateur</th>
										<th>IP</th>
										<th>Date</th>
										<th>Statut</th>
									</tr>
								</thead>
								<tbody>
									{% for attempt in recentAttempts|slice(0, 5) %}
										<tr>
											<td class="td-bold">{{ attempt.emailAttempt }}</td>
											<td class="td-muted">{{ attempt.ip ?? 'N/A' }}</td>
											<td>{{ attempt.createdAt|date('d/m - H:i') }}</td>
											<td>
												{% if attempt.success %}
													<span class="badge badge-success">Succès</span>
												{% else %}
													<span class="badge badge-danger">Échec</span>
												{% endif %}
											</td>
										</tr>
									{% else %}
										<tr>
											<td colspan="4" class="td-empty">
												Aucune donnée récente.
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					</div>
				</div>

			</div>

			{# COLONNE DROITE #}
			<div>

				<div class="card">
					<div class="card-header">
						<h3 class="card-title">Inscriptions Newsletter</h3>
					</div>
					<div class="card-body">
						<canvas id="newsletterChart" height="200"></canvas>
					</div>
				</div>

				<div class="card">
					<div class="card-header">
						<h3 class="card-title">Fil d'activité</h3>
					</div>
					<div class="card-body no-padding">

						{% for item in recentActivity|default([])|slice(0, 5) %}
							<div class="activity-item">
								<div class="dot"></div>
								<div>
									<div class="activity-text">{{ item.text|raw }}</div>
									<span class="activity-date">{{ item.date|date('d/m à H:i') }}</span>
								</div>
							</div>
						{% else %}
							<div class="activity-empty">
								R.A.S pour le moment.
							</div>
						{% endfor %}

					</div>
				</div>

			</div>

		</div>

	{% endif %}

{% endblock %}

{% block javascripts %}
	{% if not qrCodeContent %} <script src="https://cdn.jsdelivr.net/npm/chart.js" nonce="{{ csp_nonce('script') }}"></script>

		 <script nonce="{{ csp_nonce('script') }}">
					window.dashboardData = {
						labels7: {{ labels7|default(['L','M','M','J','V','S','D'])|json_encode|raw }},
						loginsSuccessByDay: {{ loginsSuccessByDay|default([0,0,0,0,0,0,0])|json_encode|raw }},
						newSubscribersByDay: {{ newSubscribersByDay|default([0,0,0,0,0,0,0])|json_encode|raw }}
					};
				</script>

		 <script src="{{ asset('js/admin/dashboard/index.js') }}" nonce="{{ csp_nonce('script') }}"></script>
	{% endif %}
{% endblock %}
