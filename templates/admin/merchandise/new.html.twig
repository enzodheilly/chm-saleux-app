{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouveau Produit
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/marchandise/new.css') }}">
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>New Item</h1>
			<p>Add a new item to the club shop catalogue.</p>
		</div>

		<div class="toolbar">
			<a href="{{ path('admin_merchandise_index') }}" class="btn-outline">Back to catalogue</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="card-body">
			{{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

			<div class="form-error">{{ form_errors(form) }}</div>

			<div class="form-grid">
				<div class="form-row-2">
					<div>
						<span class="tool-label">Item name</span>
						{{ form_widget(form.title, {'attr': {'class': 'input', 'placeholder': 'e.g. Club water bottle'}}) }}
						<div class="form-error">{{ form_errors(form.title) }}</div>
					</div>

					<div>
						<span class="tool-label">Price (€)</span>
						{{ form_widget(form.price, {'attr': {'class': 'input', 'placeholder': '0.00'}}) }}
						<div class="form-error">{{ form_errors(form.price) }}</div>
					</div>
				</div>

				<div>
					<span class="tool-label">Detailed description</span>
					{{ form_widget(form.description, {'attr': {'class': 'input', 'placeholder': 'Details, materials, usage tips...'}}) }}
					<div class="form-error">{{ form_errors(form.description) }}</div>
				</div>

				<div>
					<span class="tool-label">Item photo</span>
					{{ form_widget(form.image, {'attr': {'class': 'input'}}) }}
					<div class="form-error">{{ form_errors(form.image) }}</div>

					<div class="preview-box" id="preview-container">
						<img id="image-preview" src="" alt="Preview">
					</div>
				</div>

				<div class="form-actions">
					<button type="submit" class="btn-create">Save item</button>
					<a href="{{ path('admin_merchandise_index') }}" class="btn-outline">Cancel</a>
				</div>
			</div>

			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/marchandise/new.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
