{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des produits{% endblock %}

{% block stylesheets %}
<style>
    /* =================== HEADER & TOOLS =================== */
    .page-header {
        display: flex; justify-content: space-between; align-items: flex-end;
        margin-bottom: 2rem; padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--text-main); }
    .page-header p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; }

    .toolbar { display: flex; gap: 1rem; }

    .search-input {
        background: var(--bg-sidebar); border: 1px solid var(--border-color); color: var(--text-main);
        padding: 0.6rem 1rem; border-radius: 4px; min-width: 280px; font-size: 0.9rem; transition: 0.2s;
    }
    .search-input:focus { border-color: var(--accent); outline: none; }

    .btn-create {
        background: var(--text-main); color: var(--bg-body); padding: 0.6rem 1.2rem; border-radius: 4px;
        font-weight: 700; font-size: 0.85rem; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em;
        transition: 0.2s; border: none; text-decoration: none;
    }
    .btn-create:hover { opacity: 0.9; }

    /* =================== TABLEAU =================== */
    .table-wrapper { background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 6px; overflow: hidden; }
    .admin-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    
    .admin-table th {
        background: rgba(255,255,255,0.02); color: var(--text-muted); font-weight: 600; text-transform: uppercase; 
        letter-spacing: 0.05em; font-size: 0.75rem; text-align: left; padding: 1rem 1.5rem; border-bottom: 1px solid var(--border-color);
    }
    
    .admin-table td { padding: 1rem 1.5rem; border-bottom: 1px solid var(--border-color); color: var(--text-main); vertical-align: middle; }
    .admin-table tr:last-child td { border-bottom: none; }
    .admin-table tr:hover td { background: rgba(255,255,255,0.01); }

    /* Product UI */
    .product-info { display: flex; align-items: center; gap: 15px; }
    .product-img { width: 50px; height: 50px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border-color); background: var(--bg-body); }
    .no-img { width: 50px; height: 50px; border-radius: 4px; background: var(--bg-body); border: 1px dashed var(--border-color); display: flex; align-items: center; justify-content: center; font-size: 0.6rem; color: var(--text-muted); }

    .title-stack { display: flex; flex-direction: column; }
    .title-stack strong { font-size: 0.95rem; color: var(--text-main); }
    .ref-code { font-family: monospace; font-size: 0.7rem; color: var(--text-muted); margin-top: 2px; }

    .price-badge { font-family: monospace; font-weight: 700; color: #22c55e; font-size: 1rem; }

    /* Actions */
    .actions { display: flex; gap: 15px; justify-content: flex-end; }
    .act-link { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; cursor: pointer; transition: 0.2s; opacity: 0.7; background: none; border: none; padding: 0; }
    .act-link:hover { opacity: 1; text-decoration: underline; }
    .act-edit { color: var(--text-main); }
    .act-del { color: var(--danger); }

</style>
{% endblock %}

{% block body %}
<div class="dashboard-container">

    <div class="page-header">
        <div>
            <h1>Shop Catalogue</h1>
            <p>Manage the club shop items, prices, and visuals.</p>
        </div>
        <div class="toolbar">
            <input type="text" id="searchItem" class="search-input" placeholder="Search an item...">
            <a href="{{ path('admin_merchandise_new') }}" class="btn-create">+ New item</a>
        </div>
    </div>

    <div class="table-wrapper">
        <div style="overflow-x: auto;">
            <table class="admin-table" id="itemTable">
                <thead>
                    <tr>
                        <th width="35%">Item</th>
                        <th width="35%">Description</th>
                        <th width="15%">Price</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        <tr>
                            <td>
                                <div class="product-info">
                                    {% if item.image %}
                                        <img src="{{ asset('uploads/' ~ item.image) }}" alt="{{ item.title }}" class="product-img">
                                    {% else %}
                                        <div class="no-img">N/A</div>
                                    {% endif %}

                                    <div class="title-stack">
                                        <strong>{{ item.title }}</strong>
                                        <span class="ref-code">REF-{{ item.id|format("%05d") }}</span>
                                    </div>
                                </div>
                            </td>

                            <td style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.4;">
                                {{ item.description|length > 80 ? item.description|slice(0, 80) ~ '...' : item.description }}
                            </td>

                            <td>
                                <span class="price-badge">{{ item.price|number_format(2, '.', ' ') }} €</span>
                            </td>

                            <td>
                                <div class="actions">
                                    <a href="{{ path('admin_merchandise_edit', {id: item.id}) }}" class="act-link act-edit">Edit</a>

                                    <form method="post"
                                          action="{{ path('admin_merchandise_delete', {id: item.id}) }}"
                                          style="display:inline;"
                                          onsubmit="return confirm('Delete this item from the catalogue?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}">
                                        <button class="act-link act-del">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 4rem; color: var(--text-muted);">
                                No items are currently available in the shop.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
document.getElementById('searchItem').addEventListener('keyup', function() {
    const val = this.value.toLowerCase();
    const rows = document.querySelectorAll('#itemTable tbody tr');

    rows.forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(val) ? '' : 'none';
    });
});
</script>
{% endblock %}
