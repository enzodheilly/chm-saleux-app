{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier le produit{% endblock %}
{% block page_title %}Modifier le produit{% endblock %}

{% block stylesheets %}
<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
        gap: 1rem;
        flex-wrap: wrap;
    }

    .page-header h1 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: var(--text-main);
    }

    .page-header p {
        margin: 5px 0 0 0;
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    .toolbar {
        display: flex;
        gap: 0.75rem;
        align-items: flex-end;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .btn-create {
        background: var(--text-main);
        color: var(--bg-body);
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: 0.2s;
        border: none;
        text-decoration: none;
        display: inline-block;
        white-space: nowrap;
    }

    .btn-create:hover {
        opacity: 0.9;
    }

    .btn-outline {
        background: transparent;
        color: var(--text-main);
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: 0.2s;
        border: 1px solid var(--border-color);
        text-decoration: none;
        display: inline-block;
        white-space: nowrap;
        opacity: 0.9;
    }

    .btn-outline:hover {
        opacity: 1;
        border-color: var(--text-main);
    }

    .btn-danger-link {
        background: transparent;
        color: var(--danger);
        padding: 0.6rem 0;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: 0.2s;
        border: none;
        text-decoration: none;
        display: inline-block;
        white-space: nowrap;
    }

    .btn-danger-link:hover {
        opacity: 0.85;
        text-decoration: underline;
    }

    .table-wrapper {
        background: var(--bg-sidebar);
        border: 1px solid var(--border-color);
        border-radius: 6px;
    }

    .card-body {
        padding: 1.5rem;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.2rem;
        max-width: 900px;
    }

    .form-row-2 {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.2rem;
    }

    .tool-label {
        display: block;
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.35rem;
    }

    .input {
        background: transparent;
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 0.6rem 1rem;
        border-radius: 4px;
        outline: none;
        font-size: 0.9rem;
        transition: border-color 0.2s;
        width: 100%;
        box-sizing: border-box;
    }

    .input:focus {
        border-color: var(--text-main);
    }

    .input::placeholder {
        color: var(--text-muted);
        opacity: 0.6;
    }

    textarea.input {
        min-height: 120px;
        line-height: 1.5;
        resize: vertical;
    }

    input[type="file"].input {
        padding: 0.45rem;
        cursor: pointer;
    }

    input[type="file"]::file-selector-button {
        background: var(--bg-body);
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 0.35rem 0.8rem;
        margin-right: 0.8rem;
        border-radius: 4px;
        cursor: pointer;
        transition: 0.2s;
    }

    input[type="file"]::file-selector-button:hover {
        background: rgba(255,255,255,0.05);
    }

    .form-error {
        color: var(--danger);
        font-size: 0.85rem;
        margin-top: 0.35rem;
    }

    .form-error ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .img-preview-container {
        display: flex;
        gap: 20px;
        align-items: flex-start;
        margin-top: 1rem;
        flex-wrap: wrap;
    }

    .img-box {
        text-align: center;
    }

    .img-box span {
        display: block;
        font-size: 0.72rem;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 8px;
        font-weight: 600;
        letter-spacing: 0.05em;
    }

    .preview-frame {
        width: 130px;
        height: 130px;
        border-radius: 6px;
        border: 1px solid var(--border-color);
        background: var(--bg-body);
        overflow: hidden;
    }

    .preview-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    #new-preview-box .preview-frame {
        border: 1px dashed var(--accent);
    }

    .form-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 0.5rem;
    }

    .form-actions-right {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        flex-wrap: wrap;
    }

    @media (max-width: 600px) {
        .form-row-2 {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 700px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .toolbar {
            justify-content: flex-start;
            width: 100%;
        }

        .form-actions {
            align-items: flex-start;
            flex-direction: column;
        }

        .form-actions-right {
            width: 100%;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1>Edit item</h1>
        <p>Updating: <span style="font-weight: 700; color: var(--text-main);">{{ item.title }}</span></p>
    </div>

    <div class="toolbar">
        <a href="{{ path('admin_merchandise_index') }}" class="btn-outline">Back to catalogue</a>
    </div>
</div>

<div class="table-wrapper">
    <div class="card-body">
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

            <div class="form-error">{{ form_errors(form) }}</div>

            <div class="form-grid">
                <div class="form-row-2">
                    <div>
                        <span class="tool-label">Item name</span>
                        {{ form_widget(form.title, {'attr': {'class': 'input'}}) }}
                        <div class="form-error">{{ form_errors(form.title) }}</div>
                    </div>

                    <div>
                        <span class="tool-label">Price (€)</span>
                        {{ form_widget(form.price, {'attr': {'class': 'input'}}) }}
                        <div class="form-error">{{ form_errors(form.price) }}</div>
                    </div>
                </div>

                <div>
                    <span class="tool-label">Detailed description</span>
                    {{ form_widget(form.description, {'attr': {'class': 'input'}}) }}
                    <div class="form-error">{{ form_errors(form.description) }}</div>
                </div>

                <div>
                    <span class="tool-label">Photo (leave empty to keep current)</span>
                    {{ form_widget(form.image, {'attr': {'class': 'input'}}) }}
                    <div class="form-error">{{ form_errors(form.image) }}</div>

                    <div class="img-preview-container">
                        {% if item.image %}
                            <div class="img-box">
                                <span>Current</span>
                                <div class="preview-frame">
                                    <img src="{{ asset('uploads/' ~ item.image) }}" alt="Current">
                                </div>
                            </div>
                        {% endif %}

                        <div class="img-box" id="new-preview-box" style="display:none;">
                            <span>New</span>
                            <div class="preview-frame">
                                <img id="image-preview" alt="New">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button
                        type="button"
                        class="btn-danger-link"
                        onclick="if(confirm('⚠️ Permanently delete this item from the catalogue?')) document.getElementById('delete-form').submit();"
                    >
                        Delete item
                    </button>

                    <div class="form-actions-right">
                        <a href="{{ path('admin_merchandise_index') }}" class="btn-outline">Exit</a>
                        <button type="submit" class="btn-create">Update</button>
                    </div>
                </div>
            </div>

        {{ form_end(form) }}
    </div>
</div>

<form id="delete-form"
      method="post"
      action="{{ path('admin_merchandise_delete', {id: item.id}) }}"
      style="display: none;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}">
</form>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener("DOMContentLoaded", () => {
    const input = document.querySelector("input[type='file']");
    const preview = document.getElementById("image-preview");
    const previewBox = document.getElementById("new-preview-box");

    if (input && preview && previewBox) {
        input.addEventListener("change", function() {
            const file = this.files[0];

            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    previewBox.style.display = "block";
                };
                reader.readAsDataURL(file);
            } else {
                preview.src = "";
                previewBox.style.display = "none";
            }
        });
    }
});
</script>
{% endblock %}