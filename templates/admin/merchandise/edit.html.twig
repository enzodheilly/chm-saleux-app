{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier le produit
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/marchandise/global.css') }}">
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Edit item</h1>
			<p>Updating:
				<span class="item-title-highlight">{{ item.title }}</span>
			</p>
		</div>

		<div class="toolbar">
			<a href="{{ path('admin_merchandise_index') }}" class="btn-outline">Back to catalogue</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="card-body">
			{{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

			<div class="form-error">{{ form_errors(form) }}</div>

			<div class="form-grid">
				<div class="form-row-2">
					<div>
						<span class="tool-label">Item name</span>
						{{ form_widget(form.title, {'attr': {'class': 'input'}}) }}
						<div class="form-error">{{ form_errors(form.title) }}</div>
					</div>

					<div>
						<span class="tool-label">Price (€)</span>
						{{ form_widget(form.price, {'attr': {'class': 'input'}}) }}
						<div class="form-error">{{ form_errors(form.price) }}</div>
					</div>
				</div>

				<div>
					<span class="tool-label">Detailed description</span>
					{{ form_widget(form.description, {'attr': {'class': 'input'}}) }}
					<div class="form-error">{{ form_errors(form.description) }}</div>
				</div>

				<div>
					<span class="tool-label">Photo (leave empty to keep current)</span>
					{{ form_widget(form.image, {'attr': {'class': 'input'}}) }}
					<div class="form-error">{{ form_errors(form.image) }}</div>

					<div class="img-preview-container">
						{% if item.image %}
							<div class="img-box">
								<span>Current</span>
								<div class="preview-frame">
									<img src="{{ asset('uploads/' ~ item.image) }}" alt="Current">
								</div>
							</div>
						{% endif %}

						<div class="img-box form-hidden" id="new-preview-box">
							<span>New</span>
							<div class="preview-frame">
								<img id="image-preview" alt="New">
							</div>
						</div>
					</div>
				</div>

				<div class="form-actions">
					<button type="button" class="btn-danger-link" data-confirm="⚠️ Permanently delete this item from the catalogue?" data-submit="delete-form">
						Delete item
					</button>

					<div class="form-actions-right">
						<a href="{{ path('admin_merchandise_index') }}" class="btn-outline">Exit</a>
						<button type="submit" class="btn-create">Update</button>
					</div>
				</div>
			</div>

			{{ form_end(form) }}
		</div>
	</div>

	<form id="delete-form" method="post" action="{{ path('admin_merchandise_delete', {id: item.id}) }}" class="form-hidden">
		<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}">
	</form>
{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/marchandise/edit.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
