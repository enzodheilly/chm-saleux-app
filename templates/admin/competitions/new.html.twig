{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouvelle compétition
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/competitions/new.css') }}">
{% endblock %}

{% block body %}
	<div class="dashboard-container">

		<div id="athletes-data" data-athletes="{{ athletesJson|default('[]')|e('html_attr') }}" style="display:none;"></div>

		<div class="page-header">
			<h1>New competition</h1>
			<p>Create an event and enter results.</p>
		</div>

		<div class="form-card">
			<form id="competitionForm" action="{{ path('admin_competition_new') }}" method="POST" enctype="multipart/form-data">

				<input type="hidden" name="_token" value="{{ csrf_token('competition_new') }}">


				<div class="row-2">
					<div>
						<label class="form-label">Title</label>
						<input type="text" name="title" class="form-control" required placeholder="e.g. Open de France">
					</div>
					<div>
						<label class="form-label">Type</label>
						<input type="text" name="competitionType" class="form-control" placeholder="e.g. Qualifier">
					</div>
				</div>

				<div class="row-3" style="margin-top: 1.5rem;">
					<div>
						<label class="form-label">Date</label>
						{# datetime-local => parfait pour eventDate (datetime) #}
						<input type="datetime-local" name="eventDate" class="form-control" required>
					</div>
					<div>
						<label class="form-label">Location</label>
						<input type="text" name="location" class="form-control" required>
					</div>
					<div>
						<label class="form-label" style="color: var(--accent);">Team Gender (Filter)</label>
						{# IMPORTANT: on garde male/female. Vide = mixed / all #}
						<select id="genderSelect" name="gender" class="form-control" required>
							<option value="" disabled selected>-- Choose --</option>
							<option value="male">Male (Men)</option>
							<option value="female">Female (Women)</option>
							<option value="">Mixed (All)</option>
						</select>
					</div>
				</div>

				<div class="row-2" style="margin-top: 1.5rem;">
					<div>
						<label class="form-label">Team ranking</label>
						<input type="text" name="teamRanking" class="form-control" placeholder="e.g. 1st">
					</div>
					<div>
						<label class="form-label">Poster</label>
						<input type="file" name="image" class="form-control">
					</div>
				</div>

				<h3 class="form-section-title">Results</h3>

				<div class="results-wrapper">
					<table class="result-table" id="resultsTable">
						<thead>
							<tr>
								<th width="20%" style="color:var(--accent);">★ Quick select</th>
								<th width="12%">Last name</th>
								<th width="12%">First name</th>
								<th width="10%">Category</th>
								<th width="10%">Weight class</th>
								<th width="8%">Snatch</th>
								<th width="8%">C&J</th>
								<th width="8%">Total</th>
								<th width="8%">Points</th>
								<th width="8%">BW</th>
								<th width="8%">Level</th>
								<th width="4%"></th>
							</tr>
						</thead>
						<tbody></tbody>
					</table>
				</div>

				<button type="button" class="btn-add-row" id="addResultBtn">+ Add a row</button>

				<div class="form-actions">
					<a href="{{ path('admin_competition_index') }}" class="btn-cancel">Cancel</a>
					<button type="submit" class="btn-save">Save</button>
				</div>

			</form>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/competitions/new.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
