{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouvelle compétition
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/competitions/global.css') }}">
{% endblock %}

{% block body %}
	{# ✅ Pas de div wrapper ici non plus #}
	<div id="athletes-data" data-athletes="{{ athletesJson|default('[]')|e('html_attr') }}" class="data-hidden"></div>

	<div class="page-header">
		<div>
			<h1>New competition</h1>
			<p>Create an event and enter results.</p>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="card-body">
			<form id="competitionForm" action="{{ path('admin_competition_new') }}" method="POST" enctype="multipart/form-data">
				<input type="hidden" name="_token" value="{{ csrf_token('competition_new') }}">

				<div class="row-2">
					<div>
						<label class="tool-label">Title</label>
						<input type="text" name="title" class="input" required placeholder="e.g. Open de France">
					</div>
					<div>
						<label class="tool-label">Type</label>
						<input type="text" name="competitionType" class="input" placeholder="e.g. Qualifier">
					</div>
				</div>

				<div class="row-3 mt-form">
					<div>
						<label class="tool-label">Date</label>
						<input type="datetime-local" name="eventDate" class="input" required>
					</div>
					<div>
						<label class="tool-label">Location</label>
						<input type="text" name="location" class="input" required>
					</div>
					<div>
						<label class="tool-label form-label-accent">Team Gender (Filter)</label>
						<select id="genderSelect" name="gender" class="input" required>
							<option value="" disabled selected>-- Choose --</option>
							<option value="male">Male (Men)</option>
							<option value="female">Female (Women)</option>
							<option value="">Mixed (All)</option>
						</select>
					</div>
				</div>

				<div class="row-2 mt-form">
					<div>
						<label class="tool-label">Team ranking</label>
						<input type="text" name="teamRanking" class="input" placeholder="e.g. 1st">
					</div>
					<div>
						<label class="tool-label">Poster</label>
						<input type="file" name="image" class="input">
					</div>
				</div>

				<div class="mt-form">
					<label class="tool-label">Description</label>
					<textarea name="description" class="input" rows="4" placeholder="Décrivez la compétition..."></textarea>
				</div>

				<h3 class="form-section-title">Results</h3>

				<div class="results-wrapper">
					<table class="result-table" id="resultsTable">
						<thead>
							<tr>
								<th width="20%" class="th-accent">★ Quick select</th>
								<th>Last name</th>
								<th>First name</th>
								<th>Category</th>
								<th>Weight</th>
								<th>Snatch</th>
								<th>C&J</th>
								<th>Total</th>
								<th>Points</th>
								<th>BW</th>
								<th>Level</th>
								<th></th>
							</tr>
						</thead>
						<tbody></tbody>
					</table>
				</div>

				<button type="button" class="btn-add-row" id="addResultBtn">+ Add a row</button>

				<div class="form-actions">
					<a href="{{ path('admin_competition_index') }}" class="btn-cancel">Cancel</a>
					<button type="submit" class="btn-create">Save</button>
				</div>
			</form>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/competitions/new.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
