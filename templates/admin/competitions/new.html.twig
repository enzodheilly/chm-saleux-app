{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouvelle compétition{% endblock %}

{% block stylesheets %}
<style>
    /* =================== PAGE STYLE =================== */
    .dashboard-container { width: 100%; max-width: 1400px; margin: 0 auto; }

    /* Header */
    .page-header { margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: flex-end; }
    .page-header h1 { margin: 0; font-size: 1.6rem; font-weight: 700; color: var(--text-main); }
    .page-header p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; }

    /* Card */
    .form-card { background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 6px; padding: 2rem; }
    .form-section-title { font-size: 1rem; font-weight: 700; color: var(--text-main); margin: 2rem 0 1rem 0; padding-bottom: 0.5rem; border-bottom: 1px dashed var(--border-color); text-transform: uppercase; letter-spacing: 0.05em; }

    /* Inputs Généraux */
    .form-label { display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
    .form-control { width: 100%; background: var(--bg-body); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.6rem 0.8rem; border-radius: 4px; font-size: 0.9rem; transition: 0.2s; box-sizing: border-box; }
    .form-control:focus { border-color: var(--accent); outline: none; }

    /* Grids */
    .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; }
    @media(max-width: 900px) { .row-2, .row-3 { grid-template-columns: 1fr; gap: 1rem; } }

    /* Results Table */
    .results-wrapper { overflow-x: auto; margin-bottom: 1rem; border: 1px solid var(--border-color); border-radius: 4px; background: var(--bg-body); }
    .result-table { width: 100%; border-collapse: collapse; min-width: 1100px; font-size: 0.85rem; }
    .result-table th { background: var(--bg-sidebar); padding: 0.8rem; text-align: left; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; border-bottom: 1px solid var(--border-color); }
    .result-table td { padding: 0.4rem; border-bottom: 1px solid var(--border-color); }
    
    /* --- CORRECTION CONTRASTE INPUTS --- */
    /* On force un fond gris foncé et du texte clair pour les inputs du tableau */
    .result-table input, .result-table select { 
        width: 100%; 
        background: #2a2d35; /* Gris foncé distinct du fond noir */
        border: 1px solid #3f424a; 
        color: #ffffff; /* Texte Blanc */
        padding: 0.5rem; 
        font-size: 0.85rem; 
        border-radius: 4px; 
    }
    .result-table input:hover, .result-table select:hover { border-color: var(--text-muted); }
    .result-table input:focus, .result-table select:focus { border-color: var(--accent); background: #32353e; outline: none; }
    /* Fin correction contraste */

    /* Buttons */
    .btn-add-row { background: var(--bg-sidebar); border: 1px dashed var(--border-color); color: var(--text-muted); padding: 0.8rem; width: 100%; cursor: pointer; border-radius: 4px; margin-top: 10px; transition: 0.2s; }
    .btn-add-row:hover { border-color: var(--accent); color: var(--accent); background: rgba(255,102,0,0.05); }
    
    .btn-remove { background: rgba(239, 68, 68, 0.1); color: var(--danger); border: none; width: 24px; height: 24px; border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-weight: 700; }
    .btn-remove:hover { background: var(--danger); color: white; }

    .form-actions { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 1rem; }
    .btn-cancel { padding: 0.7rem 1.2rem; color: var(--text-muted); font-weight: 600; text-decoration: none; border-radius: 4px; }
    .btn-save { background: var(--text-main); color: var(--bg-body); padding: 0.7rem 1.5rem; border-radius: 4px; font-weight: 700; border: none; cursor: pointer; }
    .btn-save:hover { opacity: 0.9; }
</style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    
    <div id="athletes-data" data-athletes="{{ athletesJson|default('[]')|e('html_attr') }}" style="display:none;"></div>

    <div class="page-header">
        <h1>Nouvelle compétition</h1>
        <p>Création d'événement et saisie des résultats.</p>
    </div>

    <div class="form-card">
        <form action="{{ path('admin_competition_new') }}" method="POST" enctype="multipart/form-data">
            
            <div class="row-2">
                <div>
                    <label class="form-label">Titre</label>
                    <input type="text" name="titre" class="form-control" required placeholder="Ex: Open de France">
                </div>
                <div>
                    <label class="form-label">Type</label>
                    <input type="text" name="type" class="form-control" placeholder="Ex: Qualificatif">
                </div>
            </div>

            <div class="row-3" style="margin-top: 1.5rem;">
                <div>
                    <label class="form-label">Date</label>
                    <input type="date" name="date" class="form-control" required>
                </div>
                <div>
                    <label class="form-label">Lieu</label>
                    <input type="text" name="lieu" class="form-control" required>
                </div>
                <div>
                    <label class="form-label" style="color: var(--accent);">Genre Équipe (Filtre)</label>
                    <select id="equipeSelect" name="equipe" class="form-control" required>
                        <option value="" disabled selected>-- Choisir --</option>
                        <option value="male">Masculine (Hommes)</option>
                        <option value="female">Féminine (Femmes)</option>
                        <option value="mixed">Mixte (Tous)</option>
                    </select>
                </div>
            </div>

            <div class="row-2" style="margin-top: 1.5rem;">
                <div>
                    <label class="form-label">Classement Équipe</label>
                    <input type="text" name="classementEquipe" class="form-control" placeholder="Ex: 1er">
                </div>
                <div>
                    <label class="form-label">Affiche</label>
                    <input type="file" name="image" class="form-control">
                </div>
            </div>

            <h3 class="form-section-title">Résultats</h3>
            
            <div class="results-wrapper">
                <table class="result-table" id="resultsTable">
                    <thead>
                        <tr>
                            <th width="20%" style="color:var(--accent);">★ Sélection Rapide</th>
                            <th width="12%">Nom</th>
                            <th width="12%">Prénom</th>
                            <th width="10%">Catégorie</th>
                            <th width="10%">Poids</th>
                            <th width="8%">Arraché</th>
                            <th width="8%">Ép-Jeté</th>
                            <th width="8%">Total</th>
                            <th width="8%">Points</th>
                            <th width="4%"></th>
                        </tr>
                    </thead>
                    <tbody>
                        </tbody>
                </table>
            </div>
            
            <button type="button" class="btn-add-row" id="addResultBtn">+ Ajouter une ligne</button>

            <div class="form-actions">
                <a href="{{ path('admin_competition_index') }}" class="btn-cancel">Annuler</a>
                <button type="submit" class="btn-save">Enregistrer</button>
            </div>

        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
    // 1. CHARGEMENT DONNÉES
    const rawData = document.getElementById('athletes-data').dataset.athletes;
    let allAthletes = [];
    try {
        allAthletes = JSON.parse(rawData);
    } catch(e) { console.error("JSON Error", e); }

    const equipeSelect = document.getElementById('equipeSelect');
    const tableBody = document.querySelector('#resultsTable tbody');
    const addBtn = document.getElementById('addResultBtn');
    let counter = 0;

    // --- FONCTION : Récupérer les ID déjà utilisés dans le tableau ---
    function getUsedIds() {
        const selects = document.querySelectorAll('.js-athlete-select');
        const used = [];
        selects.forEach(select => {
            if (select.value !== "") {
                used.push(parseInt(select.value));
            }
        });
        return used;
    }

    // --- LOGIQUE DE FILTRAGE + EXCLUSION ---
    function generateOptionsHTML(currentValue = null, usedIds = []) {
        const teamType = equipeSelect.value;
        let html = '<option value="">-- Sélectionner --</option>';
        
        // 1. Filtre par équipe (Genre)
        let filtered = allAthletes;
        if (teamType && teamType !== 'mixed') {
            filtered = allAthletes.filter(athlete => {
                const genre = (athlete.sexe || athlete.genre || athlete.equipe || '').toLowerCase();
                if (teamType === 'male') return ['m','h','homme','masculin','male'].some(s => genre.includes(s));
                if (teamType === 'female') return ['f','femme','feminin','female'].some(s => genre.includes(s));
                return true;
            });
        }

        // 2. Filtre anti-doublon (Exclusion)
        // On affiche l'athlète SI :
        // - Il n'est PAS dans la liste des ID utilisés
        // - OU C'est l'athlète actuellement sélectionné sur CETTE ligne (sinon il disparaîtrait)
        filtered.forEach(a => {
            const isUsedElsewhere = usedIds.includes(a.id);
            const isCurrentSelection = (currentValue && parseInt(currentValue) === a.id);

            if (!isUsedElsewhere || isCurrentSelection) {
                const selected = isCurrentSelection ? 'selected' : '';
                html += `<option value="${a.id}" ${selected}
                    data-nom="${a.nom}" 
                    data-prenom="${a.prenom}" 
                    data-cat="${a.categorie || ''}" 
                    data-poids="${a.categoriePoids || ''}">
                    ${a.nom} ${a.prenom}
                </option>`;
            }
        });
        return html;
    }

    // --- MISE À JOUR MASSIVE ---
    // Cette fonction recharge TOUTES les listes déroulantes pour mettre à jour les exclusions
    function updateAllDropdowns() {
        const selects = document.querySelectorAll('.js-athlete-select');
        const usedIds = getUsedIds(); // On récupère la liste complète des ID pris

        selects.forEach(select => {
            const currentVal = select.value;
            // On regénère le HTML en passant la valeur actuelle (pour la garder) et la liste des exclus
            select.innerHTML = generateOptionsHTML(currentVal, usedIds);
        });
    }

    // --- AJOUT DE LIGNE ---
    function addRow() {
        const tr = document.createElement('tr');
        // Au moment de créer, on génère la liste en tenant compte des exclus actuels
        const options = generateOptionsHTML(null, getUsedIds());

        tr.innerHTML = `
            <td>
                <select class="js-athlete-select" style="font-weight:600;">
                    ${options}
                </select>
            </td>
            <td><input type="text" name="results[${counter}][nom]" class="input-nom" required></td>
            <td><input type="text" name="results[${counter}][prenom]" class="input-prenom" required></td>
            <td><input type="text" name="results[${counter}][categorie]" class="input-cat"></td>
            <td><input type="text" name="results[${counter}][categoriePoids]" class="input-poids"></td>
            <td><input type="number" step="1" name="results[${counter}][arracher]" class="calc-input"></td>
            <td><input type="number" step="1" name="results[${counter}][epauleJete]" class="calc-input"></td>
            <td><input type="number" step="1" name="results[${counter}][total]" class="total-output" readonly tabindex="-1" style="opacity:0.7;"></td>
            <td><input type="number" step="0.01" name="results[${counter}][point]"></td>
            <td style="text-align:center;"><button type="button" class="btn-remove">×</button></td>
        `;
        tableBody.appendChild(tr);
        counter++;
        
        // Pas besoin d'update all ici car la nouvelle ligne prend déjà en compte les autres
    }

    // --- LISTENERS ---

    // 1. Changement du genre de l'équipe -> Reset et mise à jour
    equipeSelect.addEventListener('change', () => {
        // Optionnel : vider les sélections pour éviter les incohérences Homme/Femme
        document.querySelectorAll('.js-athlete-select').forEach(s => s.value = "");
        updateAllDropdowns();
    });

    // 2. Event Delegation
    tableBody.addEventListener('change', (e) => {
        const target = e.target;
        const row = target.closest('tr');

        // Remplissage Auto + Mise à jour des exclusions
        if (target.classList.contains('js-athlete-select')) {
            const opt = target.selectedOptions[0];
            if (target.value) {
                row.querySelector('.input-nom').value = opt.dataset.nom;
                row.querySelector('.input-prenom').value = opt.dataset.prenom;
                row.querySelector('.input-cat').value = opt.dataset.cat;
                row.querySelector('.input-poids').value = opt.dataset.poids;
            }
            // IMPORTANT : On a choisi quelqu'un, il faut le retirer des autres listes !
            updateAllDropdowns();
        }

        // Calcul Total
        if (target.classList.contains('calc-input')) {
            const inputs = row.querySelectorAll('.calc-input');
            const arr = parseFloat(inputs[0].value) || 0;
            const epj = parseFloat(inputs[1].value) || 0;
            row.querySelector('.total-output').value = (arr + epj) > 0 ? (arr + epj) : '';
        }
    });

    // 3. Suppression ligne
    tableBody.addEventListener('click', (e) => {
        if (e.target.classList.contains('btn-remove')) {
            // Pas de confirm pour aller plus vite, ou alors un simple
            e.target.closest('tr').remove();
            // IMPORTANT : On libère l'athlète supprimé, donc on met à jour les listes
            updateAllDropdowns();
        }
    });

    // 4. Init
    addBtn.addEventListener('click', addRow);
    addRow(); 
});
</script>
{% endblock %}