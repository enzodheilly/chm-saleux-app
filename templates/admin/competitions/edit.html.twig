{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier la compétition{% endblock %}

{% block stylesheets %}
<style>
    /* =================== STYLES GENERAUX =================== */
    .dashboard-container { width: 100%; max-width: 1400px; margin: 0 auto; }
    .page-header { margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: flex-end; }
    .page-header h1 { margin: 0; font-size: 1.6rem; font-weight: 700; color: var(--text-main); }
    .page-header p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; }

    .form-card { background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 6px; padding: 2rem; }
    
    label { display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
    input, select { width: 100%; background: var(--bg-body); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.6rem 0.8rem; border-radius: 4px; font-size: 0.9rem; transition: 0.2s; box-sizing: border-box; }
    input:focus, select:focus { border-color: var(--accent); outline: none; }

    .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; }
    @media(max-width: 900px) { .row-2, .row-3 { grid-template-columns: 1fr; gap: 1rem; } }

    /* =================== TABLEAU DE RESULTATS =================== */
    .results-wrapper { overflow-x: auto; margin-top: 2rem; border: 1px solid var(--border-color); border-radius: 4px; background: var(--bg-body); }
    .result-table { width: 100%; border-collapse: collapse; min-width: 1100px; font-size: 0.85rem; }
    
    .result-table th { background: var(--bg-sidebar); padding: 0.8rem; text-align: left; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; border-bottom: 1px solid var(--border-color); }
    .result-table td { padding: 0.4rem; border-bottom: 1px solid var(--border-color); }

    /* INPUTS TABLEAU (Correction contraste) */
    .result-table input, .result-table select {
        background: #2a2d35; /* Gris foncé */
        border: 1px solid #3f424a;
        color: #ffffff; /* Blanc */
    }
    .result-table input:focus, .result-table select:focus {
        background: #32353e;
        border-color: var(--accent);
    }
    
    /* BOUTONS */
    .btn-add-row { background: var(--bg-sidebar); border: 1px dashed var(--border-color); color: var(--text-muted); padding: 0.8rem; width: 100%; cursor: pointer; border-radius: 4px; margin-top: 10px; transition: 0.2s; }
    .btn-add-row:hover { border-color: var(--accent); color: var(--accent); background: rgba(255,102,0,0.05); }
    
    .btn-remove { background: rgba(239, 68, 68, 0.1); color: var(--danger); border: none; width: 24px; height: 24px; border-radius: 4px; cursor: pointer; font-weight: 700; display:flex; align-items:center; justify-content:center; }
    .btn-remove:hover { background: var(--danger); color: white; }

    .form-actions { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; }
    .btn-cancel { padding: 0.7rem 1.2rem; color: var(--text-muted); font-weight: 600; text-decoration: none; }
    .btn-save { background: var(--text-main); color: var(--bg-body); padding: 0.7rem 1.5rem; border-radius: 4px; font-weight: 700; border: none; cursor: pointer; }
    .btn-delete { color: var(--danger); background: none; border: none; font-weight: 600; cursor: pointer; }
</style>
{% endblock %}

{% block body %}
<div class="dashboard-container">

    <div id="athletes-data" data-athletes="{{ athletesJson|default('[]')|e('html_attr') }}" style="display:none;"></div>

    <div class="page-header">
        <h1>Edit competition</h1>
        <p>Editing: {{ competition.title }}</p>
    </div>

    <div class="form-card">
        <form id="competitionEditForm" action="{{ path('admin_competition_edit', {id: competition.id}) }}" method="POST" enctype="multipart/form-data">

            <div class="row-2">
                <div>
                    <label>Title</label>
                    <input type="text" name="title" value="{{ competition.title }}" required>
                </div>
                <div>
                    <label>Type</label>
                    <input type="text" name="competitionType" value="{{ competition.competitionType }}">
                </div>
            </div>

            <div class="row-3" style="margin-top: 1.5rem;">
                <div>
                    <label>Date</label>
                    {# eventDate est datetime => datetime-local #}
                    <input type="datetime-local" name="eventDate" value="{{ competition.eventDate ? competition.eventDate|date('Y-m-d\\TH:i') : '' }}" required>
                </div>
                <div>
                    <label>Location</label>
                    <input type="text" name="location" value="{{ competition.location }}" required>
                </div>
                <div>
                    <label style="color:var(--accent);">Team Gender (Filter)</label>
                    <select id="genderSelect" name="gender" required>
                        <option value="male" {% if competition.gender == 'male' %}selected{% endif %}>Male</option>
                        <option value="female" {% if competition.gender == 'female' %}selected{% endif %}>Female</option>
                        <option value="" {% if competition.gender is empty %}selected{% endif %}>Mixed (All)</option>
                    </select>
                </div>
            </div>

            <div class="row-2" style="margin-top: 1.5rem;">
                <div>
                    <label>Team ranking</label>
                    <input type="text" name="teamRanking" value="{{ competition.teamRanking }}">
                </div>
                <div>
                    <label>Image (Optional)</label>
                    <input type="file" name="image">
                    {% if competition.image %}
                        <div style="font-size:0.8rem; color:var(--text-muted); margin-top:5px;">
                            Current: {{ competition.image }}
                        </div>
                    {% endif %}
                </div>
            </div>

            <h3 style="margin-top: 2rem; color: var(--text-main); font-size:1rem; border-bottom:1px dashed var(--border-color); padding-bottom:0.5rem;">
                RESULTS
            </h3>

            <div class="results-wrapper">
                <table class="result-table" id="resultsTable">
                    <thead>
                        <tr>
                            <th width="20%" style="color:var(--accent);">★ Quick select</th>
                            <th width="12%">Last name</th>
                            <th width="12%">First name</th>
                            <th width="10%">Category</th>
                            <th width="10%">Weight class</th>
                            <th width="8%">Snatch</th>
                            <th width="8%">C&amp;J</th>
                            <th width="8%">Total</th>
                            <th width="8%">Points</th>
                            <th width="8%">BW</th>
                            <th width="10%">Level</th>
                            <th width="5%"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for index, result in competition.results %}
                        <tr class="result-row">
                            <td>
                                {# data-init pour retrouver l’athlète dans le JSON #}
                                <select class="js-athlete-select"
                                        data-init-last-name="{{ result.lastName }}"
                                        data-init-first-name="{{ result.firstName }}">
                                </select>
                            </td>

                            <td><input type="text" name="results[{{ index }}][lastName]" class="input-last-name" value="{{ result.lastName }}"></td>
                            <td><input type="text" name="results[{{ index }}][firstName]" class="input-first-name" value="{{ result.firstName }}"></td>
                            <td><input type="text" name="results[{{ index }}][category]" class="input-category" value="{{ result.category }}"></td>
                            <td><input type="text" name="results[{{ index }}][weightClass]" class="input-weight-class" value="{{ result.weightClass }}"></td>

                            <td><input type="number" step="1" min="0" name="results[{{ index }}][snatch]" class="calc-input" value="{{ result.snatch }}"></td>
                            <td><input type="number" step="1" min="0" name="results[{{ index }}][cleanAndJerk]" class="calc-input" value="{{ result.cleanAndJerk }}"></td>

                            {# total affiché uniquement, pas envoyé #}
                            <td><input type="number" step="1" class="total-output" value="{{ result.total }}" readonly tabindex="-1" style="opacity:0.7;"></td>

                            <td><input type="number" step="0.01" min="0" name="results[{{ index }}][points]" value="{{ result.points }}"></td>
                            <td><input type="number" step="0.01" min="0" name="results[{{ index }}][bodyWeight]" value="{{ result.bodyWeight }}"></td>
                            <td><input type="text" name="results[{{ index }}][rankingLevel]" value="{{ result.rankingLevel }}"></td>

                            <td style="text-align:center;"><button type="button" class="btn-remove">×</button></td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <button type="button" class="btn-add-row" id="addResultBtn">+ Add a row</button>

            <div class="form-actions">
                <button type="button" class="btn-delete"
                        onclick="if(confirm('Delete this event?')) document.getElementById('del-form').submit();">
                    Delete
                </button>
                <div style="display:flex; gap:10px;">
                    <a href="{{ path('admin_competition_index') }}" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn-save">Update</button>
                </div>
            </div>
        </form>
    </div>

    <form id="del-form" method="post" action="{{ path('admin_competition_delete', {id: competition.id}) }}" style="display:none;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ competition.id) }}">
    </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // =========================================================
    // DATA LOAD
    // =========================================================
    const rawData = document.getElementById('athletes-data')?.dataset?.athletes || '[]';
    let allAthletes = [];
    try { allAthletes = JSON.parse(rawData); } catch(e) { console.error("JSON Error", e); }

    const genderSelect = document.getElementById('genderSelect');
    const tableBody = document.querySelector('#resultsTable tbody');
    const addBtn = document.getElementById('addResultBtn');
    let counter = tableBody.querySelectorAll('tr').length;

    // Helpers (support old + new athlete JSON keys)
    const getGender = (a) => String(a.gender ?? a.equipe ?? a.sexe ?? a.genre ?? '').toLowerCase();
    const getFirstName = (a) => (a.firstName ?? a.prenom ?? '').toString();
    const getLastName  = (a) => (a.lastName ?? a.nom ?? '').toString();
    const getCategory  = (a) => (a.category ?? a.categorie ?? '').toString();
    const getWeightClass = (a) => (a.weightClass ?? a.categoriePoids ?? '').toString();

    // =========================================================
    // INIT: match existing rows to athlete ids (by name)
    // =========================================================
    function matchRowsToIds() {
        const selects = document.querySelectorAll('.js-athlete-select');

        selects.forEach(select => {
            const initLN = (select.dataset.initLastName || '').trim().toLowerCase();
            const initFN = (select.dataset.initFirstName || '').trim().toLowerCase();

            if (initLN && initFN) {
                const found = allAthletes.find(a =>
                    getLastName(a).trim().toLowerCase() === initLN &&
                    getFirstName(a).trim().toLowerCase() === initFN
                );

                if (found) {
                    select.dataset.selectedId = found.id;
                }
            }
        });
    }

    function getAllSelectedIds() {
        const ids = [];
        document.querySelectorAll('.js-athlete-select').forEach(select => {
            const val = select.value || select.dataset.selectedId;
            if (val) ids.push(parseInt(val, 10));
        });
        return ids;
    }

    function renderDropdowns() {
        const teamType = genderSelect.value; // male | female | '' (mixed)
        const usedIds = getAllSelectedIds();
        const selects = document.querySelectorAll('.js-athlete-select');

        selects.forEach(select => {
            const currentId = select.value
                ? parseInt(select.value, 10)
                : (select.dataset.selectedId ? parseInt(select.dataset.selectedId, 10) : null);

            let optionsHTML = '<option value="">-- Select --</option>';

            allAthletes.forEach(a => {
                // 1) gender filter
                const g = getGender(a);
                let matchTeam = true;
                if (teamType === 'male') {
                    matchTeam = ['m','h','homme','masculin','male'].some(s => g.includes(s));
                } else if (teamType === 'female') {
                    matchTeam = ['f','femme','feminin','female'].some(s => g.includes(s));
                }

                // 2) exclude duplicates except current row
                const isAvailable = !usedIds.includes(a.id) || (a.id === currentId);

                if (matchTeam && isAvailable) {
                    const selected = (a.id === currentId) ? 'selected' : '';
                    const ln = getLastName(a);
                    const fn = getFirstName(a);
                    const cat = getCategory(a);
                    const wc  = getWeightClass(a);

                    optionsHTML += `<option value="${a.id}" ${selected}
                        data-last-name="${ln.replace(/"/g, '&quot;')}"
                        data-first-name="${fn.replace(/"/g, '&quot;')}"
                        data-category="${cat.replace(/"/g, '&quot;')}"
                        data-weight-class="${wc.replace(/"/g, '&quot;')}">
                        ${ln} ${fn}
                    </option>`;
                }
            });

            select.innerHTML = optionsHTML;
        });
    }

    // =========================================================
    // Add row
    // =========================================================
    function addRow() {
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td><select class="js-athlete-select"></select></td>

            <td><input type="text" name="results[${counter}][lastName]" class="input-last-name"></td>
            <td><input type="text" name="results[${counter}][firstName]" class="input-first-name"></td>
            <td><input type="text" name="results[${counter}][category]" class="input-category"></td>
            <td><input type="text" name="results[${counter}][weightClass]" class="input-weight-class"></td>

            <td><input type="number" step="1" min="0" name="results[${counter}][snatch]" class="calc-input"></td>
            <td><input type="number" step="1" min="0" name="results[${counter}][cleanAndJerk]" class="calc-input"></td>

            <td><input type="number" step="1" class="total-output" readonly tabindex="-1" style="opacity:0.7;"></td>

            <td><input type="number" step="0.01" min="0" name="results[${counter}][points]"></td>
            <td><input type="number" step="0.01" min="0" name="results[${counter}][bodyWeight]"></td>
            <td><input type="text" name="results[${counter}][rankingLevel]"></td>

            <td style="text-align:center;"><button type="button" class="btn-remove">×</button></td>
        `;
        tableBody.appendChild(tr);
        counter++;
        renderDropdowns();
    }

    // =========================================================
    // Delegation
    // =========================================================
    tableBody.addEventListener('change', (e) => {
        const t = e.target;
        const row = t.closest('tr');
        if (!row) return;

        if (t.classList.contains('js-athlete-select')) {
            const opt = t.selectedOptions[0];

            if (t.value && opt) {
                row.querySelector('.input-last-name').value = opt.dataset.lastName || '';
                row.querySelector('.input-first-name').value = opt.dataset.firstName || '';
                row.querySelector('.input-category').value = opt.dataset.category || '';
                row.querySelector('.input-weight-class').value = opt.dataset.weightClass || '';

                t.dataset.selectedId = t.value;
            } else {
                delete t.dataset.selectedId;
            }

            renderDropdowns();
        }

        if (t.classList.contains('calc-input')) {
            const inputs = row.querySelectorAll('.calc-input');
            const snatch = parseFloat(inputs[0].value) || 0;
            const cj = parseFloat(inputs[1].value) || 0;
            const total = snatch + cj;
            row.querySelector('.total-output').value = total > 0 ? total : '';
        }
    });

    tableBody.addEventListener('click', (e) => {
        if (e.target.classList.contains('btn-remove')) {
            if (confirm('Delete this row?')) {
                e.target.closest('tr').remove();
                renderDropdowns();
            }
        }
    });

    genderSelect.addEventListener('change', () => {
        document.querySelectorAll('.js-athlete-select').forEach(s => {
            s.value = "";
            delete s.dataset.selectedId;
        });
        renderDropdowns();
    });

    // =========================================================
    // INIT
    // =========================================================
    addBtn.addEventListener('click', addRow);
    matchRowsToIds();
    renderDropdowns();
});
</script>
{% endblock %}
