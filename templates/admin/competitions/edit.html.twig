{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier la compétition{% endblock %}

{% block stylesheets %}
<style>
    /* =================== STYLES GENERAUX =================== */
    .dashboard-container { width: 100%; max-width: 1400px; margin: 0 auto; }
    .page-header { margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: flex-end; }
    .page-header h1 { margin: 0; font-size: 1.6rem; font-weight: 700; color: var(--text-main); }
    .page-header p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; }

    .form-card { background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 6px; padding: 2rem; }
    
    label { display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
    input, select { width: 100%; background: var(--bg-body); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.6rem 0.8rem; border-radius: 4px; font-size: 0.9rem; transition: 0.2s; box-sizing: border-box; }
    input:focus, select:focus { border-color: var(--accent); outline: none; }

    .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; }
    @media(max-width: 900px) { .row-2, .row-3 { grid-template-columns: 1fr; gap: 1rem; } }

    /* =================== TABLEAU DE RESULTATS =================== */
    .results-wrapper { overflow-x: auto; margin-top: 2rem; border: 1px solid var(--border-color); border-radius: 4px; background: var(--bg-body); }
    .result-table { width: 100%; border-collapse: collapse; min-width: 1100px; font-size: 0.85rem; }
    
    .result-table th { background: var(--bg-sidebar); padding: 0.8rem; text-align: left; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; border-bottom: 1px solid var(--border-color); }
    .result-table td { padding: 0.4rem; border-bottom: 1px solid var(--border-color); }

    /* INPUTS TABLEAU (Correction contraste) */
    .result-table input, .result-table select {
        background: #2a2d35; /* Gris foncé */
        border: 1px solid #3f424a;
        color: #ffffff; /* Blanc */
    }
    .result-table input:focus, .result-table select:focus {
        background: #32353e;
        border-color: var(--accent);
    }
    
    /* BOUTONS */
    .btn-add-row { background: var(--bg-sidebar); border: 1px dashed var(--border-color); color: var(--text-muted); padding: 0.8rem; width: 100%; cursor: pointer; border-radius: 4px; margin-top: 10px; transition: 0.2s; }
    .btn-add-row:hover { border-color: var(--accent); color: var(--accent); background: rgba(255,102,0,0.05); }
    
    .btn-remove { background: rgba(239, 68, 68, 0.1); color: var(--danger); border: none; width: 24px; height: 24px; border-radius: 4px; cursor: pointer; font-weight: 700; display:flex; align-items:center; justify-content:center; }
    .btn-remove:hover { background: var(--danger); color: white; }

    .form-actions { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; }
    .btn-cancel { padding: 0.7rem 1.2rem; color: var(--text-muted); font-weight: 600; text-decoration: none; }
    .btn-save { background: var(--text-main); color: var(--bg-body); padding: 0.7rem 1.5rem; border-radius: 4px; font-weight: 700; border: none; cursor: pointer; }
    .btn-delete { color: var(--danger); background: none; border: none; font-weight: 600; cursor: pointer; }
</style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    
    <div id="athletes-data" data-athletes="{{ athletesJson|default('[]')|e('html_attr') }}" style="display:none;"></div>

    <div class="page-header">
        <h1>Modifier la compétition</h1>
        <p>Édition : {{ competition.titre }}</p>
    </div>

    <div class="form-card">
        <form action="{{ path('admin_competition_edit', {id: competition.id}) }}" method="POST" enctype="multipart/form-data">
            
            <div class="row-2">
                <div>
                    <label>Titre</label>
                    <input type="text" name="titre" value="{{ competition.titre }}" required>
                </div>
                <div>
                    <label>Type</label>
                    <input type="text" name="type" value="{{ competition.type }}">
                </div>
            </div>

            <div class="row-3" style="margin-top: 1.5rem;">
                <div>
                    <label>Date</label>
                    <input type="date" name="date" value="{{ competition.date|date('Y-m-d') }}" required>
                </div>
                <div>
                    <label>Lieu</label>
                    <input type="text" name="lieu" value="{{ competition.lieu }}" required>
                </div>
                <div>
                    <label style="color:var(--accent);">Genre Équipe (Filtre)</label>
                    <select id="equipeSelect" name="equipe" required>
                        <option value="male" {% if competition.equipe == 'male' %}selected{% endif %}>Masculine</option>
                        <option value="female" {% if competition.equipe == 'female' %}selected{% endif %}>Féminine</option>
                        <option value="mixed" {% if competition.equipe == 'mixed' %}selected{% endif %}>Mixte</option>
                    </select>
                </div>
            </div>

            <div class="row-2" style="margin-top: 1.5rem;">
                <div>
                    <label>Classement Équipe</label>
                    <input type="text" name="classementEquipe" value="{{ competition.classementEquipe }}">
                </div>
                <div>
                    <label>Image (Optionnel)</label>
                    <input type="file" name="image">
                    {% if competition.image %}
                        <div style="font-size:0.8rem; color:var(--text-muted); margin-top:5px;">Actuelle : {{ competition.image }}</div>
                    {% endif %}
                </div>
            </div>

            <h3 style="margin-top: 2rem; color: var(--text-main); font-size:1rem; border-bottom:1px dashed var(--border-color); padding-bottom:0.5rem;">RÉSULTATS</h3>
            
            <div class="results-wrapper">
                <table class="result-table" id="resultsTable">
                    <thead>
                        <tr>
                            <th width="20%" style="color:var(--accent);">★ Sélection Rapide</th>
                            <th width="12%">Nom</th>
                            <th width="12%">Prénom</th>
                            <th width="10%">Catégorie</th>
                            <th width="10%">Poids</th>
                            <th width="8%">Arraché</th>
                            <th width="8%">Ép-Jeté</th>
                            <th width="8%">Total</th>
                            <th width="8%">Points</th>
                            <th width="5%"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for index, result in competition.results %}
                        <tr class="result-row">
                            <td>
                                {# IMPORTANT : On met des data-init pour que le JS retrouve l'athlète #}
                                <select class="js-athlete-select" 
                                        data-init-nom="{{ result.nom }}" 
                                        data-init-prenom="{{ result.prenom }}">
                                    </select>
                            </td>
                            <td><input type="text" name="results[{{ index }}][nom]" class="input-nom" value="{{ result.nom }}"></td>
                            <td><input type="text" name="results[{{ index }}][prenom]" class="input-prenom" value="{{ result.prenom }}"></td>
                            <td><input type="text" name="results[{{ index }}][categorie]" class="input-cat" value="{{ result.categorie }}"></td>
                            <td><input type="text" name="results[{{ index }}][categoriePoids]" class="input-poids" value="{{ result.categoriePoids }}"></td>
                            <td><input type="number" step="1" name="results[{{ index }}][arracher]" class="calc-input" value="{{ result.arracher }}"></td>
                            <td><input type="number" step="1" name="results[{{ index }}][epauleJete]" class="calc-input" value="{{ result.epauleJete }}"></td>
                            <td><input type="number" step="1" name="results[{{ index }}][total]" class="total-output" value="{{ result.total }}" readonly tabindex="-1" style="opacity:0.7;"></td>
                            <td><input type="number" step="0.01" name="results[{{ index }}][point]" value="{{ result.point }}"></td>
                            <td style="text-align:center;"><button type="button" class="btn-remove">×</button></td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            
            <button type="button" class="btn-add-row" id="addResultBtn">+ Ajouter une ligne</button>

            <div class="form-actions">
                <button type="button" class="btn-delete" onclick="if(confirm('Supprimer cet événement ?')) document.getElementById('del-form').submit();">Supprimer</button>
                <div style="display:flex; gap:10px;">
                    <a href="{{ path('admin_competition_index') }}" class="btn-cancel">Annuler</a>
                    <button type="submit" class="btn-save">Mettre à jour</button>
                </div>
            </div>
        </form>
    </div>
    
    <form id="del-form" method="post" action="{{ path('admin_competition_delete', {id: competition.id}) }}" style="display:none;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ competition.id) }}">
    </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // 1. DATA LOAD
    const rawData = document.getElementById('athletes-data').dataset.athletes;
    let allAthletes = [];
    try { allAthletes = JSON.parse(rawData); } catch(e) { console.error("JSON Error", e); }

    const equipeSelect = document.getElementById('equipeSelect');
    const tableBody = document.querySelector('#resultsTable tbody');
    const addBtn = document.getElementById('addResultBtn');
    let counter = tableBody.querySelectorAll('tr').length;

    // --- LOGIC ---
    
    // Identifie les athlètes sur les lignes existantes au chargement
    function matchRowsToIds() {
        const selects = document.querySelectorAll('.js-athlete-select');
        selects.forEach(select => {
            // On récupère le nom/prenom qui a été rendu par Twig dans les attributs data-init
            const initNom = select.dataset.initNom ? select.dataset.initNom.trim().toLowerCase() : '';
            const initPrenom = select.dataset.initPrenom ? select.dataset.initPrenom.trim().toLowerCase() : '';
            
            if(initNom && initPrenom) {
                // On cherche l'ID correspondant dans le JSON
                const found = allAthletes.find(a => 
                    a.nom.trim().toLowerCase() === initNom && 
                    a.prenom.trim().toLowerCase() === initPrenom
                );
                
                if(found) {
                    // On "marque" ce select comme ayant cet ID sélectionné
                    select.dataset.selectedId = found.id;
                }
            }
        });
    }

    // Récupère tous les IDs actuellement sélectionnés (pour l'exclusion)
    function getAllSelectedIds() {
        const ids = [];
        document.querySelectorAll('.js-athlete-select').forEach(select => {
            // Soit c'est la valeur du select (si user a changé), soit c'est le data-selected-id (chargement initial)
            const val = select.value || select.dataset.selectedId;
            if(val) ids.push(parseInt(val));
        });
        return ids;
    }

    // Génère les options HTML pour un select donné
    function renderDropdowns() {
        const teamType = equipeSelect.value;
        const usedIds = getAllSelectedIds();
        const selects = document.querySelectorAll('.js-athlete-select');

        selects.forEach(select => {
            // L'ID actuellement choisi pour CETTE ligne spécifique
            const currentId = select.value ? parseInt(select.value) : (select.dataset.selectedId ? parseInt(select.dataset.selectedId) : null);

            // Filtrage Team + Exclusion
            let optionsHTML = '<option value="">-- Sélectionner --</option>';
            
            allAthletes.forEach(a => {
                // 1. Filtre Equipe (M/F)
                const genre = (a.sexe || a.genre || a.equipe || '').toLowerCase();
                let matchTeam = true;
                if(teamType === 'male' && !['m','h','homme','masculin','male'].some(s=>genre.includes(s))) matchTeam = false;
                if(teamType === 'female' && !['f','femme','feminin','female'].some(s=>genre.includes(s))) matchTeam = false;

                // 2. Filtre Exclusion (Est-ce que cet athlète est pris ailleurs ?)
                // Il est valide SI (il n'est pas utilisé ailleurs) OU (c'est lui-même sur cette ligne)
                const isAvailable = !usedIds.includes(a.id) || (a.id === currentId);

                if(matchTeam && isAvailable) {
                    const selected = (a.id === currentId) ? 'selected' : '';
                    optionsHTML += `<option value="${a.id}" ${selected}
                        data-nom="${a.nom}" 
                        data-prenom="${a.prenom}" 
                        data-cat="${a.categorie || ''}" 
                        data-poids="${a.categoriePoids || ''}">
                        ${a.nom} ${a.prenom}
                    </option>`;
                }
            });

            select.innerHTML = optionsHTML;
        });
    }

    // --- ACTIONS ---

    // Ajout Ligne
    function addRow() {
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td><select class="js-athlete-select"></select></td>
            <td><input type="text" name="results[${counter}][nom]" class="input-nom"></td>
            <td><input type="text" name="results[${counter}][prenom]" class="input-prenom"></td>
            <td><input type="text" name="results[${counter}][categorie]" class="input-cat"></td>
            <td><input type="text" name="results[${counter}][categoriePoids]" class="input-poids"></td>
            <td><input type="number" step="1" name="results[${counter}][arracher]" class="calc-input"></td>
            <td><input type="number" step="1" name="results[${counter}][epauleJete]" class="calc-input"></td>
            <td><input type="number" step="1" name="results[${counter}][total]" class="total-output" readonly tabindex="-1" style="opacity:0.7;"></td>
            <td><input type="number" step="0.01" name="results[${counter}][point]"></td>
            <td style="text-align:center;"><button type="button" class="btn-remove">×</button></td>
        `;
        tableBody.appendChild(tr);
        counter++;
        renderDropdowns(); // Met à jour les listes
    }

    // Event Delegation
    tableBody.addEventListener('change', (e) => {
        const t = e.target;
        const row = t.closest('tr');

        // Selection Athlète
        if(t.classList.contains('js-athlete-select')) {
            const opt = t.selectedOptions[0];
            if(t.value) {
                row.querySelector('.input-nom').value = opt.dataset.nom;
                row.querySelector('.input-prenom').value = opt.dataset.prenom;
                row.querySelector('.input-cat').value = opt.dataset.cat;
                row.querySelector('.input-poids').value = opt.dataset.poids;
                // Met à jour l'ID sélectionné (pour l'exclusion)
                t.dataset.selectedId = t.value;
            } else {
                delete t.dataset.selectedId;
            }
            // IMPORTANT : Rafraîchir toutes les autres listes pour appliquer l'exclusion
            renderDropdowns();
        }

        // Calcul
        if(t.classList.contains('calc-input')) {
            const arr = parseFloat(row.querySelectorAll('.calc-input')[0].value)||0;
            const epj = parseFloat(row.querySelectorAll('.calc-input')[1].value)||0;
            row.querySelector('.total-output').value = (arr+epj)>0?(arr+epj):'';
        }
    });

    tableBody.addEventListener('click', (e) => {
        if(e.target.classList.contains('btn-remove')) {
            if(confirm('Supprimer cette ligne ?')) {
                e.target.closest('tr').remove();
                renderDropdowns(); // Libère l'athlète supprimé
            }
        }
    });

    equipeSelect.addEventListener('change', () => {
        // Reset des sélections si changement de genre radical
        document.querySelectorAll('.js-athlete-select').forEach(s => {
            s.value = ""; 
            delete s.dataset.selectedId;
        });
        renderDropdowns();
    });

    // --- INIT ---
    addBtn.addEventListener('click', addRow);
    matchRowsToIds(); // Etape 1 : Retrouver les IDs des lignes existantes
    renderDropdowns(); // Etape 2 : Générer les HTML corrects avec exclusions
});
</script>
{% endblock %}