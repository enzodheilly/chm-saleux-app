{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier la compétition
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/competitions/global.css') }}">
{% endblock %}

{% block body %}
	{# ✅ SUPPRESSION du <div class="wrapper"> car il est déjà dans base_admin #}
	<div id="athletes-data" data-athletes="{{ athletesJson|default('[]')|e('html_attr') }}" class="data-hidden"></div>

	<div class="page-header">
		<div>
			<h1>Edit competition</h1>
			<p>Editing:
				{{ competition.title }}</p>
		</div>
	</div>

	{# ✅ Utilisation de table-wrapper pour garder le fond sombre cohérent #}
	<div class="table-wrapper">
		<div class="card-body">
			<form id="competitionEditForm" action="{{ path('admin_competition_edit', {id: competition.id}) }}" method="POST" enctype="multipart/form-data">
				<input type="hidden" name="_token" value="{{ csrf_token('competition_edit_' ~ competition.id) }}">

				<div class="row-2">
					<div>
						<label class="tool-label">Title</label>
						<input type="text" name="title" class="input" value="{{ competition.title }}" required>
					</div>
					<div>
						<label class="tool-label">Type</label>
						<input type="text" name="competitionType" class="input" value="{{ competition.competitionType }}">
					</div>
				</div>

				<div class="row-3 mt-form">
					<div>
						<label class="tool-label">Date</label>
						<input type="datetime-local" name="eventDate" class="input" value="{{ competition.eventDate ? competition.eventDate|date('Y-m-d\\TH:i') : '' }}" required>
					</div>
					<div>
						<label class="tool-label">Location</label>
						<input type="text" name="location" class="input" value="{{ competition.location }}" required>
					</div>
					<div>
						<label class="tool-label form-label-accent">Team Gender (Filter)</label>
						<select id="genderSelect" name="gender" class="input" required>
							<option value="male" {% if competition.gender == 'male' %} selected {% endif %}>Male</option>
							<option value="female" {% if competition.gender == 'female' %} selected {% endif %}>Female</option>
							<option value="" {% if competition.gender is empty %} selected {% endif %}>Mixed (All)</option>
						</select>
					</div>
				</div>

				<div class="row-2 mt-form">
					<div>
						<label class="tool-label">Team ranking</label>
						<input type="text" name="teamRanking" class="input" value="{{ competition.teamRanking }}">
					</div>
					<div>
						<label class="tool-label">Poster</label>
						<input type="file" name="image" class="input">
						{% if competition.image %}
							<div class="current-file">Current:
								{{ competition.image }}</div>
						{% endif %}
					</div>
				</div>

				<div class="mt-form">
					<label class="tool-label">Description</label>
					<textarea name="description" class="input" rows="4">{{ competition.description }}</textarea>
				</div>

				<h3 class="form-section-title">Results</h3>

				<div class="results-wrapper">
					<table class="result-table" id="resultsTable">
						<thead>
							<tr>
								<th width="20%" class="th-accent">★ Quick select</th>
								<th>Last name</th>
								<th>First name</th>
								<th>Category</th>
								<th>Weight</th>
								<th>Snatch</th>
								<th>C&J</th>
								<th>Total</th>
								<th>Points</th>
								<th>BW</th>
								<th>Level</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							{% for index, result in competition.results %}
								<tr class="result-row">
									<td>
										<select class="js-athlete-select athlete-select-bold" data-init-last-name="{{ result.lastName }}" data-init-first-name="{{ result.firstName }}"></select>
									</td>
									<td><input type="text" name="results[{{ index }}][lastName]" value="{{ result.lastName }}" required></td>
									<td><input type="text" name="results[{{ index }}][firstName]" value="{{ result.firstName }}" required></td>
									<td><input type="text" name="results[{{ index }}][category]" value="{{ result.category }}"></td>
									<td><input type="text" name="results[{{ index }}][weightClass]" value="{{ result.weightClass }}"></td>
									<td><input type="number" name="results[{{ index }}][snatch]" class="calc-input" value="{{ result.snatch }}"></td>
									<td><input type="number" name="results[{{ index }}][cleanAndJerk]" class="calc-input" value="{{ result.cleanAndJerk }}"></td>
									<td><input type="number" class="total-output input-readonly" value="{{ result.total }}" readonly tabindex="-1"></td>
									<td><input type="number" step="0.01" name="results[{{ index }}][points]" value="{{ result.points }}"></td>
									<td><input type="number" step="0.01" name="results[{{ index }}][bodyWeight]" class="input-bw" value="{{ result.bodyWeight }}"></td>
									<td><input type="text" name="results[{{ index }}][rankingLevel]" value="{{ result.rankingLevel }}"></td>
									<td class="td-center">
										<button type="button" class="btn-remove">×</button>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				<button type="button" class="btn-add-row" id="addResultBtn">+ Add a row</button>

				<div class="form-actions">
					<button type="button" class="btn-delete" data-confirm="Delete this event?" data-submit="del-form">
						Delete
					</button>
					<div class="form-actions-right">
						<a href="{{ path('admin_competition_index') }}" class="btn-cancel">Cancel</a>
						<button type="submit" class="btn-create">Update</button>
					</div>
				</div>
			</form>
		</div>
	</div>

	<form id="del-form" method="post" action="{{ path('admin_competition_delete', {id: competition.id}) }}" class="form-hidden">
		<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ competition.id) }}">
	</form>
{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/competitions/edit.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
