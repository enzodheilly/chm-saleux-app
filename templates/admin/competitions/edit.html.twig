{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier la compétition{% endblock %}

{% block stylesheets %}
<style>
    /* ... Mêmes styles que NEW pour la cohérence ... */
    .dashboard-container { width: 100%; max-width: 1200px; margin: 0 auto; }
    .page-header { margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem; }
    .page-header h1 { margin: 0; font-size: 1.6rem; font-weight: 700; color: var(--text-main); letter-spacing: -0.5px; }
    .form-card { background: var(--bg-light); border: 1px solid var(--border); border-radius: 4px; padding: 2rem; }
    
    label { display: block; font-size: 0.8rem; font-weight: 700; color: var(--text-muted); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.5px; }
    input[type="text"], input[type="date"], input[type="file"], select, input[type="number"] {
        width: 100%; background: var(--bg-darker); border: 1px solid var(--border); color: var(--text-main);
        padding: 0.7rem 1rem; border-radius: 4px; font-size: 0.95rem; outline: none; transition: border-color 0.2s; box-sizing: border-box;
    }
    input:focus, select:focus { border-color: var(--accent); }

    .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; }
    
    /* Table Results */
    .results-wrapper { overflow-x: auto; margin-top: 2rem; border: 1px solid var(--border); border-radius: 4px; }
    .result-table { width: 100%; border-collapse: collapse; min-width: 1000px; }
    .result-table th { background: var(--bg-darker); padding: 0.8rem; text-align: left; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; }
    .result-table td { padding: 0.5rem; border-top: 1px solid var(--border); background: var(--bg-light); }
    
    /* Boutons */
    .form-actions { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
    .btn-submit { background: var(--accent); color: #fff; padding: 0.7rem 1.5rem; border: none; border-radius: 4px; font-weight: 600; cursor: pointer; }
    .btn-cancel { background: transparent; border: 1px solid var(--border); color: var(--text-muted); padding: 0.7rem 1.5rem; border-radius: 4px; text-decoration: none; display: inline-flex; align-items: center; }
    .btn-delete { color: #ef4444; background: none; border: none; cursor: pointer; font-weight: 500; }
    .btn-add-row { background: var(--bg-darker); border: 1px solid var(--border); color: var(--text-main); padding: 0.5rem 1rem; cursor: pointer; font-size: 0.85rem; border-radius: 4px; margin-top: 10px; }
</style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    
    <div id="athletes-data" data-athletes="{{ athletesJson|default('[]') }}" style="display:none;"></div>

    <div class="page-header">
        <h1>Modifier la compétition</h1>
        <p>Mise à jour : {{ competition.titre }}</p>
    </div>

    <div class="form-card">
        <form action="{{ path('admin_competition_edit', {id: competition.id}) }}" method="POST" enctype="multipart/form-data">
            
            <div class="row-2">
                <div>
                    <label for="titre">Titre</label>
                    <input type="text" id="titre" name="titre" required value="{{ competition.titre }}">
                </div>
                <div>
                    <label for="type">Type</label>
                    <input type="text" id="type" name="type" value="{{ competition.type }}">
                </div>
            </div>

            <div class="row-3" style="margin-top: 1.5rem;">
                <div>
                    <label for="date">Date</label>
                    <input type="date" id="date" name="date" required value="{{ competition.date|date('Y-m-d') }}">
                </div>
                <div>
                    <label for="lieu">Lieu</label>
                    <input type="text" id="lieu" name="lieu" required value="{{ competition.lieu }}">
                </div>
                <div>
                    <label for="equipe">Catégorie Équipe</label>
                    <select id="equipeSelect" name="equipe" required>
                        <option value="male" {% if competition.equipe == 'male' %}selected{% endif %}>Masculine</option>
                        <option value="female" {% if competition.equipe == 'female' %}selected{% endif %}>Féminine</option>
                    </select>
                </div>
            </div>

            <div class="row-2" style="margin-top: 1.5rem;">
                <div>
                    <label for="classementEquipe">Classement Équipe</label>
                    <input type="text" id="classementEquipe" name="classementEquipe" value="{{ competition.classementEquipe }}">
                </div>
                <div>
                    <label for="image">Nouvelle image (Optionnel)</label>
                    <input type="file" id="image" name="image" accept="image/*">
                    {% if competition.image %}
                        <div style="margin-top: 5px; font-size: 0.8rem; color: var(--text-muted);">
                            Actuelle : {{ competition.image }}
                        </div>
                    {% endif %}
                </div>
            </div>

            <h3 style="margin-top: 2rem; font-size: 1rem; color: var(--text-main);">Résultats des athlètes</h3>
            
            <div class="results-wrapper">
                <table class="result-table" id="resultsTable">
                    <thead>
                        <tr>
                            <th width="15%" style="color:var(--accent);">★ Sélection Rapide</th>
                            <th width="12%">Nom</th>
                            <th width="12%">Prénom</th>
                            <th width="8%">Catégorie</th>
                            <th width="8%">Poids</th>
                            <th width="8%">Ép-Jeté</th>
                            <th width="8%">Arraché</th>
                            <th width="8%">Total</th>
                            <th width="8%">Points</th>
                            <th width="5%">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for index, result in competition.results %}
                        <tr>
                            <td>
                                <select class="athlete-select js-athlete-filler" data-current-nom="{{ result.nom }}">
                                    </select>
                            </td>
                            <td><input type="text" name="results[{{ index }}][nom]" class="input-nom" value="{{ result.nom }}"></td>
                            <td><input type="text" name="results[{{ index }}][prenom]" class="input-prenom" value="{{ result.prenom }}"></td>
                            <td><input type="text" name="results[{{ index }}][categorie]" value="{{ result.categorie }}"></td>
                            <td><input type="text" name="results[{{ index }}][categoriePoids]" class="input-poids" value="{{ result.categoriePoids }}"></td>
                            <td><input type="number" step="1" name="results[{{ index }}][epauleJete]" value="{{ result.epauleJete }}"></td>
                            <td><input type="number" step="1" name="results[{{ index }}][arracher]" value="{{ result.arracher }}"></td>
                            <td><input type="number" step="1" name="results[{{ index }}][total]" value="{{ result.total }}"></td>
                            <td><input type="number" step="0.01" name="results[{{ index }}][point]" value="{{ result.point }}"></td>
                            <td style="text-align:center;"><button type="button" class="btn-remove" style="color:red; background:none; border:none; cursor:pointer;">X</button></td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            
            <button type="button" class="btn-add-row" id="addResultBtn">+ Ajouter un athlète</button>

            <div class="form-actions">
                <button type="button" class="btn-delete" style="border: 1px solid #ef4444; padding: 0.5rem 1rem; border-radius: 4px;"
                        onclick="if(confirm('Supprimer définitivement la compétition ?')) document.getElementById('delete-form').submit();">
                    Supprimer l'événement
                </button>

                <div style="display: flex; gap: 10px;">
                    <a href="{{ path('admin_competition_index') }}" class="btn-cancel">Annuler</a>
                    <button type="submit" class="btn-submit">Mettre à jour</button>
                </div>
            </div>
        </form>
    </div>

    <form id="delete-form" method="post" action="{{ path('admin_competition_delete', {id: competition.id}) }}" style="display: none;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ competition.id) }}">
    </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // 1. Récupération des données JSON
    const rawData = document.getElementById('athletes-data').dataset.athletes;
    let allAthletes = [];
    try {
        allAthletes = JSON.parse(rawData);
    } catch(e) { console.error("Erreur JSON", e); }

    const equipeSelect = document.getElementById('equipeSelect');
    const tableBody = document.querySelector('#resultsTable tbody');
    const addBtn = document.getElementById('addResultBtn');
    
    // On initialise le compteur basé sur le nombre de lignes existantes pour ne pas écraser les index
    let counter = tableBody.querySelectorAll('tr').length;

    // --- FONCTION 1 : Récupérer les ID déjà utilisés ---
    function getUsedIds() {
        const selects = document.querySelectorAll('.js-athlete-filler');
        const used = [];
        selects.forEach(select => {
            if (select.value !== "") {
                used.push(parseInt(select.value));
            }
        });
        return used;
    }

    // --- FONCTION 2 : Générer les options ---
    function generateOptionsHTML(selectedTeam, currentValue, usedIds) {
        let options = '<option value="">-- Saisie manuelle --</option>';
        const filtered = allAthletes.filter(a => {
            const isInTeam = a.equipe === selectedTeam;
            const isAvailable = !usedIds.includes(a.id);
            const isCurrent = a.id === currentValue;
            return isInTeam && (isAvailable || isCurrent);
        });
        
        filtered.forEach(a => {
            const poids = a.categoriePoids || '';
            const selectedAttr = (a.id === currentValue) ? 'selected' : '';
            
            options += `<option value="${a.id}" 
                data-nom="${a.nom}" 
                data-prenom="${a.prenom}"
                data-poids="${poids}"
                ${selectedAttr}>
                ${a.nom} ${a.prenom}
            </option>`;
        });
        return options;
    }

    // --- FONCTION 3 : Update global ---
    function updateAllDropdowns() {
        const selectedTeam = equipeSelect.value;
        const allSelects = document.querySelectorAll('.js-athlete-filler');
        const usedIds = getUsedIds();

        allSelects.forEach(select => {
            const currentVal = select.value ? parseInt(select.value) : null;
            select.innerHTML = generateOptionsHTML(selectedTeam, currentVal, usedIds);
        });
    }

    // --- INITIALISATION DES LIGNES EXISTANTES ---
    // Cette fonction est Spécifique à l'Edit : elle fait correspondre les noms existants avec les IDs
    function initExistingRows() {
        const selects = document.querySelectorAll('.js-athlete-filler');
        const selectedTeam = equipeSelect.value;
        const usedIds = []; // On construit la liste des ID trouvés

        // Passe 1 : Identifier les athlètes déjà présents
        selects.forEach(select => {
            const row = select.closest('tr');
            // On a mis data-current-nom dans le HTML Twig
            const currentNom = select.dataset.currentNom; 
            
            // On cherche l'ID correspondant
            const found = allAthletes.find(a => a.nom === currentNom && a.equipe === selectedTeam);
            
            if (found) {
                // On pré-set la valeur pour que updateAllDropdowns la voie
                // Note: on ne peut pas encore set select.value car les options n'existent pas
                // On stocke l'ID dans un dataset temporaire
                select.dataset.tempId = found.id;
                usedIds.push(found.id);
            }
        });

        // Passe 2 : Générer le HTML
        selects.forEach(select => {
            const currentId = select.dataset.tempId ? parseInt(select.dataset.tempId) : null;
            select.innerHTML = generateOptionsHTML(selectedTeam, currentId, usedIds);
            // Maintenant que les options sont là, on sélectionne
            if(currentId) select.value = currentId;
        });
    }

    // --- FONCTION AJOUT LIGNE ---
    function addRow() {
        const row = document.createElement('tr');
        row.innerHTML = `
            <td>
                <select class="athlete-select js-athlete-filler">
                    </select>
            </td>
            <td><input type="text" name="results[${counter}][nom]" class="input-nom" placeholder="Nom"></td>
            <td><input type="text" name="results[${counter}][prenom]" class="input-prenom" placeholder="Prénom"></td>
            <td><input type="text" name="results[${counter}][categorie]"></td>
            <td><input type="text" name="results[${counter}][categoriePoids]" class="input-poids"></td>
            <td><input type="number" step="1" name="results[${counter}][epauleJete]"></td>
            <td><input type="number" step="1" name="results[${counter}][arracher]"></td>
            <td><input type="number" step="1" name="results[${counter}][total]"></td>
            <td><input type="number" step="0.01" name="results[${counter}][point]"></td>
            <td style="text-align:center;"><button type="button" class="btn-remove" style="color:red; background:none; border:none; cursor:pointer;">X</button></td>
        `;
        tableBody.appendChild(row);
        counter++;
        updateAllDropdowns();
    }

    // --- DEMARRAGE ---
    initExistingRows(); // On initialise les lignes chargées par Twig
    addBtn.addEventListener('click', addRow);

    // Changement d'équipe
    equipeSelect.addEventListener('change', function() {
        document.querySelectorAll('.js-athlete-filler').forEach(s => s.value = "");
        updateAllDropdowns();
    });

    // Remplissage auto
    tableBody.addEventListener('change', (e) => {
        if(e.target.classList.contains('js-athlete-filler')) {
            const select = e.target;
            const selectedOption = select.options[select.selectedIndex];
            const row = select.closest('tr');

            if (select.value !== "") {
                row.querySelector('.input-nom').value = selectedOption.dataset.nom;
                row.querySelector('.input-prenom').value = selectedOption.dataset.prenom;
                row.querySelector('.input-poids').value = selectedOption.dataset.poids;
            }
            updateAllDropdowns();
        }
    });

    // Suppression
    tableBody.addEventListener('click', (e) => {
        if(e.target.classList.contains('btn-remove')) {
            if(tableBody.rows.length > 1) { // Optionnel : permettre de tout supprimer si besoin
                e.target.closest('tr').remove();
                updateAllDropdowns();
            } else {
                 // Si tu veux autoriser 0 résultats, enlève ce if/else
                 if(confirm("Supprimer cette ligne ?")) {
                     e.target.closest('tr').remove();
                     updateAllDropdowns();
                 }
            }
        }
    });
});
</script>
{% endblock %}