{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier la compétition
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/competitions/edit.css') }}">
{% endblock %}

{% block body %}
	<div class="dashboard-container">

		<div id="athletes-data" data-athletes="{{ athletesJson|default('[]')|e('html_attr') }}" class="data-hidden"></div>

		<div class="page-header">
			<h1>Edit competition</h1>
			<p>Editing:
				{{ competition.title }}</p>
		</div>

		<div class="form-card">
			<form id="competitionEditForm" action="{{ path('admin_competition_edit', {id: competition.id}) }}" method="POST" enctype="multipart/form-data">

				<input type="hidden" name="_token" value="{{ csrf_token('competition_edit_' ~ competition.id) }}">


				<div class="row-2">
					<div>
						<label class="form-label">Title</label>
						<input type="text" name="title" class="form-control" value="{{ competition.title }}" required>
					</div>
					<div>
						<label class="form-label">Type</label>
						<input type="text" name="competitionType" class="form-control" value="{{ competition.competitionType }}">
					</div>
				</div>

				<div class="row-3 mt-form">
					<div>
						<label class="form-label">Date</label>
						<input type="datetime-local" name="eventDate" class="form-control" value="{{ competition.eventDate ? competition.eventDate|date('Y-m-d\\TH:i') : '' }}" required>
					</div>
					<div>
						<label class="form-label">Location</label>
						<input type="text" name="location" class="form-control" value="{{ competition.location }}" required>
					</div>
					<div>
						<label class="form-label form-label-accent">Team Gender (Filter)</label>
						<select id="genderSelect" name="gender" class="form-control" required>
							<option value="male" {% if competition.gender == 'male' %} selected {% endif %}>Male</option>
							<option value="female" {% if competition.gender == 'female' %} selected {% endif %}>Female</option>
							<option value="" {% if competition.gender is empty %} selected {% endif %}>Mixed (All)</option>
						</select>
					</div>
				</div>

				<div class="row-2 mt-form">
					<div>
						<label class="form-label">Team ranking</label>
						<input type="text" name="teamRanking" class="form-control" value="{{ competition.teamRanking }}">
					</div>
					<div>
						<label class="form-label">Poster</label>
						<input type="file" name="image" class="form-control">
						{% if competition.image %}
							<div class="current-file">Current:
								{{ competition.image }}</div>
						{% endif %}
					</div>
				</div>

				<h3 class="form-section-title">Results</h3>

				<div class="results-wrapper">
					<table class="result-table" id="resultsTable">
						<thead>
							<tr>
								<th width="20%" class="th-accent">★ Quick select</th>
								<th width="12%">Last name</th>
								<th width="12%">First name</th>
								<th width="10%">Category</th>
								<th width="10%">Weight class</th>
								<th width="8%">Snatch</th>
								<th width="8%">C&amp;J</th>
								<th width="8%">Total</th>
								<th width="8%">Points</th>
								<th width="8%">BW</th>
								<th width="8%">Level</th>
								<th width="4%"></th>
							</tr>
						</thead>
						<tbody>
							{% for index, result in competition.results %}
								<tr class="result-row">
									<td>
										<select class="js-athlete-select athlete-select-bold" data-init-last-name="{{ result.lastName }}" data-init-first-name="{{ result.firstName }}"></select>
									</td>

									<td><input type="text" name="results[{{ index }}][lastName]" class="input-last-name" value="{{ result.lastName }}" required></td>
									<td><input type="text" name="results[{{ index }}][firstName]" class="input-first-name" value="{{ result.firstName }}" required></td>
									<td><input type="text" name="results[{{ index }}][category]" class="input-category" value="{{ result.category }}"></td>
									<td><input type="text" name="results[{{ index }}][weightClass]" class="input-weight-class" value="{{ result.weightClass }}"></td>

									<input type="number" step="1" class="total-output input-readonly" value="{{ result.total }}" readonly tabindex="-1">
									<td><input type="number" step="1" min="0" name="results[{{ index }}][cleanAndJerk]" class="calc-input" value="{{ result.cleanAndJerk }}"></td>

									<td><input type="number" step="1" class="total-output input-readonly" value="{{ result.total }}" readonly tabindex="-1"></td>
									<td><input type="number" step="0.01" min="0" name="results[{{ index }}][points]" value="{{ result.points }}"></td>
									<td>
										<input type="number" step="0.01" min="0" name="results[{{ index }}][bodyWeight]" class="input-bw" value="{{ result.bodyWeight }}" placeholder="PDC">
									</td>
									<td><input type="text" name="results[{{ index }}][rankingLevel]" value="{{ result.rankingLevel }}" placeholder="e.g. Regional"></td>

									<td class="td-center">
										<button type="button" class="btn-remove">×</button>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				<button type="button" class="btn-add-row" id="addResultBtn">+ Add a row</button>

				<div class="form-actions">
					<button type="button" class="btn-delete" data-confirm="Delete this event?" data-submit="del-form">
						Delete
					</button>

					<div class="form-actions-right">
						<a href="{{ path('admin_competition_index') }}" class="btn-cancel">Cancel</a>
						<button type="submit" class="btn-save">Update</button>
					</div>
				</div>
			</form>
		</div>

		<form id="del-form" method="post" action="{{ path('admin_competition_delete', {id: competition.id}) }}" class="form-hidden">
			<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ competition.id) }}">
		</form>
	</div>
{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/competitions/edit.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
