{% extends 'admin/base_admin.html.twig' %}

{% block title %}Séance découverte — PDF{% endblock %}
{% block page_title %}Séance découverte{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/dashboard.css') }}">
	<style>
		.sd-wrap { max-width: 760px; margin: 0 auto; padding: 24px 0 48px; }
		.sd-intro { color: #6b7280; font-size: 14px; margin-bottom: 28px; line-height: 1.6; }
		.sd-card { background: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden; margin-bottom: 24px; }
		.sd-card-header { padding: 16px 24px; border-bottom: 1px solid #e5e7eb; }
		.sd-card-header h3 { margin: 0; font-size: 14px; font-weight: 700; color: #111827; text-transform: uppercase; letter-spacing: 0.04em; }
		.sd-card-body { padding: 20px 24px; }
		.sd-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 24px; }
		.sd-grid.cols-1 { grid-template-columns: 1fr; }
		.sd-field { display: flex; flex-direction: column; gap: 6px; }
		.sd-field label { font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.06em; }
		.sd-field input[type="text"],
		.sd-field input[type="email"],
		.sd-field input[type="tel"],
		.sd-field input[type="date"] {
			border: 1px solid #d1d5db; border-radius: 6px; padding: 9px 12px;
			font-size: 14px; color: #111827; background: #f9fafb;
			transition: border-color .15s, box-shadow .15s;
			width: 100%;
		}
		.sd-field input:focus { outline: none; border-color: #F57706; box-shadow: 0 0 0 3px rgba(245,119,6,.12); background: #fff; }
		.sd-radios { display: flex; gap: 20px; padding-top: 4px; }
		.sd-radios label { font-size: 14px; font-weight: 400; color: #374151; text-transform: none; letter-spacing: 0; display: flex; align-items: center; gap: 7px; cursor: pointer; }
		.sd-radios input[type="radio"] { accent-color: #F57706; width: 16px; height: 16px; cursor: pointer; }
		.sd-error { color: #dc2626; font-size: 12px; margin-top: 3px; }
		.sd-actions { display: flex; justify-content: flex-end; gap: 12px; padding-top: 4px; }
		.btn-generate { background: #F57706; color: #fff; border: none; border-radius: 7px; padding: 11px 28px; font-size: 14px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 8px; transition: background .15s; }
		.btn-generate:hover { background: #d96600; }
		.btn-reset { background: transparent; color: #6b7280; border: 1px solid #d1d5db; border-radius: 7px; padding: 11px 20px; font-size: 14px; font-weight: 500; cursor: pointer; transition: border-color .15s; }
		.btn-reset:hover { border-color: #9ca3af; color: #374151; }
		.sd-optional-hint { font-size: 11px; color: #9ca3af; font-style: italic; margin-left: 4px; }
	</style>
{% endblock %}

{% block body %}
<div class="sd-wrap">

	<p class="sd-intro">
		Remplissez le formulaire ci-dessous pour générer le PDF officiel "Séance découverte" pré-rempli, prêt à imprimer et à faire signer physiquement.
	</p>

	{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

	{# Pratiquant #}
	<div class="sd-card">
		<div class="sd-card-header"><h3>① Informations du pratiquant</h3></div>
		<div class="sd-card-body">
			<div class="sd-grid cols-1" style="margin-bottom:16px;">
				<div class="sd-field">
					{{ form_label(form.fullName) }}
					{{ form_widget(form.fullName, {'attr': {'placeholder': 'DUPONT Jean'}}) }}
					{{ form_errors(form.fullName) }}
				</div>
			</div>
			<div class="sd-grid" style="margin-bottom:16px;">
				<div class="sd-field">
					{{ form_label(form.discipline) }}
					<div class="sd-radios">
						{% for child in form.discipline %}
							{{ form_widget(child) }}
							<label for="{{ child.vars.id }}">{{ child.vars.label }}</label>
						{% endfor %}
					</div>
					{{ form_errors(form.discipline) }}
				</div>
				<div class="sd-field">
					{{ form_label(form.sex) }}
					<div class="sd-radios">
						{% for child in form.sex %}
							{{ form_widget(child) }}
							<label for="{{ child.vars.id }}">{{ child.vars.label }}</label>
						{% endfor %}
					</div>
					{{ form_errors(form.sex) }}
				</div>
			</div>
			<div class="sd-grid" style="margin-bottom:16px;">
				<div class="sd-field">
					{{ form_label(form.birthDate) }}
					{{ form_widget(form.birthDate) }}
					{{ form_errors(form.birthDate) }}
				</div>
				<div class="sd-field">
					{{ form_label(form.phone) }}
					{{ form_widget(form.phone, {'attr': {'placeholder': '06 XX XX XX XX'}}) }}
					{{ form_errors(form.phone) }}
				</div>
			</div>
			<div class="sd-grid cols-1" style="margin-bottom:16px;">
				<div class="sd-field">
					{{ form_label(form.address) }}
					{{ form_widget(form.address, {'attr': {'placeholder': '12 rue des Lilas, 80000 Amiens'}}) }}
					{{ form_errors(form.address) }}
				</div>
			</div>
			<div class="sd-grid cols-1">
				<div class="sd-field">
					{{ form_label(form.email) }}
					{{ form_widget(form.email, {'attr': {'placeholder': 'jean.dupont@exemple.fr'}}) }}
					{{ form_errors(form.email) }}
				</div>
			</div>
		</div>
	</div>

	{# Responsable légal #}
	<div class="sd-card">
		<div class="sd-card-header">
			<h3>② Responsable légal <span class="sd-optional-hint">optionnel — à remplir si le pratiquant est mineur</span></h3>
		</div>
		<div class="sd-card-body">
			<div class="sd-grid" style="margin-bottom:16px;">
				<div class="sd-field">
					{{ form_label(form.legalName) }}
					{{ form_widget(form.legalName, {'attr': {'placeholder': 'DUPONT Marie'}}) }}
				</div>
				<div class="sd-field">
					{{ form_label(form.legalRelation) }}
					{{ form_widget(form.legalRelation, {'attr': {'placeholder': 'Mère'}}) }}
				</div>
			</div>
			<div class="sd-grid">
				<div class="sd-field">
					{{ form_label(form.legalPhone) }}
					{{ form_widget(form.legalPhone, {'attr': {'placeholder': '06 XX XX XX XX'}}) }}
				</div>
				<div class="sd-field">
					{{ form_label(form.legalEmail) }}
					{{ form_widget(form.legalEmail, {'attr': {'placeholder': 'marie.dupont@exemple.fr'}}) }}
				</div>
			</div>
		</div>
	</div>

	{# Décharge #}
	<div class="sd-card">
		<div class="sd-card-header"><h3>③ Décharge &amp; Signature</h3></div>
		<div class="sd-card-body">
			<div class="sd-grid cols-1" style="margin-bottom:16px;">
				<div class="sd-field">
					{{ form_label(form.signeeName) }}
					{{ form_widget(form.signeeName, {'attr': {'placeholder': 'DUPONT Jean (ou nom du responsable légal)'}}) }}
					{{ form_errors(form.signeeName) }}
				</div>
			</div>
			<div class="sd-grid">
				<div class="sd-field">
					{{ form_label(form.signPlace) }}
					{{ form_widget(form.signPlace) }}
				</div>
				<div class="sd-field">
					{{ form_label(form.signDate) }}
					{{ form_widget(form.signDate) }}
				</div>
			</div>
		</div>
	</div>

	<div class="sd-actions">
		<button type="reset" class="btn-reset">Réinitialiser</button>
		<button type="submit" class="btn-generate">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
				<path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
				<path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
			</svg>
			Générer le PDF
		</button>
	</div>

	{{ form_end(form) }}

</div>
{% endblock %}
