<!DOCTYPE html>
<html lang="fr" data-theme="dark">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{% block title %}Tableau de bord{% endblock %} · CHM Saleux</title>
		<link rel="icon" type="image/png" href="{{ asset('images/favicon/icon2.png') }}">

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="stylesheet" href="{{ asset('css/admin/base_admin.css') }}">
		<link
		rel="stylesheet" href="{{ asset('css/admin/layout_admin.css') }}">

		{# ✅ Block pour que les templates enfants puissent ajouter leurs propres CSS #}
		{% block stylesheets %}{% endblock %}
	</head>

	<body>
		<div class="overlay" id="overlay"></div>

		<nav class="sidebar" id="sidebar">
			<div class="sidebar-header">
				<div class="brand">
					<img src="{{ asset('images/favicon/icon2.png') }}" alt="CHM">
					<div class="brand-text">
						<span class="brand-name">CHM Saleux</span>
						<span class="brand-label">Espace admin</span>
					</div>
				</div>
			</div>

			<div class="sidebar-content">

				<div class="nav-item">
					<a href="{{ path('admin_dashboard') }}" class="nav-link {% if app.request.get('_route') == 'admin_dashboard' %}active{% endif %}">
						Tableau de bord
					</a>
				</div>

				<div class="nav-group-label">Gestion Membres</div>

				<div class="nav-item" id="menu-users">
					<div class="nav-link" data-submenu="menu-users">
						<span>Utilisateurs & Droits</span>
						<span class="caret"></span>
					</div>
					<div class="submenu">
						<a href="{{ path('admin_users_index') }}">Liste des utilisateurs</a>
						{% if is_granted('ROLE_SUPER_ADMIN') %}
							<a href="{{ path('admin_users_new_admin') }}" class="nav-link-accent">+ Ajouter un staff</a>
						{% endif %}
						<a href="{{ path('admin_licence_index') }}">Gestion des Licences</a>
					</div>
				</div>

				<div class="nav-item">
					<a href="{{ path('admin_attendance_index') }}" class="nav-link {% if app.request.get('_route') starts with 'admin_attendance' %}active{% endif %}">
						Fréquentation & Scanner
					</a>
				</div>

				<div class="nav-item">
					<a href="{{ path('admin_seance_essai_index') }}" class="nav-link {% if app.request.get('_route') starts with 'admin_seance_essai' %}active{% endif %}">
						Séance d'initiation
					</a>
				</div>

				<div class="nav-item">
					<a href="{{ path('admin_discovery_session_index') }}" class="nav-link {% if app.request.get('_route') starts with 'admin_discovery_session' %}active{% endif %}">
						Séance découverte — PDF
					</a>
				</div>

				<div class="nav-group-label">Sport & Abonnements</div>

				<div class="nav-item">
					<a href="{{ path('admin_membership_plan_index') }}" class="nav-link">
						Offres & Abonnements
					</a>
				</div>

				<div class="nav-item" id="menu-sport">
					<div class="nav-link" data-submenu="menu-sport">
						<span>Athlètes & Compétitions</span>
						<span class="caret"></span>
					</div>
					<div class="submenu">
						<a href="{{ path('admin_athlete_index') }}">Liste des Athlètes</a>
						<a href="{{ path('admin_competition_index') }}">Compétitions</a>
					</div>
				</div>

				<div class="nav-group-label">Contenu du Site</div>

				<div class="nav-item" id="menu-content">
					<div class="nav-link" data-submenu="menu-content">
						<span>Pages & Articles</span>
						<span class="caret"></span>
					</div>
					<div class="submenu">
						{% if is_granted('ROLE_SUPER_ADMIN') %}
							<a href="{{ path('admin_legal_pages_index') }}">Pages statiques</a>
						{% endif %}
						<a href="{{ path('admin_articles_index') }}">Articles / Blog</a>
						<a href="{{ path('admin_document_index') }}">Documents du club</a>
					</div>
				</div>

				<div class="nav-item">
					<a href="{{ path('admin_settings_banner_index') }}" class="nav-link {% if app.request.get('_route') starts with 'admin_settings_banner' %}active{% endif %}">
						Bandeau d'annonce
					</a>
				</div>

				<div class="nav-item">
					<a href="{{ path('admin_new_equipment_index') }}" class="nav-link {% if app.request.get('_route') starts with 'admin_new_equipment' %}active{% endif %}">
						Nouveaux Matériels
					</a>
				</div>

				{% if is_granted('ROLE_SUPER_ADMIN') %}
				<div class="nav-group-label">Appli Mobile</div>

				<div class="nav-item" id="menu-mobile">
					<div class="nav-link" data-submenu="menu-mobile">
						<span>Appli Mobile</span>
						<span class="caret"></span>
					</div>
					<div class="submenu">
						<a href="{{ path('admin_equipment_index') }}" class="{% if app.request.get('_route') starts with 'admin_equipment' %}active-sub{% endif %}">
							Équipements (base exercices)
						</a>
						<a href="{{ path('admin_exercise_index') }}" class="{% if app.request.get('_route') starts with 'admin_exercise' %}active-sub{% endif %}">
							Exercices
						</a>
						<a href="{{ path('admin_routine_template_index') }}" class="{% if app.request.get('_route') starts with 'admin_routine_template' %}active-sub{% endif %}">
							Routines
						</a>
					</div>
				</div>
				{% endif %}

				<div class="nav-group-label">Boutique</div>
				<div class="nav-item">
					<a href="{{ path('admin_merchandise_index') }}" class="nav-link">
						Produits & Stock
					</a>
				</div>

				<div class="nav-group-label">Communication</div>
				<div class="nav-item" id="menu-com">
					<div class="nav-link" data-submenu="menu-com">
						<span>Communication</span>
						<span class="caret"></span>
					</div>
					<div class="submenu">
						<a href="{{ path('admin_newsletter_index') }}">Newsletter</a>
						<a href="{{ path('admin_contact_index') }}">Messages reçus</a>
						{% if is_granted('ROLE_SUPER_ADMIN') %}
							<a href="{{ path('admin_feedbacks') }}">Feedbacks site</a>
						{% endif %}
					</div>
				</div>

				<div class="nav-group-label">Audit & Sécurité</div>
				<div class="nav-item" id="menu-security">
					<div class="nav-link" data-submenu="menu-security">
						<span>Sécurité Système</span>
						<span class="caret"></span>
					</div>
					<div class="submenu">
						<a href="{{ path('admin_security_logs') }}">Journal des Logs</a>
						<a href="{{ path('admin_security_blocklist') }}">Blocage IP (Blacklist)</a>
					</div>
				</div>

				<div class="nav-group-label">Paramètres</div>
				<div class="nav-item">
					<a href="{{ path('admin_settings_index') }}" class="nav-link {% if app.request.get('_route') == 'admin_settings_index' %}active{% endif %}">
						Mon compte
					</a>
				</div>
				{% if is_granted('ROLE_SUPER_ADMIN') %}
				<div class="nav-item">
					<a href="{{ path('admin_settings_maintenance_index') }}" class="nav-link {% if app.request.get('_route') starts with 'admin_settings_maintenance' %}active{% endif %}">
						Maintenance
					</a>
				</div>
				{% endif %}

			</div>

			<div class="sidebar-footer">
				<a href="{{ path('admin_preview_on') }}" class="view-site-link">
					<i class="fa-solid fa-arrow-up-right-from-square"></i>
					Voir le site
				</a>
				<a href="{{ path('app_logout') }}" class="logout-link">
					Se déconnecter
				</a>
			</div>
		</nav>

		<main class="wrapper">
			<header class="top-bar">
				<button class="mobile-toggle" id="mobile-toggle">☰</button>
				<div class="page-title">
					<h1>
						{% block page_title %}Gestion
						{% endblock %}
					</h1>
				</div>
				<div class="topbar-right"></div>
			</header>

			<div class="content">
				{% for label, messages in app.flashes %}
					{% for message in messages %}
						<div class="alert alert-{{ label }}">
							{{ message }}
						</div>
					{% endfor %}
				{% endfor %}

				{% block body %}{% endblock %}
			</div>
		</main>

		{# ✅ JS externalisé — plus d'inline #}
		 <script src="{{ asset('js/admin/base_admin.js') }}" nonce="{{ csp_nonce('script') }}"></script>

		{% block javascripts %}{% endblock %}

		{# ── Modal avertissement expiration session ── #}
		<div id="session-warn-modal" class="sw-overlay" aria-modal="true" role="dialog" aria-labelledby="sw-title">
			<div class="sw-box">
				<div class="sw-icon"><i class="fa-regular fa-clock"></i></div>
				<h3 id="sw-title" class="sw-title">Êtes-vous toujours là ?</h3>
				<p class="sw-body">Votre session admin expire dans <strong id="sw-countdown">2:00</strong>.</p>
				<p class="sw-sub">Sans action, vous serez déconnecté automatiquement.</p>
				<div class="sw-actions">
					<button id="sw-btn-stay" class="sw-btn sw-btn--primary">
						<i class="fa-solid fa-check"></i> Oui, je suis là
					</button>
					<button id="sw-btn-leave" class="sw-btn sw-btn--danger">
						<i class="fa-solid fa-right-from-bracket"></i> Me déconnecter
					</button>
				</div>
			</div>
		</div>

		<script nonce="{{ csp_nonce('script') }}">
		(function () {
			var LIFETIME    = {{ constant('App\\EventSubscriber\\AdminSessionSubscriber::ADMIN_SESSION_LIFETIME') }};
			var WARN_BEFORE = 120;
			var PING_URL    = '{{ path('admin_session_ping') }}';
			var LOGOUT_URL  = '{{ path('app_logout') }}';
			var LS_KEY      = 'chm_admin_deadline';

			var deadline    = Date.now() + LIFETIME * 1000;
			localStorage.setItem(LS_KEY, String(deadline));

			var warnTimer   = null;
			var forceTimer  = null;
			var cdInterval  = null;
			var modalActive = false;

			var overlay     = document.getElementById('session-warn-modal');
			var cdEl        = document.getElementById('sw-countdown');
			var btnStay     = document.getElementById('sw-btn-stay');
			var btnLeave    = document.getElementById('sw-btn-leave');

			/* ── Countdown display ── */
			function formatTime(ms) {
				var s = Math.max(0, Math.floor(ms / 1000));
				var m = Math.floor(s / 60);
				return m + ':' + String(s % 60).padStart(2, '0');
			}

			function tickCountdown() {
				var remaining = deadline - Date.now();
				cdEl.textContent = formatTime(remaining);
				if (remaining <= 0) { clearInterval(cdInterval); doLogout(); }
			}

			/* ── Modal show/hide ── */
			function showModal() {
				if (modalActive) return;
				modalActive = true;
				overlay.classList.add('is-active');
				cdEl.textContent = formatTime(deadline - Date.now());
				clearInterval(cdInterval);
				cdInterval = setInterval(tickCountdown, 1000);
			}

			function hideModal() {
				modalActive = false;
				overlay.classList.remove('is-active');
				clearInterval(cdInterval);
			}

			/* ── Logout ── */
			function doLogout() {
				window.location.href = LOGOUT_URL;
			}

			/* ── Schedule timers based on current deadline ── */
			function scheduleTimers() {
				clearTimeout(warnTimer);
				clearTimeout(forceTimer);

				var now       = Date.now();
				var warnDelay = deadline - WARN_BEFORE * 1000 - now;
				var expDelay  = deadline - now;

				if (expDelay <= 0) { doLogout(); return; }

				if (warnDelay > 0) {
					warnTimer = setTimeout(showModal, warnDelay);
				} else {
					showModal(); // déjà dans la fenêtre d'avertissement
				}

				forceTimer = setTimeout(doLogout, expDelay);
			}

			scheduleTimers();

			/* ── Cross-tab sync via localStorage ── */
			window.addEventListener('storage', function (e) {
				if (e.key === LS_KEY && e.newValue) {
					deadline = parseInt(e.newValue, 10);
					hideModal();
					scheduleTimers();
				}
			});

			/* ── Résistance au throttling (onglet en arrière-plan) ── */
			document.addEventListener('visibilitychange', function () {
				if (document.hidden) return;
				var now = Date.now();
				if (now >= deadline) {
					doLogout();
				} else if (now >= deadline - WARN_BEFORE * 1000) {
					showModal();
				}
			});

			/* ── Bouton "Oui, je suis là" ── */
			btnStay.addEventListener('click', function () {
				fetch(PING_URL, {
					method: 'GET',
					headers: { 'X-Requested-With': 'XMLHttpRequest' }
				})
				.then(function (r) { return r.json(); })
				.then(function (data) {
					if (data.ok) {
						deadline = Date.now() + LIFETIME * 1000;
						localStorage.setItem(LS_KEY, String(deadline));
						hideModal();
						scheduleTimers();
					} else {
						doLogout();
					}
				})
				.catch(doLogout);
			});

			/* ── Bouton "Me déconnecter" ── */
			btnLeave.addEventListener('click', doLogout);
		})();
		</script>
	</body>
</html>
