{% extends 'admin/base_admin.html.twig' %}

{% block title %}Abonnements & Offres
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Abonnements</h1>
			<p>Configuration des offres commerciales visibles sur le site.</p>
		</div>
		<div class="toolbar">
			<input type="text" id="searchInput" class="search-input" placeholder="Filtrer...">
			<a href="{{ path('admin_membership_plan_new') }}" class="btn-create">+ Nouvelle Offre</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="table-scroll">
			<table class="admin-table" id="offersTable">
				<thead>
					<tr>
						<th width="25%">Nom de l'offre</th>
						<th width="15%">Prix</th>
						<th width="15%">Fréquence</th>
						<th width="30%">Avantages</th>
						<th class="th-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for plan in plans %}
						<tr>
							<td>
								<div class="title-stack">
									<strong>{{ plan.name }}</strong>
									{% if plan.isPopular %}
										{# Classe badge-popular remplace le style inline #}
										<span class="badge badge-popular">POPULAIRE</span>
									{% endif %}
								</div>
							</td>
							<td>
								{# Classe price-tag remplace le style inline #}
								<span class="td-mono price-tag">{{ plan.price }}
									€</span>
							</td>
							<td>
								{# On réutilise badge-neutral #}
								<span class="badge badge-neutral">
									{% set period = plan.billingPeriod %}
									{{ period == 'year' ? 'Annuel' : (period == 'month' ? 'Mensuel' : (period == 'one_time' ? 'Unique' : period)) }}
								</span>
							</td>
							<td>
								{# Classe benefits-list remplace le style inline #}
								<div class="time-info benefits-list">
									{% for benefit in plan.benefits|slice(0, 2) %}
										<span class="benefit-item">•
											{{ benefit }}</span>
									{% endfor %}
									{% if plan.benefits|length > 2 %}
										<span class="more-count">+{{ plan.benefits|length - 2 }}
											autres...</span>
									{% endif %}
								</div>
							</td>
							<td>
								<div class="actions">
									<a href="{{ path('admin_membership_plan_edit', {'id': plan.id}) }}" class="act-link">Modifier</a>

									{# MODIFICATION : Passage en V20 JS avec message contextuel #}
									<form method="post" action="{{ path('admin_membership_plan_delete', {'id': plan.id}) }}" class="js-confirm-form" data-confirm="⚠️ ATTENTION : Vous allez supprimer l'offre '{{ plan.name }}'. Cela n'annulera pas les contrats en cours, mais l'offre disparaîtra du site public. Confirmer ?">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ plan.id) }}">
										<button class="act-link act-del">Supprimer</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="5" class="td-empty">Aucune offre créée.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
