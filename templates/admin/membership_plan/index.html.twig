{% extends 'admin/base_admin.html.twig' %}

{% block title %}Abonnements & Offres
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/member_plan/index.css') }}">
{% endblock %}

{% block body %}

	<div class="page-header">
		<div>
			<h1>Abonnements</h1>
			<p>Configuration des offres commerciales visibles sur le site.</p>
		</div>
		<div class="toolbar">
			<input type="text" id="searchInput" class="search-input" placeholder="Filtrer les offres...">
			<button class="btn-create" data-href="{{ path('admin_membership_plan_new') }}">
				+ Nouvelle Offre
			</button>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="table-scroll">
			<table class="admin-table" id="offersTable">
				<thead>
					<tr>
						<th width="25%">Nom de l'offre</th>
						<th width="15%">Prix</th>
						<th width="15%">Fréquence</th>
						<th width="30%">Avantages (Aperçu)</th>
						<th class="th-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for plan in plans %}
						<tr>
							<td>
								<span class="offer-name">{{ plan.name }}</span>
								{% if plan.isPopular %}
									<span class="offer-badge">Populaire</span>
								{% endif %}
							</td>

							<td>
								<span class="price-tag">{{ plan.price }}
									€</span>
							</td>

							<td>
								<span class="freq-tag">
									{% set period = plan.billingPeriod %}
									{% if period == 'year' %}Annuel
										{% elseif period == 'month' %}Mensuel
										{% elseif period == 'quarter' %}Trimestriel
										{% elseif period == 'semester' %}Semestriel
										{% elseif period == 'one_time' %}Séance unique
									{% else %}
										{{ period }}
									{% endif %}
								</span>
							</td>

							<td>
								<ul
									class="features-list">
									{# Show max 3 benefits for table preview #}
									{% for benefit in plan.benefits|slice(0, 3) %}
										<li>{{ benefit }}</li>
									{% endfor %}

									{% if plan.benefits|length > 3 %}
										<li class="li-more">+{{ plan.benefits|length - 3 }}
											autres...</li>

									{% endif %}

									{% if plan.benefits|length == 0 %}
										<li class="li-empty">Aucun avantage listé</li>
									{% endif %}
								</ul>
							</td>

							<td>
								<div class="actions">
									<a href="{{ path('admin_membership_plan_edit', {'id': plan.id}) }}" class="act-link act-edit">
										Modifier
									</a>
									<form method="post" action="{{ path('admin_membership_plan_delete', {'id': plan.id}) }}" class="form-inline" data-confirm="Supprimer définitivement l'offre {{ plan.name }} ?">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ plan.id) }}">
										<button class="act-link act-del">Supprimer</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="5" class="td-empty">Aucune offre d'abonnement n'a été créée pour le moment.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>

{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/member_plan/index.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
