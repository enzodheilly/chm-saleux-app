{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier le forfait
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/member_plan/edit.css') }}">
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Modifier l'offre</h1>
			<p>Édition de :
				<span style="font-weight: 700; color: var(--text-main);">{{ plan.name }}</span>
			</p>
		</div>

		<div class="toolbar">
			<a href="{{ path('admin_membership_plan_index') }}" class="btn-outline">Retour</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="card-body">
			{{ form_start(form) }}

			<div class="form-error">{{ form_errors(form) }}</div>

			<div class="form-grid">
				<div>
					<span class="tool-label">Nom commercial</span>
					{{ form_widget(form.name, {'attr': {'class': 'input'}}) }}
					<div class="form-error">{{ form_errors(form.name) }}</div>
				</div>

				<div class="form-row-3">
					<div>
						<span class="tool-label">Prix total (€)</span>
						{{ form_widget(form.price, {'attr': {'class': 'input', 'id': 'input-price'}}) }}
						<div class="form-error">{{ form_errors(form.price) }}</div>
					</div>

					<div>
						<span class="tool-label">Période</span>
						{{ form_widget(form.billingPeriod, {'attr': {'class': 'input', 'id': 'input-freq'}}) }}
						<div class="form-error">{{ form_errors(form.billingPeriod) }}</div>
					</div>

					<div>
						<span class="tool-label">Coût mensuel (est.)</span>
						{{ form_widget(form.monthlyPrice, {'attr': {'class': 'input', 'id': 'input-monthly', 'readonly': 'readonly'}}) }}
						<span class="form-help">Recalculé à la modification</span>
					</div>
				</div>

				<div>
					<span class="tool-label">Phrase d'accroche</span>
					{{ form_widget(form.description, {'attr': {'class': 'input'}}) }}
					<div class="form-error">{{ form_errors(form.description) }}</div>
				</div>

				<div>
					<span class="tool-label">Liste des avantages</span>
					{{ form_widget(form.benefits, {'attr': {'class': 'input', 'rows': 6}}) }}
					<div class="form-error">{{ form_errors(form.benefits) }}</div>

					<div class="help-box">
						Format optionnel :
						<code>icone | texte</code>.<br>
						Une ligne par avantage.
					</div>
				</div>

				<label class="toggle-card">
					{{ form_widget(form.isPopular, {'attr': {'class': 'toggle-input'}}) }}
					<div>
						<span class="toggle-title">Offre populaire</span>
						<span class="toggle-desc">
							Cochez cette case pour mettre cet abonnement en avant sur le site.
						</span>
					</div>
				</label>

				<div class="form-actions">
					<button type="button" class="btn-danger-link" onclick="if(confirm('Attention : Supprimer cette offre peut affecter l\\'affichage du site.\\n\\nÊtes-vous sûr ?')) document.getElementById('delete-form').submit();">
						Supprimer l'offre
					</button>

					<div class="form-actions-right">
						<a href="{{ path('admin_membership_plan_index') }}" class="btn-outline">Annuler</a>
						<button type="submit" class="btn-create">Mettre à jour</button>
					</div>
				</div>
			</div>

			{{ form_end(form) }}
		</div>
	</div>

	<form id="delete-form" method="post" action="{{ path('admin_membership_plan_delete', {'id': plan.id}) }}">
		<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ plan.id) }}">
	</form>
{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/member_plan/edit.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
