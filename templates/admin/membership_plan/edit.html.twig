{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier le forfait{% endblock %}
{% block page_title %}Modifier le forfait{% endblock %}

{% block stylesheets %}
<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
        gap: 1rem;
        flex-wrap: wrap;
    }

    .page-header h1 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: var(--text-main);
    }

    .page-header p {
        margin: 5px 0 0 0;
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    .toolbar {
        display: flex;
        gap: 0.75rem;
        align-items: flex-end;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .btn-create {
        background: var(--text-main);
        color: var(--bg-body);
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: 0.2s;
        border: none;
        text-decoration: none;
        display: inline-block;
        white-space: nowrap;
    }

    .btn-create:hover {
        opacity: 0.9;
    }

    .btn-outline {
        background: transparent;
        color: var(--text-main);
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: 0.2s;
        border: 1px solid var(--border-color);
        text-decoration: none;
        display: inline-block;
        white-space: nowrap;
        opacity: 0.9;
    }

    .btn-outline:hover {
        opacity: 1;
        border-color: var(--text-main);
    }

    .btn-danger-link {
        background: transparent;
        color: var(--danger);
        padding: 0.6rem 0;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: 0.2s;
        border: none;
        text-decoration: none;
        display: inline-block;
        white-space: nowrap;
    }

    .btn-danger-link:hover {
        opacity: 0.85;
        text-decoration: underline;
    }

    .table-wrapper {
        background: var(--bg-sidebar);
        border: 1px solid var(--border-color);
        border-radius: 6px;
    }

    .card-body {
        padding: 1.5rem;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.2rem;
        max-width: 900px;
    }

    .form-row-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 1.2rem;
    }

    .tool-label {
        display: block;
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.35rem;
    }

    .input {
        background: transparent;
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 0.6rem 1rem;
        border-radius: 4px;
        outline: none;
        font-size: 0.9rem;
        transition: border-color 0.2s;
        width: 100%;
        box-sizing: border-box;
    }

    .input:focus {
        border-color: var(--text-main);
    }

    .input::placeholder {
        color: var(--text-muted);
        opacity: 0.6;
    }

    textarea.input {
        min-height: 120px;
        line-height: 1.5;
        resize: vertical;
    }

    .input[readonly] {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .form-help {
        display: block;
        margin-top: 0.35rem;
        color: var(--text-muted);
        font-size: 0.8rem;
    }

    .form-error {
        color: var(--danger);
        font-size: 0.85rem;
        margin-top: 0.35rem;
    }

    .form-error ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .help-box {
        margin-top: 0.6rem;
        padding: 0.9rem 1rem;
        background: rgba(255, 255, 255, 0.02);
        border-left: 3px solid var(--text-muted);
        border-radius: 0 4px 4px 0;
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.5;
    }

    .help-box code {
        background: rgba(0, 0, 0, 0.2);
        padding: 2px 4px;
        border-radius: 3px;
        font-family: monospace;
        color: var(--accent);
    }

    .toggle-card {
        display: flex;
        gap: 0.9rem;
        align-items: flex-start;
        padding: 1rem;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        background: rgba(255,255,255,0.01);
        cursor: pointer;
        transition: background 0.2s;
    }

    .toggle-card:hover {
        background: rgba(255,255,255,0.03);
    }

    .toggle-input {
        width: 1.1rem;
        height: 1.1rem;
        accent-color: var(--accent);
        margin-top: 0.1rem;
        cursor: pointer;
        flex-shrink: 0;
    }

    .toggle-title {
        display: block;
        font-weight: 600;
        color: var(--text-main);
        font-size: 0.9rem;
    }

    .toggle-desc {
        display: block;
        margin-top: 0.2rem;
        color: var(--text-muted);
        font-size: 0.8rem;
        line-height: 1.45;
    }

    .form-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 0.5rem;
    }

    .form-actions-right {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        flex-wrap: wrap;
    }

    @media (max-width: 900px) {
        .form-row-3 {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 700px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .toolbar {
            justify-content: flex-start;
            width: 100%;
        }

        .form-actions {
            align-items: flex-start;
            flex-direction: column;
        }

        .form-actions-right {
            width: 100%;
        }
    }
</style>
{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Modifier l'offre</h1>
            <p>Édition de : <span style="font-weight: 700; color: var(--text-main);">{{ plan.name }}</span></p>
        </div>

        <div class="toolbar">
            <a href="{{ path('admin_membership_plan_index') }}" class="btn-outline">Retour</a>
        </div>
    </div>

    <div class="table-wrapper">
        <div class="card-body">
            {{ form_start(form) }}

                <div class="form-error">{{ form_errors(form) }}</div>

                <div class="form-grid">
                    <div>
                        <span class="tool-label">Nom commercial</span>
                        {{ form_widget(form.name, {'attr': {'class': 'input'}}) }}
                        <div class="form-error">{{ form_errors(form.name) }}</div>
                    </div>

                    <div class="form-row-3">
                        <div>
                            <span class="tool-label">Prix total (€)</span>
                            {{ form_widget(form.price, {'attr': {'class': 'input', 'id': 'input-price'}}) }}
                            <div class="form-error">{{ form_errors(form.price) }}</div>
                        </div>

                        <div>
                            <span class="tool-label">Période</span>
                            {{ form_widget(form.billingPeriod, {'attr': {'class': 'input', 'id': 'input-freq'}}) }}
                            <div class="form-error">{{ form_errors(form.billingPeriod) }}</div>
                        </div>

                        <div>
                            <span class="tool-label">Coût mensuel (est.)</span>
                            {{ form_widget(form.monthlyPrice, {'attr': {'class': 'input', 'id': 'input-monthly', 'readonly': 'readonly'}}) }}
                            <span class="form-help">Recalculé à la modification</span>
                        </div>
                    </div>

                    <div>
                        <span class="tool-label">Phrase d'accroche</span>
                        {{ form_widget(form.description, {'attr': {'class': 'input'}}) }}
                        <div class="form-error">{{ form_errors(form.description) }}</div>
                    </div>

                    <div>
                        <span class="tool-label">Liste des avantages</span>
                        {{ form_widget(form.benefits, {'attr': {'class': 'input', 'rows': 6}}) }}
                        <div class="form-error">{{ form_errors(form.benefits) }}</div>

                        <div class="help-box">
                            Format optionnel : <code>icone | texte</code>.<br>
                            Une ligne par avantage.
                        </div>
                    </div>

                    <label class="toggle-card" onclick="document.getElementById('{{ form.isPopular.vars.id }}').click()">
                        {{ form_widget(form.isPopular, {'attr': {'class': 'toggle-input'}}) }}
                        <div>
                            <span class="toggle-title">Offre populaire</span>
                            <span class="toggle-desc">
                                Cochez cette case pour mettre cet abonnement en avant sur le site.
                            </span>
                        </div>
                    </label>

                    <div class="form-actions">
                        <button
                            type="button"
                            class="btn-danger-link"
                            onclick="if(confirm('Attention : Supprimer cette offre peut affecter l\\'affichage du site.\\n\\nÊtes-vous sûr ?')) document.getElementById('delete-form').submit();"
                        >
                            Supprimer l'offre
                        </button>

                        <div class="form-actions-right">
                            <a href="{{ path('admin_membership_plan_index') }}" class="btn-outline">Annuler</a>
                            <button type="submit" class="btn-create">Mettre à jour</button>
                        </div>
                    </div>
                </div>

            {{ form_end(form) }}
        </div>
    </div>

    <form id="delete-form" method="post" action="{{ path('admin_membership_plan_delete', {'id': plan.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ plan.id) }}">
    </form>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener("DOMContentLoaded", function() {
    const priceInput = document.getElementById('input-price');
    const freqSelect = document.getElementById('input-freq');
    const monthlyInput = document.getElementById('input-monthly');

    function calculateMonthly() {
        const price = parseFloat(priceInput.value);
        const period = freqSelect.value;

        if (isNaN(price)) {
            monthlyInput.value = '';
            return;
        }

        let divisor = 1;

        if (period === 'quarter') divisor = 3;
        else if (period === 'semester') divisor = 6;
        else if (period === 'year') divisor = 12;
        else if (period === 'month') divisor = 1;
        else if (period === 'one_time') divisor = 1;

        const result = price / divisor;
        monthlyInput.value = result.toFixed(2);
    }

    if (priceInput && freqSelect) {
        priceInput.addEventListener('input', calculateMonthly);
        freqSelect.addEventListener('change', calculateMonthly);
        calculateMonthly();
    }
});
</script>
{% endblock %}