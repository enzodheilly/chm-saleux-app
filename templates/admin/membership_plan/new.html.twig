{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouveau Forfait
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/member_plan/new.css') }}">
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Créer une offre</h1>
			<p>Ajouter un nouvel abonnement à la grille tarifaire.</p>
		</div>

		<div class="toolbar">
			<a href="{{ path('admin_membership_plan_index') }}" class="btn-outline">Retour</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="card-body">
			{{ form_start(form) }}

			<div class="form-error">{{ form_errors(form) }}</div>

			<div class="form-grid">
				<div>
					<span class="tool-label">Nom commercial</span>
					{{ form_widget(form.name, {'attr': {'class': 'input', 'placeholder': 'Ex: Abonnement Premium'}}) }}
					<div class="form-error">{{ form_errors(form.name) }}</div>
				</div>

				<div class="form-row-3">
					<div>
						<span class="tool-label">Prix total (€)</span>
						{{ form_widget(form.price, {'attr': {'class': 'input', 'id': 'input-price', 'placeholder': '0.00'}}) }}
						<div class="form-error">{{ form_errors(form.price) }}</div>
					</div>

					<div>
						<span class="tool-label">Période</span>
						{{ form_widget(form.billingPeriod, {'attr': {'class': 'input', 'id': 'input-freq'}}) }}
						<div class="form-error">{{ form_errors(form.billingPeriod) }}</div>
					</div>

					<div>
						<span class="tool-label">Coût mensuel (est.)</span>
						{{ form_widget(form.monthlyPrice, {'attr': {'class': 'input', 'id': 'input-monthly', 'readonly': 'readonly'}}) }}
						<span class="form-help">Calculé automatiquement</span>
					</div>
				</div>

				<div>
					<span class="tool-label">Phrase d'accroche</span>
					{{ form_widget(form.description, {'attr': {'class': 'input', 'placeholder': 'Ex: Idéal pour commencer...'}}) }}
					<div class="form-error">{{ form_errors(form.description) }}</div>
				</div>

				<div>
					<span class="tool-label">Liste des avantages (1 par ligne)</span>
					{{ form_widget(form.benefits, {'attr': {'class': 'input', 'rows': 6, 'placeholder': 'Accès illimité\nCoaching inclus\n...'}}) }}
					<div class="form-error">{{ form_errors(form.benefits) }}</div>

					<div class="help-box">
						Vous pouvez ajouter une icône spécifique avec le format :
						<code>icone | texte</code><br>
						Exemple :
						<code>dumbbell | Accès Plateau</code>
					</div>
				</div>

				<label class="toggle-card" for="{{ form.isPopular.vars.id }}">
					{{ form_widget(form.isPopular, {'attr': {'class': 'toggle-input'}}) }}
					<div>
						<span class="toggle-title">Mettre en avant cette offre</span>
						<span class="toggle-desc">
							Ajoute un badge “Populaire” et met l'offre en surbrillance sur le site.
						</span>
					</div>
				</label>

				<div class="form-actions">
					<button type="submit" class="btn-create">Enregistrer</button>
					<a href="{{ path('admin_membership_plan_index') }}" class="btn-outline">Annuler</a>
				</div>
			</div>

			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/member_plan/new.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
