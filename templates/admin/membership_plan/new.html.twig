{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouveau Forfait{% endblock %}

{% block stylesheets %}
<style>
    /* =================== CONTAINER =================== */
    .form-container { max-width: 800px; margin: 0 auto; }

    /* =================== HEADER =================== */
    .page-header {
        margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem;
        display: flex; justify-content: space-between; align-items: flex-end;
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--text-main); }
    .page-header p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; }
    .back-link { font-size: 0.85rem; color: var(--text-muted); font-weight: 500; text-decoration: underline; cursor: pointer; }
    .back-link:hover { color: var(--text-main); }

    /* =================== FORM CARD =================== */
    .form-card { background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 6px; padding: 2rem; }
    .form-group { margin-bottom: 1.5rem; }

    /* Labels */
    .form-label { display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }

    /* Inputs */
    .form-control {
        width: 100%; background: var(--bg-body); border: 1px solid var(--border-color); color: var(--text-main);
        padding: 0.75rem 1rem; border-radius: 4px; font-size: 0.95rem; font-family: inherit; transition: border-color 0.2s, box-shadow 0.2s; box-sizing: border-box;
    }
    .form-control:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.1); }
    
    textarea.form-control { min-height: 120px; line-height: 1.5; resize: vertical; }

    /* Grille 3 colonnes */
    .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; }
    @media(max-width: 700px) { .form-row-3 { grid-template-columns: 1fr; gap: 0; } }

    /* Toggle Switch (Checkbox Pro) */
    .toggle-wrapper { display: flex; align-items: center; gap: 10px; cursor: pointer; user-select: none; margin-top: 2rem; padding: 1rem; border: 1px solid var(--border-color); border-radius: 4px; background: rgba(255,255,255,0.01); transition: background 0.2s; }
    .toggle-wrapper:hover { background: rgba(255,255,255,0.03); }
    .toggle-input { width: 1.2rem; height: 1.2rem; accent-color: var(--accent); cursor: pointer; }
    .toggle-label { font-weight: 600; color: var(--text-main); cursor: pointer; }
    .toggle-desc { display: block; font-size: 0.8rem; color: var(--text-muted); margin-left: 30px; margin-top: 2px; }

    /* Help Box */
    .help-box { margin-top: 0.5rem; padding: 0.8rem; background: rgba(255,255,255,0.02); border-left: 3px solid var(--text-muted); border-radius: 0 4px 4px 0; font-size: 0.85rem; color: var(--text-muted); }
    .help-box code { background: rgba(0,0,0,0.2); padding: 2px 4px; border-radius: 3px; font-family: monospace; color: var(--accent); }

    /* Actions */
    .form-actions { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 1rem; }
    .btn-cancel { padding: 0.7rem 1.2rem; color: var(--text-muted); font-weight: 600; font-size: 0.9rem; border-radius: 4px; transition: color 0.2s; }
    .btn-cancel:hover { color: var(--text-main); }
    .btn-save { background: var(--text-main); color: var(--bg-body); padding: 0.7rem 1.5rem; border-radius: 4px; font-weight: 700; font-size: 0.9rem; border: none; cursor: pointer; transition: opacity 0.2s; }
    .btn-save:hover { opacity: 0.9; }

</style>
{% endblock %}

{% block body %}
<div class="form-container">
    
    <div class="page-header">
        <div>
            <h1>Créer une offre</h1>
            <p>Ajouter un nouvel abonnement à la grille tarifaire.</p>
        </div>
        <a href="{{ path('admin_membership_plan_index') }}" class="back-link">Retour à la liste</a>
    </div>

    <div class="form-card">
        {{ form_start(form) }}

        <div class="form-group">
            {{ form_label(form.name, 'Nom commercial', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Abonnement Premium'}}) }}
            <div style="color: var(--danger); font-size: 0.85rem;">{{ form_errors(form.name) }}</div>
        </div>

        <div class="form-row-3">
            <div class="form-group">
                {{ form_label(form.price, 'Prix Total (€)', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.price, {'attr': {'class': 'form-control', 'id': 'input-price', 'placeholder': '0.00'}}) }}
                <div style="color: var(--danger); font-size: 0.85rem;">{{ form_errors(form.price) }}</div>
            </div>
            
            <div class="form-group">
                {{ form_label(form.billingPeriod, 'Période', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.billingPeriod, {'attr': {'class': 'form-control', 'id': 'input-freq'}}) }}
                <div style="color: var(--danger); font-size: 0.85rem;">{{ form_errors(form.billingPeriod) }}</div>
            </div>

            <div class="form-group">
                {{ form_label(form.monthlyPrice, 'Coût mensuel (Est.)', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.monthlyPrice, {'attr': {'class': 'form-control', 'id': 'input-monthly', 'readonly': 'readonly', 'style': 'opacity: 0.7; cursor: not-allowed;'}}) }}
                <small style="display:block; color:var(--text-muted); font-size:0.75rem; margin-top:4px;">Calculé automatiquement</small>
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.description, 'Phrase d\'accroche (Sous le prix)', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Idéal pour commencer...'}}) }}
        </div>

        <div class="form-group">
            {{ form_label(form.benefits, 'Liste des avantages (1 par ligne)', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.benefits, {'attr': {'class': 'form-control', 'rows': 6, 'placeholder': 'Accès illimité\nCoaching inclus\n...'}}) }}
            
            <div class="help-box">
                Vous pouvez ajouter une icône spécifique en utilisant le format : <code>icone | texte</code>.<br>
                Exemple : <code>dumbbell | Accès Plateau</code>
            </div>
        </div>

        <div class="toggle-wrapper" onclick="document.getElementById('{{ form.isPopular.vars.id }}').click()">
            {{ form_widget(form.isPopular, {'attr': {'class': 'toggle-input'}}) }}
            <div>
                <label for="{{ form.isPopular.vars.id }}" class="toggle-label">Mettre en avant cette offre</label>
                <span class="toggle-desc">Ajoute un badge "Populaire" et met l'offre en surbrillance sur le site.</span>
            </div>
        </div>

        <div class="form-actions">
            <a href="{{ path('admin_membership_plan_index') }}" class="btn-cancel">Annuler</a>
            <button type="submit" class="btn-save">Enregistrer l'offre</button>
        </div>

        {{ form_end(form) }}
    </div>

</div>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const priceInput = document.getElementById('input-price');
        const freqSelect = document.getElementById('input-freq');
        const monthlyInput = document.getElementById('input-monthly');

        function calculateMonthly() {
            const price = parseFloat(priceInput.value);
            const selectedValue = freqSelect.value; // <-- now uses value like: year/month/quarter/semester/one_time

            if (isNaN(price)) {
                monthlyInput.value = '';
                return;
            }

            let divisor = 1;

            if (selectedValue === 'quarter') divisor = 3;
            else if (selectedValue === 'semester') divisor = 6;
            else if (selectedValue === 'year') divisor = 12;
            else if (selectedValue === 'month') divisor = 1;
            else if (selectedValue === 'one_time') divisor = 1;

            const result = price / divisor;
            monthlyInput.value = result.toFixed(2);
        }

        if (priceInput && freqSelect) {
            priceInput.addEventListener('input', calculateMonthly);
            freqSelect.addEventListener('change', calculateMonthly);
        }
    });
</script>
{% endblock %}
