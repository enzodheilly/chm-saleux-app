{% extends 'admin/base_admin.html.twig' %}

{% block title %}Informations du club{% endblock %}

{% block stylesheets %}
<style>
    /* =================== HEADER & TOOLS =================== */
    .page-header {
        display: flex; justify-content: space-between; align-items: flex-end;
        margin-bottom: 2rem; padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--text-main); }
    .page-header p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; }

    .btn-create {
        background: var(--text-main);
        color: var(--bg-body);
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        font-weight: 700; font-size: 0.85rem;
        cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em;
        transition: 0.2s; border: none; text-decoration: none; display: inline-block;
    }
    .btn-create:hover { opacity: 0.9; }

    /* =================== TABLEAU PRO =================== */
    .table-wrapper {
        background: var(--bg-sidebar);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        overflow: hidden;
    }
    
    .admin-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    
    .admin-table th {
        background: rgba(255,255,255,0.02);
        color: var(--text-muted);
        font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.75rem;
        text-align: left; padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
    }
    
    .admin-table td {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-main); vertical-align: middle;
    }
    .admin-table tr:last-child td { border-bottom: none; }
    .admin-table tr:hover td { background: rgba(255,255,255,0.01); }

    /* Badges de Catégorie */
    .info-badge {
        display: inline-block; padding: 4px 10px; border-radius: 4px; 
        font-size: 0.7rem; font-weight: 700; text-transform: uppercase; 
        letter-spacing: 0.05em; background: var(--bg-body); 
        color: var(--accent); border: 1px solid var(--border-color);
    }

    .content-preview { 
        color: var(--text-muted); 
        font-size: 0.85rem; 
        max-width: 700px; 
        line-height: 1.5;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Actions */
    .actions { display: flex; gap: 15px; justify-content: flex-end; }
    .act-link { 
        font-size: 0.75rem; font-weight: 600; text-transform: uppercase; 
        letter-spacing: 0.05em; cursor: pointer; transition: 0.2s; opacity: 0.7; 
        background: none; border: none; padding: 0;
    }
    .act-link:hover { opacity: 1; text-decoration: underline; }
    .act-edit { color: var(--text-main); }
    .act-del { color: var(--danger); }

</style>
{% endblock %}

{% block page_title %}Informations Club{% endblock %}

{% block body %}

    <div class="page-header">
        <div>
            <h1>Textes de Présentation</h1>
            <p>Gérez les informations fixes du site (Horaires, Histoire, Équipements...).</p>
        </div>
        <div class="toolbar">
            <a href="{{ path('admin_clubinfo_new') }}" class="btn-create">
                + Ajouter une section
            </a>
        </div>
    </div>

    <div class="table-wrapper">
        <div style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th width="200">Emplacement / Type</th>
                        <th>Aperçu du texte</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for info in infos %}
                        <tr>
                            <td>
                                <span class="info-badge">{{ info.category|capitalize }}</span>
                            </td>

                            <td>
                                <div class="content-preview">
                                    {{ info.content|striptags|slice(0, 120) ~ (info.content|length > 120 ? '...' : '') }}
                                </div>
                            </td>

                            <td>
                                <div class="actions">
                                    <a href="{{ path('admin_clubinfo_edit', {id: info.id}) }}" class="act-link act-edit">Modifier</a>
                                    
                                    <form method="post" action="{{ path('admin_clubinfo_delete', {id: info.id}) }}" 
                                          onsubmit="return confirm('Confirmer la suppression ?');" 
                                          style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ info.id) }}">
                                        <button class="act-link act-del">Supprimer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" style="text-align: center; padding: 4rem; color: var(--text-muted);">
                                Aucun texte d'information n'a été rédigé.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

{% endblock %}