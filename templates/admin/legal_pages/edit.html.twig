{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier la page :
	{{ page.title }}
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/legal_pages/edit.css') }}">
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Modifier la page</h1>
			<p>
				Identifiant technique :
				<span class="page-id">#{{ page.id }}</span>
			</p>
		</div>

		<div class="toolbar">
			<a href="{{ path('admin_legal_pages_index') }}" class="btn-outline">Retour à la liste</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="card-body">
			{{ form_start(form) }}

			<div class="form-error">{{ form_errors(form) }}</div>

			<div class="form-grid">
				<div class="form-row-page">
					<div>
						<span class="tool-label">Titre de la page</span>
						{{ form_widget(form.title, {'attr': {'class': 'input'}}) }}
						<div class="form-error">{{ form_errors(form.title) }}</div>
					</div>

					<div>
						<span class="tool-label">URL (slug)</span>
						{{ form_widget(form.slug, {'attr': {'class': 'input'}}) }}
						<span class="help-text">Attention : changer le slug peut briser des liens existants.</span>
						<div class="form-error">{{ form_errors(form.slug) }}</div>
					</div>
				</div>

				<div>
					<span class="tool-label">Contenu de la page (HTML / texte)</span>
					{{ form_widget(form.content, {'attr': {'class': 'input'}}) }}
					<div class="form-error">{{ form_errors(form.content) }}</div>
				</div>

				<div class="form-actions">
					<button type="button" class="btn-danger-link" data-confirm="⚠️ Supprimer cette page définitivement ? Les liens vers /legal/{{ page.slug }} ne fonctionneront plus." data-submit="delete-page-form">
						Supprimer la page
					</button>

					<div class="form-actions-right">
						<a href="{{ path('admin_legal_pages_index') }}" class="btn-outline">Quitter</a>
						<button type="submit" class="btn-create">Enregistrer les modifications</button>
					</div>
				</div>
			</div>

			{{ form_end(form) }}
		</div>
	</div>

	<form id="delete-page-form" method="post" action="{{ path('admin_legal_pages_delete', { id: page.id }) }}" class="form-hidden">
		<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ page.id) }}">
	</form>
{% endblock %}
