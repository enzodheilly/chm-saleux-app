{% extends 'admin/base_admin.html.twig' %}

{% block title %}
	{{ title }}
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/legal_pages/form.css') }}">
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Éditeur de page légale</h1>
			<p>
				Le contenu sera publié sous le chemin :
				<span class="route-preview">/legal/{{ form.vars.value.slug|default('...') }}</span>
			</p>
		</div>

		<div class="toolbar">
			<a href="{{ path('admin_legal_pages_index') }}" class="btn-outline">Annuler les modifications</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="card-body">
			{{ form_start(form) }}

			<div class="form-error">{{ form_errors(form) }}</div>

			<div class="form-grid">
				<div class="form-row-page">
					<div>
						<span class="tool-label">Titre de la page</span>
						{{ form_widget(form.title, {'attr': {'class': 'input', 'placeholder': 'Ex: CGU, Cookies, Confidentialité'}}) }}
						<div class="form-error">{{ form_errors(form.title) }}</div>
					</div>

					<div>
						<span class="tool-label">URL (slug)</span>
						{{ form_widget(form.slug, {'attr': {'class': 'input', 'placeholder': 'cgu'}}) }}
						<span class="help-text">Utilisé pour l’adresse de la page.</span>
						<div class="form-error">{{ form_errors(form.slug) }}</div>
					</div>
				</div>

				<div>
					<span class="tool-label">Contenu de la page (HTML ou texte)</span>
					{{ form_widget(form.content, {'attr': {'class': 'input'}}) }}
					<div class="form-error">{{ form_errors(form.content) }}</div>
				</div>

				<div class="form-actions">
					<button type="submit" class="btn-create">
						{{ form.vars.value.id is not null ? 'Mettre à jour la page' : 'Publier la page' }}
					</button>
					<a href="{{ path('admin_legal_pages_index') }}" class="btn-outline">Quitter</a>
				</div>
			</div>

			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}
