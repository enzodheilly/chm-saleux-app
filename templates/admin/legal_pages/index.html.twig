{% extends 'admin/base_admin.html.twig' %}

{% block title %}
	{{ title }}
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>Pages légales</h1>
			<p>Gestion des contenus permanents (CGU, Cookies, Confidentialité...).</p>
		</div>
		<div class="toolbar">
			<input type="text" id="searchInput" class="search-input" placeholder="Filtrer les pages...">
			<a href="{{ path('admin_legal_pages_new') }}" class="btn-create">+ Créer une page</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="table-scroll">
			<table class="admin-table" id="pagesTable">
				<thead>
					<tr>
						<th width="80">ID</th>
						<th width="35%">Titre de la page</th>
						<th width="25%">Chemin (URL)</th>
						<th width="20%">Dernière modif.</th>
						<th class="th-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for page in pages %}
						<tr>
							<td>
								<span class="td-mono">#{{ page.id }}</span>
							</td>
							<td>
								<div class="title-stack">
									<strong>{{ page.title }}</strong>
								</div>
							</td>
							<td>
								{# La classe url-slug remplace le style inline #}
								<code class="td-mono-sm url-slug">/legal/{{ page.slug }}</code>
							</td>
							<td class="td-mono-sm">
								{{ page.updatedAt ? page.updatedAt|date('d/m/Y à H:i') : 'Non modifiée' }}
							</td>
							<td>
								<div class="actions">
									<a href="{{ path('admin_legal_pages_edit', { id: page.id }) }}" class="act-link">Modifier</a>

									{# MODIFICATION : Message d'alerte renforcé dans le data-confirm #}
									<form method="post" action="{{ path('admin_legal_pages_delete', { id: page.id }) }}" class="js-confirm-form" data-confirm="⚖️ ATTENTION : Vous allez supprimer la page légale '{{ page.title }}'. Cela peut créer des erreurs 404 sur vos liens de pied de page. Confirmer ?">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ page.id) }}">
										<button class="act-link act-del">Supprimer</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="5" class="td-empty">Aucune page légale trouvée.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
