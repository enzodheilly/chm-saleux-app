{% extends 'admin/base_admin.html.twig' %}

{% block title %}
	{{ title }}
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/legal_pages/index.css') }}">
{% endblock %}

{% block body %}

	<div class="page-header">
		<div>
			<h1>Pages légales</h1>
			<p>Gestion des contenus permanents (CGU, Cookies, Confidentialité, Mentions légales...).</p>
		</div>
		<div class="toolbar">
			<input type="text" id="searchInput" class="search-input" placeholder="Filtrer les pages...">
			<a href="{{ path('admin_legal_pages_new') }}" class="btn-create">
				+ Créer une page
			</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div style="overflow-x: auto;">
			<table class="admin-table" id="pagesTable">
				<thead>
					<tr>
						<th width="80">ID</th>
						<th width="35%">Titre de la page</th>
						<th width="25%">Chemin (URL)</th>
						<th width="20%">Dernière modif.</th>
						<th style="text-align: right;">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for page in pages %}
						<tr>
							<td>
								<span style="font-family: monospace; color: var(--text-muted);">#{{ page.id }}</span>
							</td>

							<td>
								<strong style="font-weight: 600; color: var(--text-main);">{{ page.title }}</strong>
							</td>

							<td>
								<span class="slug-code">/legal/{{ page.slug }}</span>
							</td>

							<td style="color: var(--text-muted); font-size: 0.85rem;">
								{{ page.updatedAt ? page.updatedAt|date('d/m/Y à H:i') : 'Non modifiée' }}
							</td>

							<td>
								<div class="actions">
									<a href="{{ path('admin_legal_pages_edit', { id: page.id }) }}" class="act-link act-edit">
										Modifier
									</a>

									<form method="post" action="{{ path('admin_legal_pages_delete', { id: page.id }) }}" style="display:inline;" onsubmit="return confirm('⚠️ Attention : Supprimer cette page peut créer des erreurs 404 sur votre site.\n\nConfirmer la suppression ?');">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ page.id) }}">
										<button class="act-link act-del">Supprimer</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="5" style="text-align: center; padding: 4rem; color: var(--text-muted);">
								Aucune page légale n'a été trouvée.
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>

{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/legal_pages/index.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
