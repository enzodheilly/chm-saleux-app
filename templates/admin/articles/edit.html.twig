{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier l'article{% endblock %}

{% block stylesheets %}
<style>
    /* =================== CONTAINER =================== */
    .form-container { max-width: 900px; margin: 0 auto; }

    /* =================== HEADER =================== */
    .page-header {
        margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem;
        display: flex; justify-content: space-between; align-items: flex-end;
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--text-main); }
    .page-header p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; }
    .back-link { font-size: 0.85rem; color: var(--text-muted); font-weight: 500; text-decoration: underline; cursor: pointer; }
    .back-link:hover { color: var(--text-main); }

    /* =================== FORM CARD =================== */
    .form-card { background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 6px; padding: 2rem; }
    .form-group { margin-bottom: 1.5rem; }

    /* Labels */
    .form-label { display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }

    /* Inputs */
    .form-control {
        width: 100%; background: var(--bg-body); border: 1px solid var(--border-color); color: var(--text-main);
        padding: 0.75rem 1rem; border-radius: 4px; font-size: 0.95rem; font-family: inherit; transition: border-color 0.2s, box-shadow 0.2s; box-sizing: border-box;
    }
    .form-control:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.1); }
    
    textarea.form-control { min-height: 350px; line-height: 1.6; resize: vertical; }

    /* Grille */
    .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    @media(max-width: 700px) { .form-row-2 { grid-template-columns: 1fr; gap: 0; } }

    /* Image Management */
    .image-management { display: flex; align-items: flex-start; gap: 20px; margin-bottom: 1rem; }
    .current-image-preview { 
        width: 150px; height: 100px; object-fit: cover; 
        border-radius: 4px; border: 1px solid var(--border-color); background: var(--bg-body);
    }
    .image-info { font-size: 0.8rem; color: var(--text-muted); line-height: 1.4; }

    /* =================== ACTIONS (Edit Mode) =================== */
    .form-actions { 
        margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color); 
        display: flex; justify-content: space-between; align-items: center; 
    }
    .btn-group-right { display: flex; gap: 1rem; }

    .btn-cancel { padding: 0.7rem 1.2rem; color: var(--text-muted); font-weight: 600; font-size: 0.9rem; border-radius: 4px; transition: color 0.2s; }
    .btn-cancel:hover { color: var(--text-main); }
    
    .btn-save { background: var(--text-main); color: var(--bg-body); padding: 0.7rem 1.5rem; border-radius: 4px; font-weight: 700; font-size: 0.9rem; border: none; cursor: pointer; transition: opacity 0.2s; }
    .btn-save:hover { opacity: 0.9; }

    .btn-delete { color: var(--danger); background: none; border: none; font-size: 0.85rem; font-weight: 600; cursor: pointer; text-transform: uppercase; opacity: 0.7; transition: 0.2s; }
    .btn-delete:hover { opacity: 1; text-decoration: underline; }

</style>
{% endblock %}

{% block body %}
<div class="form-container">
    
    <div class="page-header">
        <div>
            <h1>Modifier l'article</h1>
            <p>Modification de : <span style="font-weight: 700; color: var(--text-main);">{{ article.title }}</span></p>
        </div>
        <a href="{{ path('admin_articles_index') }}" class="back-link">Retour aux articles</a>
    </div>

    <div class="form-card">
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

        <div class="form-group">
            {{ form_label(form.title, 'Titre de l\'article', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="form-row-2">
            <div class="form-group">
                {{ form_label(form.publishedAt, 'Date de publication', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.publishedAt, {'attr': {'class': 'form-control'}}) }}
            </div>
            
            {% if form.categorie is defined %}
            <div class="form-group">
                {{ form_label(form.categorie, 'Catégorie', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.categorie, {'attr': {'class': 'form-control'}}) }}
            </div>
            {% endif %}
        </div>

        <div class="form-group">
            {{ form_label(form.description, 'Contenu rédactionnel', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="form-group">
            {{ form_label(form.photo, 'Image de couverture', {'label_attr': {'class': 'form-label'}}) }}
            
            {% if article.photo %}
                <div class="image-management">
                    <img src="{{ asset('uploads/' ~ article.photo) }}" alt="Aperçu" class="current-image-preview">
                    <div class="image-info">
                        <strong>Image actuelle</strong><br>
                        Fichier : {{ article.photo }}<br>
                        <small>Téléchargez un nouveau fichier uniquement pour remplacer l'image.</small>
                    </div>
                </div>
            {% endif %}

            {{ form_widget(form.photo, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="form-actions">
            <button type="button" class="btn-delete" onclick="if(confirm('⚠️ Supprimer définitivement cet article ? Cette action est irréversible.')) document.getElementById('delete-form').submit();">
                Supprimer l'article
            </button>

            <div class="btn-group-right">
                <a href="{{ path('admin_articles_index') }}" class="btn-cancel">Annuler</a>
                <button type="submit" class="btn-save">Enregistrer les modifications</button>
            </div>
        </div>

        {{ form_end(form) }}
    </div>

    <form id="delete-form" method="post" action="{{ path('admin_articles_delete', {id: article.id}) }}" style="display: none;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
    </form>
</div>
{% endblock %}