{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des articles
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1>News</h1>
			<p>Manage blog posts and club announcements.</p>
		</div>
		<div class="toolbar">
			<input type="text" id="searchInput" class="search-input" placeholder="Filter by title...">
			<a href="{{ path('admin_articles_new') }}" class="btn-create">+ New Article</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="table-scroll">
			<table class="admin-table" id="articlesTable">
				<thead>
					<tr>
						<th width="35%">Article</th>
						<th width="35%">Content preview</th>
						<th width="15%">Status</th>
						<th class="th-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for article in articles %}
						<tr>
							<td>
								<div class="product-info">
									{% if article.photo %}
										<img src="{{ asset('uploads/' ~ article.photo) }}" alt="" class="product-img">
									{% else %}
										{# Classe placeholder remplace le style inline #}
										<div class="product-img img-placeholder">N/A</div>
									{% endif %}

									<div class="title-stack">
										<strong>{{ article.title }}</strong>
										<span class="td-mono-sm category-tag">
											{{ article.category ? article.category.name : 'General' }}
										</span>
									</div>
								</div>
							</td>

							<td class="td-muted">
								{{ article.description ? (article.description|striptags|slice(0, 80) ~ '...') : '—' }}
							</td>

							<td>
								{% if article.publishedAt %}
									<span class="badge badge-active">Published</span>
									<div class="td-mono-sm date-sub">{{ article.publishedAt|date('d/m/Y') }}</div>
								{% else %}
									<span class="badge badge-draft">Draft</span>
								{% endif %}
							</td>

							<td>
								<div class="actions">
									<a href="{{ path('admin_articles_edit', {id: article.id}) }}" class="act-link">Edit</a>

									{# MODIFICATION : Passage au moteur V20 JS #}
									<form method="post" action="{{ path('admin_articles_delete', {id: article.id}) }}" class="js-confirm-form" data-confirm="📰 Delete the article '{{ article.title }}'? This action will remove it from the public news feed.">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
										<button class="act-link act-del">Delete</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="4" class="td-empty">No articles yet.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
