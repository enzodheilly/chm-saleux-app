{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des articles
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/articles/index.css') }}">
{% endblock %}

{% block body %}

	<div class="page-header">
		<div>
			<h1>News</h1>
			<p>Manage blog posts and club announcements.</p>
		</div>
		<div class="toolbar">
			<input type="text" id="searchInput" class="search-input" placeholder="Filter by title...">
			<a href="{{ path('admin_articles_new') }}" class="btn-create">
				+ New Article
			</a>
		</div>
	</div>

	<div class="table-wrapper">
		<div class="table-scroll">
			<table class="admin-table" id="articlesTable">
				<thead>
					<tr>
						<th width="35%">Article</th>
						<th width="35%">Content preview</th>
						<th width="15%">Published</th>
						<th class="th-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for article in articles %}
						<tr>
							<td>
								<div class="article-preview">
									{% if article.photo %}
										<img src="{{ asset('uploads/' ~ article.photo) }}" alt="" class="thumb">
									{% else %}
										<div class="no-thumb">N/A</div>
									{% endif %}

									<div class="title-group">
										<strong>{{ article.title }}</strong>

										<span class="cat-tag">
											{{ article.category ? article.category.name : 'General' }}
										</span>
									</div>
								</div>
							</td>

							<td class="td-preview">
								{{ article.description ? (article.description|striptags|slice(0, 80) ~ '...') : '—' }}
							</td>

							<td>
								<span class="date-badge">
									{% if article.publishedAt %}
										{{ article.publishedAt|date('d/m/Y') }}
									{% else %}
										<span class="draft-tag">Draft</span>
									{% endif %}
								</span>
							</td>

							<td>
								<div class="actions">
									<a href="{{ path('admin_articles_edit', {id: article.id}) }}" class="act-link act-edit">
										Edit
									</a>

									<form method="post" action="{{ path('admin_articles_delete', {id: article.id}) }}" class="form-inline" data-confirm="Delete this article permanently?">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
										<button class="act-link act-del">Delete</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="4" class="td-empty">No articles yet.</td>

						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>

{% endblock %}

{% block javascripts %}
	 <script src="{{ asset('js/admin/articles/index.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
