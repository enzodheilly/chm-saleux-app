{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block stylesheets %}
<style>
    /* =================== CONTAINER =================== */
    .form-container { max-width: 1100px; margin: 0 auto; }

    /* =================== HEADER =================== */
    .page-header {
        margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem;
        display: flex; justify-content: space-between; align-items: flex-end;
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--text-main); }
    .page-header p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 0.9rem; }
    .back-link { font-size: 0.85rem; color: var(--text-muted); font-weight: 500; text-decoration: underline; }
    .back-link:hover { color: var(--text-main); }

    /* =================== FORM CARD =================== */
    .form-card { background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 6px; padding: 2rem; }
    .form-group { margin-bottom: 1.5rem; }

    /* Labels */
    .form-label { display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }

    /* Inputs */
    .form-control {
        width: 100%; background: var(--bg-body); border: 1px solid var(--border-color); color: var(--text-main);
        padding: 0.75rem 1rem; border-radius: 4px; font-size: 0.95rem; font-family: inherit; transition: 0.2s; box-sizing: border-box;
    }
    .form-control:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.1); }
    
    /* Textarea spécifique pour le contenu */
    textarea.form-control {
        min-height: 500px;
        font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
        line-height: 1.6;
        font-size: 0.9rem;
        resize: vertical;
    }

    /* Grid Titre / Slug */
    .form-row-page { display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; }
    @media(max-width: 800px) { .form-row-page { grid-template-columns: 1fr; gap: 1rem; } }

    .help-text { display: block; margin-top: 5px; font-size: 0.75rem; color: var(--text-muted); font-style: italic; }

    /* Actions */
    .form-actions {
        margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color);
        display: flex; justify-content: flex-end; gap: 1rem;
    }

    .btn-cancel { padding: 0.7rem 1.2rem; color: var(--text-muted); font-weight: 600; font-size: 0.9rem; border-radius: 4px; }
    .btn-save { background: var(--text-main); color: var(--bg-body); padding: 0.7rem 1.5rem; border-radius: 4px; font-weight: 700; border: none; cursor: pointer; }
    .btn-save:hover { opacity: 0.9; }

</style>
{% endblock %}

{% block page_title %}{{ title }}{% endblock %}

{% block body %}
<div class="form-container">
    
    <div class="page-header">
        <div>
            <h1>Éditeur de Page</h1>
            <p>Le contenu sera publié sous le chemin : <strong style="color: var(--accent);">/{{ form.vars.value.slug|default('...') }}</strong></p>
        </div>
        <a href="{{ path('admin_pages_index') }}" class="back-link">Annuler les modifications</a>
    </div>

    <div class="form-card">
        {{ form_start(form) }}

        <div class="form-row-page">
            <div class="form-group">
                {{ form_label(form.title, 'Titre de la page', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Notre Histoire'}}) }}
                <div style="color: var(--danger); font-size: 0.8rem;">{{ form_errors(form.title) }}</div>
            </div>
            <div class="form-group">
                {{ form_label(form.slug, 'URL (Slug)', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.slug, {'attr': {'class': 'form-control', 'placeholder': 'notre-histoire'}}) }}
                <span class="help-text">Utilisé pour l'adresse de la page.</span>
                <div style="color: var(--danger); font-size: 0.8rem;">{{ form_errors(form.slug) }}</div>
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.content, 'Contenu de la page (HTML ou Texte)', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.content, {'attr': {'class': 'form-control'}}) }}
            <div style="color: var(--danger); font-size: 0.8rem;">{{ form_errors(form.content) }}</div>
        </div>

        <div class="form-actions">
            <a href="{{ path('admin_pages_index') }}" class="btn-cancel">Quitter</a>
            <button type="submit" class="btn-save">
                {{ form.vars.value.id is not null ? 'Mettre à jour la page' : 'Publier la page' }}
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}