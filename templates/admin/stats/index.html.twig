{% extends 'admin/base_admin.html.twig' %}

{% block title %}Tableau de Bord Analytique
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/admin/stats/index.css') }}">
{% endblock %}

{% block body %}
	<div class="dashboard-container">

		<div class="page-header">
			<div>
				<h1>Statistiques d'activité</h1>
				<p>Indicateurs clés de performance et croissance du club.</p>
			</div>
			<div class="last-update">
				Dernière mise à jour :
				{{ "now"|date("d/m/Y H:i") }}
			</div>
		</div>

		{# CARTES KPI #}
		<div class="stats-grid">
			<div class="stat-card">
				<span class="stat-label">Utilisateurs inscrits</span>
				<span class="stat-value">{{ totalUsers|number_format(0, '.', ' ') }}</span>
			</div>
			<div class="stat-card">
				<span class="stat-label">Articles publiés</span>
				<span class="stat-value">{{ totalArticles }}</span>
			</div>
			<div class="stat-card">
				<span class="stat-label">Abonnés newsletter</span>
				<span class="stat-value">{{ newsletterSubscribers }}</span>
			</div>
		</div>

		{# GRAPHIQUES #}
		<div class="charts-row">
			<div class="chart-card">
				<h3 class="chart-title">Inscriptions (7 derniers jours)</h3>
				<div class="chart-container">
					<canvas id="usersChart"></canvas>
				</div>
			</div>
			<div class="chart-card">
				<h3 class="chart-title">Activité éditoriale</h3>
				<div class="chart-container">
					<canvas id="articlesChart"></canvas>
				</div>
			</div>
		</div>

	</div>
{% endblock %}

{# ✅ Block javascripts HORS du block body #}
{% block javascripts %} <script src="https://cdn.jsdelivr.net/npm/chart.js" nonce="{{ csp_nonce('script') }}"></script>

	 <script nonce="{{ csp_nonce('script') }}">
				        window.statsData = {
				            labels: {{ labels|json_encode|raw }},
				            userRegistrations: {{ userRegistrations|json_encode|raw }},
				            articlesPublished: {{ articlesPublished|json_encode|raw }}
				        };
				    </script>

	 <script src="{{ asset('js/admin/stats/index.js') }}" nonce="{{ csp_nonce('script') }}"></script>
{% endblock %}
