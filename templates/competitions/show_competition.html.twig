{% extends 'base.html.twig' %}

{% block title %}{{ competition.title }} — CHM Saleux{% endblock %}

{% block og_description %}
	{{ competition.description ? competition.description|striptags|slice(0, 150) ~ '...' : 'Découvrez les résultats de cette compétition du CHM Saleux.' }}
{% endblock %}

{% block og_image %}
	{{ app.request.schemeAndHttpHost ~ (competition.image ? asset('uploads/competitions/' ~ competition.image) : asset('images/club/club1.jpg')) }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/competitions/competition-detail.css') }}">
{% endblock %}

{% block body %}

{% set backGender = (competition.gender in ['female', 'feminine']) ? 'feminine' : 'masculine' %}
{% set teamLabel  = backGender == 'feminine' ? 'Féminine' : 'Masculine' %}

<main class="cd-root">

	{# ── EN-TÊTE ÉDITORIAL ── #}
	<div class="cd-page-header">
		<div class="cd-content-container">

			<nav class="cd-breadcrumb">
				<a href="{{ path('competitions_team', { gender: backGender }) }}">Équipe {{ teamLabel|lower }}</a>
				<i class="fa-solid fa-chevron-right"></i>
				<a href="{{ path('competition_team_archives', { gender: backGender }) }}">Archives</a>
			</nav>

			<span class="cd-badge">Équipe {{ teamLabel }}</span>

			<h1 class="cd-title">{{ competition.title }}</h1>

			<div class="cd-meta">
				{% if competition.eventDate %}
					<span class="cd-meta-item">
						<i class="fa-regular fa-calendar-check"></i>
						{{ competition.eventDate|date('d F Y') }}
					</span>
				{% endif %}
				{% if competition.location %}
					<span class="cd-meta-item">
						<i class="fa-solid fa-location-dot"></i>
						{{ competition.location }}
					</span>
				{% endif %}
				{% if competition.competitionType %}
					<span class="cd-meta-item">
						<i class="fa-solid fa-trophy"></i>
						{{ competition.competitionType }}
					</span>
				{% endif %}
				<span class="cd-meta-item">
					<i class="fa-solid fa-users"></i>
					{{ competition.results|length }} athlète{{ competition.results|length > 1 ? 's' : '' }}
				</span>
			</div>

		</div>
	</div>

	{# ── PHOTO PLEINE LARGEUR ── #}
	{% if competition.image %}
		<div class="cd-cover">
			<img
				src="{{ asset('uploads/competitions/' ~ competition.image) }}"
				alt="{{ competition.title }}"
				draggable="false"
				loading="eager">
		</div>
	{% endif %}

	{# ── CONTENU ── #}
	<section class="cd-body-wrapper">
		<div class="cd-content-container">

				{# ── Classement équipe ── #}
			{% if competition.teamRanking %}
				<div class="cd-ranking-banner">
					<div class="cd-ranking-icon">
						<i class="fa-solid fa-medal"></i>
					</div>
					<div>
						<span class="cd-ranking-eyebrow">Classement par équipes</span>
						<p class="cd-ranking-value">
							{{ competition.teamRanking }}{{ competition.teamRanking == 1 ? 'er' : 'e' }}
							{{ backGender == 'feminine' ? 'équipe féminine' : 'club' }}
						</p>
					</div>
				</div>
			{% endif %}

			{# ── Description ── #}
			{% if competition.description %}
				<div class="cd-description">
					{{ competition.description|nl2br }}
				</div>
			{% endif %}

			{# ── Résultats ── #}
			<div class="cd-results-section">

				<h2 class="cd-results-heading">
					Résultats du <span>Plateau</span>
				</h2>

				{% if competition.results|length > 0 %}
					<div class="cd-table-wrap">
						<table class="cd-table">
							<thead>
								<tr>
									<th class="col-rank">#</th>
									<th>Athlète</th>
									<th>Catégorie</th>
									<th class="col-num">Poids de corps</th>
									<th class="col-num">Arraché</th>
									<th class="col-num">Épaulé-Jeté</th>
									<th class="col-total">Total</th>
									<th class="col-pts">Points</th>
									<th class="col-level">Niveau</th>
								</tr>
							</thead>
							<tbody>
								{% for result in competition.results %}
									<tr class="cd-row {% if loop.index == 1 %}cd-row--gold{% elseif loop.index == 2 %}cd-row--silver{% elseif loop.index == 3 %}cd-row--bronze{% endif %}">
										<td class="col-rank">
											{% if loop.index <= 3 %}
												<span class="cd-medal cd-medal--{{ loop.index == 1 ? 'gold' : (loop.index == 2 ? 'silver' : 'bronze') }}">
													<i class="fa-solid fa-medal"></i>
												</span>
											{% else %}
												<span class="cd-row-num">{{ loop.index }}</span>
											{% endif %}
										</td>
										<td data-label="Athlète" class="col-name">
											<strong class="cd-lastname">{{ result.lastName }}</strong>
											<span class="cd-firstname">{{ result.firstName }}</span>
										</td>
										<td data-label="Catégorie">{{ result.category ?: '—' }}</td>
										<td class="col-num" data-label="Poids de corps">{{ result.bodyWeight ? result.bodyWeight ~ ' kg' : '—' }}</td>
										<td class="col-num" data-label="Arraché">{{ result.snatch ? result.snatch ~ ' kg' : '—' }}</td>
										<td class="col-num" data-label="Épaulé-Jeté">{{ result.cleanAndJerk ? result.cleanAndJerk ~ ' kg' : '—' }}</td>
										<td class="col-total" data-label="Total">{{ result.total ? result.total ~ ' kg' : '—' }}</td>
										<td class="col-pts" data-label="Points">{{ result.points ?: '—' }}</td>
										<td class="col-level" data-label="Niveau">
											{% if result.rankingLevel %}
												<span class="cd-level-pill">{{ result.rankingLevel }}</span>
											{% else %}—{% endif %}
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% else %}
					<div class="cd-empty">
						<i class="fa-solid fa-clipboard-list"></i>
						<p>Aucun résultat enregistré pour cette compétition.</p>
					</div>
				{% endif %}

			</div>

			<div class="cd-bottom-nav">
				<a href="{{ path('competition_team_archives', { gender: backGender }) }}" class="cd-back-link">
					<i class="fa-solid fa-arrow-left-long"></i>
					Archives {{ teamLabel|lower }}s
				</a>
			</div>

		</div>
	</section>

</main>

{% endblock %}
