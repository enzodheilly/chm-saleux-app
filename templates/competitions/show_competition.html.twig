{% extends 'base.html.twig' %}

{% block title %}{{ competition.title }} — Détail compétition | CHM Saleux{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/competitions/feminine.css') }}">
    <link rel="stylesheet" href="{{ asset('css/competitions/competition-detail.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
{% endblock %}

{% block body %}

<header class="page-header-sport"
        style="--bg-image: url('{% if competition.image %}{{ asset('uploads/competitions/' ~ competition.image) }}{% else %}{{ asset('images/defaults/competition-placeholder.jpg') }}{% endif %}');">
    <div class="header-overlay-gradient"></div>

    <div class="header-content">
        <div class="page-container">
            <nav class="breadcrumb-nav detail-breadcrumbs">
                <a href="{{ path('competition_root') }}" class="back-link-minimal">
                    <i class="fa-solid fa-chevron-left"></i>
                    <span>Retour aux compétitions</span>
                </a>

            </nav>

            <div class="header-main-box">
                <div class="badge-accent">
                    {{ competition.gender == 'female' ? 'Équipe féminine' : (competition.gender == 'male' ? 'Équipe masculine' : 'Compétition') }}
                </div>

                <h1>{{ competition.title }}</h1>

                <p class="lead detail-lead">
                    <span><i class="fa-regular fa-calendar"></i> {{ competition.eventDate ? competition.eventDate|date('d F Y') : 'Date non renseignée' }}</span>
                    <span><i class="fa-solid fa-location-dot"></i> {{ competition.location ?: 'Lieu non renseigné' }}</span>
                </p>
            </div>
        </div>
    </div>
</header>

<main class="page-shell dashboard-root competition-detail-root">

    <section class="page-container section-spacer pt-0">
        <div class="detail-top-grid">

            <article class="detail-info-card">
                <div class="section-header-compact">
                    <h2 class="section-heading">Informations <span>Compétition</span></h2>
                </div>

                <div class="detail-meta-list">
                    <div class="detail-meta-item">
                        <span class="meta-label">Titre</span>
                        <span class="meta-value">{{ competition.title }}</span>
                    </div>

                    <div class="detail-meta-item">
                        <span class="meta-label">Date</span>
                        <span class="meta-value">
                            {{ competition.eventDate ? competition.eventDate|date('d/m/Y') : 'Non renseignée' }}
                        </span>
                    </div>

                    <div class="detail-meta-item">
                        <span class="meta-label">Lieu</span>
                        <span class="meta-value">{{ competition.location ?: 'Non renseigné' }}</span>
                    </div>

                    {% if competition.competitionType %}
                        <div class="detail-meta-item">
                            <span class="meta-label">Type</span>
                            <span class="meta-value">{{ competition.competitionType }}</span>
                        </div>
                    {% endif %}

                    <div class="detail-meta-item">
                        <span class="meta-label">Équipe</span>
                        <span class="meta-value">
                            {{ competition.gender == 'female' ? 'Féminine' : (competition.gender == 'male' ? 'Masculine' : '—') }}
                        </span>
                    </div>

                    <div class="detail-meta-item">
                        <span class="meta-label">Résultats</span>
                        <span class="meta-value">{{ competition.results|length }} athlète{{ competition.results|length > 1 ? 's' : '' }}</span>
                    </div>
                </div>
            </article>

            {% if competition.teamRanking %}
                <article class="detail-rank-card">
                    <span class="rank-label">Classement équipe</span>
                    <div class="rank-number">{{ competition.teamRanking }}<sup>er</sup></div>
                    <p class="rank-caption">Performance collective sur ce plateau</p>
                </article>
            {% endif %}
        </div>
    </section>

    <section class="page-container section-spacer pt-0">
        <div class="section-header-compact">
            <h2 class="section-heading">Résultats <span>du plateau</span></h2>
        </div>

        {% if competition.results|length > 0 %}
            <div class="result-card-main detail-result-card">
                <div class="table-container">
                    <table class="stats-table">
                        <thead>
                            <tr>
                                <th>Athlète</th>
                                <th>Cat.</th>
                                <th class="text-center">PC</th>
                                <th class="text-center">Arraché</th>
                                <th class="text-center">E.J.</th>
                                <th class="highlight">Total</th>
                                <th class="highlight-accent">Pts</th>
                                <th class="text-center">Niveau</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for result in competition.results %}
                                <tr class="athlete-row">
                                    <td>
                                        <div class="ath-name-cell">
                                            <strong>{{ result.lastName }}</strong> {{ result.firstName }}
                                        </div>
                                    </td>

                                    <td>
                                        <span class="cat-pill">{{ result.category ?: '--' }}</span>
                                    </td>

                                    <td class="text-center weight-val">
                                        {{ result.bodyWeight is not null ? result.bodyWeight ~ 'kg' : '--' }}
                                    </td>

                                    <td class="text-center weight-val">
                                        {{ result.snatch is not null ? result.snatch ~ 'kg' : '--' }}
                                    </td>

                                    <td class="text-center weight-val">
                                        {{ result.cleanAndJerk is not null ? result.cleanAndJerk ~ 'kg' : '--' }}
                                    </td>

                                    <td class="highlight total-val">
                                        {{ result.total is not null ? result.total ~ 'kg' : '--' }}
                                    </td>

                                    <td class="highlight-accent points-val">
                                        {{ result.points is not null ? result.points : '--' }}
                                    </td>

                                    <td class="text-center">
                                        <span class="ranking-pill">{{ result.rankingLevel ?: '--' }}</span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% else %}
            <div class="empty-dashboard">
                <p>Aucun résultat enregistré pour cette compétition.</p>
            </div>
        {% endif %}
    </section>

    <section class="page-container section-spacer pt-0 detail-bottom-actions">
        {% if competition.gender == 'female' %}
            <a href="{{ path('competition_feminine_archives') }}" class="btn-history-ghost">
                <i class="fa-solid fa-arrow-left"></i> Retour aux archives féminines
            </a>
        {% elseif competition.gender == 'male' %}
            <a href="{{ path('competitions_masculine') }}" class="btn-history-ghost">
                <i class="fa-solid fa-arrow-left"></i> Retour à l’équipe masculine
            </a>
        {% else %}
            <a href="{{ path('competition_root') }}" class="btn-history-ghost">
                <i class="fa-solid fa-arrow-left"></i> Retour aux compétitions
            </a>
        {% endif %}
    </section>

</main>
{% endblock %}