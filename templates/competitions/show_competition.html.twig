{% extends 'base.html.twig' %}

{% block title %}
	{{ competition.title }}
	— Détail compétition | CHM Saleux
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/competitions/feminine.css') }}">
	<link rel="stylesheet" href="{{ asset('css/competitions/competition-detail.css') }}">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
	<style nonce="{{ csp_nonce('style') }}">
		.competition-detail-header-bg {
			--bg-image: url('{% if competition.image %}{{ asset('uploads/competitions/' ~ competition.image) }}{% else %}{{ asset('images/defaults/competition-placeholder.jpg') }}{% endif %}');
		}
	</style>
{% endblock %}

{% block body %}

	{# HEADER #}
	<header class="page-header-sport competition-detail-header-bg">
		<div class="header-content">
			<div class="page-container">
				<a href="{{ path('competition_root') }}" class="back-link-minimal">
					<i class="fa-solid fa-chevron-left"></i>
					<span>Retour aux compétitions</span>
				</a>
				<div class="header-main-box">
					<div class="badge-accent">
						{{ competition.gender == 'female' ? 'Équipe féminine' : (competition.gender == 'male' ? 'Équipe masculine' : 'Compétition') }}
					</div>
					<h1>{{ competition.title }}</h1>
					<div class="detail-lead">
						<span>
							<i class="fa-regular fa-calendar"></i>
							{{ competition.eventDate ? competition.eventDate|date('d F Y') : 'Date non renseignée' }}</span>
						<span>
							<i class="fa-solid fa-location-dot"></i>
							{{ competition.location ?: 'Lieu non renseigné' }}</span>
						{% if competition.competitionType %}
							<span>
								<i class="fa-solid fa-trophy"></i>
								{{ competition.competitionType }}</span>
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</header>

	{# IMAGE DÉCORATIVE GAUCHE #}
	<div class="deco-left-wrap">
		<img src="{{ asset('images/decorations/dots-tree.png') }}" alt="" class="deco-left-img" aria-hidden="true">
	</div>

	<main
		class="page-shell competition-detail-root">

		{# TITRE DE SECTION CORRIGÉ #}
		<div class="section-header-compact centered">
			<h2 class="section-heading">
				Résultats de la
				<span>Compétition</span>
			</h2>
		</div>

		{# BLOC STATS RAPIDES - SYNTAXE CORRIGÉE ICI #}
		<section class="detail-stats-band">
			<div class="page-container">
				<div class="stats-band-grid">
					<div class="stat-band-item">
						<i class="fa-solid fa-users"></i>
						<div>
							<span class="stat-band-value">{{ competition.results|length }}</span>
							<span class="stat-band-label">Athlète{{ competition.results|length > 1 ? 's' : '' }}</span>
						</div>
					</div>
					<div class="stat-band-item">
						<i class="fa-solid fa-location-dot"></i>
						<div>
							<span class="stat-band-value">{{ competition.location ?: '—' }}</span>
							<span class="stat-band-label">Lieu</span>
						</div>
					</div>
					{% if competition.teamRanking %}
						<div class="stat-band-item stat-band-item--accent">
							<i class="fa-solid fa-medal"></i>
							<div>
								<span class="stat-band-value">{{ competition.teamRanking }}<sup>er</sup>
								</span>
								<span class="stat-band-label">Classement équipe</span>
							</div>
						</div>
					{% endif %}
					<div class="stat-band-item">
						<i class="fa-regular fa-calendar"></i>
						<div>
							<span class="stat-band-value">{{ competition.eventDate ? competition.eventDate|date('d/m/Y') : '—' }}</span>
							<span class="stat-band-label">Date</span>
						</div>
					</div>
					{% if competition.competitionType %}
						<div class="stat-band-item">
							<i class="fa-solid fa-tag"></i>
							<div>
								<span class="stat-band-value">{{ competition.competitionType }}</span>
								<span class="stat-band-label">Type</span>
							</div>
						</div>
					{% endif %}
				</div>
			</div>
		</section>

		{# DESCRIPTION #}
		{% if competition.description %}
			<section class="page-container detail-description-section">
				<div class="detail-description-box">
					<div class="detail-description-icon">
						<i class="fa-solid fa-newspaper"></i>
					</div>
					<div class="detail-description-content">
						<h3 class="detail-description-title">À propos de cette compétition</h3>
						<p class="detail-description-text">{{ competition.description }}</p>
					</div>
				</div>
			</section>
		{% endif %}

		{# TABLEAU RÉSULTATS #}
		<section class="page-container section-spacer">
			<div class="detail-results-header">
				<div>
					<h2 class="section-heading">Résultats
						<span>du plateau</span>
					</h2>
					<p class="section-subtitle">{{ competition.results|length }}
						athlète{{ competition.results|length > 1 ? 's' : '' }}
						enregistré{{ competition.results|length > 1 ? 's' : '' }}</p>
				</div>
			</div>

			{% if competition.results|length > 0 %}
				<div class="detail-table-wrapper">
					<table class="stats-table">
						<thead>
							<tr>
								<th>Athlète</th>
								<th>Catégorie</th>
								<th class="text-center">PC</th>
								<th class="text-center">Arraché</th>
								<th class="text-center">Épaulé-Jeté</th>
								<th class="highlight">Total</th>
								<th class="highlight-accent">Points</th>
								<th class="text-center">Niveau</th>
							</tr>
						</thead>
						<tbody>
							{% for result in competition.results %}
								<tr class="athlete-row">
									<td class="ath-name-cell" data-label="Athlète">
										<div class="ath-name-inline">
											<span class="ath-last-name">{{ result.lastName }}</span>
											<span class="ath-first-name">{{ result.firstName }}</span>
											<span class="ath-bodyweight">PC :
												{{ result.bodyWeight is not null ? result.bodyWeight ~ ' kg' : '--' }}</span>
										</div>
									</td>
									<td data-label="Catégorie">
										<span class="cat-pill">{{ result.category ?: '--' }}</span>
									</td>
									<td class="text-center weight-val bodyweight-cell" data-label="PC">
										{{ result.bodyWeight is not null ? result.bodyWeight ~ ' kg' : '--' }}
									</td>
									<td class="text-center weight-val" data-label="Arraché">
										{{ result.snatch is not null ? result.snatch ~ ' kg' : '--' }}
									</td>
									<td class="text-center weight-val" data-label="E.J.">
										{{ result.cleanAndJerk is not null ? result.cleanAndJerk ~ ' kg' : '--' }}
									</td>
									<td class="highlight total-val" data-label="Total">
										{{ result.total is not null ? result.total ~ ' kg' : '--' }}
									</td>
									<td class="highlight-accent points-val" data-label="Points">
										{{ result.points is not null ? result.points : '--' }}
									</td>
									<td class="text-center" data-label="Niveau">
										<span class="ranking-pill">{{ result.rankingLevel ?: '--' }}</span>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% else %}
				<div class="detail-empty">
					<i class="fa-solid fa-circle-info"></i>
					<p>Aucun résultat enregistré pour cette compétition.</p>
				</div>
			{% endif %}
		</section>

		{# BOUTON RETOUR #}
		<section class="page-container detail-bottom-actions">
			{% if competition.gender == 'female' %}
				<a href="{{ path('competition_feminine_archives') }}" class="btn-history-ghost">
					<i class="fa-solid fa-arrow-left"></i>
					Retour aux archives féminines
				</a>
			{% elseif competition.gender == 'male' %}
				<a href="{{ path('competitions_masculine') }}" class="btn-history-ghost">
					<i class="fa-solid fa-arrow-left"></i>
					Retour à l'équipe masculine
				</a>
			{% else %}
				<a href="{{ path('competition_root') }}" class="btn-history-ghost">
					<i class="fa-solid fa-arrow-left"></i>
					Retour aux compétitions
				</a>
			{% endif %}
		</section>
	</main>
{% endblock %}
