{% extends 'base.html.twig' %}

{% set isFeminine = gender == 'feminine' %}

{% block title %}
	{{ isFeminine ? 'Équipe Féminine' : 'Équipe Masculine' }}
	— CHM Saleux
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/competitions/team.css') }}">
	<link rel="stylesheet" href="{{ asset('css/competitions/team-archives.css') }}">
{% endblock %}

{% block body %}

	<header class="page-header-sport {{ isFeminine ? 'feminine-header-bg' : 'masculine-header-bg' }}">
		<div class="header-overlay-gradient"></div>

		<div class="header-content">
			<div class="page-container">
				<nav class="breadcrumb-nav">
					<a href="{{ path('competition_root') }}" class="back-link-minimal">
						<i class="fa-solid fa-chevron-left"></i>
						<span>Compétitions</span>
					</a>
				</nav>

				<div class="header-main-box">
					<div class="badge-accent">Saison 2025 / 2026</div>
					<h1>Équipe
						<span class="text-outline">{{ isFeminine ? 'Féminine' : 'Masculine' }}</span>
					</h1>
					<p class="lead">Performance, puissance & progression. Suivez le parcours de nos athlètes.</p>
				</div>
			</div>
		</div>
	</header>

	<main
		class="page-shell dashboard-root team-root">

		{# --- EFFECTIF --- #}
		<section class="page-container section-spacer athlete-section">
			<div class="section-header-row">
				<h2 class="section-heading">Effectif
					<span>Saison 25/26</span>
				</h2>

				<div class="slider-nav">
					<button id="prevAthlete" type="button" class="nav-circle" aria-label="Précédent">
						<i class="fa-solid fa-arrow-left"></i>
					</button>
					<button id="nextAthlete" type="button" class="nav-circle" aria-label="Suivant">
						<i class="fa-solid fa-arrow-right"></i>
					</button>
				</div>
			</div>

			<div class="athlete-viewport">
				<div class="athlete-track" id="athleteTrack">
					{% for athlete in athletes %}
						<div class="athlete-card-modern">
							<div class="athlete-img-wrapper">
								<img src="{{ athlete.image ? asset('uploads/athletes/' ~ athlete.image) : asset('images/defaults/athlete-placeholder.jpg') }}" alt="{{ athlete.firstName }} {{ athlete.lastName }}" loading="lazy">
								<div class="athlete-overlay"></div>
								{% if athlete.category %}
									<div class="athlete-cat-tag">{{ athlete.category }}</div>
								{% endif %}
							</div>
							<div class="athlete-info">
								<span class="last-name">{{ athlete.lastName }}</span>
								<span class="first-name">{{ athlete.firstName }}</span>
							</div>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>

		{# --- DERNIER RÉSULTAT --- #}
		<section class="page-container section-spacer pt-0 last-result-section">
			<div class="section-header-compact">
				<h2 class="section-heading">Dernier
					<span>Plateau</span>
				</h2>
			</div>

			{% set lastCompetition = competitions|first %}
			{% if lastCompetition %}
				<div class="lp-card">
					<div class="lp-split">

						{# ── Colonne gauche : image ── #}
						<div class="lp-img-col">
							<img
								src="{{ lastCompetition.image ? asset('uploads/competitions/' ~ lastCompetition.image) : asset('images/defaults/competition-placeholder.jpg') }}"
								alt="{{ lastCompetition.title }}"
								draggable="false">
							{% if lastCompetition.teamRanking %}
								<div class="lp-rank-pill">
									<i class="fa-solid fa-medal"></i>
									{{ lastCompetition.teamRanking }}{{ lastCompetition.teamRanking == 1 ? 'er' : 'e' }}
									{{ isFeminine ? 'équipe' : 'club' }}
								</div>
							{% endif %}
						</div>

						{# ── Colonne droite : meta + tableau ── #}
						<div class="lp-content-col">

							<div class="lp-meta">
								<span class="lp-eyebrow">Dernier plateau</span>
								<h3 class="lp-title">{{ lastCompetition.title }}</h3>
								<div class="lp-infos">
									{% if lastCompetition.eventDate %}
										<span class="lp-info-item">
											<i class="fa-regular fa-calendar"></i>
											{{ lastCompetition.eventDate|date('d F Y') }}
										</span>
									{% endif %}
									{% if lastCompetition.location %}
										<span class="lp-info-item">
											<i class="fa-solid fa-location-dot"></i>
											{{ lastCompetition.location }}
										</span>
									{% endif %}
								</div>
								<div class="lp-bar">
									<span class="lp-athletes-count">
										<i class="fa-solid fa-users"></i>
										{{ lastCompetition.results|length }} athlète{{ lastCompetition.results|length > 1 ? 's' : '' }}
									</span>
									<a href="{{ path('competition_show', { id: lastCompetition.id }) }}" class="lp-detail-link">
										Voir le détail <i class="fa-solid fa-arrow-right"></i>
									</a>
								</div>
							</div>

							<div class="table-container">
								<table class="stats-table">
									<thead>
										<tr>
											<th>Athlète</th>
											{% if isFeminine %}<th>Cat.</th>{% endif %}
											<th class="text-center">Arraché</th>
											<th class="text-center">E.J.</th>
											<th class="highlight">Total</th>
											<th class="highlight-accent">{{ isFeminine ? 'Pts' : 'Points' }}</th>
											{% if not isFeminine %}<th>Statut</th>{% endif %}
										</tr>
									</thead>
									<tbody>
										{% for result in lastCompetition.results %}
											<tr class="athlete-row">
												<td class="ath-name-cell" data-label="Athlète">
													<div class="ath-name-inline">
														<span class="ath-last-name">{{ result.lastName }}</span>
														<span class="ath-first-name">{{ result.firstName }}</span>
														<span class="ath-bodyweight">PC: {{ result.bodyWeight|default('--') }} kg</span>
													</div>
												</td>
												{% if isFeminine %}
													<td data-label="Catégorie"><span class="cat-pill">{{ result.category }}</span></td>
												{% endif %}
												<td class="text-center weight-val" data-label="Arraché">{{ result.snatch }} kg</td>
												<td class="text-center weight-val" data-label="E.J.">{{ result.cleanAndJerk }} kg</td>
												<td class="highlight total-val" data-label="Total">{{ result.total }} kg</td>
												<td class="highlight-accent points-val" data-label="Points">{{ result.points }}</td>
												{% if not isFeminine %}
													<td data-label="Statut">
														{% if result.rankingLevel %}
															<span class="status-pill success">Classé</span>
														{% else %}
															<span class="status-pill error">Non classé</span>
														{% endif %}
													</td>
												{% endif %}
											</tr>
										{% else %}
											<tr class="athlete-row">
												<td colspan="6" class="empty-dashboard">Aucun résultat disponible.</td>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>

						</div>{# fin lp-content-col #}
					</div>{# fin lp-split #}
				</div>
			{% else %}
				<div class="empty-dashboard">
					<p>La saison n'a pas encore commencé.</p>
				</div>
			{% endif %}
		</section>

		{# --- ARCHIVES --- #}
		{% if competitions|length > 1 %}
			<section class="page-container section-spacer pt-0 section-history">
				<div class="section-header-compact">
					<h2 class="section-heading">Archives
						<span>Saison en cours</span>
					</h2>
				</div>

				<div class="arc-grid">
					{% for comp in competitions|slice(1, 3) %}
						<a href="{{ path('competition_show', { id: comp.id }) }}" class="arc-card">

							<div class="arc-card-media">
								<img
									class="arc-card-img"
									src="{{ comp.image ? asset('uploads/competitions/' ~ comp.image) : asset('images/defaults/competition-placeholder.jpg') }}"
									alt="{{ comp.title }}"
									loading="lazy"
									draggable="false">
							</div>

							<div class="arc-card-body">
								<span class="arc-card-eyebrow {% if comp.teamRanking and comp.teamRanking <= 3 %}arc-eyebrow--orange{% endif %}">
									{% if comp.teamRanking %}
										{{ comp.teamRanking }}{{ comp.teamRanking == 1 ? 'er' : 'e' }} classement
									{% elseif comp.location %}
										{{ comp.location }}
									{% else %}
										Plateau national
									{% endif %}
								</span>

								<h4 class="arc-card-title">{{ comp.title }}</h4>

								{% if comp.description %}
									<p class="arc-card-excerpt">{{ comp.description|striptags|slice(0, 110) }}…</p>
								{% endif %}

								<div class="arc-card-footer">
									{% if comp.results|length > 0 %}
										<span class="arc-card-meta">{{ comp.results|length }} athlète{{ comp.results|length > 1 ? 's' : '' }}</span>
									{% endif %}
									<span class="arc-card-date">
										{{ comp.eventDate ? comp.eventDate|date('d/m/Y') : '' }}
									</span>
								</div>
							</div>

						</a>
					{% endfor %}
				</div>

				{% if competitions|length > 4 %}
					<div class="history-more-wrap">
						<a href="{{ path('competition_team_archives', { gender: gender }) }}" class="btn-history-more">
							Voir plus de résultats
						</a>
					</div>
				{% endif %}
			</section>
		{% endif %}

	</main>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	 <script src="{{ asset('js/competitions/competitions.js') }}"></script>
{% endblock %}
