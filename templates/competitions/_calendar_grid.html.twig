{# templates/competitions/_calendar_grid.html.twig #}

<div class="calendar-header-minimal">
    <div class="month-selector">
        <a href="{{ path('competition', prevParams) }}" class="nav-arrow js-calendar-nav" aria-label="Mois précédent">
            <i class="fa-solid fa-angle-left"></i>
        </a>
        <h3 class="current-month-display">
            {{ currentMonthName|format_date(locale='fr', pattern='MMMM yyyy')|capitalize }}
        </h3>
        <a href="{{ path('competition', nextParams) }}" class="nav-arrow js-calendar-nav" aria-label="Mois suivant">
            <i class="fa-solid fa-angle-right"></i>
        </a>
    </div>
</div>

<div class="calendar-main-grid">
    {# En-têtes de jours #}
    {% for dayName in ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'] %}
        <div class="day-header">{{ dayName }}</div>
    {% endfor %}

    {# Cellules vides pour le décalage #}
    {% if startDay > 1 %}
        {% for i in 1..(startDay - 1) %}
            <div class="day-cell-wrapper empty"></div>
        {% endfor %}
    {% endif %}

    {# Boucle des jours réels #}
    {% for day in 1..daysInMonth %}
        {% set dateKey = currentYear ~ "-" ~ (currentMonth|format('%02d')) ~ "-" ~ (day|format('%02d')) %}
        {% set dayEvents = eventsByDate[dateKey] ?? [] %}
        {% set hasEvent = dayEvents|length > 0 %}

        <div class="day-cell-wrapper {% if hasEvent %}has-event-group{% endif %}">
            <div class="day-content">
                <span class="day-num">{{ day }}</span>
                
                {% if hasEvent %}
                    <div class="events-stack">
                        {% for event in dayEvents|slice(0, 1) %}
                            <div class="mini-event-tag" title="{{ event.title }}">
                                <span class="event-dot"></span>
                                <span class="event-name">{{ event.title }}</span>
                            </div>
                        {% endfor %}
                        
                        {% if dayEvents|length > 1 %}
                            <div class="more-indicator">+{{ dayEvents|length - 1 }} match{{ dayEvents|length > 2 ? 'es' : '' }}</div>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
            
            {# Overlay au survol pour les détails (optionnel) #}
            {% if hasEvent %}
                <div class="event-hover-details">
                    {% for event in dayEvents %}
                        <div class="hover-event-item">
                            <span class="hover-time">{{ event.eventDate|date('H:i') }}</span>
                            <span class="hover-title">{{ event.title }}</span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% endfor %}
</div>