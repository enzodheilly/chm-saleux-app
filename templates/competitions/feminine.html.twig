{% extends 'base.html.twig' %}

{% block title %}Équipe Féminine — CHM Saleux{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/competitions/feminine.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
{% endblock %}

{% block body %}

    {# Header avec dégradé directionnel #}

    <header class="page-header-sport" style="--bg-image: url('{{ asset('images/competitions/1.jpg') }}');">
  <div class="header-overlay-gradient"></div>

  <div class="container header-content">
    <nav class="breadcrumb-nav">
      <a href="{{ path('competition_root') }}" class="back-link-minimal">
        <i class="fa-solid fa-chevron-left"></i> <span>Retour à l'accueil</span>
      </a>
    </nav>

    <div class="header-main-box">
      <div class="badge-accent">Saison 2025 / 2026</div>
      <h1>Équipe<span class="text-outline">Féminine</span></h1>
      <p class="lead">Performance, puissance & progression. Suivez le parcours de nos athlètes.</p>
    </div>
  </div>
</header>

    <main class="dashboard-root">
        
        {# --- SECTION EFFECTIF --- #}
        <section class="container-fluid athlete-section">
            <div class="section-header-row">
                <h2 class="title-with-bar">Effectif <span>Saison 25/26</span></h2>
                <div class="slider-nav">
                    <button id="prevAthlete" type="button" class="nav-circle" aria-label="Précédent"><i class="fa-solid fa-arrow-left"></i></button>
                    <button id="nextAthlete" type="button" class="nav-circle" aria-label="Suivant"><i class="fa-solid fa-arrow-right"></i></button>
                </div>
            </div>

            <div class="athlete-viewport">
                <div class="athlete-track" id="athleteTrack">
                    {% for athlete in athletes %}
                        <div class="athlete-card-modern">
                            <div class="athlete-img-wrapper">
                                <img src="{{ athlete.image ? asset('uploads/athletes/' ~ athlete.image) : asset('images/defaults/athlete-placeholder.jpg') }}" alt="{{ athlete.firstName }}">
                                <div class="athlete-overlay"></div>
                                <div class="athlete-cat-tag">{{ athlete.category|default('Sénior') }}</div>
                            </div>
                            <div class="athlete-info">
                                <span class="last-name">{{ athlete.lastName }}</span>
                                <span class="first-name">{{ athlete.firstName }}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        {# --- DERNIÈRE COMPÉTITION --- #}
        <section class="container last-result-section">
            <h2 class="title-with-bar">Dernier Plateau</h2>

            {% set lastCompetition = competitions|first %}
            {% if lastCompetition %}
                <div class="result-card-main">
                    <div class="result-header" {% if lastCompetition.image %} style="background-image: url('{{ asset('uploads/competitions/' ~ lastCompetition.image) }}');" {% endif %}>
                        <div class="result-header-overlay"></div>
                        <div class="result-meta-data">
                            <div class="meta-left">
                                <span class="date-label"><i class="fa-regular fa-calendar"></i> {{ lastCompetition.eventDate|date('d F Y') }}</span>
                                <h3>{{ lastCompetition.title }}</h3>
                                <p><i class="fa-solid fa-location-dot"></i> {{ lastCompetition.location }}</p>
                            </div>
                            {% if lastCompetition.teamRanking %}
                                <div class="team-rank-box">
                                    <span class="rank-label">Classement Équipe</span>
                                    <span class="rank-number">{{ lastCompetition.teamRanking }}<sup>er</sup></span>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="table-container">
                        <table class="stats-table">
                            <thead>
                                <tr>
                                    <th>Athlète</th>
                                    <th>Cat.</th>
                                    <th class="text-center">Arraché</th>
                                    <th class="text-center">E.J.</th>
                                    <th class="highlight">Total</th>
                                    <th class="highlight-accent">Pts</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for result in lastCompetition.results %}
                                    <tr class="athlete-row">
                                        <td>
                                            <div class="ath-name-cell">
                                                <strong>{{ result.lastName }}</strong> {{ result.firstName }}
                                                <small>PC: {{ result.bodyWeight|default('--') }}kg</small>
                                            </div>
                                        </td>
                                        <td><span class="cat-pill">{{ result.category }}</span></td>
                                        <td class="text-center weight-val">{{ result.snatch }}kg</td>
                                        <td class="text-center weight-val">{{ result.cleanAndJerk }}kg</td>
                                        <td class="highlight total-val">{{ result.total }}kg</td>
                                        <td class="highlight-accent points-val">{{ result.points }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% else %}
                <div class="empty-dashboard">
                    <p>La saison n’a pas encore commencé.</p>
                </div>
            {% endif %}
        </section>

        {# --- ARCHIVES DE LA SAISON (Ajouté ici) --- #}
        {% if competitions|length > 1 %}
        <section class="container section-history">
            <h2 class="title-with-bar">Archives <span>Saison en cours</span></h2>
            
            <div class="history-grid">
                {% for comp in competitions %}
                    {# On ignore la première car elle est déjà affichée au-dessus #}
                    {% if not loop.first %}
                        <article class="history-card">
                            <div class="card-thumb">
                                <img src="{{ comp.image ? asset('uploads/competitions/' ~ comp.image) : asset('images/defaults/competition-placeholder.jpg') }}" alt="{{ comp.title }}">
                                <div class="card-date">{{ comp.eventDate|date('d/m') }}</div>
                            </div>
                            <div class="card-body">
                                <h4>{{ comp.title }}</h4>
                                <p class="card-lieu"><i class="fa-solid fa-location-dot"></i> {{ comp.location }}</p>
                                <a href="#" class="card-link">Consulter le plateau <i class="fa-solid fa-arrow-right"></i></a>
                            </div>
                        </article>
                    {% endif %}
                {% endfor %}
            </div>
        </section>
        {% endif %}

    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/competitions/competitions.js') }}"></script>
{% endblock %}