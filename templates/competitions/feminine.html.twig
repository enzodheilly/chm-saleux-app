{% extends 'base.html.twig' %}

{% block title %}Équipe Féminine - Résultats & Performances{% endblock %}

{% block stylesheets %}
    {# On garde ton fichier, mais je te conseille d'ajouter le CSS que je fournis plus bas #}
    <link rel="stylesheet" href="{{ asset('css/competitions/feminine.css') }}">
    {# Ajout optionnel pour des icônes ou polices si besoin #}
{% endblock %}

{% block body %}

    {# --- HEADER IMMERSIF --- #}
    <header class="page-header">
        <div class="header-bg" style="background-image: url('{{ asset('images/competitions/1.jpg') }}');"></div>
        <div class="header-overlay"></div>
        
        <div class="container header-content">
            <a href="{{ path('competition') }}" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Retour aux compétitions</span>
            </a>
            
            <div class="header-title-box">
                <span class="subtitle">Saison en cours</span>
                <h1>Équipe Féminine</h1>
                <p>Performance, Puissance & Progression. Retrouvez tous les résultats officiels.</p>
            </div>
        </div>
    </header>

    <div class="main-container">
        

        {# --- SECTION 2 : L'ÉQUIPE (SLIDER) --- #}
        <section class="section-team">
            <div class="section-header-flex">
                <h2 class="section-heading">L'effectif</h2>
                <div class="slider-controls">
                    <button id="prevAthlete" class="control-btn"><</button>
                    <button id="nextAthlete" class="control-btn">></button>
                </div>
            </div>

            <div class="athlete-slider-wrapper">
                <div class="athlete-track" id="athleteTrack">
                    {% for athlete in athletes %}
                        <div class="athlete-card">
                            <div class="athlete-img-box">
                                <img src="{{ asset('uploads/athletes/' ~ athlete.image) }}" alt="{{ athlete.prenom }}" loading="lazy">
                                <div class="athlete-badge">{{ athlete.categorie }}</div>
                            </div>
                            <div class="athlete-details">
                                <h3>{{ athlete.prenom }} {{ athlete.nom }}</h3>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        {# --- SECTION 3 : DERNIÈRE COMPÉTITION (STYLE DASHBOARD) --- #}
        <section class="section-last-comp">
            <h2 class="section-heading">Derniers Résultats</h2>

            {% set lastCompetition = competitions|first %}

            {% if lastCompetition %}
                <div class="competition-dashboard">
                    {# En-tête de la compétition #}
                    <div class="dashboard-header" {% if lastCompetition.image %}style="background-image: linear-gradient(to right, rgba(0,0,0,0.9), rgba(0,0,0,0.4)), url('{{ asset('uploads/competitions/' ~ lastCompetition.image) }}');"{% endif %}>
                        <div class="dashboard-meta">
                            <span class="comp-date">{{ lastCompetition.date|date('d F Y') }}</span>
                            <h3 class="comp-title">{{ lastCompetition.titre }}</h3>
                            <div class="comp-location">
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
                                {{ lastCompetition.lieu }}
                            </div>
                            {% if lastCompetition.classementEquipe %}
                                <div class="team-rank-badge">
                                    Équipe : {{ lastCompetition.classementEquipe }}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    {# Tableau de résultats modernisé #}
                    <div class="dashboard-body">
                        <div class="table-responsive">
                            <table class="modern-results-table">
                                <thead>
                                    <tr>
                                        <th>Athlète</th>
                                        <th>Catégorie</th>
                                        <th>Arraché</th>
                                        <th>Épaulé-Jeté</th>
                                        <th>Total</th>
                                        <th>Pts</th>
                                        <th>Statut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for result in lastCompetition.results %}
                                        <tr>
                                            <td class="col-athlete">
                                                <div class="athlete-row">
                                                    <span class="name">{{ result.prenom }} {{ result.nom }}</span>
                                                    <span class="sub-info">PDC: {{ result.pdc }}kg</span>
                                                </div>
                                            </td>
                                            <td>{{ result.categorie }}</td>
                                            <td>{{ result.arracher }}</td>
                                            <td>{{ result.epauleJete }}</td>
                                            <td class="col-total">{{ result.total }}</td>
                                            <td class="col-points">{{ result.point }}</td>
                                            <td>
                                                {% if result.classee %}
                                                    <span class="status-pill success">Classée</span>
                                                {% else %}
                                                    <span class="status-pill error">Non Classée</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr><td colspan="7" class="text-center">Aucun résultat individuel.</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="empty-dashboard">
                    <p>La saison n'a pas encore débuté.</p>
                </div>
            {% endif %}
        </section>

        {# --- SECTION 4 : ARCHIVES (GRILLE) --- #}
        <section class="section-history">
            <h2 class="section-heading">Historique de la saison</h2>
            
            <div class="history-grid">
                {% for comp in competitions %}
                    {# On affiche tout sauf la dernière qui est déjà en vedette #}
                    {% if lastCompetition and comp.id != lastCompetition.id %}
                        <article class="history-card">
                            <div class="card-thumb">
                                <img src="{{ comp.image ? asset('uploads/competitions/' ~ comp.image) : asset('images/defaults/competition-placeholder.jpg') }}" alt="">
                                <div class="card-date">{{ comp.date|date('d/m') }}</div>
                            </div>
                            <div class="card-body">
                                <h4>{{ comp.titre }}</h4>
                                <p class="card-lieu">{{ comp.lieu }}</p>
                                <a href="#" class="card-link">Voir les détails &rarr;</a>
                            </div>
                        </article>
                    {% endif %}
                {% endfor %}
            </div>
            
            {% if competitions|length <= 1 %}
                <p class="text-muted text-center">Aucune archive pour le moment.</p>
            {% endif %}
        </section>

    </div> {# Fin main-container #}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/competitions/competitions.js') }}"></script>
{% endblock %}