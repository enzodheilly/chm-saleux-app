{% extends 'base.html.twig' %}

{# On définit des variables pour adapter le contenu selon le genre #}
{% set isFeminine = gender == 'feminine' %}
{% set teamLabel = isFeminine ? 'Féminine' : 'Masculine' %}
{% set headerClass = isFeminine ? 'feminine-archives-header-bg' : 'masculine-archives-header-bg' %}

{% block title %}Archives — Équipe
	{{ teamLabel }}
	| CHM Saleux
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{# Tes CSS actuels fonctionnent très bien avec cette structure #}
	<link rel="stylesheet" href="{{ asset('css/competitions/team-archives.css') }}">
{% endblock %}

{% block body %}

	<header class="page-header-sport {{ headerClass }}">
		<div class="header-overlay-gradient"></div>

		<div class="header-content">
			<div class="page-container">
				<nav
					class="breadcrumb-nav archives-breadcrumbs">
					{# Retour dynamique vers la page de l'équipe correspondante #}
					<a href="{{ path('competitions_team', { gender: gender }) }}" class="back-link-minimal">
						<i class="fa-solid fa-chevron-left"></i>
						<span>Équipe
							{{ teamLabel|lower }}</span>
					</a>
				</nav>

				<div class="header-main-box">
					<div class="badge-accent">Historique complet</div>
					<h1>Archives
						<span class="text-outline">{{ teamLabel }}s</span>
					</h1>
					<p class="lead">
						Retrouvez l’ensemble des plateaux de l’équipe
						{{ teamLabel|lower }}, classés du plus récent au plus ancien.
					</p>
				</div>
			</div>
		</div>
	</header>

	{# IMAGE DÉCORATIVE GAUCHE #}
	<div class="deco-left-wrap">
		<img src="{{ asset('images/decorations/dots-tree.png') }}" alt="" class="deco-left-img" aria-hidden="true">
	</div>

	<main class="page-shell dashboard-root archives-page-root">

		<section class="page-container section-spacer section-history-full">
			<div class="archives-topbar">
				<div class="section-header-compact centered">
					<h2 class="section-heading">Tous les
						<span>Résultats</span>
					</h2>
					<p class="archives-subtext">
						{{ competitions|length }}
						compétition{{ competitions|length > 1 ? 's' : '' }}
						enregistrée{{ competitions|length > 1 ? 's' : '' }}
					</p>
				</div>
			</div>

			{% if competitions is not empty %}
				<div class="history-grid history-grid-archives">
					{% for comp in competitions %}
						<article class="history-card history-card-archives">
							<div class="card-thumb">
								<img src="{{ comp.image ? asset('uploads/competitions/' ~ comp.image) : asset('images/defaults/competition-placeholder.jpg') }}" alt="{{ comp.title }}">
								<div class="card-date">{{ comp.eventDate ? comp.eventDate|date('d/m/Y') : '--/--/----' }}</div>

								{% if comp.teamRanking %}
									<div class="card-ranking-badge">
										{{ comp.teamRanking }}{{ comp.teamRanking == 1 ? 'er' : 'e' }}
									</div>
								{% endif %}
							</div>

							<div class="card-body">
								<h4>{{ comp.title }}</h4>

								<p class="card-lieu">
									<i class="fa-solid fa-location-dot"></i>
									{{ comp.location ?: 'Lieu non renseigné' }}
								</p>

								<div class="archive-meta-list">
									<div class="archive-meta-item">
										<span class="meta-label">Date</span>
										<span class="meta-value">
											{{ comp.eventDate ? comp.eventDate|date('d F Y') : 'Non renseignée' }}
										</span>
									</div>

									<div class="archive-meta-item">
										<span class="meta-label">Résultats</span>
										<span class="meta-value">
											{{ comp.results|length }}
											athlète{{ comp.results|length > 1 ? 's' : '' }}
										</span>
									</div>

									{% if comp.teamRanking %}
										<div class="archive-meta-item">
											<span class="meta-label">Classement</span>
											<span class="meta-value meta-rank">
												{{ comp.teamRanking }}{{ comp.teamRanking == 1 ? 'er' : 'e' }}
												{{ isFeminine ? 'équipe' : 'club' }}
											</span>
										</div>
									{% endif %}
								</div>

								<a href="{{ path('competition_show', { id: comp.id }) }}" class="card-link">
									Consulter le plateau
									<i class="fa-solid fa-arrow-right"></i>
								</a>
							</div>
						</article>
					{% endfor %}
				</div>
			{% else %}
				<div class="empty-dashboard">
					<p>Aucune archive disponible pour l’équipe
						{{ teamLabel|lower }}
						pour le moment.</p>
				</div>
			{% endif %}
		</section>

	</main>
{% endblock %}
