{% extends 'base.html.twig' %}

{% set isFeminine = gender == 'feminine' %}
{% set teamLabel = isFeminine ? 'Féminine' : 'Masculine' %}
{% set headerClass = isFeminine ? 'feminine-archives-header-bg' : 'masculine-archives-header-bg' %}

{% block title %}Archives — Équipe {{ teamLabel }} | CHM Saleux{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/competitions/team-archives.css') }}">
{% endblock %}

{% block body %}

	<header class="page-header-sport {{ headerClass }}">
		<div class="header-overlay-gradient"></div>
		<div class="header-content">
			<div class="page-container">
				<nav class="breadcrumb-nav archives-breadcrumbs">
					<a href="{{ path('competitions_team', { gender: gender }) }}" class="back-link-minimal">
						<i class="fa-solid fa-chevron-left"></i>
						<span>Équipe {{ teamLabel|lower }}</span>
					</a>
				</nav>
				<div class="header-main-box">
					<div class="badge-accent">Historique complet</div>
					<h1>Archives
						<span class="text-outline">{{ teamLabel }}s</span>
					</h1>
					<p class="lead">Retrouvez l'ensemble des plateaux de l'équipe {{ teamLabel|lower }}, classés du plus récent au plus ancien.</p>
				</div>
			</div>
		</div>
	</header>

	<main class="page-shell archives-page-root">

		<section class="page-container section-spacer">

			<div class="archives-header">
				<h2 class="section-heading">Tous les <span>Résultats</span></h2>
				<span class="archives-count-pill">
					{{ total }} plateau{{ total > 1 ? 'x' : '' }} au total
				</span>
			</div>

			{% if competitions is not empty %}

				<div class="arc-grid">
					{% for comp in competitions %}
						<a href="{{ path('competition_show', { id: comp.id }) }}" class="arc-card">

							{# — Image — #}
							<div class="arc-card-media">
								<img
									class="arc-card-img"
									src="{{ comp.image ? asset('uploads/competitions/' ~ comp.image) : asset('images/defaults/competition-placeholder.jpg') }}"
									alt="{{ comp.title }}"
									loading="lazy"
									draggable="false">
							</div>

							{# — Bande texte — #}
							<div class="arc-card-body">

								<span class="arc-card-eyebrow {% if comp.teamRanking and comp.teamRanking <= 3 %}arc-eyebrow--orange{% endif %}">
									{% if comp.teamRanking %}
										{{ comp.teamRanking }}{{ comp.teamRanking == 1 ? 'er' : 'e' }} classement
									{% elseif comp.location %}
										{{ comp.location }}
									{% else %}
										Plateau national
									{% endif %}
								</span>

								<h4 class="arc-card-title">{{ comp.title }}</h4>

								{% if comp.description %}
									<p class="arc-card-excerpt">{{ comp.description|striptags|slice(0, 110) }}…</p>
								{% endif %}

								<div class="arc-card-footer">
									{% if comp.results|length > 0 %}
										<span class="arc-card-meta">{{ comp.results|length }} athlète{{ comp.results|length > 1 ? 's' : '' }}</span>
									{% endif %}
									<span class="arc-card-date">
										{{ comp.eventDate ? comp.eventDate|date('d/m/Y') : '' }}
									</span>
								</div>

							</div>

						</a>
					{% endfor %}
				</div>

			{% if competitions|length > 6 %}
				<div class="arc-mobile-more-wrap" id="arcMoreWrap">
					<button type="button" class="arc-mobile-more-btn" id="arcMobileMore">
						Voir plus
					</button>
				</div>
			{% endif %}

			{% else %}
				<div class="arc-empty">
					<i class="fa-solid fa-trophy"></i>
					<p>Aucune archive disponible pour l'équipe {{ teamLabel|lower }} pour le moment.</p>
				</div>
			{% endif %}

			{# — Pagination — #}
			{% if totalPages > 1 %}
				<div class="arc-pagination">
					<a href="{{ path('competition_team_archives', { gender: gender, page: currentPage - 1 }) }}"
					   class="arc-page-btn {{ currentPage <= 1 ? 'disabled' : '' }}">
						<i class="fa-solid fa-chevron-left"></i>
					</a>

					{% for p in 1..totalPages %}
						<a href="{{ path('competition_team_archives', { gender: gender, page: p }) }}"
						   class="arc-page-btn {{ p == currentPage ? 'active' : '' }}">{{ p }}</a>
					{% endfor %}

					<a href="{{ path('competition_team_archives', { gender: gender, page: currentPage + 1 }) }}"
					   class="arc-page-btn {{ currentPage >= totalPages ? 'disabled' : '' }}">
						<i class="fa-solid fa-chevron-right"></i>
					</a>
				</div>
			{% endif %}

		</section>

	</main>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('js/competitions/archives.js') }}"></script>
{% endblock %}
