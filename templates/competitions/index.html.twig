{% extends 'base.html.twig' %}

{% block title %}Compétitions & Résultats - CHM Saleux{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/competitions/competitions.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
{% endblock %}

{% block body %}

<header class="page-header" style="background-image: url('{{ asset('images/90.jpg') }}');">
    <div class="header-overlay"></div>
    
    <div class="container header-content">
        <a href="{{ path('home') }}" class="back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            <span>Retour à l'accueil</span>
        </a>
        
        <div class="header-title-box">
            <span class="subtitle">Saison 2025-2026</span>
            <h1>Compétitions & résultats</h1>
            <p>Le calendrier officiel et les performances de nos athlètes sur les plateaux nationaux et régionaux.</p>
        </div>
    </div>
</header>

<main class="main-container">

    {# --- SECTION AGENDA DYNAMIQUE --- #}
    <section class="calendar-section">
        <div class="section-title-wrapper">
            <h2 class="section-heading">Agenda Sportif</h2>
            <p>Retrouvez les dates clés des prochaines échéances gérées par le club.</p>
        </div>

        <div id="calendar-container" class="calendar-card">
            {# On inclut le fichier partiel créé à l'étape 2 #}
            {% include 'competitions/_calendar_grid.html.twig' %}
        </div>
    </section>

    {# --- SECTION ÉQUIPES --- #}
    <section class="teams-section">
        <div class="section-title-wrapper">
            <h2 class="section-heading">Nos Équipes</h2>
            <p>Sélectionnez une équipe pour voir les résultats détaillés et les classements.</p>
        </div>

        <div class="teams-grid">
            {# Carte Féminine #}
            <a href="{{ path('competitions_feminine') }}" class="team-card">
                <div class="card-img-box">
                    <img src="{{ asset('images/female-team.jpg') }}" alt="Équipe Féminine">
                    <div class="card-overlay"></div>
                </div>
                <div class="card-info">
                    <span class="pille">Haltérophilie</span>
                    <h3>Équipe<br><strong>Féminine</strong></h3>
                    <p>Calendriers de matchs, résultats individuels et performances collectives.</p>
                    <div class="card-footer-link">
                        Explorer les résultats <i class="fa-solid fa-arrow-right"></i>
                    </div>
                </div>
            </a>

            {# Carte Masculine #}
            <a href="{{ path('competitions_masculine') }}" class="team-card">
                <div class="card-img-box">
                    <img src="{{ asset('images/male-team.jpg') }}" alt="Équipe Masculine">
                    <div class="card-overlay"></div>
                </div>
                <div class="card-info">
                    <span class="pille">Haltérophilie</span>
                    <h3>Équipe<br><strong>Masculine</strong></h3>
                    <p>Suivi des records, calendrier des plateaux et effectifs de la saison.</p>
                    <div class="card-footer-link">
                        Explorer les résultats <i class="fa-solid fa-arrow-right"></i>
                    </div>
                </div>
            </a>
        </div>
    </section>

</main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/competitions/competitions.js') }}" defer></script>
{% endblock %}