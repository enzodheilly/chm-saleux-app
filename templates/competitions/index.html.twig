{% extends 'base.html.twig' %}

{% block title %}Compétitions & Résultats — CHM Saleux
{% endblock %}

{% block og_title %}Compétitions & Résultats — CHM Saleux
{% endblock %}

{% block og_description %}Suivez les résultats et performances de nos équipes masculine et féminine en compétition d'haltérophilie.
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/competitions/competitions.css') }}">
{% endblock %}

{% block body %}

	<header class="page-header-sport competition-header-bg">

		<div class="header-overlay-gradient"></div>

		<div class="header-content">
			<div class="page-container">
				{% include 'components/breadcrumb.html.twig' with { items: [{ label: 'Compétitions' }] } %}

				<div class="header-main-box">
					<h1>Compétitions &
						<span class="text-outline">Résultats</span>
					</h1>
					<p class="lead">Retrouvez les événements du club et découvrez nos équipes.</p>
				</div>
			</div>
		</div>
	</header>

	{# IMAGE DÉCORATIVE GAUCHE #}

	<main
		class="page-shell competitions-root">

		{# --- SECTION AGENDA --- #}
		<section class="page-container section-spacer calendar-section">
			<div class="comp-wm page-wm" aria-hidden="true">AGENDA</div>
			<div id="calendar-container" class="calendar-wrapper">
				<div class="calendar-card">
					{% include 'competitions/_calendar_grid.html.twig' %}
				</div>
			</div>
		</section>

		{# --- SECTION ÉQUIPES --- #}
		<section class="bg-dark">
			<div class="comp-wm page-wm" aria-hidden="true">NOS <br class="wm-br">ÉQUIPES</div>
			<div class="page-container section-spacer teams-section">
				<div
					class="teams-grid">
					{# Carte Féminine #}
					<a href="{{ path('competitions_team', { 'gender': 'feminine' }) }}" class="team-card" aria-label="Voir l'équipe féminine">
						<div class="card-img-box">
							<img src="{{ asset('images/competitions/1.jpg') }}" alt="Équipe Féminine CHM Saleux" loading="lazy" draggable="false">
							<div class="card-overlay"></div>
						</div>
						<div class="card-num" aria-hidden="true">01</div>
						<div class="card-info">
							<div class="card-pille">Féminin</div>
							<h3>Équipe <strong>Féminine</strong></h3>
							<div class="card-reveal">
								<p>Calendriers de matchs, résultats individuels et performances collectives.</p>
								<span class="card-footer-link">Explorer <i class="fa-solid fa-arrow-right"></i></span>
							</div>
						</div>
					</a>

					{# Carte Masculine #}
					<a href="{{ path('competitions_team', { 'gender': 'masculine' }) }}" class="team-card" aria-label="Voir l'équipe masculine">
						<div class="card-img-box">
							<img src="{{ asset('images/competitions/male-team.jpg') }}" alt="Équipe Masculine CHM Saleux" loading="lazy" draggable="false">
							<div class="card-overlay"></div>
						</div>
						<div class="card-num" aria-hidden="true">02</div>
						<div class="card-info">
							<div class="card-pille">Masculin</div>
							<h3>Équipe <strong>Masculine</strong></h3>
							<div class="card-reveal">
								<p>Suivi des records, calendrier des plateaux et effectifs de la saison.</p>
								<span class="card-footer-link">Explorer <i class="fa-solid fa-arrow-right"></i></span>
							</div>
						</div>
					</a>
				</div>
			</div>
		</section>

		{# --- SECTION CHIFFRES CLÉS --- #}
		<section class="page-container section-spacer stats-section">
			<div class="section-header-competition centered">
				<h2 class="section-heading">
					Le Club
					<span>En Chiffres</span>
				</h2>
				<p class="section-subtext">Une saison de performances et d'engagements.</p>
			</div>

			<div class="stats-grid">

				<div class="stat-card">
					<div class="stat-icon">
						<i class="fa-solid fa-medal"></i>
					</div>
					<div class="stat-value">47</div>
					<div class="stat-label">Médailles cette saison</div>
				</div>

				<div class="stat-card">
					<div class="stat-icon">
						<i class="fa-solid fa-users"></i>
					</div>
					<div class="stat-value">32</div>
					<div class="stat-label">Athlètes en compétition</div>
				</div>

				<div class="stat-card">
					<div class="stat-icon">
						<i class="fa-solid fa-flag-checkered"></i>
					</div>
					<div class="stat-value">12</div>
					<div class="stat-label">Compétitions disputées</div>
				</div>

				<div class="stat-card highlight">
					<div class="stat-icon">
						<i class="fa-solid fa-trophy"></i>
					</div>
					<div class="stat-value">8</div>
					<div class="stat-label">Titres régionaux</div>
				</div>

			</div>
		</section>

	</main>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	 <script src="{{ asset('js/competitions/competitions.js') }}" defer></script>
	<script nonce="{{ csp_nonce('script') }}">
		(function(){
			var els = document.querySelectorAll('.comp-wm');
			if(!els.length) return;
			var obs = new IntersectionObserver(function(entries){
				entries.forEach(function(e){ if(e.isIntersecting) e.target.classList.add('is-visible'); });
			},{threshold:0});
			els.forEach(function(el){ obs.observe(el); });
		})();
	</script>
{% endblock %}
